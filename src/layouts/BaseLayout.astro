---
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import EmacsMinibuffer from "../components/EmacsMinibuffer.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  author?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title = "Szymon Wilczek",
  description = "Personal website, software projects, developer utilities, photography, and plain-text writings.",
  image,
  imageAlt,
  type = "website",
  pubDate,
  updatedDate,
  category,
  tags,
  author,
  noindex = false,
  breadcrumbs,
  prevUrl,
  nextUrl,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      rel="preload"
      href="/fonts/TypusMono95-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/TypusMono95-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Literata-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      category={category}
      tags={tags}
      author={author}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />

    <script is:inline>
      (function () {
        function applyThemeAndFont() {
          var stored = localStorage.getItem("theme");
          if (
            stored === "light" ||
            stored === "dark" ||
            stored === "arcadia" ||
            stored === "day" ||
            stored === "autumn"
          ) {
            document.documentElement.setAttribute("data-theme", stored);
          } else {
            var prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
            document.documentElement.setAttribute("data-theme", prefersLight ? "light" : "dark");
          }

          var font = localStorage.getItem("font-preference");
          if (font) {
            document.documentElement.setAttribute("data-font", font);
          }
        }
        applyThemeAndFont();
      })();
    </script>

    <script type="speculationrules">
      {
        "prerender": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/*.xml" } },
                { "not": { "href_matches": "/downloads/*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <header class="mobile-header">
      <button
        id="mobile-menu-toggle"
        class="mobile-menu-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        <span>[Menu]</span>
      </button>
      <a href="/" class="mobile-title">Szymon Wilczek</a>
    </header>

    <div id="drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>

    <div class="site-layout">
      <Sidebar currentPath={Astro.url.pathname} />
      <div class="content-wrapper">
        <main id="main-content">
          <div class="main-body">
            <slot />
          </div>
          <div class="site-page-footer">
            <Footer />
          </div>
        </main>
      </div>
    </div>

    <EmacsMinibuffer />

    <script>
      (function () {
        function initCodeCopy() {
          var pres = document.querySelectorAll("pre");
          pres.forEach(function (pre) {
            if (
              pre.closest(".raw-code-drawer") ||
              (pre.parentElement && pre.parentElement.classList.contains("code-block-wrapper"))
            )
              return;

            var wrapper = document.createElement("div");
            wrapper.className = "code-block-wrapper";

            var btn = document.createElement("button");
            btn.type = "button";
            btn.className = "copy-code-btn";
            btn.setAttribute("aria-label", "Copy code to clipboard");
            btn.textContent = "Copy";

            btn.addEventListener("click", function () {
              var code = pre.querySelector("code") || pre;
              var text = code.innerText || code.textContent || "";
              navigator.clipboard.writeText(text.trim()).then(function () {
                btn.textContent = "Copied";
                btn.classList.add("is-copied");
                setTimeout(function () {
                  btn.textContent = "Copy";
                  btn.classList.remove("is-copied");
                }, 2000);
              });
            });

            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);
            wrapper.appendChild(btn);
          });
        }

        initCodeCopy();
      })();
    </script>
  </body>
</html>
