---
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import EmacsMinibuffer from "../components/EmacsMinibuffer.astro";
import ThemePicker from "../components/ThemePicker.astro";
import SEO from "../components/SEO.astro";
import auThemes from "../data/au-themes.json";
import "../styles/global.css";

const themeIds = auThemes.map((theme) => theme.id);

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  author?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title = "Szymon Wilczek",
  description = "Personal website, developer utilities, photography, and plain-text writings.",
  image,
  imageAlt,
  type = "website",
  pubDate,
  updatedDate,
  category,
  tags,
  author,
  noindex = false,
  breadcrumbs,
  prevUrl,
  nextUrl,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      rel="preload"
      href="/fonts/TypusMono95-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/TypusMono95-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Literata-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      category={category}
      tags={tags}
      author={author}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />

    <script is:inline define:vars={{ themeIds }}>
      (function () {
        var KEY = "au-theme";
        var DEFAULTS = { light: "aurum-day", dark: "aurum-night" };
        var root = document.documentElement;
        var light = window.matchMedia("(prefers-color-scheme: light)");

        function read() {
          try {
            var stored = localStorage.getItem(KEY);
            return themeIds.indexOf(stored) === -1 ? "auto" : stored;
          } catch (e) {
            return "auto";
          }
        }

        function resolve(choice) {
          if (choice !== "auto") return choice;
          return light.matches ? DEFAULTS.light : DEFAULTS.dark;
        }

        function apply(choice) {
          root.setAttribute("data-theme", resolve(choice));
          root.setAttribute("data-theme-choice", choice);
        }

        window.auTheme = {
          ids: themeIds,
          get: read,
          resolve: resolve,
          set: function (choice) {
            try {
              if (choice === "auto") localStorage.removeItem(KEY);
              else localStorage.setItem(KEY, choice);
            } catch (e) {}
            apply(choice);
            document.dispatchEvent(
              new CustomEvent("au-theme-change", {
                detail: { choice: choice, theme: resolve(choice) },
              }),
            );
          },
          preview: function (id) {
            root.setAttribute("data-theme", id || resolve(read()));
          },
          flood: function (choice) {
            var set = window.auTheme.set;
            var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (!document.startViewTransition || still) return set(choice);

            var button = document.getElementById("theme-toggle");
            var r = button && button.getBoundingClientRect();
            var visible = r && r.width > 0;
            root.style.setProperty(
              "--ink-x",
              (visible ? r.left + r.width / 2 : innerWidth - 40) + "px",
            );
            root.style.setProperty("--ink-y", (visible ? r.top + r.height / 2 : 40) + "px");
            root.classList.add("ink-flood");
            document
              .startViewTransition(function () {
                set(choice);
              })
              .finished.finally(function () {
                root.classList.remove("ink-flood");
              });
          },
        };

        try {
          localStorage.removeItem("theme");
        } catch (e) {}

        light.addEventListener("change", function () {
          if (read() === "auto") apply("auto");
        });
        apply(read());

        try {
          var font = localStorage.getItem("font-preference");
          if (font) root.setAttribute("data-font", font);
        } catch (e) {}
      })();
    </script>
    <script type="speculationrules">
      {
        "prerender": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/*.xml" } },
                { "not": { "href_matches": "/downloads/*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <div class="site-page">
      <SiteHeader />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>

    <ThemePicker />
    <EmacsMinibuffer />

    <script>
      (function () {
        function pressHanko(wrapper: HTMLElement) {
          wrapper.querySelector(".copy-hanko")?.remove();
          var hanko = document.createElement("span");
          hanko.className = "copy-hanko";
          hanko.setAttribute("aria-hidden", "true");
          hanko.innerHTML =
            '<svg viewBox="0 0 46 46" width="40" height="40"><path d="M4 5 Q23 2 42 4 Q45 23 43 42 Q23 45 3 43 Q1 23 4 5 Z"/><text x="23" y="31" text-anchor="middle">写</text></svg>';
          wrapper.append(hanko);
          hanko.addEventListener("animationend", function () {
            hanko.remove();
          });
        }

        function initCodeCopy() {
          var pres = document.querySelectorAll("pre");
          pres.forEach(function (pre) {
            if (
              pre.closest(".raw-code-drawer") ||
              (pre.parentElement && pre.parentElement.classList.contains("code-block-wrapper"))
            )
              return;

            var wrapper = document.createElement("div");
            wrapper.className = "code-block-wrapper";

            var btn = document.createElement("button");
            btn.type = "button";
            btn.className = "copy-code-btn";
            btn.setAttribute("aria-label", "Copy code to clipboard");
            btn.textContent = "Copy";

            btn.addEventListener("click", function () {
              var code = pre.querySelector("code") || pre;
              var text = code.innerText || code.textContent || "";
              navigator.clipboard.writeText(text.trim()).then(function () {
                pressHanko(wrapper);
                btn.setAttribute("aria-label", "Copied");
                btn.classList.add("is-copied");
                setTimeout(function () {
                  btn.setAttribute("aria-label", "Copy code to clipboard");
                  btn.classList.remove("is-copied");
                }, 2000);
              });
            });

            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);
            wrapper.appendChild(btn);
          });
        }

        initCodeCopy();
      })();
    </script>
    <script>
      import { earn, season, SEASONS, walk } from "../utils/garden";
      import "../scripts/focus-loop";
      import "../scripts/tab-title";
      import "../scripts/glossary";
      import "../scripts/console";

      walk(location.pathname);
      earn("狼");
      earn(SEASONS[season()].glyph);

      // season's ornament shows on the dividers
      document.documentElement.dataset.season = season();
      try {
        if (season() === "autumn" && !sessionStorage.getItem("kigo-fell")) {
          sessionStorage.setItem("kigo-fell", "1");
          document.querySelector(".divider")?.classList.add("kigo-drift");
        }
      } catch {
        // without session storage the leaf simply lies there
      }

      // staying a full minute late at night earns seal
      var hour = new Date().getHours();
      if (hour >= 21 || hour < 5) {
        setTimeout(function () {
          earn("夜");
        }, 60000);
      }
    </script>
  </body>
</html>
