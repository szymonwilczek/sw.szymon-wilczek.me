---
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import EmacsMinibuffer from '../components/EmacsMinibuffer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Szymon Wilczek',
  description = 'Personal website, projects, files, and writings.',
} = Astro.props;

const pageTitle = title === 'Szymon Wilczek' ? title : `${title} · Szymon Wilczek`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href="/fonts/TypusMono95-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark' || stored === 'arcadia' || stored === 'day' || stored === 'autumn') {
          document.documentElement.setAttribute('data-theme', stored);
        } else {
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.setAttribute('data-theme', prefersLight ? 'light' : 'dark');
        }
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title="Szymon Wilczek RSS Feed" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="mobile-header">
      <button id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Open navigation menu" aria-expanded="false">
        <span>[Menu]</span>
      </button>
      <a href="/" class="mobile-title">Szymon Wilczek</a>
    </header>

    <div id="drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>

    <div class="site-layout">
      <Sidebar currentPath={Astro.url.pathname} />
      <div class="content-wrapper">
        <main id="main-content">
          <slot />
        </main>
        <div class="mobile-footer">
          <Footer />
        </div>
      </div>
    </div>
    <EmacsMinibuffer />
  </body>
</html>
