---
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import EmacsMinibuffer from "../components/EmacsMinibuffer.astro";
import ThemePicker from "../components/ThemePicker.astro";
import Pebble from "../components/Pebble.astro";
import SEO from "../components/SEO.astro";
import auThemes from "../data/au-themes.json";
import moreThemes from "../styles/au-themes-more.css?url";
import "../styles/global.css";

const themeIds = auThemes.map((theme) => theme.id);

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  author?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
  prevUrl?: string;
  nextUrl?: string;
  collection?: boolean;
  wordCount?: number;
  graph?: Record<string, unknown>[];
}

const {
  title = "Szymon Wilczek",
  description,
  image,
  imageAlt,
  type = "website",
  pubDate,
  updatedDate,
  category,
  tags,
  author,
  noindex = false,
  breadcrumbs,
  prevUrl,
  nextUrl,
  collection,
  wordCount,
  graph,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Fragment
      set:html={
        "<!-- you look under stones. M-x knows one command it never lists: show-me-the-... -->"
      }
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      rel="preload"
      href="/fonts/TypusMono95-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Literata-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Kalam-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <link
      rel="preload"
      href="/fonts/Kalam-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <link
      rel="preload"
      href="/fonts/YujiSyuku-seals.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <slot name="head" />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      category={category}
      tags={tags}
      author={author}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      collection={collection}
      wordCount={wordCount}
      graph={graph}
    />

    <script is:inline define:vars={{ themeIds, moreThemes }}>
      (function () {
        var STORAGE_KEY = "au-theme";
        var DEFAULTS = { light: "salina-day", dark: "salina-night" };
        var root = document.documentElement;
        var light = window.matchMedia("(prefers-color-scheme: light)");

        function read() {
          try {
            var stored = localStorage.getItem(STORAGE_KEY);
            return themeIds.indexOf(stored) === -1 ? "auto" : stored;
          } catch (error) {
            return "auto";
          }
        }

        function resolve(choice) {
          if (choice !== "auto") return choice;
          return light.matches ? DEFAULTS.light : DEFAULTS.dark;
        }

        var sheet = null;
        var loaded = false;
        var afterLoad = null;

        function ready(theme) {
          return loaded || theme === DEFAULTS.light || theme === DEFAULTS.dark;
        }

        function fetchThemes() {
          if (sheet) return;
          sheet = document.createElement("link");
          sheet.rel = "stylesheet";
          sheet.href = moreThemes;
          sheet.onload = function () {
            loaded = true;
            var next = afterLoad;
            afterLoad = null;
            if (next) next();
          };
          sheet.onerror = function () {
            sheet.remove();
            sheet = null;
            afterLoad = null;
          };
          document.head.insertBefore(sheet, document.querySelector("style"));
        }

        function whenReady(theme, callback) {
          if (!ready(theme)) {
            afterLoad = callback;
            fetchThemes();
            return;
          }
          afterLoad = null;
          callback();
        }

        function apply(choice) {
          root.setAttribute("data-theme", resolve(choice));
          root.setAttribute("data-theme-choice", choice);
        }

        var pouring = false;
        var waiting = null;
        var desk = window.matchMedia(
          "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
        );

        function pour(job) {
          if (!ready(job.theme)) {
            whenReady(job.theme, function () {
              pour(job);
            });
            return;
          }
          afterLoad = null;
          var still = !desk.matches || navigator.maxTouchPoints > 0;
          if (!document.startViewTransition || still) return job.apply();
          if (pouring) {
            waiting = job;
            return;
          }
          if (root.getAttribute("data-theme") === job.theme) {
            job.apply();
            return;
          }
          pouring = true;
          var button = document.getElementById("theme-toggle");
          var rect = button && button.getBoundingClientRect();
          var visible = rect && rect.width > 0;
          var x = visible ? rect.left + rect.width / 2 : innerWidth - 40;
          var y = visible ? rect.top + rect.height / 2 : 40;
          var reach = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

          root.style.setProperty("--ink-x", x + "px");
          root.style.setProperty("--ink-y", y + "px");
          root.style.setProperty("--ink-size", Math.ceil(reach * 2.7) + "px");
          root.classList.add("ink-flood");
          root.classList.toggle("ink-quick", job.quick);

          var flow = document.startViewTransition(job.apply);
          flow.ready.catch(function () {});
          flow.finished.finally(function () {
            pouring = false;
            var next = waiting;
            waiting = null;
            if (next) pour(next);
            else root.classList.remove("ink-flood", "ink-quick");
          });
        }

        function store(choice) {
          try {
            if (choice === "auto") localStorage.removeItem(STORAGE_KEY);
            else localStorage.setItem(STORAGE_KEY, choice);
          } catch (error) {}
        }

        function show(choice) {
          apply(choice);
          document.dispatchEvent(
            new CustomEvent("au-theme-change", {
              detail: { choice: choice, theme: resolve(choice) },
            }),
          );
        }

        window.auTheme = {
          ids: themeIds,
          get: read,
          resolve: resolve,
          set: function (choice) {
            store(choice);
            whenReady(resolve(choice), function () {
              show(choice);
            });
          },
          warm: fetchThemes,
          preview: function (id) {
            var theme = id || resolve(read());
            if (waiting && waiting.theme === theme) return;
            pour({
              theme: theme,
              quick: true,
              apply: function () {
                root.setAttribute("data-theme", theme);
              },
            });
          },
          flood: function (choice) {
            store(choice);
            pour({
              theme: resolve(choice),
              quick: false,
              apply: function () {
                show(choice);
              },
            });
          },
        };

        try {
          localStorage.removeItem("theme");
          localStorage.removeItem("font-preference");
        } catch (error) {}

        light.addEventListener("change", function () {
          if (read() === "auto") apply("auto");
        });

        var first = resolve(read());
        if (!ready(first)) {
          document.write(
            '<link rel="stylesheet" href="' +
              moreThemes +
              "\" onerror=\"document.documentElement.setAttribute('data-theme', '" +
              resolve("auto") +
              "')\">",
          );
          sheet = true;
          loaded = true;
        }
        apply(read());
      })();
    </script>
    <script type="speculationrules">
      {
        "prerender": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/*.xml" } },
                { "not": { "href_matches": "/downloads/*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <div class="site-page">
      <SiteHeader />
      <main id="main-content">
        <slot />
      </main>
      <Pebble />
      <Footer />
    </div>

    <ThemePicker />
    <EmacsMinibuffer />

    <script>
      (function () {
        function initCodeCopy() {
          var pres = document.querySelectorAll("pre");
          pres.forEach(function (pre) {
            if (
              pre.closest(".raw-code-drawer") ||
              (pre.parentElement && pre.parentElement.classList.contains("code-block-wrapper"))
            )
              return;

            var wrapper = document.createElement("div");
            wrapper.className = "code-block-wrapper";

            var button = document.createElement("button");
            button.type = "button";
            button.className = "copy-code-btn";
            button.setAttribute("aria-label", "Copy code to clipboard");
            button.textContent = "Copy";

            button.addEventListener("click", function () {
              var code = pre.querySelector("code") || pre;
              var text = code.innerText || code.textContent || "";
              navigator.clipboard.writeText(text.trim()).then(function () {
                button.setAttribute("aria-label", "Copied");
                button.classList.add("is-copied");
                setTimeout(function () {
                  button.setAttribute("aria-label", "Copy code to clipboard");
                  button.classList.remove("is-copied");
                }, 2000);
              });
            });

            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);
            wrapper.appendChild(button);
          });
        }

        initCodeCopy();
      })();
    </script>
    <script>
      import { earn, season, SEASONS, walk } from "../utils/garden";
      import "../scripts/focus-loop";
      import "../scripts/glossary";
      import "../scripts/console";
      import "../scripts/print";
      import "../scripts/stamping";
      import "../scripts/wolf-seal";
      import "../scripts/dusk";
      import "../scripts/zone";

      walk(location.pathname);
      earn("狼");
      earn(SEASONS[season()].glyph);

      // season's ornament shows on the dividers
      document.documentElement.dataset.season = season();
      try {
        if (season() === "autumn" && !sessionStorage.getItem("kigo-fell")) {
          sessionStorage.setItem("kigo-fell", "1");
          document.querySelector(".divider")?.classList.add("kigo-drift");
        }
      } catch {
        // without session storage the geese are simply there
      }

      // staying a full minute late at night earns seal
      var hour = new Date().getHours();
      if (hour >= 21 || hour < 5) {
        setTimeout(function () {
          earn("夜");
        }, 60000);
      }
    </script>
  </body>
</html>
