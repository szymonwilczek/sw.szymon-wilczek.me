---
import BaseLayout from "../layouts/BaseLayout.astro";
import Seal from "../components/Seal.astro";
import Kintsugi from "../components/Kintsugi.astro";
---

<BaseLayout
  title="404 Not Found"
  description="The requested resource could not be found."
  noindex={true}
>
  <div class="lost">
    <div class="map">
      <svg viewBox="0 0 360 260" aria-hidden="true">
        <path
          class="trail"
          d="M18 236 C 60 220, 64 180, 104 176 C 150 172, 170 214, 206 196 C 246 176, 196 128, 150 132 C 104 136, 92 86, 136 66 C 176 48, 230 82, 262 60 C 286 44, 280 20, 306 18"
        ></path>
        <path class="cross" d="M300 8 L 316 28 M 316 8 L 300 28"></path>
        <circle class="you" cx="18" cy="236" r="5"></circle>
        <text x="30" y="256">
          you, somewhere
        </text>
        <text x="308" y="-4" text-anchor="middle" transform="rotate(-4 308 -4)">
          it was here?
        </text>
      </svg>
      <p class="code" aria-hidden="true">
        404
      </p>
    </div>

    <div class="words">
      <div class="title">
        <Seal glyph="迷" size={44} tilt={5} />
        <h1>Are you lost?</h1>
      </div>
      <p>
        If you were looking for a document or resource &dash; it does not exist at this address. It
        may have been moved, renamed, or permanently removed.
      </p>
      <a class="back" href="/">
        <svg width="44" height="20" viewBox="0 0 44 20" aria-hidden="true">
          <path d="M42 11 C 30 9, 18 12, 4 10 M 12 3 L 3 10 L 12 17"></path>
        </svg>
        back to the garden
      </a>
    </div>
  </div>

  <Kintsugi />
</BaseLayout>

<script>
  import { earn } from "../utils/garden";

  earn("迷");
</script>

<style>
  .lost {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem 4.5rem;
    margin-top: 5rem;
  }

  .map {
    position: relative;
    flex: 1 1 20rem;
    max-width: 26.25rem;
    padding-top: 1.5rem;
  }

  .map svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .trail {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
  }

  .cross {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .you {
    fill: var(--cursor);
  }

  .map text {
    font-family: var(--font-hand);
    font-size: 16px;
    fill: var(--fg-dim);
  }

  .code {
    position: absolute;
    right: 0;
    bottom: -0.5rem;
    margin: 0;
    font-size: 7.5rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    color: var(--border);
  }

  .words {
    flex: 999 1 26.25rem;
    min-width: 0;
    max-width: 35rem;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .title :global(.seal) {
    flex: none;
  }

  h1 {
    margin: 0;
    font-size: 3.25rem;
    line-height: 1.1;
  }

  .words p {
    margin: 1.5rem 0 0;
    color: var(--fg-dim);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    margin-top: 1.5rem;
    font-family: var(--font-hand);
    font-size: 1.3125rem;
    text-decoration: none;
  }

  .back path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 48em) and (orientation: portrait) {
    .lost {
      justify-content: center;
    }
  }

  @media (max-width: 47.99em) {
    .lost {
      margin-top: 2.5rem;
    }

    .map {
      max-width: none;
    }

    .code {
      font-size: 4.5rem;
    }

    h1 {
      font-size: 2.25rem;
    }
  }
</style>
