    <h1>404 · Page Not Found</h1>
    <p>
      The document or resource you requested does not exist at this address.
    </p>
    <p>
      It may have been moved, renamed, or permanently removed from this server.
    </p>
    <p>
      <a href="/">&larr; Return to Home Page</a>
    </p>
  </article>
</BaseLayout>
