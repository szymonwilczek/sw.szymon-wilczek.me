---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found" description="The requested resource could not be found.">
	<article>
		<h1>404 - Page Not Found</h1>
		<p>
			Are you lost? <br /> If you were looking for a document or resource - it does not exist at this address.
			<br />
			It may have been moved, renamed, or permanently removed.
		</p>
		<p>
			<a href="/">&larr; Return to Home Page</a>
		</p>
	</article>
</BaseLayout>
