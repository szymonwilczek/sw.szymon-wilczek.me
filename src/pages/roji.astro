---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { sceneGarden16, toSvg, tones2, TONE_CSS } from "../utils/tea/ink.js";
import { clean, turned } from "../utils/tea/pottery";
import pieces from "../data/pieces.json";

const shelf = (pieces as unknown[]).map(clean).filter((p) => p !== null);
const TOP = 90;
const H = 690 - TOP;
const left = (x: number) => (x / 1100) * 100;
const top = (y: number) => ((y - TOP) / H) * 100;
const STONE = { left: left(640), top: top(504) };
const pct = (x: number, y: number, w: number, h: number) =>
  `left:${left(x)}%;top:${top(y)}%;width:${left(w)}%;height:${(h / H) * 100}%`;
const DOOR = pct(474, 280, 390, 178);
const SHUT = `left:${left(670)}%;top:${top(330)}%`;
const MACHIAI = pct(22, 450, 292, 221);
const garden = sceneGarden16(tones2(), "start", {
  shelf: (i: number) => (shelf[i] ? turned(shelf[i]) : null),
});
---

<BaseLayout
  title="Roji"
  description="A tea garden in ink: a waiting room with a shelf of guests' pottery, and a workshop behind a stone."
>
  <header class="roji-head">
    <div>
      <h1>The garden path</h1>
      <p class="lede">
        A waiting room with a shelf of pieces other guests have made, and up the path a workshop
        where you can make your own. A stone tied with rope stops the path before its door.
      </p>
    </div>
    <p class="tally">{shelf.length ? `${shelf.length} on the shelf` : "the shelf is empty"}</p>
  </header>

  <Divider from={480} to={700} />

  <p class="hint hand">
    <span class="hint-point">draw a line across the bamboo to cut it.</span>
    <span class="hint-touch">swipe across the bamboo to cut it.</span>
  </p>

  <figure class="roji" style={TONE_CSS} data-shelf={JSON.stringify(shelf)}>
    <svg
      viewBox={`0 ${TOP} ${garden.W} ${garden.H - TOP}`}
      role="img"
      aria-label="An ink drawing of a tea garden: stepping stones, a clump of bamboo, a small waiting room with shelves, a thatched workshop with a stone on the path before it, and a kiln climbing the slope behind."
      set:html={toSvg(garden, true)}
    />
    <button
      type="button"
      class="stone"
      style={`left:${STONE.left}%;top:${STONE.top}%`}
      aria-label="The stone on the path"
      aria-expanded="false"
      aria-controls="roji-key"
    ></button>
    <form id="roji-key" class="key hand" style={`left:${STONE.left}%;top:${STONE.top}%`} hidden>
      <label for="roji-key-in">a stone tied with rope. the key from the books moves it.</label>
      <span class="key-row">
        <input id="roji-key-in" name="key" autocomplete="off" spellcheck="false" />
        <button type="submit">roll it</button>
      </span>
      <output aria-live="polite"></output>
    </form>
    <button
      type="button"
      class="door"
      style={DOOR}
      aria-label="The workshop door"
      aria-expanded="false"
      aria-controls="roji-shut"
    ></button>
    <p id="roji-shut" class="shut hand" style={SHUT} hidden>
      the door is shut, and a stone sits on the path. somebody left its key in a book on the{" "}
      <a href="/books/">bookshelf</a>.
    </p>
    <button
      type="button"
      class="door machiai"
      style={MACHIAI}
      aria-label="Into the waiting room, to the shelf of pieces"
    ></button>
    <div class="kobo" hidden></div>
  </figure>
</BaseLayout>

<script>
  import {
    bambooClump,
    Br,
    BrW,
    G,
    groupSvg,
    tones2,
    rng,
    hash,
    sceneGarden16,
    toSvg,
  } from "../utils/tea/ink.js";
  import { turned, type PieceSpec } from "../utils/tea/pottery";
  import { fits } from "../utils/tea/key";

  type P = [number, number];
  type Cut = { line: [P, P]; phase: "fall" | "down" };

  const fig = document.querySelector<HTMLElement>(".roji")!;
  const svg = fig.querySelector<SVGSVGElement>("svg")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  const CLUMP = { x: 250, y: 404, half: 60, top: 150 };

  function draw(cut: Cut, still: boolean) {
    const groups: object[] = [];
    bambooClump(groups, rng(hash("bb")), CLUMP.x, CLUMP.y, tones2(), 1, cut);
    const old = svg.querySelector(".roji-bamboo")!;
    old.outerHTML = groupSvg({ cls: `roji-bamboo${still ? "" : " cutting"}`, groups });
  }

  // swipe cuts only if it runs across the clump
  function across([a, b]: [P, P]): boolean {
    if (Math.abs(b[0] - a[0]) < 40) return false;
    const lo = Math.min(a[0], b[0]),
      hi = Math.max(a[0], b[0]);
    if (lo > CLUMP.x - CLUMP.half || hi < CLUMP.x + CLUMP.half) return false;
    const y = a[1] + ((b[1] - a[1]) * (CLUMP.x - a[0])) / (b[0] - a[0]);
    return y > CLUMP.top && y < CLUMP.y - 20;
  }

  localStorage.removeItem("roji:bamboo");
  let done = false;
  let cut: Cut | undefined;

  const STONE_KEY = "roji:key";
  const stone = fig.querySelector<HTMLButtonElement>(".stone")!;
  const form = fig.querySelector<HTMLFormElement>(".key")!;
  const said = form.querySelector("output")!;

  async function open(slowly: boolean) {
    if (slowly && !still.matches) {
      svg.querySelector(".roji-stone")?.classList.add("rolling");
      svg.querySelector(".roji-roof")?.classList.add("lifting");
      await new Promise((r) => setTimeout(r, 1400));
    }
    const shelf: PieceSpec[] = JSON.parse(fig.dataset.shelf || "[]");
    const garden = sceneGarden16(tones2(), "open", {
      shelf: (i: number) => (shelf[i] ? turned(shelf[i]) : null),
      cut,
    });
    svg.innerHTML = toSvg(garden, true);
    fig.classList.add("open");
    fig.querySelector(".door:not(.machiai)")?.setAttribute("aria-label", "Into the workshop");
  }

  stone.addEventListener("click", () => {
    form.hidden = !form.hidden;
    stone.setAttribute("aria-expanded", String(!form.hidden));
    if (!form.hidden) form.key.focus();
  });
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const key = String(form.key.value);
    if (!(await fits(key))) {
      said.textContent = "the stone does not move.";
      form.classList.remove("nope");
      void form.offsetWidth;
      form.classList.add("nope");
      return;
    }
    localStorage.setItem(STONE_KEY, key);
    form.hidden = true;
    open(true);
  });
  const kept = localStorage.getItem(STONE_KEY);
  if (kept) fits(kept).then((yes) => yes && open(false));

  // into the open workshop
  const door = fig.querySelector<HTMLButtonElement>(".door:not(.machiai)")!;
  const machiai = fig.querySelector<HTMLButtonElement>(".machiai")!;
  const kobo = fig.querySelector<HTMLElement>(".kobo")!;
  async function inside(
    from: HTMLButtonElement,
    origin: string,
    go: (leave: () => void) => Promise<void>,
  ) {
    if (!still.matches) {
      svg.style.transformOrigin = origin;
      fig.classList.add("zooming");
      await new Promise((r) => setTimeout(r, 650));
    }
    fig.classList.remove("zooming");
    fig.classList.add("inside");
    kobo.hidden = false;
    await go(() => {
      kobo.hidden = true;
      kobo.innerHTML = "";
      fig.classList.remove("inside");
      from.focus();
    });
    kobo.querySelector<HTMLElement>(".kobo-title")?.scrollIntoView({ block: "nearest" });
  }
  const shut = fig.querySelector<HTMLElement>(".shut")!;
  door.addEventListener("click", () => {
    if (!fig.classList.contains("open")) {
      shut.hidden = !shut.hidden;
      door.setAttribute("aria-expanded", String(!shut.hidden));
      return;
    }
    door.removeAttribute("aria-expanded");
    const code = import("../scripts/kobo/index");
    inside(door, "61% 46%", async (leave) => (await code).enter(kobo, leave));
  });
  machiai.addEventListener("click", () => {
    const code = import("../scripts/machiai");
    const shelf: PieceSpec[] = JSON.parse(fig.dataset.shelf || "[]");
    inside(machiai, "15% 78%", async (leave) => (await code).enter(kobo, shelf, leave));
  });

  const at = (e: PointerEvent): P => {
    const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
    return [Math.round(p.x), Math.round(p.y)];
  };

  let start: P | null = null;
  let trail: P[] = [];
  let slash: SVGGElement | null = null;
  let queued = false;
  const ink = tones2();
  function paint() {
    queued = false;
    if (!slash || trail.length < 2) return;
    const g = G(),
      r = rng(hash("slash"));
    BrW(g, r, trail, 10, ink.gold, 0.55);
    Br(g, r, trail, 2.4, ink.ink, 0.5, { tip: 0.05, head: 0.1 });
    slash.innerHTML = groupSvg(g);
  }
  function lift(cut: boolean) {
    const el = slash;
    slash = null;
    trail = [];
    if (!el) return;
    if (still.matches) return el.remove();
    el.classList.add(cut ? "lifting" : "missing");
    el.addEventListener("animationend", () => el.remove(), { once: true });
  }
  svg.addEventListener("pointerdown", (e) => {
    if (done) return;
    start = at(e);
    trail = [start];
    slash?.remove();
    slash = document.createElementNS("http://www.w3.org/2000/svg", "g");
    slash.classList.add("roji-slash");
    svg.append(slash);
  });
  svg.addEventListener("pointermove", (e) => {
    if (!start || done) return;
    const p = at(e),
      last = trail[trail.length - 1];
    if (Math.hypot(p[0] - last[0], p[1] - last[1]) < 8) return;
    trail.push(p);
    if (trail.length > 24) trail = trail.filter((_, i) => i % 2 === 0 || i === trail.length - 1);
    if (!queued) {
      queued = true;
      requestAnimationFrame(paint);
    }
  });
  fig.addEventListener("pointerup", (e) => {
    if (!start || done) return;
    const line: [P, P] = [start, at(e)];
    start = null;
    const cut = across(line);
    lift(cut);
    if (!cut) return;
    done = true;
    draw({ line, phase: "down" }, false);
    cut = { line, phase: "down" };
  });
  fig.addEventListener("pointercancel", () => {
    start = null;
    lift(false);
  });
</script>

<style>
  .roji-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }

  .roji-head > div {
    flex: 999 1 30rem;
    max-width: 40rem;
  }

  .roji-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .tally {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .hint {
    margin: 1rem 0 0 0.375rem;
    font-size: 1.0625rem;
    transform: rotate(-0.6deg);
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-point {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  .roji {
    margin: 1.5rem 0 0;
  }

  .roji svg {
    display: block;
    width: 100%;
    height: auto;
    touch-action: pan-y pinch-zoom;
    user-select: none;
  }

  .roji {
    position: relative;
  }

  .stone {
    position: absolute;
    width: 5%;
    aspect-ratio: 1.4;
    translate: -50% -75%;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .stone:focus-visible {
    outline: 1px dashed var(--fg-dim);
    outline-offset: 4px;
  }

  .open .stone,
  .open .key {
    display: none;
  }

  .key {
    position: absolute;
    translate: -50% 1.5rem;
    width: min(20rem, 80vw);
    padding: 0.75rem 1rem;
    background: var(--bg-main);
    border: 1px solid color-mix(in oklab, var(--fg-main), transparent 80%);
    border-radius: 3px;
    font-size: 1.0625rem;
    rotate: -0.4deg;
  }

  .key-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .key input {
    flex: 1;
    min-width: 0;
    font: inherit;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--fg-dim);
    color: var(--fg-main);
  }

  .key button {
    font: inherit;
    background: none;
    border: 0;
    color: var(--fg-link);
    cursor: pointer;
  }

  .key output {
    display: block;
    min-height: 1.4em;
    color: var(--fg-dim);
  }

  .key.nope {
    animation: roji-nope 0.4s;
  }

  @keyframes roji-nope {
    25% {
      translate: calc(-50% - 4px) 1.5rem;
    }
    75% {
      translate: calc(-50% + 4px) 1.5rem;
    }
  }

  .roji :global(.roji-stone) {
    transform-origin: 640px 504px;
    transition:
      transform 1.2s cubic-bezier(0.3, 0, 0.3, 1),
      opacity 1.2s;
  }

  .roji :global(.roji-stone.rolling) {
    transform: translate(26px, 3px) rotate(80deg);
    opacity: 0.6;
  }

  .roji :global(.roji-roof) {
    transition:
      transform 1.3s cubic-bezier(0.5, 0, 0.6, 1),
      opacity 1.3s;
  }

  .roji :global(.roji-roof.lifting) {
    transform: translateY(-140px);
    opacity: 0;
  }

  .door {
    position: absolute;
    display: block;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .open .door,
  .door.machiai {
    cursor: zoom-in;
  }

  .shut {
    position: absolute;
    translate: -50% 0;
    width: min(17rem, 75vw);
    margin: 0;
    padding: 0.6rem 0.9rem;
    background: var(--bg-main);
    border: 1px solid color-mix(in oklab, var(--fg-main), transparent 80%);
    border-radius: 3px;
    font-size: 1.0625rem;
    line-height: 1.35;
    rotate: 0.6deg;
    pointer-events: none;
  }

  .shut a {
    pointer-events: auto;
  }

  .open .shut,
  .inside .shut {
    display: none;
  }

  .door:focus-visible {
    outline: 1px dashed var(--fg-dim);
    outline-offset: 4px;
  }

  .roji > svg {
    transform-origin: 61% 46%;
    transition:
      transform 0.65s cubic-bezier(0.5, 0, 0.7, 1),
      opacity 0.65s;
  }

  .zooming > svg {
    transform: scale(2.6);
    opacity: 0;
  }

  .zooming {
    overflow: hidden;
  }

  .inside > svg,
  .inside .door,
  .inside .stone,
  .inside .key {
    display: none;
  }

  .kobo {
    animation: kobo-in 0.5s ease-out;
  }

  @keyframes kobo-in {
    from {
      opacity: 0;
    }
  }

  .kobo :global(.kobo-title) {
    margin: 0 0 0.5rem;
  }

  .kobo :global(.kobo-kan) {
    font-family: var(--font-seal);
    font-size: 1.375rem;
  }

  .kobo :global(.kobo-title .hand) {
    font-size: 1.25rem;
    color: var(--fg-dim);
  }

  .kobo :global(.kobo-art) {
    position: relative;
  }

  .kobo :global(.kobo-art svg) {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
    user-select: none;
  }

  .kobo :global(.kobo-room .kobo-art svg) {
    touch-action: pan-y pinch-zoom;
  }

  .kobo :global(.kobo-over) {
    position: absolute;
    min-width: 44px;
    min-height: 44px;
    transform: translate(-50%, -50%);
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .kobo :global(.kobo-over:focus-visible) {
    outline: 1px dashed var(--fg-dim);
  }

  .kobo :global(.kobo-say) {
    min-height: 1.5em;
    margin: 0.75rem 0 0;
    font-size: 1.125rem;
  }

  .kobo :global(.kobo-do) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.5rem 0 0;
  }

  .kobo :global(.kobo-btn) {
    padding: 0;
    font-size: 1.0625rem;
    background: none;
    border: 0;
    color: var(--fg-link);
    cursor: pointer;
  }

  .kobo :global(.kobo-btn.quiet) {
    color: var(--fg-dim);
  }

  .kobo :global(.kobo-btn:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .kobo :global(.kobo-btn:disabled) {
    color: var(--fg-dim);
    opacity: 0.5;
    text-decoration: none;
    cursor: default;
  }

  .kobo :global(.kobo-name) {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    color: var(--fg-dim);
    font-size: 1.0625rem;
  }

  .kobo :global(.kobo-name input) {
    width: 10em;
    padding: 0 0.25rem;
    font: inherit;
    color: var(--fg-main);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--fg-dim);
  }

  .kobo :global(.kobo-name input:focus-visible) {
    outline: none;
    border-bottom-color: var(--fg-link);
  }

  .kobo :global(.later) {
    opacity: 0.4;
  }

  .kobo :global(.now) {
    animation: kobo-now 2.4s ease-in-out infinite alternate;
  }

  @keyframes kobo-now {
    to {
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roji > svg {
      transition: none;
    }

    .kobo,
    .kobo :global(.now) {
      animation: none;
    }
  }

  .roji :global(.roji-slash) {
    pointer-events: none;
  }

  .roji :global(.roji-slash.lifting) {
    animation: roji-lift 0.9s 0.25s ease-out both;
  }

  .roji :global(.roji-slash.missing) {
    animation: roji-lift 0.4s ease-out both;
  }

  @keyframes roji-lift {
    to {
      opacity: 0;
    }
  }

  .roji :global(.cutting .fall) {
    animation: roji-fall 1.1s cubic-bezier(0.55, 0, 0.85, 0.5) both;
  }

  @keyframes roji-fall {
    from {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roji :global(.cutting .fall) {
      animation: none;
    }
  }
</style>
