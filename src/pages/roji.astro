---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { sceneGarden16, toSvg, toneVars, TONE_CSS } from "../utils/tea/ink.js";
import { clean, turned } from "../utils/tea/pottery";
import pieces from "../data/pieces.json";

const shelf = (pieces as unknown[]).map(clean).filter((piece) => piece !== null);
const CROP_TOP = 90;
const CROP_HEIGHT = 690 - CROP_TOP;
const left = (drawnX: number) => (drawnX / 1100) * 100;
const top = (drawnY: number) => ((drawnY - CROP_TOP) / CROP_HEIGHT) * 100;
const STONE = { left: left(640), top: top(504) };
const placeBox = (boxX: number, boxY: number, boxWidth: number, boxHeight: number) =>
  `left:${left(boxX)}%;top:${top(boxY)}%;width:${left(boxWidth)}%;height:${(boxHeight / CROP_HEIGHT) * 100}%`;
const DOOR = placeBox(474, 280, 390, 178);
const SHUT = `left:${left(670)}%;top:${top(330)}%`;
const MACHIAI = placeBox(22, 450, 292, 221);
const garden = sceneGarden16(toneVars(), "start", {
  shelf: (i: number) => (shelf[i] ? turned(shelf[i]) : null),
});
---

<BaseLayout
  title="Roji"
  description="A waiting room with a shelf of guests' pottery, and a workshop."
>
  <header class="roji-head">
    <div>
      <h1>The garden path</h1>
      <p class="lede">
        A waiting room with a shelf of pieces other guests have made, and up the path a workshop
        where you can make your own.
      </p>
    </div>
    <p class="tally">{shelf.length ? `${shelf.length} on the shelf` : "the shelf is empty"}</p>
  </header>

  <Divider from={480} to={700} />

  <p class="hint hand">
    <span class="hint-point">draw a line across the bamboo to cut it.</span>
    <span class="hint-touch">swipe across the bamboo to cut it.</span>
  </p>

  <figure class="roji" style={TONE_CSS} data-shelf={JSON.stringify(shelf)}>
    <svg
      viewBox={`0 ${CROP_TOP} ${garden.W} ${garden.H - CROP_TOP}`}
      role="img"
      aria-label="An ink drawing of a tea garden: stepping stones, a clump of bamboo, a small waiting room with shelves, a thatched workshop with a stone on the path before it, and a kiln climbing the slope behind."
      set:html={toSvg(garden, true)}
    />
    <button
      type="button"
      class="stone"
      style={`left:${STONE.left}%;top:${STONE.top}%`}
      aria-label="The stone on the path"
      aria-expanded="false"
      aria-controls="roji-key"
    ></button>
    <form id="roji-key" class="key hand" style={`left:${STONE.left}%;top:${STONE.top}%`} hidden>
      <label for="roji-key-in">a stone tied with rope. the key from the books moves it.</label>
      <span class="key-row">
        <input id="roji-key-in" name="key" autocomplete="off" spellcheck="false" />
        <button type="submit">roll it</button>
      </span>
      <output aria-live="polite"></output>
    </form>
    <button
      type="button"
      class="door"
      style={DOOR}
      aria-label="The workshop door"
      aria-expanded="false"
      aria-controls="roji-shut"
    ></button>
    <p id="roji-shut" class="shut hand" style={SHUT} hidden>
      the door is shut, and a stone sits on the path. somebody left its key in a book on the{" "}
      <a href="/books/">bookshelf</a>.
    </p>
    <button
      type="button"
      class="door machiai"
      style={MACHIAI}
      aria-label="Into the waiting room, to the shelf of pieces"
    ></button>
    <div class="kobo" hidden></div>
  </figure>
</BaseLayout>

<script>
  import "../scripts/roji";
</script>

<style>
  .roji-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }

  .roji-head > div {
    flex: 999 1 30rem;
    max-width: 40rem;
  }

  .roji-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .tally {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .hint {
    margin: 1rem 0 0 0.375rem;
    font-size: 1.0625rem;
    transform: rotate(-0.6deg);
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-point {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  .roji {
    margin: 1.5rem 0 0;
  }

  .roji svg {
    display: block;
    width: 100%;
    height: auto;
    touch-action: pan-y pinch-zoom;
    user-select: none;
  }

  .roji {
    position: relative;
  }

  .stone {
    position: absolute;
    width: 5%;
    aspect-ratio: 1.4;
    translate: -50% -75%;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .stone:focus-visible {
    outline: 1px dashed var(--fg-dim);
    outline-offset: 4px;
  }

  .open .stone,
  .open .key {
    display: none;
  }

  .key {
    position: absolute;
    translate: -50% 1.5rem;
    width: min(20rem, 80vw);
    padding: 0.75rem 1rem;
    background: var(--bg-main);
    border: 1px solid color-mix(in oklab, var(--fg-main), transparent 80%);
    border-radius: 3px;
    font-size: 1.0625rem;
    rotate: -0.4deg;
  }

  .key-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .key input {
    flex: 1;
    min-width: 0;
    font: inherit;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--fg-dim);
    color: var(--fg-main);
  }

  .key button {
    font: inherit;
    background: none;
    border: 0;
    color: var(--fg-link);
    cursor: pointer;
  }

  .key output {
    display: block;
    min-height: 1.4em;
    color: var(--fg-dim);
  }

  .key.nope {
    animation: roji-nope 0.4s;
  }

  @keyframes roji-nope {
    25% {
      translate: calc(-50% - 4px) 1.5rem;
    }
    75% {
      translate: calc(-50% + 4px) 1.5rem;
    }
  }

  .roji :global(.roji-stone) {
    transform-origin: 640px 504px;
    transition:
      transform 1.2s cubic-bezier(0.3, 0, 0.3, 1),
      opacity 1.2s;
  }

  .roji :global(.roji-stone.rolling) {
    transform: translate(26px, 3px) rotate(80deg);
    opacity: 0.6;
  }

  .roji :global(.roji-roof) {
    transition:
      transform 1.3s cubic-bezier(0.5, 0, 0.6, 1),
      opacity 1.3s;
  }

  .roji :global(.roji-roof.lifting) {
    transform: translateY(-140px);
    opacity: 0;
  }

  .door {
    position: absolute;
    display: block;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .open .door,
  .door.machiai {
    cursor: zoom-in;
  }

  .shut {
    position: absolute;
    translate: -50% 0;
    width: min(17rem, 75vw);
    margin: 0;
    padding: 0.6rem 0.9rem;
    background: var(--bg-main);
    border: 1px solid color-mix(in oklab, var(--fg-main), transparent 80%);
    border-radius: 3px;
    font-size: 1.0625rem;
    line-height: 1.35;
    rotate: 0.6deg;
    pointer-events: none;
  }

  .shut a {
    pointer-events: auto;
  }

  .open .shut,
  .inside .shut {
    display: none;
  }

  .door:focus-visible {
    outline: 1px dashed var(--fg-dim);
    outline-offset: 4px;
  }

  .roji > svg {
    transform-origin: 61% 46%;
    transition:
      transform 0.65s cubic-bezier(0.5, 0, 0.7, 1),
      opacity 0.65s;
  }

  .zooming > svg {
    transform: scale(2.6);
    opacity: 0;
  }

  .zooming {
    overflow: hidden;
  }

  .inside > svg,
  .inside .door,
  .inside .stone,
  .inside .key {
    display: none;
  }

  .kobo {
    animation: kobo-in 0.5s ease-out;
  }

  @keyframes kobo-in {
    from {
      opacity: 0;
    }
  }

  .kobo :global(.kobo-title) {
    margin: 0 0 0.5rem;
  }

  .kobo :global(.kobo-kan) {
    font-family: var(--font-seal);
    font-size: 1.375rem;
  }

  .kobo :global(.kobo-title .hand) {
    font-size: 1.25rem;
    color: var(--fg-dim);
  }

  .kobo :global(.kobo-art) {
    position: relative;
  }

  .kobo :global(.kobo-art svg) {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
    user-select: none;
  }

  .kobo :global(.kobo-room .kobo-art svg) {
    touch-action: pan-y pinch-zoom;
  }

  .kobo :global(.kobo-over) {
    position: absolute;
    min-width: 44px;
    min-height: 44px;
    transform: translate(-50%, -50%);
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .kobo :global(.kobo-over:focus-visible) {
    outline: 1px dashed var(--fg-dim);
  }

  .kobo :global(.kobo-say) {
    min-height: 1.5em;
    margin: 0.75rem 0 0;
    font-size: 1.125rem;
  }

  .kobo :global(.kobo-do) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.5rem 0 0;
  }

  .kobo :global(.kobo-btn) {
    padding: 0;
    font-size: 1.0625rem;
    background: none;
    border: 0;
    color: var(--fg-link);
    cursor: pointer;
  }

  .kobo :global(.kobo-btn.quiet) {
    color: var(--fg-dim);
  }

  .kobo :global(.kobo-btn:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .kobo :global(.kobo-btn:disabled) {
    color: var(--fg-dim);
    opacity: 0.5;
    text-decoration: none;
    cursor: default;
  }

  .kobo :global(.kobo-pick) {
    display: flex;
    flex-basis: 100%;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    align-items: baseline;
    color: var(--fg-dim);
    font-size: 1.0625rem;
  }

  .kobo :global(.kobo-pick .kobo-btn[aria-pressed="false"]) {
    color: var(--fg-dim);
  }

  .kobo :global(.kobo-pick .kobo-btn[aria-pressed="true"]) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .kobo :global(.kobo-name) {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    color: var(--fg-dim);
    font-size: 1.0625rem;
  }

  .kobo :global(.kobo-name input) {
    width: 10em;
    padding: 0 0.25rem;
    font: inherit;
    color: var(--fg-main);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--fg-dim);
  }

  .kobo :global(.kobo-name input:focus-visible) {
    outline: none;
    border-bottom-color: var(--fg-link);
  }

  .kobo :global(.later) {
    opacity: 0.4;
  }

  .kobo :global(.now) {
    animation: kobo-now 2.4s ease-in-out infinite alternate;
  }

  @keyframes kobo-now {
    to {
      opacity: 0.6;
    }
  }

  .kobo {
    --tip-away-time: 0.22s;
    --come-up-time: 0.42s;
    --come-up-past: 1.04;
    --stamp-time: 0.7s;
    --stamp-lift: 1.6;
    --stamp-squash: 0.94;
  }

  .kobo :global(.kobo-turn-over) {
    animation: kobo-come-up var(--come-up-time) both;
  }

  @keyframes kobo-come-up {
    from {
      scale: 1 0;
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1);
    }
    70% {
      scale: 1 var(--come-up-past);
      animation-timing-function: ease-in-out;
    }
    to {
      scale: 1;
    }
  }

  .kobo :global(.kobo-stamp) {
    animation: kobo-stamp var(--stamp-time) cubic-bezier(0.5, 0, 0.7, 0.4) both;
  }

  @keyframes kobo-stamp {
    from {
      scale: var(--stamp-lift);
      opacity: 0;
    }
    65% {
      scale: var(--stamp-squash);
      opacity: 1;
      animation-timing-function: ease-out;
    }
    to {
      scale: 1;
    }
  }

  .kobo :global(.kobo-tipping) {
    animation: kobo-tip-away var(--tip-away-time) cubic-bezier(0.5, 0, 0.8, 0.4) both;
  }

  @keyframes kobo-tip-away {
    to {
      scale: 1 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roji > svg {
      transition: none;
    }

    .kobo,
    .kobo :global(.now),
    .kobo :global(.kobo-turn-over),
    .kobo :global(.kobo-tipping),
    .kobo :global(.kobo-stamp) {
      animation: none;
    }
  }

  .roji :global(.roji-slash) {
    pointer-events: none;
  }

  .roji :global(.roji-slash.lifting) {
    animation: roji-lift 0.9s 0.25s ease-out both;
  }

  .roji :global(.roji-slash.missing) {
    animation: roji-lift 0.4s ease-out both;
  }

  @keyframes roji-lift {
    to {
      opacity: 0;
    }
  }

  .roji :global(.cutting .fall) {
    animation: roji-fall 1.7s var(--d, 0s) both;
  }

  @keyframes roji-fall {
    0% {
      transform: translate(0, 0) rotate(0deg);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.6);
    }
    32% {
      transform: translate(calc(var(--tx) * 0.04), calc(var(--ty) * 0.02))
        rotate(calc(var(--r) * 0.3));
      animation-timing-function: cubic-bezier(0.4, 0, 1, 0.7);
    }
    62% {
      transform: translate(var(--tx), var(--ty)) rotate(calc(var(--r) * 1.06));
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.4, 1);
    }
    74% {
      transform: translate(var(--tx), calc(var(--ty) - 9px)) rotate(calc(var(--r) * 0.94));
      animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.4);
    }
    84% {
      transform: translate(var(--tx), var(--ty)) rotate(calc(var(--r) * 1.01));
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.4, 1);
    }
    90% {
      transform: translate(var(--tx), calc(var(--ty) - 2px)) rotate(calc(var(--r) * 0.99));
      animation-timing-function: ease-in;
    }
    100% {
      transform: translate(var(--tx), var(--ty)) rotate(var(--r));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roji :global(.cutting .fall) {
      animation: none;
    }
  }
</style>
