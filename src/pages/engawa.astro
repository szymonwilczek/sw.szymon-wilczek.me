---
// Veranda of an old house, looking out at a small garden
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { sceneEngawa, toSvg, tones2, TONE_CSS } from "../utils/tea/ink.js";

const first = sceneEngawa(tones2(), 17.6, false, "aki", { unlit: true, burnt: 0 });
const pct = (x: number, y: number, w: number, h: number) =>
  `left:${(x / 1100) * 100}%;top:${(y / 640) * 100}%;width:${(w / 1100) * 100}%;height:${(h / 640) * 100}%`;
const THINGS = [
  { key: "record", box: pct(492, 498, 120, 92), label: "The record player" },
  { key: "incense", box: pct(398, 506, 54, 80), label: "The incense burner" },
  { key: "tree", box: pct(880, 160, 210, 250), label: "The tree in the garden" },
  { key: "sky", box: pct(788, 380, 64, 92), label: "The stone lantern" },
  { key: "tea", box: pct(338, 562, 50, 44), label: "The tea cup" },
  { key: "lamp", box: pct(688, 470, 50, 90), label: "The paper lamp" },
  { key: "cushion", box: pct(206, 558, 134, 70), label: "The cushion: sit, and the words go" },
  { key: "geta", box: pct(924, 584, 62, 30), label: "The geta, down into the garden" },
];
const DIAL = pct(990, 110, 80, 80);
const SEASON = pct(1010, 192, 40, 30);
---

<BaseLayout
  title="Engawa"
  description="A veranda in ink, lit for your own hour and season: incense to work by, a record player, and a quiet radio."
>
  <header class="engawa-head">
    <div>
      <h1>The veranda</h1>
      <p class="lede">
        The edge of an old house, open to a small garden. It keeps your hour and your season. Sit a
        while: light the incense to work by it, see what is on the record player, or let the whole
        thing play on the side.
      </p>
    </div>
  </header>

  <Divider from={480} to={700} />

  <p class="hint hand">touch the things on the boards. the enso turns the hour.</p>

  <figure class="engawa" style={TONE_CSS}>
    <svg
      viewBox={`0 0 ${first.W} ${first.H}`}
      role="img"
      aria-label="An ink drawing of a veranda: wooden boards under a deep eave, a reed blind, a record player, a teacup and an incense burner on the boards, and beyond them a garden with a stone lantern, stepping stones and a tree."
      set:html={toSvg(first, true)}
    />
    {THINGS.map((t) => (
      <button type="button" class="thing" data-card={t.key} style={t.box} aria-label={t.label} />
    ))}
    <button
      type="button"
      class="dial"
      style={DIAL}
      aria-label="The enso: drag round for another hour, tap for now"
    ></button>
    <button
      type="button"
      class="season"
      style={SEASON}
      aria-label="The season: tap for the next"
    ></button>
    <div class="knobs">
      <button
        type="button"
        class="sound"
        aria-pressed="false"
        aria-label="Sound: the radio and the garden"
      >
        音
      </button>
      <button
        type="button"
        class="broadcast"
        aria-pressed="false"
        aria-label="The radio: the veranda alone on the screen, playing"
      >
        放
      </button>
    </div>
  </figure>
</BaseLayout>

<script>
  import { sceneOf } from "../scripts/engawa/scene";
  import { dialOf } from "../scripts/engawa/dial";
  import { cardsOf } from "../scripts/engawa/cards";
  import { sky, tea, tree } from "../scripts/engawa/almanac";
  import { incenseOf } from "../scripts/engawa/incense";
  import { recordOf } from "../scripts/engawa/record";
  import { radioOf } from "../scripts/engawa/radio";
  import { gardenOf } from "../scripts/engawa/garden";
  import { broadcastOf } from "../scripts/engawa/broadcast";
  import { hourLight, tones2 } from "../utils/tea/ink.js";

  const fig = document.querySelector<HTMLElement>(".engawa")!;
  const scene = sceneOf(fig.querySelector("svg")!);
  dialOf(fig, scene);

  const cards = cardsOf(fig, scene);
  cards.fill("tree", tree);
  cards.fill("sky", sky);
  cards.fill("tea", tea);
  const incense = incenseOf(scene);
  cards.fill("incense", incense.fill);
  const radio = radioOf(() => scene.view.hour);
  cards.fill("record", recordOf(radio));
  gardenOf(radio, scene.view, () => incense.burning);
  broadcastOf(fig, radio, incense);

  const sound = fig.querySelector<HTMLButtonElement>(".sound")!;
  sound.addEventListener("click", radio.toggle);
  radio.onChange((on) => sound.setAttribute("aria-pressed", String(on)));
  if (radio.wanted())
    addEventListener(
      "pointerdown",
      (e) => !radio.on && !sound.contains(e.target as Node) && radio.start(),
      {
        once: true,
      },
    );
  fig.querySelectorAll<HTMLButtonElement>(".thing").forEach((b) =>
    b.addEventListener("click", () => {
      const key = b.dataset.card!;
      if (key === "geta") location.href = "/map/";
      else if (key === "lamp") {
        // lit by hand, or put out
        const lit =
          scene.view.lamp ??
          (hourLight(tones2(), scene.view.hour, scene.view.season).lamp > 0.5 ? 1 : 0);
        scene.view.lamp = lit ? 0 : 1;
        scene.draw();
      } else if (key === "cushion") {
        // sitting down
        b.setAttribute("aria-pressed", String(document.body.classList.toggle("engawa-sitting")));
      } else cards.show(key, b);
    }),
  );
</script>

<style>
  .engawa-head {
    margin-top: 1.5rem;
  }

  .engawa-head > div {
    max-width: 40rem;
  }

  .engawa-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .hint {
    margin: 1rem 0 0 0.375rem;
    font-size: 1.0625rem;
    transform: rotate(-0.6deg);
  }

  .engawa {
    position: relative;
    margin: 1.5rem 0 0;
  }

  .engawa svg {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
  }

  .thing,
  .dial,
  .season {
    position: absolute;
    padding: 0;
    border: 0;
    border-radius: 40%;
    background: none;
    cursor: pointer;
  }

  .dial {
    border-radius: 50%;
    touch-action: none;
    cursor: grab;
  }

  .thing:hover,
  .dial:hover,
  .season:hover {
    background: color-mix(in oklab, var(--cursor), transparent 85%);
  }

  .thing:focus-visible,
  .dial:focus-visible,
  .season:focus-visible {
    outline: 2px dashed var(--red);
    outline-offset: 2px;
  }

  .knobs {
    position: absolute;
    top: 2.5%;
    left: 1.5%;
    display: flex;
    gap: 0.4rem;
  }

  .knobs button {
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    border: 1.5px solid var(--fg-main);
    border-radius: 48% 52% 50% 46% / 55% 45% 55% 45%;
    background: color-mix(in oklab, var(--paper), transparent 15%);
    color: var(--fg-main);
    font-family: var(--font-seal);
    font-size: 1.1rem;
    cursor: pointer;
  }

  .knobs button[aria-pressed="true"] {
    border-color: var(--red);
    color: var(--red);
  }

  .knobs button:focus-visible {
    outline: 2px dashed var(--red);
    outline-offset: 2px;
  }

  @keyframes sway {
    0%,
    100% {
      transform: rotate(-0.8deg);
    }
    50% {
      transform: rotate(0.9deg);
    }
  }

  @keyframes drift {
    0%,
    100% {
      transform: skewX(0deg) translateX(0);
    }
    50% {
      transform: skewX(-4deg) translateX(5px);
    }
  }

  .engawa :global(.cards) {
    position: fixed;
    inset: 0;
    z-index: 20;
    pointer-events: none;
  }

  .engawa :global(.card) {
    position: absolute;
    top: 50%;
    right: max(1rem, calc(50vw - 36rem));
    height: min(94vh, 762px, calc((100vw - 2rem) * 762 / 540));
    aspect-ratio: 540 / 762;
    translate: 0 -50%;
    container-type: inline-size;
    pointer-events: auto;
    outline: none;
  }

  .engawa :global(.card.in) {
    animation: card-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: rotate(3deg) translateX(1.5rem);
    }
  }

  .engawa :global(.card > svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .engawa :global(.card-close) {
    position: absolute;
    top: 2%;
    right: 2.5%;
    width: 9%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .engawa :global(.card-body) {
    position: absolute;
    top: 47%;
    left: 7.8%;
    right: 7.8%;
    bottom: 5%;
    overflow: auto;
    font-family: var(--font-hand);
    font-size: 3.6cqw;
    line-height: 1.45;
    color: var(--fg-main);
  }

  :global(body.engawa-radio) .engawa {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: min(100vw, calc(100vh * 1100 / 640));
    height: fit-content;
    margin: auto;
    box-shadow: 0 0 0 100vmax var(--bg-main);
  }

  :global(body.engawa-radio) {
    overflow: hidden;
  }

  :global(body.engawa-radio) .knobs {
    display: none;
  }

  :global(body.engawa-radio.radio-still) {
    cursor: none;
  }

  @keyframes radio-close {
    to {
      clip-path: circle(0% at 50% 60%);
      filter: blur(2px);
    }
  }

  @keyframes radio-open {
    from {
      clip-path: circle(0% at 50% 60%);
      transform: scale(0.96);
    }
    to {
      clip-path: circle(75% at 50% 60%);
      transform: none;
    }
  }

  .engawa:global(.radio-closing) {
    animation: radio-close 0.55s ease-in forwards;
  }

  .engawa:global(.radio-opening) {
    animation: radio-open 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(.radio-strip) {
    display: none;
  }

  :global(body.engawa-radio .radio-strip) {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    z-index: 101;
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.3rem 0.5rem 0.3rem 1rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg-main), transparent 15%);
    color: var(--fg-main);
    font-family: var(--font-hand);
    transform: translateX(-50%);
    transition: opacity 0.8s;
  }

  :global(body.engawa-radio.radio-still .radio-strip) {
    opacity: 0;
  }

  :global(.radio-strip button) {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1.5px solid var(--fg-main);
    border-radius: 48% 52% 50% 46% / 55% 45% 55% 45%;
    background: none;
    color: inherit;
    font-family: var(--font-seal);
    cursor: pointer;
  }

  :global(.radio-strip button[aria-pressed="true"]) {
    border-color: var(--red);
    color: var(--red);
  }

  :global(.rs-incense:empty) {
    display: none;
  }

  :global(body.engawa-sitting) .engawa-head,
  :global(body.engawa-sitting) .hint,
  :global(body.engawa-sitting .divider) {
    opacity: 0;
    transition: opacity 0.8s;
  }

  .engawa :global(.card-body p) {
    margin: 0 0 0.6em;
  }

  .engawa :global(.card-small),
  .engawa :global(.card-dim) {
    opacity: 0.65;
  }

  .engawa :global(.card-small) {
    font-size: 0.85em;
  }

  .engawa :global(.card-kanji) {
    margin: 0 !important;
    font-family: var(--font-seal);
    font-size: 2.3em;
    line-height: 1.2;
  }

  .engawa :global(.card-big) {
    font-size: 1.45em;
    line-height: 1.2;
  }

  .engawa :global(.card-row) {
    display: flex;
    gap: 1em;
    align-items: flex-start;
  }

  .engawa :global(.card-ring) {
    flex: 0 0 38%;
    stroke: var(--fg-main);
    stroke-linecap: round;
  }

  .engawa :global(.card-ring path) {
    opacity: 0.5;
  }

  .engawa :global(.card-ring path.now) {
    stroke: var(--red);
    stroke-width: 3;
    opacity: 1;
  }

  .engawa :global(.card-ring text),
  .engawa :global(.card-sky text) {
    fill: var(--fg-main);
    stroke: none;
    font-family: var(--font-seal);
    font-size: 15px;
    text-anchor: middle;
    dominant-baseline: central;
    opacity: 0.55;
  }

  .engawa :global(.card-sky) {
    display: block;
    width: 100%;
    margin-bottom: 0.4em;
    overflow: visible;
  }

  .engawa :global(.card-sky text) {
    font-family: inherit;
    font-size: 16px;
    opacity: 0.7;
  }

  .engawa :global(.card-sky .horizon),
  .engawa :global(.card-sky .arc) {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 1.2;
    opacity: 0.6;
  }

  .engawa :global(.card-sky .arc) {
    stroke-width: 3;
    stroke-dasharray: 2 5;
    opacity: 0.35;
  }

  .engawa :global(.card-sky .sun) {
    fill: color-mix(in oklab, #f2c46a, var(--paper) 20%);
    stroke: var(--fg-main);
  }

  .engawa :global(.card-sky .moon-dark) {
    fill: color-mix(in oklab, var(--fg-main), var(--paper) 15%);
  }

  .engawa :global(.card-sky .moon) {
    fill: #f3eedf;
  }

  .engawa :global(.inc-stick) {
    position: relative;
    height: 0.5em;
    margin: 1em 0 0.4em;
    border-radius: 0.25em;
    background: color-mix(in oklab, var(--tape), var(--fg-main) 30%);
  }

  .engawa :global(.inc-ash) {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 0.25em 0 0 0.25em;
    background: color-mix(in oklab, var(--fg-main), var(--paper) 62%);
  }

  .engawa :global(.inc-ash + .inc-ember) {
    display: none;
  }

  .engawa :global(.inc-lens) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    align-items: center;
  }

  .engawa :global(.inc-own input) {
    width: 3.6em;
    padding: 0.2em 0.3em;
    border: 0;
    border-bottom: 1.5px solid var(--fg-main);
    background: none;
    color: inherit;
    font: inherit;
  }

  .engawa :global(.inc-rounds) {
    position: absolute;
    bottom: 0.6em;
    left: 0;
  }

  .engawa :global(.card-kanji-s) {
    font-family: var(--font-seal);
    color: var(--red);
  }

  .engawa :global(.rec-now) {
    display: flex;
    gap: 0.8em;
    align-items: flex-start;
  }

  .engawa :global(.rec-now img) {
    width: 24cqw;
    height: auto;
    border-radius: 2px;
    filter: sepia(0.25) saturate(0.8);
  }

  .engawa :global(.rec-now p) {
    margin: 0 0 0.2em;
  }

  .engawa :global(.rec-bar) {
    margin-top: 0.5em;
  }

  .engawa :global(.rec-radio) {
    margin-top: 0.8em;
  }

  .engawa :global(.card-knob) {
    margin-top: 0.4em;
    padding: 0.35em 1em;
    border: 1.5px solid var(--fg-main);
    border-radius: 48% 52% 50% 46% / 55% 45% 55% 45%;
    background: color-mix(in oklab, var(--paper), var(--fg-main) 6%);
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .engawa :global(.card-knob[aria-pressed="true"]) {
    border-color: var(--red);
    color: var(--red);
  }

  @media (prefers-reduced-motion: reduce) {
    .engawa :global(g[style*="animation"]) {
      animation: none !important;
    }
  }
</style>
