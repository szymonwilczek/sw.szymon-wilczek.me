---
// Veranda of an old house, looking out at a small garden
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { sceneEngawa, toSvg, tones2, TONE_CSS } from "../utils/tea/ink.js";

const first = sceneEngawa(tones2(), 17.6, false, "aki", { unlit: true, burnt: 0 });
const pct = (x: number, y: number, w: number, h: number) =>
  `left:${(x / 1100) * 100}%;top:${(y / 640) * 100}%;width:${(w / 1100) * 100}%;height:${(h / 640) * 100}%`;
const THINGS = [
  { key: "record", box: pct(492, 498, 120, 92), label: "The record player" },
  { key: "incense", box: pct(398, 506, 54, 80), label: "The incense burner" },
  { key: "tree", box: pct(880, 160, 210, 250), label: "The tree in the garden" },
  { key: "sky", box: pct(788, 380, 64, 92), label: "The stone lantern" },
  { key: "tea", box: pct(338, 562, 50, 44), label: "The tea cup" },
  { key: "lamp", box: pct(688, 470, 50, 90), label: "The paper lamp" },
  { key: "geta", box: pct(924, 584, 62, 30), label: "The geta, down into the garden" },
];
const DIAL = pct(990, 110, 80, 80);
const SEASON = pct(1010, 192, 40, 30);
---

<BaseLayout
  title="Engawa"
  description="A veranda in ink, lit for your own hour and season: incense to work by, a record player, and a quiet radio."
>
  <header class="engawa-head">
    <div>
      <h1>The veranda</h1>
      <p class="lede">
        The edge of an old house, open to a small garden. It keeps your hour and your season. Sit a
        while: light the incense to work by it, see what is on the record player, or let the whole
        thing play on the side.
      </p>
    </div>
  </header>

  <Divider from={480} to={700} />

  <p class="hint hand">touch the things on the boards. the enso turns the hour.</p>

  <figure class="engawa" style={TONE_CSS}>
    <svg
      viewBox={`0 0 ${first.W} ${first.H}`}
      role="img"
      aria-label="An ink drawing of a veranda: wooden boards under a deep eave, a reed blind, a record player, a teacup and an incense burner on the boards, and beyond them a garden with a stone lantern, stepping stones and a tree."
      set:html={toSvg(first, true)}
    />
    {THINGS.map((t) => (
      <button type="button" class="thing" data-card={t.key} style={t.box} aria-label={t.label} />
    ))}
    <button
      type="button"
      class="dial"
      style={DIAL}
      aria-label="The enso: drag round for another hour, tap for now"
    ></button>
    <button
      type="button"
      class="season"
      style={SEASON}
      aria-label="The season: tap for the next"
    ></button>
  </figure>
</BaseLayout>

<script>
  import { sceneOf } from "../scripts/engawa/scene";
  import { dialOf } from "../scripts/engawa/dial";
  import { cardsOf } from "../scripts/engawa/cards";

  const fig = document.querySelector<HTMLElement>(".engawa")!;
  const scene = sceneOf(fig.querySelector("svg")!);
  dialOf(fig, scene);

  const cards = cardsOf(fig, scene);
  fig.querySelectorAll<HTMLButtonElement>(".thing").forEach((b) =>
    b.addEventListener("click", () => {
      const key = b.dataset.card!;
      if (key === "geta") location.href = "/map/";
      else cards.show(key, b);
    }),
  );
</script>

<style>
  .engawa-head {
    margin-top: 1.5rem;
  }

  .engawa-head > div {
    max-width: 40rem;
  }

  .engawa-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .hint {
    margin: 1rem 0 0 0.375rem;
    font-size: 1.0625rem;
    transform: rotate(-0.6deg);
  }

  .engawa {
    position: relative;
    margin: 1.5rem 0 0;
  }

  .engawa svg {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
  }

  .thing,
  .dial,
  .season {
    position: absolute;
    padding: 0;
    border: 0;
    border-radius: 40%;
    background: none;
    cursor: pointer;
  }

  .dial {
    border-radius: 50%;
    touch-action: none;
    cursor: grab;
  }

  .thing:hover,
  .dial:hover,
  .season:hover {
    background: color-mix(in oklab, var(--cursor), transparent 85%);
  }

  .thing:focus-visible,
  .dial:focus-visible,
  .season:focus-visible {
    outline: 2px dashed var(--red);
    outline-offset: 2px;
  }

  @keyframes sway {
    0%,
    100% {
      transform: rotate(-0.8deg);
    }
    50% {
      transform: rotate(0.9deg);
    }
  }

  @keyframes drift {
    0%,
    100% {
      transform: skewX(0deg) translateX(0);
    }
    50% {
      transform: skewX(-4deg) translateX(5px);
    }
  }

  .engawa :global(.cards) {
    position: fixed;
    inset: 0;
    z-index: 20;
    pointer-events: none;
  }

  .engawa :global(.card) {
    position: absolute;
    top: 50%;
    right: max(1rem, calc(50vw - 36rem));
    height: min(94vh, 762px);
    aspect-ratio: 540 / 762;
    max-width: calc(100vw - 2rem);
    translate: 0 -50%;
    container-type: inline-size;
    pointer-events: auto;
    outline: none;
  }

  .engawa :global(.card.in) {
    animation: card-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: rotate(3deg) translateX(1.5rem);
    }
  }

  .engawa :global(.card > svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .engawa :global(.card-close) {
    position: absolute;
    top: 2%;
    right: 2.5%;
    width: 9%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .engawa :global(.card-body) {
    position: absolute;
    top: 47%;
    left: 7.8%;
    right: 7.8%;
    bottom: 5%;
    overflow: auto;
    font-size: 3.6cqw;
    line-height: 1.45;
    color: var(--fg-main);
  }

  @media (prefers-reduced-motion: reduce) {
    .engawa :global(g[style*="animation"]) {
      animation: none !important;
    }
  }
</style>
