---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stamp from "../../components/Stamp.astro";
import { getAllAlbums } from "../../utils/albums";

const albums = await getAllAlbums();

const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
const postmarkDate = (date: Date) =>
  `${ROMAN[date.getMonth()]}·${String(date.getFullYear()).slice(2)}`;
const postmarkPlace = (album: (typeof albums)[number]) =>
  (album.location ?? album.title).toUpperCase();

const TILTS = [-1.2, 0.8, 1.4, -0.6, 0.5];
const DROPS = ["0", "4rem", "0", "3rem", "0"];
---

<BaseLayout
  title="Photographs"
  description="Places walked through, kept the way they looked that day."
>
  <header class="photos-head">
    <div>
      <h1>Photographs</h1>
      <p class="lede">Places walked through, kept the way they looked that day.</p>
    </div>
    <p class="aside hand">
      postcards I never sent<br />
      <a href="/photos/stamps/">the stamps, kept in one album →</a>
    </p>
  </header>

  <ol class="postcards">
    {albums.map((album, i) => (
      <li style={`--tilt: ${TILTS[i % TILTS.length]}deg; --drop: ${DROPS[i % DROPS.length]}`}>
        <a
          href={`/photos/${album.slug}/`}
          class="postcard paper"
          aria-label={`${album.title}, ${album.photoCount} frames`}
          data-astro-prefetch="hover"
        >
          <img
            src={album.coverThumb || album.coverImage}
            alt=""
            loading={i < 2 ? "eager" : "lazy"}
            decoding="async"
          />
          <div class="back">
            <svg class="fold" viewBox="0 0 8 100" preserveAspectRatio="none" aria-hidden="true">
              <path d="M4.4 0 C 3 14, 5.6 30, 4 46 S 2.8 70, 4.6 84 S 4 96, 3.2 100" />
            </svg>
            <svg
              class="fold fold-across"
              viewBox="0 0 100 8"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M0 4.4 C 14 3, 30 5.6, 46 4 S 70 2.8, 84 4.6 S 96 4, 100 3.2" />
            </svg>
            <span class="stamp-spot">
              <Stamp
                slug={album.slug}
                terrain={album.terrain}
                country={album.country ?? "[COUNTRY]"}
                num={album.stampNum}
                size={104}
              />
              <svg class="postmark" viewBox="0 0 110 52" aria-hidden="true">
                <circle cx="78" cy="26" r="21" stroke-width="1.1" />
                <circle cx="78" cy="26" r="17" stroke-width="0.6" />
                <text
                  x="78"
                  y="23"
                  class="pm-place"
                  textLength={postmarkPlace(album).length > 9 ? 30 : undefined}
                  lengthAdjust="spacingAndGlyphs"
                >
                  {postmarkPlace(album)}
                </text>
                <text x="78" y="33" class="pm-date">
                  {postmarkDate(album.date)}
                </text>
                <path d="M2 16 q 6 -3.5 12 0 t 12 0 t 12 0 t 12 0 M2 26 q 6 -3.5 12 0 t 12 0 t 12 0 t 12 0 M2 36 q 6 -3.5 12 0 t 12 0 t 12 0 t 12 0" />
              </svg>
            </span>
            <span class="lines">
              <span class="num">No. {album.stampNum}</span>
              <span class="title">{album.title}</span>
              <span class="line">{album.dateFormatted}</span>
              <span class="line">{album.photoCount} frames →</span>
            </span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .photos-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }

  .photos-head h1 {
    margin: 0;
  }

  .lede {
    max-width: 32.5rem;
    margin: 1rem 0 0;
    color: var(--fg-dim);
  }

  .aside {
    margin: 0;
    font-size: 1.25rem;
    transform: rotate(-2deg);
  }

  .aside a {
    font-size: 1.0625rem;
  }

  .postcards {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4.5rem 2.5rem;
    margin: 5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .postcards li {
    flex: 0 1 calc(50% - 1.25rem);
    min-width: 0;
    margin: var(--drop) 0 0;
    transform: rotate(var(--tilt));
  }

  .postcard {
    display: flex;
    padding: 12px;
    color: inherit;
    text-decoration: none;
    box-shadow:
      0 1px 0 var(--border),
      0 18px 30px -22px rgba(0, 0, 0, 0.55);
    transition: transform 0.2s ease;
  }

  .postcard:hover {
    color: inherit;
    transform: translateY(-3px);
  }

  .postcard img {
    flex: 0 0 54%;
    min-width: 0;
    height: 20rem;
    object-fit: cover;
    border-radius: 1px;
  }

  .back {
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 17.5rem;
    padding: 1rem 0.625rem 0.5rem 2.125rem;
  }

  .fold {
    position: absolute;
    left: 10px;
    top: 2%;
    width: 8px;
    height: 96%;
  }

  .fold-across {
    display: none;
  }

  .fold path {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .stamp-spot {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
  }

  .postmark {
    position: absolute;
    left: -4.5rem;
    top: 4rem;
    width: 110px;
    height: 52px;
    opacity: 0.62;
    transform: rotate(-9deg);
    pointer-events: none;
    fill: none;
    stroke: var(--fg-main);
  }

  .postmark text {
    stroke: none;
    fill: var(--fg-main);
    font-family: var(--font-mono);
    text-anchor: middle;
  }

  .pm-place {
    font-size: 6.5px;
    letter-spacing: 0.5px;
  }

  .pm-date {
    font-size: 7px;
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-hand);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .title,
  .line {
    border-bottom: 1px solid var(--border);
  }

  .title {
    padding-bottom: 6px;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .line {
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 2.1;
    color: var(--fg-dim);
  }

  @media (max-width: 47.99em) {
    .postcards {
      gap: 3rem 0;
      margin-top: 3rem;
    }

    .postcards li {
      flex-basis: 100%;
      margin-top: 0;
    }

    .postcards li:nth-child(odd) {
      transform: rotate(-0.6deg);
    }

    .postcards li:nth-child(even) {
      transform: rotate(0.6deg);
    }

    .postcard {
      flex-wrap: wrap;
    }

    .postcard img {
      flex-basis: 100%;
      height: 13.75rem;
    }

    .back {
      flex-basis: 100%;
      min-height: 12.5rem;
      padding: 1.75rem 0.5rem 0.5rem 0.25rem;
    }

    .fold {
      display: none;
    }

    .fold-across {
      display: block;
      left: 2%;
      top: 4px;
      width: 96%;
      height: 8px;
    }

    .stamp-spot {
      top: 1.375rem;
    }
  }
</style>
