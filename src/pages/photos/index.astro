---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import SearchFilter from "../../components/SearchFilter.astro";
import Pagination from "../../components/Pagination.astro";

const PAGE_SIZE = 12;
const allPhotos = (await getCollection("photos")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const totalPages = Math.ceil(allPhotos.length / PAGE_SIZE);
const photos = allPhotos.slice(0, PAGE_SIZE);
---

<BaseLayout
  title="Photos"
  description="Curated personal photography gallery capturing moments, architecture, and landscapes."
>
  <article>
    <h1>Photography</h1>

    <p>Personal visual archive. All photographs are presented without compression artifacts.</p>

    <SearchFilter
      placeholder="Filter by title, location, or camera..."
      targetSelector=".photo-item"
      containerSelector=".gallery-grid"
    />

    <div class="gallery-grid">
      {
        photos.map((photo) => (
          <figure
            class="photo-item"
            data-search={`${photo.data.title} ${photo.data.location || ""} ${photo.data.camera || ""} ${photo.data.description || ""}`}
          >
            <a href={`/photos/${photo.id.replace(/\.(org|md|mdx|json)$/, "")}`} class="image-link">
              <div class="image-wrapper">
                <img src={photo.data.image} alt={photo.data.alt} loading="lazy" />
              </div>
            </a>
            <figcaption class="photo-caption">
              <a
                href={`/photos/${photo.id.replace(/\.(org|md|mdx)$/, "")}`}
                class="photo-title-link"
              >
                <span class="photo-title">{photo.data.title}</span>
              </a>
              {photo.data.description && <p class="photo-note">{photo.data.description}</p>}
              <div class="photo-meta">
                <span>
                  <FormattedDate date={photo.data.date} />
                </span>
                {photo.data.location && <span>· {photo.data.location}</span>}
                {photo.data.camera && (
                  <span>
                    · <code>{photo.data.camera}</code>
                  </span>
                )}
              </div>
            </figcaption>
          </figure>
        ))
      }

      {photos.length === 0 && <p>No photographs cataloged in this collection yet.</p>}
    </div>

    <Pagination
      currentPage={1}
      lastPage={totalPages}
      nextUrl={totalPages > 1 ? "/photos/page/2" : undefined}
      baseUrl="/photos"
    />
  </article>
</BaseLayout>

<style>
  .gallery-grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .photo-item {
    margin: 0;
    border: 1px solid var(--border);
    background-color: var(--bg-dim);
    padding: 0.65rem;
    display: flex;
    flex-direction: column;
  }

  .image-link {
    display: block;
    text-decoration: none;
    overflow: hidden;
  }

  .image-wrapper {
    overflow: hidden;
    background-color: var(--bg-main);
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease;
  }

  .image-link:hover .image-wrapper img {
    transform: scale(1.06);
    opacity: 0.95;
  }

  .photo-caption {
    padding: 0.75rem 0.25rem 0.25rem 0.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .photo-title-link {
    text-decoration: none;
  }

  .photo-title-link:hover .photo-title {
    color: var(--fg-link-hover);
    text-decoration: underline;
  }

  .photo-title {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--fg-main);
    display: block;
    line-height: 1.3;
  }

  .photo-note {
    font-size: 0.92rem;
    margin: 0.4rem 0;
    color: var(--fg-main);
    line-height: 1.5;
  }

  .photo-meta {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.82rem;
    color: var(--fg-dim);
    margin-top: 0.5rem;
    border-top: 1px dashed var(--border);
    padding-top: 0.4rem;
  }
</style>
