---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import ExifBar from '../../components/ExifBar.astro';
import { getExifData } from '../../utils/exif';
import { renderContentEntry } from '../../utils/org';

export async function getStaticPaths() {
	const photos = await getCollection('photos');
	return photos.map((photo) => ({
		params: { slug: photo.id.replace(/\.(org|md|mdx|json)$/, '') },
		props: { photo },
	}));
}

const { photo } = Astro.props;
const { html, Content } = await renderContentEntry(photo);
const exif = await getExifData(photo.data.image);
---

<BaseLayout title={photo.data.title} description={photo.data.description || photo.data.title}>
	<article class="photo-article">
		<header class="photo-header">
			<div class="back-link">
				<a href="/photos">&larr; All photographs</a>
			</div>
			<h1>{photo.data.title}</h1>
			<div class="photo-meta">
				<span>Captured: <FormattedDate date={photo.data.date} /></span>
				{
					photo.data.location && (
						<span>
							Location: <code>{photo.data.location}</code>
						</span>
					)
				}
			</div>
		</header>

		<figure class="featured-image-container">
			<div class="image-frame zoomable">
				<img src={photo.data.image} alt={photo.data.alt} />
			</div>
			<ExifBar exif={exif} overrides={photo.data} />
			{photo.data.description && <figcaption class="image-caption">{photo.data.description}</figcaption>}
		</figure>

		<div class="photo-narrative">
			{Content ? <Content /> : <div class="org-content" set:html={html} />}
		</div>
	</article>
</BaseLayout>

<style>
	.photo-header {
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border);
	}

	.back-link {
		font-family: 'Typus Mono 95', 'Typus Mono', monospace;
		font-size: 0.9rem;
		margin-bottom: 1rem;
	}

	.photo-header h1 {
		margin-top: 0.25rem;
		margin-bottom: 0.5rem;
	}

	.photo-meta {
		font-family: 'Typus Mono 95', 'Typus Mono', monospace;
		font-size: 0.9rem;
		color: var(--fg-dim);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.featured-image-container {
		margin: 2rem 0;
	}

	.image-frame {
		border: 1px solid var(--border);
		background-color: var(--bg-dim);
		padding: 0.5rem;
		overflow: hidden;
	}

	.image-frame.zoomable img {
		width: 100%;
		max-height: 520px;
		object-fit: contain;
		display: block;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.image-frame.zoomable:hover img {
		transform: scale(1.03);
	}

	.image-caption {
		font-family: 'Typus Mono 95', 'Typus Mono', monospace;
		font-size: 0.88rem;
		color: var(--fg-dim);
		padding: 0.75rem 0.25rem 0.25rem 0.25rem;
	}

	.photo-narrative {
		margin-top: 2.5rem;
		line-height: 1.8;
	}

	.photo-narrative :global(img) {
		width: 100%;
		max-height: 520px;
		object-fit: contain;
		background-color: var(--bg-dim);
		border: 1px solid var(--border);
		padding: 0.5rem;
		margin: 1.75rem 0 0.5rem 0;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		display: block;
	}

	.photo-narrative :global(img:hover) {
		transform: scale(1.025);
	}

	.photo-narrative :global(figcaption),
	.photo-narrative :global(em) {
		font-family: 'Typus Mono 95', 'Typus Mono', monospace;
		font-size: 0.88rem;
		color: var(--fg-dim);
		font-style: normal;
	}
</style>
