---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllAlbums, type PhotoAlbum } from "../../utils/albums";

export async function getStaticPaths() {
  const albums = await getAllAlbums();
  return albums.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

interface Props {
  album: PhotoAlbum;
}

const { album } = Astro.props;
---

<BaseLayout
  title={`${album.title} - Photography Album`}
  description={`Photography journal from ${album.title} (${album.dateFormatted}). ${album.photoCount} high-fidelity captures.`}
  image={album.photos[0]?.src}
  imageAlt={album.photos[0]?.alt || `${album.title} Photography`}
  category="Photography"
>
  <article class="album-page">
    <header class="album-header">
      <div class="back-nav">
        <a href="/photos/" class="back-link">&larr; All Albums</a>
      </div>
      <h1>{album.title}</h1>
      <div class="album-stats-bar">
        <span class="stat-item">Date: <strong>{album.dateFormatted}</strong></span>
        <span class="stat-sep">&middot;</span>
        <span class="stat-item">
          Captures: <strong>{album.photoCount}</strong>
        </span>
        <span class="stat-sep">&middot;</span>
        <span class="stat-item">
          Master Data: <strong>{album.totalSizeFormatted}</strong>
        </span>
      </div>

      {album.description && <p class="album-lead-text">{album.description}</p>}
    </header>

    {
      album.narrativeHtml && (
        <section class="album-narrative-section">
          <div class="org-content" set:html={album.narrativeHtml} />
        </section>
      )
    }

    <hr />

    <div class="album-photos-stream">
      {
        album.photos.map((photo, index) => (
          <figure
            class={`photo-card ${photo.isPortrait ? "layout-portrait" : "layout-landscape"}`}
            id={photo.id}
          >
            <div class="photo-media">
              <a
                href={photo.src}
                target="_blank"
                rel="noopener"
                class="photo-lightbox-trigger"
                data-lightbox={photo.src}
                data-title={`${album.title} — ${photo.filename}`}
              >
                <img
                  src={photo.thumbSrc || photo.src}
                  alt={`${album.title} capture ${index + 1}`}
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </a>
            </div>

            <figcaption class="photo-details">
              <div class="photo-info-row">
                <span class="photo-num">
                  #{index + 1} &middot; <code>{photo.filename}</code>
                </span>
                <span class="photo-date">
                  {photo.date.toLocaleString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                  })}
                </span>
              </div>

              {photo.note && (
                <div class="photo-user-note">
                  <span class="note-label">Field Note:</span>
                  <p>{photo.note}</p>
                </div>
              )}

              <div class="exif-telemetry-grid">
                {photo.camera && (
                  <div class="exif-cell">
                    <span class="exif-label">Camera</span>
                    <span class="exif-val">{photo.camera}</span>
                  </div>
                )}
                {photo.lens && (
                  <div class="exif-cell">
                    <span class="exif-label">Lens</span>
                    <span class="exif-val">{photo.lens}</span>
                  </div>
                )}
                {photo.focalLength && (
                  <div class="exif-cell">
                    <span class="exif-label">Focal</span>
                    <span class="exif-val">{photo.focalLength}</span>
                  </div>
                )}
                {photo.aperture && (
                  <div class="exif-cell">
                    <span class="exif-label">Aperture</span>
                    <span class="exif-val">{photo.aperture}</span>
                  </div>
                )}
                {photo.shutterSpeed && (
                  <div class="exif-cell">
                    <span class="exif-label">Shutter</span>
                    <span class="exif-val">{photo.shutterSpeed}</span>
                  </div>
                )}
                {photo.iso && (
                  <div class="exif-cell">
                    <span class="exif-label">ISO</span>
                    <span class="exif-val">{photo.iso}</span>
                  </div>
                )}
                {photo.gps && (
                  <div class="exif-cell exif-cell-wide">
                    <span class="exif-label">Coordinates</span>
                    <span class="exif-val">
                      <a href={photo.gps.mapsUrl} target="_blank" rel="noopener" class="gps-link">
                        {photo.gps.latitude.toFixed(4)}&deg; N, {photo.gps.longitude.toFixed(4)}
                        &deg; E [OpenStreetMap]
                      </a>
                    </span>
                  </div>
                )}
              </div>

              <div class="file-integrity-block">
                <span class="sha-label">SHA-256 Integrity Sum:</span>
                <code class="sha-hash-full">{photo.sha256}</code>
              </div>

              <div class="download-action-row">
                <a href={photo.src} download={photo.filename} class="btn-action">
                  Download Original ({photo.sizeFormatted})
                </a>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div id="lightbox-modal" class="lightbox-modal" aria-hidden="true">
      <div class="lightbox-backdrop"></div>
      <div class="lightbox-container">
        <button class="lightbox-close-btn" aria-label="Close image preview">&times;</button>
        <div class="lightbox-image-wrapper">
          <img id="lightbox-img" src="" alt="Fullscreen capture preview" />
        </div>
        <p id="lightbox-caption" class="lightbox-caption"></p>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  function setupLightbox() {
    const modal = document.getElementById("lightbox-modal");
    const modalImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const modalCaption = document.getElementById("lightbox-caption");
    const closeBtn = document.querySelector(".lightbox-close-btn");
    const backdrop = document.querySelector(".lightbox-backdrop");

    if (!modal || !modalImg) return;

    const links = document.querySelectorAll("[data-lightbox]");
    const linkArray = Array.from(links);
    let currentIndex = -1;

    const showImage = (index: number) => {
      if (index < 0 || index >= linkArray.length) return;
      currentIndex = index;
      const link = linkArray[currentIndex];
      const src = link.getAttribute("data-lightbox") || "";
      const title = link.getAttribute("data-title") || "";

      modalImg.src = src;
      if (modalCaption) modalCaption.textContent = title;
      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    linkArray.forEach((link, idx) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        showImage(idx);
      });
    });

    const closeModal = () => {
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      modalImg.src = "";
      document.body.style.overflow = "";
      currentIndex = -1;
    };

    closeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    const container = document.querySelector(".lightbox-container");
    container?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (
        target !== modalImg &&
        target !== modalCaption &&
        target !== closeBtn &&
        !target.closest(".lightbox-close-btn")
      ) {
        closeModal();
      }
    });

    window.addEventListener("keydown", (e) => {
      if (!modal.classList.contains("active")) return;

      if (e.key === "Escape") {
        closeModal();
      } else if (
        (e.key === "j" || e.key === "ArrowRight" || e.key === "ArrowDown") &&
        !e.ctrlKey &&
        !e.altKey &&
        !e.metaKey
      ) {
        if (currentIndex < linkArray.length - 1) {
          e.preventDefault();
          showImage(currentIndex + 1);
        }
      } else if (
        (e.key === "k" || e.key === "ArrowLeft" || e.key === "ArrowUp") &&
        !e.ctrlKey &&
        !e.altKey &&
        !e.metaKey
      ) {
        if (currentIndex > 0) {
          e.preventDefault();
          showImage(currentIndex - 1);
        }
      }
    });
  }

  setupLightbox();
  document.addEventListener("astro:after-swap", setupLightbox);
</script>

<style>
  .album-header {
    margin-bottom: 2rem;
  }

  .back-nav {
    margin-bottom: 1rem;
  }

  .back-link {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.95rem;
    color: var(--fg-link);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--fg-link-hover);
    text-decoration: underline;
  }

  .album-header h1 {
    margin: 0.25rem 0 0.75rem 0;
  }

  .album-stats-bar {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.92rem;
    color: var(--fg-dim);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-sep {
    opacity: 0.4;
  }

  .album-lead-text {
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--fg-main);
  }

  .album-narrative-section {
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background-color: var(--bg-dim);
  }

  .album-photos-stream {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .photo-card {
    margin: 0;
    border: 1px solid var(--border);
    background-color: var(--bg-dim);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 75em) {
    .photo-card.layout-portrait {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 1.75rem;
      align-items: start;
    }

    .photo-card.layout-portrait .photo-media {
      width: 100%;
    }

    .photo-card.layout-portrait .photo-media img {
      max-height: 650px;
    }
  }

  .photo-card.layout-landscape {
    display: flex;
    flex-direction: column;
  }

  .photo-media {
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .photo-lightbox-trigger {
    display: block;
    width: 100%;
    cursor: zoom-in;
    text-decoration: none;
  }

  .photo-media img {
    width: 100%;
    height: auto;
    max-height: 750px;
    object-fit: contain;
    display: block;
    border: 1px solid var(--border);
    background-color: transparent;
    transition: transform 0.25s ease;
  }

  .photo-lightbox-trigger:hover img {
    transform: scale(1.01);
  }

  .photo-details {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    flex: 1;
  }

  .photo-info-row {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.9rem;
    color: var(--fg-dim);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-bottom: 1px dashed var(--border);
    padding-bottom: 0.5rem;
  }

  .photo-num {
    font-weight: 600;
    color: var(--fg-main);
  }

  .photo-user-note {
    background-color: var(--bg-main);
    border-left: 3px solid var(--fg-link);
    padding: 0.65rem 0.85rem;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .note-label {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.75rem;
    color: var(--fg-link);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.25rem;
    font-weight: 600;
  }

  .photo-user-note p {
    margin: 0;
    color: var(--fg-main);
  }

  .exif-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
    background-color: var(--bg-main);
    border: 1px solid var(--border);
    padding: 0.85rem;
  }

  .exif-cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .exif-cell-wide {
    grid-column: 1 / -1;
  }

  .exif-label {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.72rem;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .exif-val {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.86rem;
    color: var(--fg-main);
    font-weight: 500;
  }

  .gps-link {
    color: var(--fg-link);
    text-decoration: none;
  }

  .gps-link:hover {
    color: var(--fg-link-hover);
    text-decoration: underline;
  }

  .file-integrity-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sha-label {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.72rem;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sha-hash-full {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.76rem;
    color: var(--fg-dim);
    background-color: var(--bg-main);
    border: 1px solid var(--border);
    padding: 0.45rem 0.65rem;
    word-break: break-all;
    display: block;
    line-height: 1.4;
  }

  .download-action-row {
    display: flex;
    align-items: center;
    padding-top: 0.25rem;
  }

  .btn-action {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: 1px solid var(--border) !important;
    color: var(--fg-main) !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    padding: 0.4rem 0.95rem !important;
    border-radius: 0 !important;
    cursor: pointer !important;
    text-decoration: none !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    transition:
      background-color 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease !important;
  }

  .btn-action:hover {
    background-color: var(--fg-main) !important;
    color: var(--bg-main) !important;
    border-color: var(--fg-main) !important;
  }

  .btn-action:active {
    background-color: var(--fg-link) !important;
    color: var(--bg-main) !important;
    border-color: var(--fg-link) !important;
  }

  .lightbox-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999;
  }

  .lightbox-modal.active {
    display: block;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .lightbox-container {
    position: absolute;
    z-index: 100000;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    padding: 0.75rem;
    gap: 0.4rem;
  }

  @media (min-width: 64em) {
    .lightbox-container {
      top: 0;
      right: 0;
      bottom: 0;
      left: var(--sidebar-width, 320px);
    }
  }

  @media (max-width: 63.99em) {
    .lightbox-container {
      top: 3.75rem;
      right: 0;
      bottom: 0;
      left: 0;
    }
  }

  .lightbox-close-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--bg-main, #211c19);
    border: 1px solid var(--border, #4a4535);
    color: var(--fg-main, #ffffff);
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 1.4rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    line-height: 1;
    z-index: 100001;
    transition:
      background-color 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease;
  }

  .lightbox-close-btn:hover {
    background-color: var(--fg-main);
    color: var(--bg-main);
    border-color: var(--fg-main);
  }

  .lightbox-image-wrapper {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .lightbox-image-wrapper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .lightbox-caption {
    flex-shrink: 0;
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.85rem;
    color: var(--fg-dim, #e0e0e0);
    text-align: center;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.15rem 0.5rem;
  }
</style>
