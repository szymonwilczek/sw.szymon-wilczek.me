---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getAllAlbums, type PhotoAlbum } from "../../../utils/albums";
import SearchFilter from "../../../components/SearchFilter.astro";
import Pagination from "../../../components/Pagination.astro";
import type { GetStaticPathsOptions, Page } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const albums = await getAllAlbums();
  return paginate(albums, { pageSize: 6 });
}

interface Props {
  page: Page<PhotoAlbum>;
}

const { page } = Astro.props;
const albums = page.data;
const prevUrl = page.currentPage === 2 ? "/photos" : page.url.prev;
---

<BaseLayout
  title={`Photo Albums - Page ${page.currentPage}`}
  description="A personal archive of places I've walked through and things I found worth remembering."
>
  <article class="photos-index-article">
    <header class="gallery-header">
      <h1>Photography &amp; Albums</h1>
      <p class="gallery-desc">
        A personal archive of places I've walked through and things I found worth remembering.
      </p>
    </header>

    <SearchFilter
      placeholder="Filter by location, title, or date..."
      targetSelector=".album-card"
      containerSelector=".albums-grid"
    />

    <div class="albums-grid">
      {
        albums.map((album, idx) => (
          <article
            class="album-card"
            data-search={`${album.title} ${album.dateFormatted} ${album.id}`}
          >
            <a href={`/photos/${album.slug}`} data-astro-prefetch="hover" class="album-cover-link">
              <div class="album-cover-wrapper">
                <img
                  src={album.coverThumb || album.coverImage}
                  alt={`Cover photo for ${album.title}`}
                  loading={idx < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="album-count-badge">
                  {album.photoCount} {album.photoCount === 1 ? "capture" : "captures"}
                </span>
              </div>
            </a>

            <div class="album-info">
              <h2 class="album-title">
                <a href={`/photos/${album.slug}`} data-astro-prefetch="hover">
                  {album.title}
                </a>
              </h2>
              <div class="album-meta">
                <span class="album-date">{album.dateFormatted}</span>
                <span class="meta-sep">&middot;</span>
                <span class="album-size">{album.totalSizeFormatted} master</span>
              </div>
              {album.description && <p class="album-note">{album.description}</p>}
              <div class="album-action">
                <a href={`/photos/${album.slug}`} data-astro-prefetch="hover" class="btn-action">
                  View Album &rarr;
                </a>
              </div>
            </div>
          </article>
        ))
      }

      {albums.length === 0 && <p>No photo albums cataloged on this page.</p>}
    </div>

    <Pagination
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={prevUrl}
      nextUrl={page.url.next}
      baseUrl="/photos"
    />
  </article>
</BaseLayout>

<style>
  .gallery-header {
    margin-bottom: 1.75rem;
  }

  .gallery-desc {
    color: var(--fg-dim);
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  .albums-grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .album-card {
    border: 1px solid var(--border);
    background-color: var(--bg-dim);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .album-card:hover {
    border-color: var(--fg-link);
  }

  .album-cover-link {
    display: block;
    text-decoration: none;
    overflow: hidden;
  }

  .album-cover-wrapper {
    position: relative;
    height: 240px;
    background-color: var(--bg-main);
    overflow: hidden;
  }

  .album-cover-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .album-card:hover .album-cover-wrapper img {
    transform: scale(1.04);
  }

  .album-count-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: var(--bg-dim);
    color: var(--fg-main);
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
  }

  .album-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .album-title {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .album-title a {
    color: var(--fg-main);
    text-decoration: none;
  }

  .album-title a:hover {
    color: var(--fg-link-hover);
    text-decoration: underline;
  }

  .album-meta {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.85rem;
    color: var(--fg-dim);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .album-note {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 1rem 0;
    color: var(--fg-main);
    flex: 1;
  }

  .album-action {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border);
  }

  .btn-action {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: 1px solid var(--border) !important;
    color: var(--fg-main) !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    padding: 0.35rem 0.85rem !important;
    border-radius: 0 !important;
    cursor: pointer !important;
    text-decoration: none !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    transition:
      background-color 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease !important;
  }

  .btn-action:hover {
    background-color: var(--fg-main) !important;
    color: var(--bg-main) !important;
    border-color: var(--fg-main) !important;
  }
</style>
