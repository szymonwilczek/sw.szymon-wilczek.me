---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import { getAllAlbums } from "../../utils/albums";
import { shioriUrl } from "../../utils/shiori";
import { hash, rng } from "../../utils/stamp";

// hung by date: the oldest bookmark first, the newest with the highest number
const albums = (await getAllAlbums()).slice().reverse();

const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
const since = albums[0]
  ? `${ROMAN[albums[0].date.getMonth()]}·${albums[0].date.getFullYear()}`
  : null;

const round1 = (value: number) => Math.round(value * 10) / 10;

function bookmark(slug: string, place: string) {
  const rand = rng(hash(slug + "/shiori"));
  // cord
  const cordX = 20 + (rand() - 0.5) * 10;
  const knotY = 6 + rand() * 6;
  let tassel = "";

  for (let strand = 0; strand < 7; strand++)
    tassel += `M${round1(cordX)} ${round1(knotY)} q${round1((strand - 3) * 1.4)} -6 ${round1((strand - 3) * 2.2 + (rand() - 0.5) * 2)} -${round1(14 + rand() * 6)} `;

  const caps = place.toUpperCase();
  const longest = Math.max(...caps.split(" ").map((word) => word.length));
  return {
    caps,
    cap: Math.min(19, Math.round(138 / (longest * 0.86))),
    cord: `M20 64 C${round1(cordX + 8)} 44 ${round1(cordX - 8)} 24 ${round1(cordX)} ${round1(knotY)}`,
    tassel,
    rot: round1((rand() - 0.5) * 2.4),
    give: round1(0.7 + rand() * 0.6),
  };
}

const rows: Array<{
  country: string;
  albums: Array<(typeof albums)[number] & ReturnType<typeof bookmark>>;
}> = [];
for (const album of albums) {
  const country = album.country ?? "[COUNTRY]";
  let row = rows.find((candidate) => candidate.country === country);
  if (!row) rows.push((row = { country, albums: [] }));
  row.albums.push({ ...album, ...bookmark(album.slug, album.location ?? album.title) });
}

const next = {
  ...bookmark("next", "[PLACE]"),
  num: String(albums.length + 1).padStart(2, "0"),
};

// empty bookmark's under-drawing
const grid = "M0 100 H100 M0 200 H100 M50 0 V300";
const gables =
  "M8 210 L8 150 L22 132 L36 150 L36 210 M36 210 L36 160 H64 V210 M64 210 L64 140 L78 126 L92 140 L92 210";
---

<BaseLayout
  title="Bookmarks"
  description="One bookmark for every place the camera went, painted from that album's own terrain."
>
  <a class="back hand" href="/photos/">
    <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
      <path d="M42 11 C 30 9, 18 12, 4 10 M 12 3 L 3 10 L 12 17"></path>
    </svg>
    postcards
  </a>

  <header class="klaser-head">
    <div>
      <h1>Bookmarks</h1>
      <p class="lede">
        One for every place the camera went.
      </p>
    </div>
    <p class="tally">
      {albums.length}
      {albums.length === 1 ? "bookmark" : "bookmarks"} · {rows.length}
      {rows.length === 1 ? "country" : "countries"}
      {since && ` · since ${since}`}
    </p>
  </header>

  <Divider from={520} to={760} />

  <div class="rack-bar">
    <p class="hint hand">
      <span class="hint-point">pull its cord to take it out</span>
      <span class="hint-touch">swipe along the shelf; tap one, or pull it out by the cord</span>
    </p>
    <button type="button" class="sift hand" hidden>
      only <span class="sift-tag"></span> · show all
    </button>
    <div class="rack-nav" hidden>
      <button type="button" class="rack-step" data-step="-1" aria-label="Scroll back">
        <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
          <path d="M42 11 C 30 9, 18 12, 4 10 M 12 3 L 3 10 L 12 17"></path>
        </svg>
      </button>
      <button type="button" class="rack-step" data-step="1" aria-label="Scroll on">
        <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
          <path d="M2 9 C 14 11, 26 8, 40 10 M 32 3 L 41 10 L 32 17"></path>
        </svg>
      </button>
    </div>
  </div>

  <section class="rack" aria-label="Bookmarks" tabindex="0">
    {rows.map((row, rowIndex) => (
      <div class="shelf">
        <div class="shelf-row">
          {row.albums.map((album) => (
            <div
              class="shiori"
              data-terrain={album.terrain.join(" ")}
              style={`--rot: ${album.rot}deg; --give: ${album.give}; --cap: ${album.cap}px; --i: ${albums.indexOf(album)}`}
            >
              <a
                class="open"
                href={`/photos/${album.slug}/`}
                aria-label={`${album.title}, bookmark ${album.stampNum}`}
              />
              <svg class="cord" width="40" height="70" viewBox="0 0 40 70" aria-hidden="true">
                <path d={album.cord} />
                <path class="tassel" d={album.tassel} />
              </svg>
              <span class="hole" aria-hidden="true" />
              <svg
                class="art"
                viewBox="0 0 100 300"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
                data-art={shioriUrl(album.slug)}
              />
              <span class="margin">
                <span class="caps">{album.caps}</span>
                <span class="tags">
                  {album.terrain.map((tag, i) => (
                    <Fragment>
                      {i > 0 && " · "}
                      <button type="button" class="tag" data-tag={tag} aria-pressed="false">
                        {tag}
                      </button>
                    </Fragment>
                  ))}
                </span>
                <span class="sign">
                  <span class="num">no. {album.stampNum}</span>
                  <span class="hand">sw.</span>
                </span>
              </span>
            </div>
          ))}
          {rowIndex === rows.length - 1 && (
            <span
              class="shiori blank"
              style={`--rot: ${next.rot}deg; --give: ${next.give}; --cap: ${next.cap}px; --i: ${albums.length}`}
            >
              <svg class="cord" width="40" height="70" viewBox="0 0 40 70" aria-hidden="true">
                <path d={next.cord} />
                <path class="tassel" d={next.tassel} />
              </svg>
              <span class="hole" aria-hidden="true" />
              <span class="art sketch">
                <svg viewBox="0 0 100 300" preserveAspectRatio="none" aria-hidden="true">
                  <path d={grid} vector-effect="non-scaling-stroke" />
                  <path class="subject" d={gables} vector-effect="non-scaling-stroke" />
                </svg>
                <span class="hand">next?</span>
              </span>
              <span class="margin">
                <span class="caps">{next.caps}</span>
                <span class="tags">[SUBJECT]</span>
                <span class="sign">
                  <span class="num">no. {next.num}</span>
                </span>
              </span>
            </span>
          )}
        </div>
        <p class="shelf-label hand">
          {row.country} <span>· {row.albums.length}</span>
        </p>
      </div>
    ))}
  </section>

  <p class="foot hand">bookmarks hang by date</p>
</BaseLayout>

<script>
  import { fillArt } from "../../scripts/art";

  const rack = document.querySelector<HTMLElement>(".rack");
  const nav = document.querySelector<HTMLElement>(".rack-nav");
  if (rack && nav) {
    const [back, forward] = nav.querySelectorAll<HTMLButtonElement>(".rack-step");

    const soak =
      !matchMedia("(prefers-reduced-motion: reduce)").matches &&
      !sessionStorage.getItem("shiori-soaked");
    sessionStorage.setItem("shiori-soaked", "1");

    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          seen.unobserve(entry.target);
          fillArt(entry.target as SVGSVGElement).then(() => {
            if (soak) entry.target.classList.add("soak");
          });
        }
      },
      { root: rack, rootMargin: "0px 640px" },
    );
    rack.querySelectorAll<SVGSVGElement>("svg[data-art]").forEach((svg) => seen.observe(svg));

    // arrows and edge fades only while the shelf is wider than the page
    const ends = () => {
      const maxScroll = rack.scrollWidth - rack.clientWidth;
      nav.hidden = maxScroll < 2;
      back.disabled = rack.scrollLeft < 2;
      forward.disabled = rack.scrollLeft > maxScroll - 2;
      rack.classList.toggle("more-back", !nav.hidden && !back.disabled);
      rack.classList.toggle("more-on", !nav.hidden && !forward.disabled);
    };
    ends();
    rack.addEventListener("scroll", ends, { passive: true });
    new ResizeObserver(ends).observe(rack);

    const still = matchMedia("(prefers-reduced-motion: reduce)");

    const stops = () => {
      const padding = parseFloat(getComputedStyle(rack).scrollPaddingLeft) || 0;
      const maxScroll = rack.scrollWidth - rack.clientWidth;
      const left = rack.getBoundingClientRect().left + rack.clientLeft - rack.scrollLeft;
      return [...rack.querySelectorAll<HTMLElement>(".shiori")]
        .map((shiori) => {
          const box = shiori.getBoundingClientRect();
          return getComputedStyle(shiori).scrollSnapAlign.includes("center")
            ? box.left - left + box.width / 2 - rack.clientWidth / 2
            : box.left - left - padding;
        })
        .map((x) => Math.round(Math.max(0, Math.min(maxScroll, x))));
    };
    let settle = 0;
    const unsnap = () => {
      rack.style.scrollSnapType = "none";
      const done = () => {
        clearTimeout(settle);
        settle = window.setTimeout(function again() {
          if (!/^(0deg)?$/.test(rack.style.getPropertyValue("--sway"))) {
            settle = window.setTimeout(again, 80);
            return;
          }
          rack.style.removeProperty("scroll-snap-type");
          rack.removeEventListener("scroll", done);
        }, 160);
      };
      rack.addEventListener("scroll", done, { passive: true });
      done();
    };
    for (const button of [back, forward])
      button.addEventListener("click", () => {
        const direction = Number(button.dataset.step);
        const x = rack.scrollLeft;
        const want = x + direction * rack.clientWidth * 0.8;
        const allStops = [...new Set(stops())].sort((former, latter) => former - latter);
        const ahead = allStops.filter((stop) => (direction > 0 ? stop > x + 2 : stop < x - 2));
        if (!ahead.length) return;
        const within = ahead.filter((stop) => (direction > 0 ? stop <= want : stop >= want));
        const destination = within.length
          ? direction > 0
            ? within.at(-1)!
            : within[0]
          : direction > 0
            ? ahead[0]
            : ahead.at(-1)!;
        unsnap();
        rack.scrollTo({ left: destination, behavior: still.matches ? "auto" : "smooth" });
      });

    // moving the shelf leaves the bookmarks leaning behind
    if (!still.matches) {
      let last = rack.scrollLeft;
      let lastT = performance.now();
      let push = 0;
      let sway = 0;
      let velocity = 0;
      let frame = 0;
      const step = () => {
        velocity = (velocity + (push - sway) * 0.08) * 0.86;
        sway += velocity;
        push *= 0.85;
        const rest = Math.abs(sway) + Math.abs(velocity) + Math.abs(push) < 0.01;
        rack.style.setProperty("--sway", rest ? "0deg" : `${sway.toFixed(3)}deg`);
        frame = rest ? 0 : requestAnimationFrame(step);
      };
      rack.addEventListener(
        "scroll",
        () => {
          const now = performance.now();
          const speed = (rack.scrollLeft - last) / Math.max(8, now - lastT);
          last = rack.scrollLeft;
          lastT = now;
          push = Math.max(-4, Math.min(4, speed * 2));
          frame ||= requestAnimationFrame(step);
        },
        { passive: true },
      );
    }

    // pull a bookmark up by its cord
    rack.addEventListener("pointerdown", (event) => {
      const cord = (event.target as Element).closest<SVGSVGElement>(".shiori:not(.blank) .cord");
      if (!cord) return;
      const mark = cord.closest<HTMLElement>(".shiori")!;
      const href = mark.querySelector<HTMLAnchorElement>(".open")!.href;
      event.preventDefault();
      cord.setPointerCapture(event.pointerId);
      mark.classList.add("pulling");
      const startY = event.clientY;
      let pull = 0;
      let moved = 0;
      const move = (moveEvent: PointerEvent) => {
        const drag = Math.max(0, startY - moveEvent.clientY);
        moved = Math.max(moved, Math.abs(startY - moveEvent.clientY));
        pull = 90 * (1 - Math.exp(-drag / 90));
        mark.style.setProperty("--pull", `${pull.toFixed(1)}px`);
      };
      const release = (releaseEvent: PointerEvent) => {
        cord.removeEventListener("pointermove", move);
        cord.removeEventListener("pointerup", release);
        cord.removeEventListener("pointercancel", release);
        mark.classList.remove("pulling");
        if (releaseEvent.type === "pointerup" && (pull > 60 || moved < 4)) {
          mark.classList.add("leaving");
          setTimeout(() => location.assign(href), still.matches ? 0 : 280);
        } else mark.style.removeProperty("--pull");
      };
      cord.addEventListener("pointermove", move);
      cord.addEventListener("pointerup", release);
      cord.addEventListener("pointercancel", release);
    });

    // coming back to the page puts it back in the rack
    addEventListener("pageshow", () => {
      for (const shiori of rack.querySelectorAll<HTMLElement>(".leaving")) {
        shiori.classList.remove("leaving");
        shiori.style.removeProperty("--pull");
      }
    });

    // empty bookmark keeps trying out the next place
    const subject = rack.querySelector<SVGPathElement>(".blank .subject");
    if (subject && !still.matches) {
      const between = (low: number, high: number) => low + Math.random() * (high - low);
      const round1 = (value: number) => Math.round(value * 10) / 10;
      const sketches = [
        // row of houses
        () => {
          let path = "";
          for (let x = between(4, 10); x < 86;) {
            const width = between(18, 28);
            const top = between(130, 165);
            path += `M${round1(x)} 210 V${round1(top)} `;
            path +=
              Math.random() < 0.6
                ? `L${round1(x + width / 2)} ${round1(top - between(10, 18))} L${round1(x + width)} ${round1(top)} `
                : `H${round1(x + width)} `;
            path += "V210 ";
            x += width + between(0, 4);
          }
          return path;
        },
        // ridge and its sun
        () => {
          let path = `M0 ${round1(between(170, 190))}`;
          for (let x = between(8, 14); x < 100; x += between(10, 18))
            path += ` L${round1(x)} ${round1(between(110, 190))}`;
          const sunX = between(20, 80);
          const sunY = between(55, 90);
          return `${path} L100 ${round1(between(150, 190))} M${round1(sunX - 7)} ${round1(sunY)} a7 7 0 1 0 14 0 a7 7 0 1 0 -14 0`;
        },
        // horizon, few waves and sail
        () => {
          const y = between(150, 175);
          let path = `M0 ${round1(y)} H100`;
          for (let i = 0; i < 4; i++)
            path += ` M${round1(between(6, 70))} ${round1(y + between(15, 90))} q4 -4 8 0 q4 -4 8 0`;
          const boatX = between(20, 70);
          return `${path} M${round1(boatX)} ${round1(y - 2)} h14 l-3 5 h-8 z M${round1(boatX + 7)} ${round1(y - 2)} V${round1(y - 28)} L${round1(boatX + 17)} ${round1(y - 6)}`;
        },
        // cliff with small white town
        () => {
          const edge = between(48, 62);
          let path = `M${round1(edge)} 300`;
          for (let y = 280; y > 130; y -= 15) path += ` L${round1(edge + between(-6, 6))} ${y}`;
          path += ` L${round1(edge)} 130 H100`;
          for (let x = edge + 2; x < 90; x += between(9, 12))
            path += ` M${round1(x)} 130 v-${round1(between(8, 15))} h${round1(between(6, 8))} V130`;
          return path;
        },
      ];

      let shown = false;
      new IntersectionObserver(([entry]) => (shown = entry.isIntersecting), {
        threshold: 0.3,
      }).observe(subject.closest(".shiori")!);

      const pause = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
      (async () => {
        for (let index = 1; ; index = (index + 1) % sketches.length) {
          await pause(4000);
          while (!shown || document.hidden) await pause(500);
          await subject.animate([{ opacity: 0 }], { duration: 700, fill: "forwards" }).finished;
          subject.setAttribute("d", sketches[index]());
          subject.getAnimations().forEach((animation) => animation.cancel());
          await subject.animate(
            [{ clipPath: "inset(-5% 100% -5% -5%)" }, { clipPath: "inset(-5% -5% -5% -5%)" }],
            {
              duration: 2600,
              easing: "ease-in-out",
            },
          ).finished;
        }
      })();
    }

    // terrain tag sifts the shelf
    const sift = document.querySelector<HTMLButtonElement>(".sift")!;
    const marks = [...rack.querySelectorAll<HTMLElement>(".shiori[data-terrain]")];
    let only: string | null = null;
    const choose = (tag: string | null) => {
      only = tag === only ? null : tag;
      rack.toggleAttribute("data-sifting", only !== null);
      sift.hidden = only === null;
      sift.querySelector(".sift-tag")!.textContent = only ?? "";
      for (const button of rack.querySelectorAll<HTMLButtonElement>(".tag"))
        button.setAttribute("aria-pressed", String(button.dataset.tag === only));
      const hits = marks.filter((shiori) => {
        const hit = only !== null && shiori.dataset.terrain!.split(" ").includes(only);
        shiori.classList.toggle("match", hit);
        return hit;
      });
      hits[0]?.scrollIntoView({
        inline: "center",
        block: "nearest",
        behavior: still.matches ? "auto" : "smooth",
      });
    };
    rack.addEventListener("click", (event) => {
      const tag = (event.target as Element).closest<HTMLButtonElement>(".tag");
      if (tag) choose(tag.dataset.tag!);
    });
    sift.addEventListener("click", () => choose(null));
    addEventListener("keydown", (event) => {
      if (event.key === "Escape" && only !== null) choose(null);
    });
  }
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    font-weight: 300;
    font-size: 1.1875rem;
    color: var(--fg-dim);
    text-decoration: none;
  }

  .back path,
  .rack-step path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s;
  }

  .back:hover path {
    transform: translateX(-3px);
  }

  .klaser-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }

  .klaser-head > div {
    flex: 999 1 30rem;
    max-width: 40rem;
  }

  .klaser-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .tally {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .rack-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  .hint {
    margin: 0 0 0 0.375rem;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--fg-dim);
    transform: rotate(-1deg);
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-point {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  .sift {
    min-height: 44px;
    margin-left: auto;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--fg-dim);
    cursor: pointer;
  }

  .sift[hidden] {
    display: none;
  }

  .sift-tag {
    color: var(--red);
  }

  .sift:hover {
    color: var(--fg-main);
  }

  .rack-nav {
    display: flex;
    gap: 0.25rem;
  }

  .rack-nav[hidden] {
    display: none;
  }

  .rack-step {
    display: grid;
    place-items: center;
    width: 52px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .rack-step:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .rack-step[data-step="-1"]:not(:disabled):hover path {
    transform: translateX(-3px);
  }

  .rack-step[data-step="1"]:not(:disabled):hover path {
    transform: translateX(3px);
  }

  .rack {
    --w: 164px;
    --h: 560px;
    --gap: 18px;
    --fade: 0px;
    --fade-back: 0px;
    --fade-on: 0px;
    display: flex;
    align-items: flex-start;
    gap: 28px;
    margin: 0.25rem calc(var(--gutter) * -1) 0;
    padding: 150px var(--gutter) 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-back),
      #000 calc(100% - var(--fade-on)),
      transparent
    );
  }

  .rack.more-back {
    --fade-back: var(--gutter);
  }

  .rack.more-on {
    --fade-on: var(--gutter);
  }

  .rack:focus-visible {
    outline: 1.5px dashed var(--cursor);
    outline-offset: -4px;
  }

  .shelf {
    flex: none;
    display: flex;
    flex-direction: column;
  }

  .shelf-row {
    display: flex;
    align-items: flex-end;
    gap: var(--gap);
  }

  .shelf-label {
    margin: 14px 0 0;
    padding-top: 8px;
    border-top: 1.5px solid var(--border);
    font-size: 1.125rem;
  }

  .shelf-label span {
    font-weight: 300;
    font-size: 0.9375rem;
    color: var(--fg-dim);
  }

  .shiori {
    position: relative;
    flex: none;
    display: block;
    width: var(--w);
    height: var(--h);
    background: var(--paper);
    border-radius: 3px 3px 4px 4px;
    box-shadow:
      0 10px 14px -10px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(0, 0, 0, 0.05);
    color: var(--fg-main);
    scroll-snap-align: start;
    transform: rotate(var(--rot));
    transform-origin: 50% 100%;
    rotate: calc(var(--sway, 0deg) * var(--give));
    translate: 0 calc(var(--pull, 0px) * -1);
    transition:
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
      translate 0.5s cubic-bezier(0.3, 1.5, 0.5, 1),
      box-shadow 0.5s ease,
      opacity 0.4s ease,
      filter 0.4s ease;
    animation: hang 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) calc(min(var(--i), 10) * 70ms) backwards;
  }

  @keyframes hang {
    from {
      opacity: 0;
      translate: 0 -46px;
      rotate: calc(var(--give) * -5deg);
    }
    40% {
      opacity: 1;
