---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import { getAllAlbums } from "../../utils/albums";
import { shioriUrl } from "../../utils/shiori";
import { hash, rng } from "../../utils/stamp";

// hung by date: the oldest bookmark first, the newest with the highest number
const albums = (await getAllAlbums()).slice().reverse();

const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
const since = albums[0]
  ? `${ROMAN[albums[0].date.getMonth()]}·${albums[0].date.getFullYear()}`
  : null;

const round1 = (value: number) => Math.round(value * 10) / 10;

function bookmark(slug: string, place: string) {
  const rand = rng(hash(slug + "/shiori"));
  // cord
  const cordX = 20 + (rand() - 0.5) * 10;
  const knotY = 6 + rand() * 6;
  let tassel = "";

  for (let strand = 0; strand < 7; strand++)
    tassel += `M${round1(cordX)} ${round1(knotY)} q${round1((strand - 3) * 1.4)} -6 ${round1((strand - 3) * 2.2 + (rand() - 0.5) * 2)} -${round1(14 + rand() * 6)} `;

  const caps = place.toUpperCase();
  const longest = Math.max(...caps.split(" ").map((word) => word.length));
  return {
    caps,
    cap: Math.min(19, Math.round(138 / (longest * 0.86))),
    cord: `M20 64 C${round1(cordX + 8)} 44 ${round1(cordX - 8)} 24 ${round1(cordX)} ${round1(knotY)}`,
    tassel,
    rot: round1((rand() - 0.5) * 2.4),
    give: round1(0.7 + rand() * 0.6),
  };
}

const rows: Array<{
  country: string;
  albums: Array<(typeof albums)[number] & ReturnType<typeof bookmark>>;
}> = [];
for (const album of albums) {
  const country = album.country ?? "[COUNTRY]";
  let row = rows.find((candidate) => candidate.country === country);
  if (!row) rows.push((row = { country, albums: [] }));
  row.albums.push({ ...album, ...bookmark(album.slug, album.location ?? album.title) });
}

const next = {
  ...bookmark("next", "[PLACE]"),
  num: String(albums.length + 1).padStart(2, "0"),
};

// empty bookmark's under-drawing
const grid = "M0 100 H100 M0 200 H100 M50 0 V300";
const gables =
  "M8 210 L8 150 L22 132 L36 150 L36 210 M36 210 L36 160 H64 V210 M64 210 L64 140 L78 126 L92 140 L92 210";
---

<BaseLayout
  title="Bookmarks"
  description="One bookmark for every place the camera went, painted from that album's own terrain."
>
  <a class="back hand" href="/photos/">
    <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
      <path d="M42 11 C 30 9, 18 12, 4 10 M 12 3 L 3 10 L 12 17"></path>
    </svg>
    postcards
  </a>

  <header class="klaser-head">
    <div>
      <h1>Bookmarks</h1>
      <p class="lede">One for every place the camera went.</p>
    </div>
    <p class="tally">
      {albums.length}
      {albums.length === 1 ? "bookmark" : "bookmarks"} · {rows.length}
      {rows.length === 1 ? "country" : "countries"}
      {since && ` · since ${since}`}
    </p>
  </header>

  <Divider from={520} to={760} />

  <div class="rack-bar">
    <p class="hint hand">
      <span class="hint-point">pull its cord to take it out</span>
      <span class="hint-touch">swipe along the shelf; tap one, or pull it out by the cord</span>
    </p>
    <button type="button" class="sift hand" hidden>
      only <span class="sift-tag"></span> · show all
    </button>
    <div class="rack-nav" hidden>
      <button type="button" class="rack-step" data-step="-1" aria-label="Scroll back">
        <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
          <path d="M42 11 C 30 9, 18 12, 4 10 M 12 3 L 3 10 L 12 17"></path>
        </svg>
      </button>
      <button type="button" class="rack-step" data-step="1" aria-label="Scroll on">
        <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
          <path d="M2 9 C 14 11, 26 8, 40 10 M 32 3 L 41 10 L 32 17"></path>
        </svg>
      </button>
    </div>
  </div>

  <section class="rack" aria-label="Bookmarks" tabindex="0">
    {rows.map((row, rowIndex) => (
      <div class="shelf">
        <div class="shelf-row">
          {row.albums.map((album) => (
            <div
              class="shiori"
              data-terrain={album.terrain.join(" ")}
              style={`--rot: ${album.rot}deg; --give: ${album.give}; --cap: ${album.cap}px; --i: ${albums.indexOf(album)}`}
            >
              <a
                class="open"
                href={`/photos/${album.slug}/`}
                aria-label={`${album.title}, bookmark ${album.stampNum}`}
              />
              <svg class="cord" width="40" height="70" viewBox="0 0 40 70" aria-hidden="true">
                <path d={album.cord} />
                <path class="tassel" d={album.tassel} />
              </svg>
              <span class="hole" aria-hidden="true" />
              <svg
                class="art"
                viewBox="0 0 100 300"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
                data-art={shioriUrl(album.slug)}
              />
              <span class="margin">
                <span class="caps">{album.caps}</span>
                <span class="tags">
                  {album.terrain.map((tag, i) => (
                    <Fragment>
                      {i > 0 && " · "}
                      <button type="button" class="tag" data-tag={tag} aria-pressed="false">
                        {tag}
                      </button>
                    </Fragment>
                  ))}
                </span>
                <span class="sign">
                  <span class="num">no. {album.stampNum}</span>
                  <span class="hand">sw.</span>
                </span>
              </span>
            </div>
          ))}
          {rowIndex === rows.length - 1 && (
            <span
              class="shiori blank"
              style={`--rot: ${next.rot}deg; --give: ${next.give}; --cap: ${next.cap}px; --i: ${albums.length}`}
            >
              <svg class="cord" width="40" height="70" viewBox="0 0 40 70" aria-hidden="true">
                <path d={next.cord} />
                <path class="tassel" d={next.tassel} />
              </svg>
              <span class="hole" aria-hidden="true" />
              <span class="art sketch">
                <svg viewBox="0 0 100 300" preserveAspectRatio="none" aria-hidden="true">
                  <path d={grid} vector-effect="non-scaling-stroke" />
                  <path class="subject" d={gables} vector-effect="non-scaling-stroke" />
                </svg>
                <span class="hand">next?</span>
              </span>
              <span class="margin">
                <span class="caps">{next.caps}</span>
                <span class="tags">[SUBJECT]</span>
                <span class="sign">
                  <span class="num">no. {next.num}</span>
                </span>
              </span>
            </span>
          )}
        </div>
        <p class="shelf-label hand">
          {row.country} <span>· {row.albums.length}</span>
        </p>
      </div>
    ))}
  </section>

  <p class="foot hand">bookmarks hang by date</p>
</BaseLayout>

<script>
  import "../../scripts/bookmarks";
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    font-weight: 300;
    font-size: 1.1875rem;
    color: var(--fg-dim);
    text-decoration: none;
  }

  .back path,
  .rack-step path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s;
  }

  .back:hover path {
    transform: translateX(-3px);
  }

  .klaser-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }

  .klaser-head > div {
    flex: 999 1 30rem;
    max-width: 40rem;
  }

  .klaser-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .tally {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .rack-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  .hint {
    margin: 0 0 0 0.375rem;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--fg-dim);
    transform: rotate(-1deg);
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-point {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  .sift {
    min-height: 44px;
    margin-left: auto;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--fg-dim);
    cursor: pointer;
  }

  .sift[hidden] {
    display: none;
  }

  .sift-tag {
    color: var(--red);
  }

  .sift:hover {
    color: var(--fg-main);
  }

  .rack-nav {
    display: flex;
    gap: 0.25rem;
  }

  .rack-nav[hidden] {
    display: none;
  }

  .rack-step {
    display: grid;
    place-items: center;
    width: 52px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .rack-step:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .rack-step[data-step="-1"]:not(:disabled):hover path {
    transform: translateX(-3px);
  }

  .rack-step[data-step="1"]:not(:disabled):hover path {
    transform: translateX(3px);
  }

  .rack {
    --w: 164px;
    --h: 560px;
    --gap: 18px;
    --fade: 0px;
    --fade-back: 0px;
    --fade-on: 0px;
    display: flex;
    align-items: flex-start;
    gap: 28px;
    margin: 0.25rem calc(var(--gutter) * -1) 0;
    padding: 150px var(--gutter) 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-back),
      #000 calc(100% - var(--fade-on)),
      transparent
    );
  }

  .rack.more-back {
    --fade-back: var(--gutter);
  }

  .rack.more-on {
    --fade-on: var(--gutter);
  }

  .rack:focus-visible {
    outline: 1.5px dashed var(--cursor);
    outline-offset: -4px;
  }

  .shelf {
    flex: none;
    display: flex;
    flex-direction: column;
  }

  .shelf-row {
    display: flex;
    align-items: flex-end;
    gap: var(--gap);
  }

  .shelf-label {
    margin: 14px 0 0;
    padding-top: 8px;
    border-top: 1.5px solid var(--border);
    font-size: 1.125rem;
  }

  .shelf-label span {
    font-weight: 300;
    font-size: 0.9375rem;
    color: var(--fg-dim);
  }

  .shiori {
    position: relative;
    flex: none;
    display: block;
    width: var(--w);
    height: var(--h);
    background: var(--paper);
    border-radius: 3px 3px 4px 4px;
    box-shadow:
      0 10px 14px -10px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(0, 0, 0, 0.05);
    color: var(--fg-main);
    scroll-snap-align: start;
    transform: rotate(var(--rot));
    transform-origin: 50% 100%;
    rotate: calc(var(--sway, 0deg) * var(--give));
    translate: 0 calc(var(--pull, 0px) * -1);
    transition:
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
      translate 0.5s cubic-bezier(0.3, 1.5, 0.5, 1),
      box-shadow 0.5s ease,
      opacity 0.4s ease,
      filter 0.4s ease;
    animation: hang 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) calc(min(var(--i), 10) * 70ms) backwards;
  }

  @keyframes hang {
    from {
      opacity: 0;
      translate: 0 -46px;
      rotate: calc(var(--give) * -5deg);
    }
    40% {
      opacity: 1;
    }
  }

  .shiori.pulling {
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 0.4s ease;
  }

  .shiori.leaving {
    translate: 0 calc(var(--pull, 0px) * -1 - 70px);
    opacity: 0;
    transition:
      translate 0.28s ease-in,
      opacity 0.28s ease-in;
  }

  .shiori:not(.blank):hover,
  .shiori:has(:focus-visible) {
    transform: translateY(-30px) rotate(var(--rot));
    box-shadow:
      0 30px 30px -18px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(0, 0, 0, 0.05);
  }

  .open {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .open:focus-visible {
    outline: 1.5px dashed var(--cursor);
    outline-offset: 4px;
  }

  .rack[data-sifting] .shiori:not(.match) {
    opacity: 0.3;
    filter: saturate(0.3);
  }

  .shiori:not(.blank) .cord {
    z-index: 2;
    cursor: grab;
    touch-action: none;
  }

  .shiori.pulling .cord {
    cursor: grabbing;
  }

  .cord {
    position: absolute;
    left: calc(50% - 20px);
    top: -56px;
    overflow: visible;
    rotate: calc(var(--sway, 0deg) * var(--give) * 1.8);
    transform-origin: 20px 64px;
  }

  .cord path {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .cord .tassel {
    stroke-width: 0.8;
    opacity: 0.85;
  }

  .hole {
    position: absolute;
    left: calc(50% - 4px);
    top: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg-main);
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.35);
  }

  .art {
    position: absolute;
    left: 9px;
    top: 24px;
    width: calc(100% - 18px);
    height: calc(var(--h) - 136px);
    border-radius: 1px;
  }

  .art.soak {
    animation: soak 1.4s cubic-bezier(0.3, 0.6, 0.4, 1) calc((var(--give) - 0.7) * 0.5s) backwards;
  }

  @keyframes soak {
    from {
      opacity: 0.2;
      clip-path: inset(0 0 100% 0);
    }
    60% {
      opacity: 0.85;
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  .art :global(.shiori-wash path) {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .art :global(.shiori-mist) {
    fill: var(--paper);
    opacity: 0.5;
  }

  .art :global(.shiori-white) {
    fill: none;
    stroke: var(--paper);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.95;
  }

  .art :global(.shiori-windows) {
    fill: color-mix(in srgb, var(--paper), var(--sky) 25%);
    stroke: var(--fg-main);
    stroke-width: 0.25;
    stroke-opacity: 0.5;
  }

  .art :global(.shiori-pencil) {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 0.35;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .art :global(.shiori-grain) {
    fill: var(--fg-main);
    opacity: 0.09;
  }

  .margin {
    position: absolute;
    left: 8px;
    right: 8px;
    top: calc(var(--h) - 98px);
    bottom: 12px;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .caps {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--cap);
    line-height: 1.15;
    letter-spacing: 0.14em;
  }

  .tags {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.12em;
    white-space: nowrap;
    color: var(--fg-dim);
  }

  .tag {
    position: relative;
    z-index: 2;
    margin: -6px -2px;
    padding: 6px 2px;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    cursor: pointer;
  }

  .tag:hover,
  .tag[aria-pressed="true"] {
    color: var(--red);
    text-decoration: underline 1px;
    text-underline-offset: 3px;
  }

  .tag:focus-visible {
    outline: 1.5px dashed var(--cursor);
    outline-offset: 0;
  }

  .sign {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: auto 2px 0;
    padding-top: 6px;
    font-size: 13px;
  }

  .num {
    font-family: var(--font-body);
    font-style: italic;
    color: var(--red);
  }

  .sign .hand {
    font-weight: 300;
    color: var(--fg-dim);
    transform: rotate(-6deg);
  }

  .sketch {
    border: 1px dashed var(--border);
  }

  .sketch svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sketch path {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.4;
    opacity: 0.45;
  }

  .sketch .hand {
    position: absolute;
    left: 0;
    right: 0;
    top: 42%;
    text-align: center;
    font-weight: 300;
    font-size: 1.25rem;
    color: var(--fg-dim);
  }

  .blank .caps {
    color: var(--fg-dim);
  }

  .foot {
    margin: 0.5rem 0 0 0.375rem;
    font-weight: 300;
    font-size: 1.0625rem;
    color: var(--fg-dim);
    transform: rotate(-1deg);
  }

  @media (max-width: 40rem) {
    .rack {
      --w: 150px;
      --h: 500px;
      --gap: 14px;
      gap: 26px;
      scroll-snap-type: x mandatory;
    }

    .shiori {
      scroll-snap-align: center;
    }

    .caps {
      font-size: calc(var(--cap) * 0.9);
    }

    .art {
      height: calc(var(--h) - 128px);
    }

    .margin {
      top: calc(var(--h) - 90px);
    }

    .tags {
      font-size: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shiori,
    .back path,
    .rack-step path {
      transition: none;
      animation: none;
    }
  }
</style>
