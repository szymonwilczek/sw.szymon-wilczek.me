---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import Stamp from "../../components/Stamp.astro";
import { getAllAlbums } from "../../utils/albums";
import { shioriUrl } from "../../utils/shiori";
import { hash, rng } from "../../utils/stamp";

// hung by date: the oldest bookmark first, the newest with the highest number
const albums = (await getAllAlbums()).slice().reverse();

const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
const since = albums[0]
  ? `${ROMAN[albums[0].date.getMonth()]}·${albums[0].date.getFullYear()}`
  : null;

const f1 = (n: number) => Math.round(n * 10) / 10;

function bookmark(slug: string, place: string) {
  const r = rng(hash(slug + "/shiori"));
  // cord
  const cx = 20 + (r() - 0.5) * 10;
  const ky = 6 + r() * 6;
  let tassel = "";

  for (let k = 0; k < 7; k++)
    tassel += `M${f1(cx)} ${f1(ky)} q${f1((k - 3) * 1.4)} -6 ${f1((k - 3) * 2.2 + (r() - 0.5) * 2)} -${f1(14 + r() * 6)} `;

  const caps = place.toUpperCase();
  const longest = Math.max(...caps.split(" ").map((w) => w.length));
  return {
    caps,
    cap: Math.min(19, Math.round(138 / (longest * 0.86))),
    cord: `M20 64 C${f1(cx + 8)} 44 ${f1(cx - 8)} 24 ${f1(cx)} ${f1(ky)}`,
    tassel,
    rot: f1((r() - 0.5) * 2.4),
    tilt: f1(-4 + r() * 8),
    give: f1(0.7 + r() * 0.6),
  };
}

const rows: Array<{
  country: string;
  albums: Array<(typeof albums)[number] & ReturnType<typeof bookmark>>;
}> = [];
for (const album of albums) {
  const country = album.country ?? "[COUNTRY]";
  let row = rows.find((r) => r.country === country);
  if (!row) rows.push((row = { country, albums: [] }));
  row.albums.push({ ...album, ...bookmark(album.slug, album.location ?? album.title) });
}

const next = {
  ...bookmark("next", "[PLACE]"),
  num: String(albums.length + 1).padStart(2, "0"),
};

// empty bookmark's under-drawing
const grid = "M0 100 H100 M0 200 H100 M50 0 V300";
const gables =
  "M8 210 L8 150 L22 132 L36 150 L36 210 M36 210 L36 160 H64 V210 M64 210 L64 140 L78 126 L92 140 L92 210";
---

<BaseLayout
  title="Bookmarks"
  description="One bookmark for every place the camera went, painted from that album's own terrain."
>
  <a class="back hand" href="/photos/">
    <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
      <path d="M42 11 C 30 9, 18 12, 4 10 M 12 3 L 3 10 L 12 17"></path>
    </svg>
    postcards
  </a>

  <header class="klaser-head">
    <div>
      <h1>Bookmarks</h1>
      <p class="lede">
        One 栞 for every place the camera went: a tall bookmark painted from that album’s own
        terrain, with its stamp hinged at the foot. No two come out alike, and each one keeps the
        page where that trip is.
      </p>
    </div>
    <p class="tally">
      {albums.length}
      {albums.length === 1 ? "bookmark" : "bookmarks"} · {rows.length}
      {rows.length === 1 ? "country" : "countries"}
      {since && ` · since ${since}`}
    </p>
  </header>

  <Divider from={520} to={760} />

  <div class="rack-bar">
    <p class="hint hand">
      <span class="hint-point">point at one and it rises; pull its cord to take it out.</span>
      <span class="hint-touch">swipe along the shelf; tap one, or pull it out by the cord.</span>
    </p>
    <button type="button" class="sift hand" hidden>
      only <span class="sift-tag"></span> · show all
    </button>
    <div class="rack-nav" hidden>
      <button type="button" class="rack-step" data-step="-1" aria-label="Scroll back">
        <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
          <path d="M42 11 C 30 9, 18 12, 4 10 M 12 3 L 3 10 L 12 17"></path>
        </svg>
      </button>
      <button type="button" class="rack-step" data-step="1" aria-label="Scroll on">
        <svg width="40" height="18" viewBox="0 0 44 20" aria-hidden="true">
          <path d="M2 9 C 14 11, 26 8, 40 10 M 32 3 L 41 10 L 32 17"></path>
        </svg>
      </button>
    </div>
  </div>

  <section class="rack" aria-label="Bookmarks" tabindex="0">
    {rows.map((row, ri) => (
      <div class="shelf">
        <div class="shelf-row">
          {row.albums.map((album) => (
            <div
              class="shiori"
              data-terrain={album.terrain.join(" ")}
              style={`--rot: ${album.rot}deg; --give: ${album.give}; --cap: ${album.cap}px`}
            >
              <a
                class="open"
                href={`/photos/${album.slug}/`}
                aria-label={`${album.title}, bookmark ${album.stampNum}`}
              />
              <svg class="cord" width="40" height="70" viewBox="0 0 40 70" aria-hidden="true">
                <path d={album.cord} />
                <path class="tassel" d={album.tassel} />
              </svg>
              <span class="hole" aria-hidden="true" />
              <svg
                class="art"
                viewBox="0 0 100 300"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
                data-art={shioriUrl(album.slug)}
              />
              <span class="stuck" style={`--tilt: ${album.tilt}deg`}>
                <Stamp
                  slug={album.slug}
                  terrain={album.terrain}
                  country={row.country}
                  num={album.stampNum}
                  size={56}
                />
              </span>
              <span class="margin">
                <span class="caps">{album.caps}</span>
                <span class="tags">
                  {album.terrain.map((t, i) => (
                    <Fragment>
                      {i > 0 && " · "}
                      <button type="button" class="tag" data-tag={t} aria-pressed="false">
                        {t}
                      </button>
                    </Fragment>
                  ))}
                </span>
                <span class="sign">
                  <span class="num">no. {album.stampNum}</span>
                  <span class="hand">sw.</span>
                </span>
              </span>
            </div>
          ))}
          {ri === rows.length - 1 && (
            <span
              class="shiori blank"
              style={`--rot: ${next.rot}deg; --give: ${next.give}; --cap: ${next.cap}px`}
            >
              <svg class="cord" width="40" height="70" viewBox="0 0 40 70" aria-hidden="true">
                <path d={next.cord} />
                <path class="tassel" d={next.tassel} />
              </svg>
              <span class="hole" aria-hidden="true" />
              <span class="art sketch">
                <svg viewBox="0 0 100 300" preserveAspectRatio="none" aria-hidden="true">
                  <path d={grid} vector-effect="non-scaling-stroke" />
                  <path class="subject" d={gables} vector-effect="non-scaling-stroke" />
                </svg>
                <span class="hand">next?</span>
              </span>
              <span class="margin">
                <span class="caps">{next.caps}</span>
                <span class="tags">[SUBJECT]</span>
                <span class="sign">
                  <span class="num">no. {next.num}</span>
                </span>
              </span>
            </span>
          )}
        </div>
        <p class="shelf-label hand">
          {row.country} <span>· {row.albums.length}</span>
        </p>
      </div>
    ))}
  </section>

  <p class="foot hand">bookmarks hang by date; the newest gets the highest number.</p>
</BaseLayout>

<script>
  import { fillArt } from "../../scripts/art";

  const rack = document.querySelector<HTMLElement>(".rack");
  const nav = document.querySelector<HTMLElement>(".rack-nav");
  if (rack && nav) {
    const [back, on] = nav.querySelectorAll<HTMLButtonElement>(".rack-step");

    const soak =
      !matchMedia("(prefers-reduced-motion: reduce)").matches &&
      !sessionStorage.getItem("shiori-soaked");
    sessionStorage.setItem("shiori-soaked", "1");

    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          seen.unobserve(e.target);
          fillArt(e.target as SVGSVGElement).then(() => {
            if (soak) e.target.classList.add("soak");
          });
        }
      },
      { root: rack, rootMargin: "0px 640px" },
    );
    rack.querySelectorAll<SVGSVGElement>("svg[data-art]").forEach((svg) => seen.observe(svg));

    // arrows and edge fades only while the shelf is wider than the page
    const ends = () => {
      const max = rack.scrollWidth - rack.clientWidth;
      nav.hidden = max < 2;
      back.disabled = rack.scrollLeft < 2;
      on.disabled = rack.scrollLeft > max - 2;
      rack.classList.toggle("more-back", !nav.hidden && !back.disabled);
      rack.classList.toggle("more-on", !nav.hidden && !on.disabled);
    };
    ends();
    rack.addEventListener("scroll", ends, { passive: true });
    new ResizeObserver(ends).observe(rack);

    const still = matchMedia("(prefers-reduced-motion: reduce)");
    for (const b of [back, on])
      b.addEventListener("click", () =>
        rack.scrollBy({
          left: Number(b.dataset.step) * rack.clientWidth * 0.8,
          behavior: still.matches ? "auto" : "smooth",
        }),
      );

    // moving the shelf leaves the bookmarks leaning behind
    if (!still.matches) {
      let last = rack.scrollLeft;
      let lastT = performance.now();
      let push = 0;
      let sway = 0;
      let vel = 0;
      let raf = 0;
      const step = () => {
        vel = (vel + (push - sway) * 0.08) * 0.86;
        sway += vel;
        push *= 0.85;
        const rest = Math.abs(sway) + Math.abs(vel) + Math.abs(push) < 0.01;
        rack.style.setProperty("--sway", rest ? "0deg" : `${sway.toFixed(3)}deg`);
        raf = rest ? 0 : requestAnimationFrame(step);
      };
      rack.addEventListener(
        "scroll",
        () => {
          const now = performance.now();
          const v = (rack.scrollLeft - last) / Math.max(8, now - lastT);
          last = rack.scrollLeft;
          lastT = now;
          push = Math.max(-4, Math.min(4, v * 2));
          raf ||= requestAnimationFrame(step);
        },
        { passive: true },
      );
    }

    // pull a bookmark up by its cord
    rack.addEventListener("pointerdown", (e) => {
      const cord = (e.target as Element).closest<SVGSVGElement>(".shiori:not(.blank) .cord");
      if (!cord) return;
      const mark = cord.closest<HTMLElement>(".shiori")!;
      const href = mark.querySelector<HTMLAnchorElement>(".open")!.href;
      e.preventDefault();
      cord.setPointerCapture(e.pointerId);
      mark.classList.add("pulling");
      const y0 = e.clientY;
      let pull = 0;
      let moved = 0;
      const move = (ev: PointerEvent) => {
        const d = Math.max(0, y0 - ev.clientY);
        moved = Math.max(moved, Math.abs(y0 - ev.clientY));
        pull = 90 * (1 - Math.exp(-d / 90));
        mark.style.setProperty("--pull", `${pull.toFixed(1)}px`);
      };
      const release = (ev: PointerEvent) => {
        cord.removeEventListener("pointermove", move);
        cord.removeEventListener("pointerup", release);
        cord.removeEventListener("pointercancel", release);
        mark.classList.remove("pulling");
        if (ev.type === "pointerup" && (pull > 60 || moved < 4)) {
          mark.classList.add("leaving");
          setTimeout(() => location.assign(href), still.matches ? 0 : 280);
        } else mark.style.removeProperty("--pull");
      };
      cord.addEventListener("pointermove", move);
      cord.addEventListener("pointerup", release);
      cord.addEventListener("pointercancel", release);
    });

    // coming back to the page puts it back in the rack
    addEventListener("pageshow", () => {
      for (const m of rack.querySelectorAll<HTMLElement>(".leaving")) {
        m.classList.remove("leaving");
        m.style.removeProperty("--pull");
      }
    });

    // empty bookmark keeps trying out the next place
    const subject = rack.querySelector<SVGPathElement>(".blank .subject");
    if (subject && !still.matches) {
      const ri = (a: number, b: number) => a + Math.random() * (b - a);
      const f = (n: number) => Math.round(n * 10) / 10;
      const sketches = [
        // row of houses
        () => {
          let d = "";
          for (let x = ri(4, 10); x < 86; ) {
            const w = ri(18, 28);
            const top = ri(130, 165);
            d += `M${f(x)} 210 V${f(top)} `;
            d +=
              Math.random() < 0.6
                ? `L${f(x + w / 2)} ${f(top - ri(10, 18))} L${f(x + w)} ${f(top)} `
                : `H${f(x + w)} `;
            d += "V210 ";
            x += w + ri(0, 4);
          }
          return d;
        },
        // ridge and its sun
        () => {
          let d = `M0 ${f(ri(170, 190))}`;
          for (let x = ri(8, 14); x < 100; x += ri(10, 18)) d += ` L${f(x)} ${f(ri(110, 190))}`;
          const cx = ri(20, 80);
          const cy = ri(55, 90);
          return `${d} L100 ${f(ri(150, 190))} M${f(cx - 7)} ${f(cy)} a7 7 0 1 0 14 0 a7 7 0 1 0 -14 0`;
        },
        // horizon, few waves and sail
        () => {
          const y = ri(150, 175);
          let d = `M0 ${f(y)} H100`;
          for (let i = 0; i < 4; i++)
            d += ` M${f(ri(6, 70))} ${f(y + ri(15, 90))} q4 -4 8 0 q4 -4 8 0`;
          const bx = ri(20, 70);
          return `${d} M${f(bx)} ${f(y - 2)} h14 l-3 5 h-8 z M${f(bx + 7)} ${f(y - 2)} V${f(y - 28)} L${f(bx + 17)} ${f(y - 6)}`;
        },
        // cliff with small white town
        () => {
          const e = ri(48, 62);
          let d = `M${f(e)} 300`;
          for (let y = 280; y > 130; y -= 15) d += ` L${f(e + ri(-6, 6))} ${y}`;
          d += ` L${f(e)} 130 H100`;
          for (let x = e + 2; x < 90; x += ri(9, 12))
            d += ` M${f(x)} 130 v-${f(ri(8, 15))} h${f(ri(6, 8))} V130`;
          return d;
        },
      ];

      let shown = false;
      new IntersectionObserver(([e]) => (shown = e.isIntersecting), { threshold: 0.3 }).observe(
        subject.closest(".shiori")!,
      );

      const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));
      (async () => {
        for (let k = 1; ; k = (k + 1) % sketches.length) {
          await pause(4000);
          while (!shown || document.hidden) await pause(500);
          await subject.animate([{ opacity: 0 }], { duration: 700, fill: "forwards" }).finished;
          subject.setAttribute("d", sketches[k]());
          subject.getAnimations().forEach((a) => a.cancel());
          await subject.animate(
            [{ clipPath: "inset(-5% 100% -5% -5%)" }, { clipPath: "inset(-5% -5% -5% -5%)" }],
            {
              duration: 2600,
              easing: "ease-in-out",
            },
          ).finished;
        }
      })();
    }

    // terrain tag sifts the shelf
    const sift = document.querySelector<HTMLButtonElement>(".sift")!;
    const marks = [...rack.querySelectorAll<HTMLElement>(".shiori[data-terrain]")];
    let only: string | null = null;
    const choose = (tag: string | null) => {
      only = tag === only ? null : tag;
      rack.toggleAttribute("data-sifting", only !== null);
      sift.hidden = only === null;
      sift.querySelector(".sift-tag")!.textContent = only ?? "";
      for (const b of rack.querySelectorAll<HTMLButtonElement>(".tag"))
        b.setAttribute("aria-pressed", String(b.dataset.tag === only));
      const hits = marks.filter((m) => {
        const hit = only !== null && m.dataset.terrain!.split(" ").includes(only);
        m.classList.toggle("match", hit);
        return hit;
      });
      hits[0]?.scrollIntoView({
        inline: "center",
        block: "nearest",
        behavior: still.matches ? "auto" : "smooth",
      });
    };
    rack.addEventListener("click", (e) => {
      const tag = (e.target as Element).closest<HTMLButtonElement>(".tag");
      if (tag) choose(tag.dataset.tag!);
    });
    sift.addEventListener("click", () => choose(null));
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && only !== null) choose(null);
    });
  }
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    font-weight: 300;
    font-size: 1.1875rem;
    color: var(--fg-dim);
    text-decoration: none;
  }

  .back path,
  .rack-step path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s;
  }

  .back:hover path {
    transform: translateX(-3px);
  }

  .klaser-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }

  .klaser-head > div {
    flex: 999 1 30rem;
    max-width: 40rem;
  }

  .klaser-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .tally {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .rack-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  .hint {
    margin: 0 0 0 0.375rem;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--fg-dim);
    transform: rotate(-1deg);
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-point {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  .sift {
    min-height: 44px;
    margin-left: auto;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--fg-dim);
    cursor: pointer;
  }

  .sift[hidden] {
    display: none;
  }

  .sift-tag {
    color: var(--red);
  }

  .sift:hover {
    color: var(--fg-main);
  }

  .rack-nav {
    display: flex;
    gap: 0.25rem;
  }

  .rack-nav[hidden] {
    display: none;
  }

  .rack-step {
    display: grid;
    place-items: center;
    width: 52px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .rack-step:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .rack-step[data-step="-1"]:not(:disabled):hover path {
    transform: translateX(-3px);
  }

  .rack-step[data-step="1"]:not(:disabled):hover path {
    transform: translateX(3px);
  }

  .rack {
    --w: 164px;
    --h: 560px;
    --gap: 18px;
    --fade: 0px;
    --fade-back: 0px;
    --fade-on: 0px;
    display: flex;
    align-items: flex-start;
    gap: 28px;
    margin: 0.25rem calc(var(--gutter) * -1) 0;
    padding: 150px var(--gutter) 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-back),
      #000 calc(100% - var(--fade-on)),
      transparent
    );
  }

  .rack.more-back {
    --fade-back: var(--gutter);
  }

  .rack.more-on {
    --fade-on: var(--gutter);
  }

  .rack:focus-visible {
    outline: 1.5px dashed var(--cursor);
    outline-offset: -4px;
  }

  .shelf {
    flex: none;
    display: flex;
    flex-direction: column;
  }

  .shelf-row {
    display: flex;
    align-items: flex-end;
    gap: var(--gap);
  }

  .shelf-label {
    margin: 14px 0 0;
    padding-top: 8px;
    border-top: 1.5px solid var(--border);
    font-size: 1.125rem;
  }

  .shelf-label span {
    font-weight: 300;
    font-size: 0.9375rem;
    color: var(--fg-dim);
  }

  .shiori {
    position: relative;
    flex: none;
    display: block;
    width: var(--w);
    height: var(--h);
    background: var(--paper);
    border-radius: 3px 3px 4px 4px;
    box-shadow:
      0 10px 14px -10px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(0, 0, 0, 0.05);
    color: var(--fg-main);
    scroll-snap-align: start;
    transform: rotate(var(--rot));
    transform-origin: 50% 100%;
    rotate: calc(var(--sway, 0deg) * var(--give));
    translate: 0 calc(var(--pull, 0px) * -1);
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1),
      translate 0.5s cubic-bezier(0.3, 1.5, 0.5, 1),
      box-shadow 0.4s ease,
      opacity 0.4s ease,
      filter 0.4s ease;
  }

  .shiori.pulling {
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 0.4s ease;
  }

  .shiori.leaving {
    translate: 0 calc(var(--pull, 0px) * -1 - 70px);
    opacity: 0;
    transition:
      translate 0.28s ease-in,
      opacity 0.28s ease-in;
  }

  .shiori:not(.blank):hover,
  .shiori:has(:focus-visible) {
    transform: translateY(-30px) rotate(var(--rot));
    box-shadow:
      0 30px 30px -18px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(0, 0, 0, 0.05);
  }

  .open {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .open:focus-visible {
    outline: 1.5px dashed var(--cursor);
    outline-offset: 4px;
  }

  .rack[data-sifting] .shiori:not(.match) {
    opacity: 0.3;
    filter: saturate(0.3);
  }

  .shiori:not(.blank) .cord {
    z-index: 2;
    cursor: grab;
    touch-action: none;
  }

  .shiori.pulling .cord {
    cursor: grabbing;
  }

  .cord {
    position: absolute;
    left: calc(50% - 20px);
    top: -56px;
    overflow: visible;
    rotate: calc(var(--sway, 0deg) * var(--give) * 1.8);
    transform-origin: 20px 64px;
  }

  .cord path {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .cord .tassel {
    stroke-width: 0.8;
    opacity: 0.85;
