---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { ID_LENGTH, MAX_CHARS } from "../utils/paste";
import { UNIT } from "../utils/paste-qr";

const SQUARE_TILTS = [-1.5, 0.8, -0.4, 1.2, -0.9];
const DECKLE =
  "M8 10 L120 4 L260 9 L410 3 L560 8 L700 2 L850 7 L992 4 L996 160 L990 330 L997 500 L991 680 L996 840 L993 994 L840 990 L690 996 L540 991 L380 997 L230 992 L90 996 L6 991 L9 820 L3 650 L8 480 L2 300 L7 140 Z";
const PAGE_SHADOW_OFFSET = "translate(5 9)";
const LOCK =
  "M8 11 V8.2 C 8 4.6, 16 4.6, 16 8.2 V11 M5.5 11.2 C 9 10.8, 15 11.3, 18.5 10.9 L 18.2 20 C 14 20.3, 10 19.8, 5.8 20.2 Z";
const ARROW =
  "M2 8 C 8 7.6, 16 8.4, 24 7.8 M18 3 C 20 5, 22 6.4, 24.5 7.8 C 22 9.4, 20 11, 18.4 13";
const PLACEHOLDER = [
  ";; This buffer is for text that is not saved, and for files",
  ";; that will not stay. To keep anything, open the link",
  ";; within a day; after that, it is garbage collected.",
].join("\n");
const TREMBLE_FREQUENCY = 0.9 / UNIT;
const TREMBLE_SCALE = 0.12 * UNIT;
const WASH_BLUR = 0.25 * UNIT;
const SHADOW_BLUR = 0.5 * UNIT;
const WASH_OFFSET = `translate(${0.32 * UNIT} ${0.42 * UNIT})`;
const SHADOW_OFFSET = `translate(${0.25 * UNIT} ${0.45 * UNIT})`;
---

<BaseLayout title="Paste" description="Text from one of my screens to another." noindex={true}>
  <header class="paste-head">
    <p class="crumb">paste · 原稿</p>
    <h1>Paste</h1>
    <p class="lede">
      Text from one of my screens to another. Five letters to type, one day to live.
    </p>
  </header>

  <Divider from={600} to={840} />

  <form class="sheet" data-form>
    <div class="page">
      <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
        <path d={DECKLE} class="page-shadow" transform={PAGE_SHADOW_OFFSET}></path>
        <path d={DECKLE} class="page-sheet"></path>
      </svg>
      <p class="page-head">
        <label for="paste-text" class="hand">
          text
        </label>
        <span class="count" aria-live="polite">
          <span data-count>0</span> / {MAX_CHARS.toLocaleString("fr-FR")}
        </span>
      </p>
      <textarea
        id="paste-text"
        name="text"
        maxlength={MAX_CHARS}
        rows="12"
        placeholder={PLACEHOLDER}
        spellcheck="false"
        autocomplete="off"
        required
        data-text
      ></textarea>
    </div>

    <div class="send-row">
      <label class="word">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={LOCK}></path>
        </svg>
        <span class="hand">password</span>
        <input type="password" name="word" autocomplete="current-password" required data-word />
      </label>
      <div class="send-group">
        <kbd class="hint">ctrl + enter</kbd>
        <button type="submit" class="send hand" data-send>
          seal &amp; send
          <svg viewBox="0 0 26 16" aria-hidden="true">
            <path d={ARROW}></path>
          </svg>
        </button>
      </div>
    </div>
    <p class="error" role="alert" data-error hidden></p>
  </form>

  <section class="sealed" aria-label="The link" data-sealed hidden>
    <div class="sealed-row">
      <div class="sealed-text">
        <p class="hand">sealed · on the other screen type</p>
        <div class="squares" aria-hidden="true">
          {Array.from({ length: ID_LENGTH }, (_, index) => (
            <span
              class="square"
              style={`--tilt: ${SQUARE_TILTS[index % SQUARE_TILTS.length]}deg`}
              data-square
            ></span>
          ))}
        </div>
        <p class="link">
          <a data-link></a>
        </p>
        <div class="actions hand">
          <button type="button" data-copy>
            copy the link
          </button>
          <a target="_blank" rel="noopener" data-open>
            open it ↗
          </a>
          <button type="button" data-again>
            another one
          </button>
        </div>
        <p class="sealed-meta" data-sealed-meta></p>
      </div>
      <figure class="qr">
        <svg role="img" data-qr>
          <defs>
            <filter id="qr-tremble" x="-5%" y="-5%" width="110%" height="110%">
              <feTurbulence
                type="fractalNoise"
                baseFrequency={TREMBLE_FREQUENCY}
                numOctaves="2"
                seed="4"
              />
              <feDisplacementMap in="SourceGraphic" scale={TREMBLE_SCALE} />
            </filter>
            <filter id="qr-wash" x="-5%" y="-5%" width="110%" height="110%">
              <feGaussianBlur stdDeviation={WASH_BLUR} />
            </filter>
            <filter id="qr-shadow" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation={SHADOW_BLUR} />
            </filter>
          </defs>
          <path class="qr-shadow" transform={SHADOW_OFFSET} data-qr-slip></path>
          <path class="qr-slip" data-qr-slip></path>
          <g class="qr-wash" transform={WASH_OFFSET}>
            <path data-qr-ink></path>
            <path fill-rule="evenodd" data-qr-finders></path>
          </g>
          <g class="qr-ink">
            <path data-qr-ink></path>
            <path fill-rule="evenodd" data-qr-finders></path>
          </g>
        </svg>
        <figcaption class="hand">or point the other screen's camera here</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/paste";
</script>

<style>
  .paste-head {
    margin-top: 6rem;
    max-width: 40rem;
  }

  .crumb {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-dim);
  }

  .paste-head h1 {
    margin: 1rem 0 0;
    font-weight: 300;
    line-height: 1.1;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .sheet,
  .sealed-text {
    max-width: 50rem;
  }

  .sealed-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .page {
    --sheet: light-dark(
      color-mix(in srgb, var(--bg-main) 45%, white),
      color-mix(in srgb, var(--bg-main) 90%, var(--fg-main))
    );
    --rule: light-dark(
      color-mix(in srgb, var(--sheet) 90%, var(--fg-main)),
      color-mix(in srgb, var(--sheet) 88%, var(--fg-main))
    );
    --line: 1.75rem;
    position: relative;
    padding: 2.125rem 2.75rem 1.875rem;
  }

  .page svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-shadow {
    fill: var(--fg-main);
    opacity: 0.14;
  }

  .page-sheet {
    fill: var(--sheet);
  }

  .page-head {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.375rem;
    padding-bottom: 0.625rem;
    border-bottom: 1.5px solid var(--red);
  }

  .page-head label {
    font-weight: 300;
    font-size: 1.0625rem;
    color: var(--fg-dim);
  }

  .page textarea {
    position: relative;
    display: block;
    width: 100%;
    min-height: 21.25rem;
    padding: 0;
    border: 0;
    background: repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(var(--line) - 1px),
        var(--rule) calc(var(--line) - 1px),
        var(--rule) var(--line)
      )
      local;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: var(--line);
    color: var(--fg-main);
    caret-color: var(--cursor);
    resize: vertical;
    outline: none;
  }

  .page textarea::placeholder {
    color: var(--fg-dim);
    opacity: 0.75;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .send-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    margin-top: 2.25rem;
  }

  .word {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1.5rem 0.75rem 1.125rem;
    border-radius: 2px 4px 3px 2px;
    background: var(--tape);
    box-shadow: 0 6px 14px -8px rgb(0 0 0 / 0.45);
    color: var(--fg-main);
  }

  .word svg {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .word .hand {
    font-size: 1.125rem;
  }

  .word input {
    width: 11.25rem;
    min-width: 0;
    padding: 0.25rem 0;
    border: 0;
    border-bottom: 1.5px dotted currentColor;
    background: none;
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: inherit;
    outline: none;
  }

  .word input:focus {
    border-bottom: 1.5px solid var(--cursor);
  }

  .send-group {
    display: flex;
    align-items: center;
    gap: 1.125rem;
  }

  .hint {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  /* no keyboard, no shortcut */
  @media (hover: none) {
    .hint {
      display: none;
    }
  }

  .send {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0 1.75rem;
    border: 2px solid currentColor;
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    background: none;
    font-size: 1.3125rem;
    color: var(--fg-main);
    transition: color 0.2s;
    cursor: pointer;
  }

  .send svg {
    width: 1.625rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .send:hover,
  .send:focus-visible {
    color: var(--cursor);
  }

  .send:hover svg,
  .send:focus-visible svg {
    transform: translateX(0.25rem);
  }

  .send:focus-visible {
    outline: 2px solid var(--cursor);
    outline-offset: 4px;
  }

  .send[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .error {
    margin: 1rem 0 0;
    color: var(--red);
  }

  .sealed .hand {
    margin: 0;
    font-size: 1.1875rem;
  }

  .squares {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }

  .square {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    border: 1px solid var(--border);
    border-radius: 2px 3px 2px 4px;
    transform: rotate(var(--tilt));
    --cross: color-mix(in srgb, var(--border) 45%, transparent);
    background:
      linear-gradient(var(--cross), var(--cross)) center / 1px 100% no-repeat,
      linear-gradient(var(--cross), var(--cross)) center / 100% 1px no-repeat;
    font-family: var(--font-mono);
    font-size: 3.5rem;
    color: var(--fg-main);
  }

  .link {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--fg-dim);
    word-break: break-all;
  }

  .link a {
    color: inherit;
    text-decoration: none;
  }

  .link :global(b) {
    font-weight: 400;
    color: var(--cursor);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    margin-top: 1.5rem;
    font-size: 1.1875rem;
  }

  .actions button,
  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--fg-link);
    text-decoration: none;
    cursor: pointer;
  }

  .qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
    margin: 0;
    --slip: light-dark(var(--paper), var(--fg-main));
    --qr-ink: light-dark(var(--fg-main), var(--bg-main));
  }

  .qr svg {
    display: block;
    width: 16.5rem;
    height: 16.5rem;
    overflow: visible;
    transform: rotate(-1.5deg);
  }

  .qr-shadow {
    fill: var(--fg-main);
    opacity: 0.18;
    filter: url(#qr-shadow);
  }

  .qr-slip {
    fill: var(--slip);
  }

  .qr-wash {
    fill: var(--red);
    opacity: 0.5;
    filter: url(#qr-wash);
  }

  .qr-ink {
    fill: var(--qr-ink);
    filter: url(#qr-tremble);
  }

  .qr .hand {
    font-size: 1.0625rem;
    color: var(--fg-dim);
    text-align: center;
  }

  .sealed-meta {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  @media (max-width: 40rem) {
    .page {
      padding: 1.5rem 1.125rem 1.375rem;
    }

    .page textarea {
      min-height: 16.25rem;
    }

    .word input {
      width: 6.875rem;
    }

    .squares {
      gap: 0.375rem;
    }

    .qr {
      margin: 0 auto;
    }

    .qr svg {
      width: 14.375rem;
      height: 14.375rem;
    }

    .square {
      width: 3.125rem;
      height: 3.125rem;
      font-size: 1.875rem;
    }
  }
</style>
