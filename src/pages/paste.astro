---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import Seal from "../components/Seal.astro";
import { ID_LENGTH, MAX_CHARS } from "../utils/paste";

const SQUARE_TILTS = [-1.5, 0.8, -0.4, 1.2, -0.9];
---

<BaseLayout title="Paste" description="Text from one of my screens to another." noindex={true}>
  <header class="paste-head">
    <p class="crumb">paste · 原稿</p>
    <h1>Paste</h1>
    <p class="lede">
      Text from one of my screens to another. Five letters to type, one day to live.
    </p>
  </header>

  <Divider from={600} to={840} />

  <form class="sheet" data-form>
    <label class="page">
      <span class="page-label hand">text</span>
      <textarea
        name="text"
        maxlength={MAX_CHARS}
        rows="14"
        spellcheck="false"
        autocomplete="off"
        required
        data-text
      ></textarea>
    </label>
    <p class="count" aria-live="polite">
      <span data-count>0</span> / {MAX_CHARS.toLocaleString("fr-FR")}
    </p>

    <div class="send-row">
      <label class="word">
        <span class="hand">the word</span>
        <input type="password" name="word" autocomplete="current-password" required data-word />
      </label>
      <button type="submit" class="seal-send hand" data-send>
        seal &amp; send
        <Seal glyph="送" size={52} tilt={-6} />
      </button>
    </div>
    <p class="error" role="alert" data-error hidden></p>
  </form>

  <section class="sealed" aria-label="The link" data-sealed hidden>
    <p class="hand">sealed · on the other screen type</p>
    <div class="squares" aria-hidden="true">
      {Array.from({ length: ID_LENGTH }, (_, index) => (
        <span
          class="square"
          style={`--tilt: ${SQUARE_TILTS[index % SQUARE_TILTS.length]}deg`}
          data-square
        ></span>
      ))}
      <Seal glyph="送" size={56} tilt={9} class="sealed-seal" />
    </div>
    <p class="link">
      <a data-link></a>
    </p>
    <div class="actions hand">
      <button type="button" data-copy>
        copy the link
      </button>
      <a target="_blank" rel="noopener" data-open>
        open it ↗
      </a>
      <button type="button" data-again>
        another one
      </button>
    </div>
    <p class="sealed-meta" data-sealed-meta></p>
  </section>
</BaseLayout>

<script>
  import "../scripts/paste";
</script>

<style>
  .paste-head {
    margin-top: 6rem;
    max-width: 40rem;
  }

  .crumb {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-dim);
  }

  .paste-head h1 {
    margin: 1rem 0 0;
    font-weight: 300;
    line-height: 1.1;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .sheet,
  .sealed {
    max-width: 50rem;
  }

  /* a notebook page: red margin, no box */
  .page {
    --margin: 3.5rem;
    position: relative;
    display: block;
    padding-left: var(--margin);
  }

  .page::before {
    content: "";
    position: absolute;
    left: calc(var(--margin) - 1rem);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--red);
    opacity: 0.6;
  }

  .page-label {
    position: absolute;
    left: 0;
    top: 0.125rem;
    font-size: 1rem;
    writing-mode: vertical-rl;
  }

  .page textarea {
    display: block;
    width: 100%;
    min-height: 23.75rem;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--fg-main);
    caret-color: var(--cursor);
    resize: vertical;
    outline: none;
  }

  .count {
    margin: 0.5rem 0 0;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .send-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 1.25rem 0 0 3.5rem;
    border-top: 1px dashed var(--border);
  }

  .word {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    flex: 1 1 15rem;
  }

  .word .hand {
    font-size: 1.125rem;
  }

  .word input {
    flex: 1;
    max-width: 15rem;
    min-height: 2.75rem;
    padding: 0.375rem 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: none;
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: var(--fg-main);
    outline: none;
  }

  .word input:focus {
    border-bottom-color: var(--cursor);
  }

  .seal-send {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 3.5rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: 1.25rem;
    color: var(--fg-main);
    cursor: pointer;
  }

  .seal-send :global(.seal) {
    transition: transform 0.2s;
  }

  .seal-send:hover :global(.seal),
  .seal-send:focus-visible :global(.seal) {
    transform: rotate(-12deg) scale(1.05) !important;
  }

  .seal-send[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .error {
    margin: 1rem 0 0 3.5rem;
    color: var(--red);
  }

  .sealed .hand {
    margin: 0;
    font-size: 1.1875rem;
  }

  .squares {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }

  .square {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    border: 1px solid var(--border);
    border-radius: 2px 3px 2px 4px;
    transform: rotate(var(--tilt));
    --cross: color-mix(in srgb, var(--border) 45%, transparent);
    background:
      linear-gradient(var(--cross), var(--cross)) center / 1px 100% no-repeat,
      linear-gradient(var(--cross), var(--cross)) center / 100% 1px no-repeat;
    font-family: var(--font-mono);
    font-size: 3.5rem;
    color: var(--fg-main);
  }

  .squares :global(.sealed-seal) {
    margin-left: 0.75rem;
    opacity: 0.9;
  }

  .link {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--fg-dim);
    word-break: break-all;
  }

  .link a {
    color: inherit;
    text-decoration: none;
  }

  .link :global(b) {
    font-weight: 400;
    color: var(--cursor);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    margin-top: 1.5rem;
    font-size: 1.1875rem;
  }

  .actions button,
  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--fg-link);
    text-decoration: none;
    cursor: pointer;
  }

  .sealed-meta {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  @media (max-width: 40rem) {
    .page {
      --margin: 1.125rem;
    }

    .page-label {
      display: none;
    }

    .send-row,
    .error {
      padding-left: 0;
      margin-left: 0;
    }

    .squares {
      gap: 0.375rem;
    }

    .square {
      width: 3.125rem;
      height: 3.125rem;
      font-size: 1.875rem;
    }
  }
</style>
