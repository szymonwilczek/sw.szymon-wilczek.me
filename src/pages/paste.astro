---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import Seal from "../components/Seal.astro";
import { ID_LENGTH, MAX_CHARS } from "../utils/paste";
import { UNIT } from "../utils/paste-qr";

const SQUARE_TILTS = [-1.5, 0.8, -0.4, 1.2, -0.9];
const TREMBLE_FREQUENCY = 0.9 / UNIT;
const TREMBLE_SCALE = 0.12 * UNIT;
const WASH_BLUR = 0.25 * UNIT;
const SHADOW_BLUR = 0.5 * UNIT;
const WASH_OFFSET = `translate(${0.32 * UNIT} ${0.42 * UNIT})`;
const SHADOW_OFFSET = `translate(${0.25 * UNIT} ${0.45 * UNIT})`;
---

<BaseLayout title="Paste" description="Text from one of my screens to another." noindex={true}>
  <header class="paste-head">
    <p class="crumb">paste · 原稿</p>
    <h1>Paste</h1>
    <p class="lede">
      Text from one of my screens to another. Five letters to type, one day to live.
    </p>
  </header>

  <Divider from={600} to={840} />

  <form class="sheet" data-form>
    <label class="page">
      <span class="page-label hand">text</span>
      <textarea
        name="text"
        maxlength={MAX_CHARS}
        rows="14"
        spellcheck="false"
        autocomplete="off"
        required
        data-text
      ></textarea>
    </label>
    <p class="count" aria-live="polite">
      <span data-count>0</span> / {MAX_CHARS.toLocaleString("fr-FR")}
    </p>

    <div class="send-row">
      <label class="word">
        <span class="hand">the word</span>
        <input type="password" name="word" autocomplete="current-password" required data-word />
      </label>
      <button type="submit" class="seal-send hand" data-send>
        seal &amp; send
        <Seal glyph="送" size={52} tilt={-6} />
      </button>
    </div>
    <p class="error" role="alert" data-error hidden></p>
  </form>

  <section class="sealed" aria-label="The link" data-sealed hidden>
    <div class="sealed-row">
      <div class="sealed-text">
        <p class="hand">sealed · on the other screen type</p>
        <div class="squares" aria-hidden="true">
          {Array.from({ length: ID_LENGTH }, (_, index) => (
            <span
              class="square"
              style={`--tilt: ${SQUARE_TILTS[index % SQUARE_TILTS.length]}deg`}
              data-square
            ></span>
          ))}
        </div>
        <p class="link">
          <a data-link></a>
        </p>
        <div class="actions hand">
          <button type="button" data-copy>
            copy the link
          </button>
          <a target="_blank" rel="noopener" data-open>
            open it ↗
          </a>
          <button type="button" data-again>
            another one
          </button>
        </div>
        <p class="sealed-meta" data-sealed-meta></p>
      </div>
      <figure class="qr">
        <svg role="img" data-qr>
          <defs>
            <filter id="qr-tremble" x="-5%" y="-5%" width="110%" height="110%">
              <feTurbulence
                type="fractalNoise"
                baseFrequency={TREMBLE_FREQUENCY}
                numOctaves="2"
                seed="4"
              />
              <feDisplacementMap in="SourceGraphic" scale={TREMBLE_SCALE} />
            </filter>
            <filter id="qr-wash" x="-5%" y="-5%" width="110%" height="110%">
              <feGaussianBlur stdDeviation={WASH_BLUR} />
            </filter>
            <filter id="qr-shadow" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation={SHADOW_BLUR} />
            </filter>
          </defs>
          <path class="qr-shadow" transform={SHADOW_OFFSET} data-qr-slip></path>
          <path class="qr-slip" data-qr-slip></path>
          <g class="qr-wash" transform={WASH_OFFSET}>
            <path data-qr-ink></path>
            <path fill-rule="evenodd" data-qr-finders></path>
          </g>
          <g class="qr-ink">
            <path data-qr-ink></path>
            <path fill-rule="evenodd" data-qr-finders></path>
          </g>
        </svg>
        <figcaption class="hand">or point the other screen's camera here</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/paste";
</script>

<style>
  .paste-head {
    margin-top: 6rem;
    max-width: 40rem;
  }

  .crumb {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-dim);
  }

  .paste-head h1 {
    margin: 1rem 0 0;
    font-weight: 300;
    line-height: 1.1;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .sheet,
  .sealed-text {
    max-width: 50rem;
  }

  .sealed-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  /* a notebook page: red margin, no box */
  .page {
    --margin: 3.5rem;
    position: relative;
    display: block;
    padding-left: var(--margin);
  }

  .page::before {
    content: "";
    position: absolute;
    left: calc(var(--margin) - 1rem);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--red);
    opacity: 0.6;
  }

  .page-label {
    position: absolute;
    left: 0;
    top: 0.125rem;
    font-size: 1rem;
    writing-mode: vertical-rl;
  }

  .page textarea {
    display: block;
    width: 100%;
    min-height: 23.75rem;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--fg-main);
    caret-color: var(--cursor);
    resize: vertical;
    outline: none;
  }

  .count {
    margin: 0.5rem 0 0;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .send-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 1.25rem 0 0 3.5rem;
    border-top: 1px dashed var(--border);
  }

  .word {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    flex: 1 1 15rem;
  }

  .word .hand {
    font-size: 1.125rem;
  }

  .word input {
    flex: 1;
    max-width: 15rem;
    min-height: 2.75rem;
    padding: 0.375rem 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: none;
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: var(--fg-main);
    outline: none;
  }

  .word input:focus {
    border-bottom-color: var(--cursor);
  }

  .seal-send {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 3.5rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: 1.25rem;
    color: var(--fg-main);
    cursor: pointer;
  }

  .seal-send :global(.seal) {
    transition: transform 0.2s;
  }

  .seal-send:hover :global(.seal),
  .seal-send:focus-visible :global(.seal) {
    transform: rotate(-12deg) scale(1.05) !important;
  }

  .seal-send[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .error {
    margin: 1rem 0 0 3.5rem;
    color: var(--red);
  }

  .sealed .hand {
    margin: 0;
    font-size: 1.1875rem;
  }

  .squares {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }

  .square {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    border: 1px solid var(--border);
    border-radius: 2px 3px 2px 4px;
    transform: rotate(var(--tilt));
    --cross: color-mix(in srgb, var(--border) 45%, transparent);
    background:
      linear-gradient(var(--cross), var(--cross)) center / 1px 100% no-repeat,
      linear-gradient(var(--cross), var(--cross)) center / 100% 1px no-repeat;
    font-family: var(--font-mono);
    font-size: 3.5rem;
    color: var(--fg-main);
  }

  .link {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--fg-dim);
    word-break: break-all;
  }

  .link a {
    color: inherit;
    text-decoration: none;
  }

  .link :global(b) {
    font-weight: 400;
    color: var(--cursor);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    margin-top: 1.5rem;
    font-size: 1.1875rem;
  }

  .actions button,
  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--fg-link);
    text-decoration: none;
    cursor: pointer;
  }

  .qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
    margin: 0;
    --slip: light-dark(var(--paper), var(--fg-main));
    --qr-ink: light-dark(var(--fg-main), var(--bg-main));
  }

  .qr svg {
    display: block;
    width: 16.5rem;
    height: 16.5rem;
    overflow: visible;
    transform: rotate(-1.5deg);
  }

  .qr-shadow {
    fill: var(--fg-main);
    opacity: 0.18;
    filter: url(#qr-shadow);
  }

  .qr-slip {
    fill: var(--slip);
  }

  .qr-wash {
    fill: var(--red);
    opacity: 0.5;
    filter: url(#qr-wash);
  }

  .qr-ink {
    fill: var(--qr-ink);
    filter: url(#qr-tremble);
  }

  .qr .hand {
    font-size: 1.0625rem;
    color: var(--fg-dim);
    text-align: center;
  }

  .sealed-meta {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  @media (max-width: 40rem) {
    .page {
      --margin: 1.125rem;
    }

    .page-label {
      display: none;
    }

    .send-row,
    .error {
      padding-left: 0;
      margin-left: 0;
    }

    .squares {
      gap: 0.375rem;
    }

    .qr {
      margin: 0 auto;
    }

    .qr svg {
      width: 14.375rem;
      height: 14.375rem;
    }

    .square {
      width: 3.125rem;
      height: 3.125rem;
      font-size: 1.875rem;
    }
  }
</style>
