---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import StillWater from "../components/StillWater.astro";
import Seal from "../components/Seal.astro";
---

<BaseLayout
  title="About"
  description="Szymon Wilczek: a computer science student, and a software architect by day."
  type="profile"
>
  <header class="about-head">
    <div>
      <h1>About me</h1>
      <p class="lede">Student, and a writer of long notes.</p>
    </div>
    <a class="say hand" href="/contact/">
      <Seal glyph="文" size={40} tilt={-6} />
      <span>
        <span class="say-title">
          contact &amp; key →
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M1 5 C 20 3, 45 6.5, 70 4 S 92 4.5, 99 3.4"
              vector-effect="non-scaling-stroke"
            ></path>
          </svg>
        </span>
        <span class="say-sub">mail, gpg, a postcard</span>
      </span>
    </a>
  </header>

  <Divider from={140} to={372} />

  <div class="sections">
    <section>
      <p class="num" aria-hidden="true">
        01
      </p>
      <div class="body">
        <h2>Who I am</h2>
        <p>
          I study computer science at the Silesian University of Technology in Gliwice, in the
          seventh semester of the engineering degree.
        </p>
        <p>
          Most of my day, nearly every day, is spent in code. These days most of it goes to LOTA, my
          project for Linux: it lives close to the kernel, and the work I used to do in the kernel
          itself carries on there. What made it upstream, is on the{" "}
          <a href="/research/">research page</a>.
        </p>
        <p>
          I would like to stay at the university after the degree, to teach and to do research on
          operating systems.
        </p>
      </div>
    </section>

    <section>
      <p class="num" aria-hidden="true">
        02
      </p>
      <div class="body">
        <h2>Work</h2>
        <p>
          By day I'm a software architect at FAMUR in Zabrze, where I build and supervise
          manufacturing execution systems (MES) for the mining industry.
        </p>
      </div>
    </section>
  </div>

  <StillWater />

  <Seal glyph="終" size={48} tilt={3} label="end" class="about-end" />
</BaseLayout>

<style>
  .about-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2rem 4rem;
  }

  .about-head > div {
    flex: 999 1 32.5rem;
    min-width: 0;
    max-width: 42.5rem;
  }

  .about-head h1 {
    margin: 0;
  }

  .lede {
    margin: 0.875rem 0 0;
    color: var(--fg-dim);
  }

  .say {
    flex: 1 1 14rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin: 0 0 0.5rem;
    color: var(--fg-main);
    text-decoration: none;
    transform: rotate(-2deg);
  }

  .say > span {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .say-title {
    position: relative;
    width: fit-content;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .say-title svg {
    position: absolute;
    left: -2px;
    bottom: -0.3rem;
    width: calc(100% + 4px);
    height: 0.5rem;
    overflow: visible;
  }

  .say-title path {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .say:hover .say-title path,
  .say:focus-visible .say-title path {
    opacity: 1;
  }

  .say-sub {
    font-size: 1.0625rem;
    font-weight: 300;
    color: var(--fg-dim);
  }

  .say:focus-visible {
    outline: 2px solid var(--cursor);
    outline-offset: 4px;
  }

  .clue {
    margin: 4rem 0 0;
    font-weight: 300;
    font-size: 1rem;
    color: var(--fg-dim);
    opacity: 0.7;
    transform: rotate(-1.5deg);
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 2.125rem;
  }

  section {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0 1.5rem;
  }

  .num {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-dim);
  }

  .body {
    min-width: 0;
    max-width: 42.5rem;
  }

  .body h2 {
    margin: 0 0 0.875rem;
  }

  .body p {
    margin: 0 0 1rem;
  }

  :global(.about-end) {
    margin: 5.5rem auto 0;
  }

  @media (max-width: 47.99em) {
    section {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0 0.75rem;
    }
  }
</style>
