---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import StillWater from "../components/StillWater.astro";
import Seal from "../components/Seal.astro";
---

<BaseLayout
  title="About"
  description="Szymon Wilczek: a computer science student in Gliwice, LOTA and the kernel, and a software architect by day."
  type="profile"
>
  <header class="about-head">
    <div>
      <h1>About me</h1>
      <p class="lede">Student, and a writer of long notes.</p>
    </div>
    <a class="say hand" href="/contact/">
      <Seal glyph="文" size={40} tilt={-6} />
      <span>
        <span class="say-title">
          contact &amp; key →
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M1 5 C 20 3, 45 6.5, 70 4 S 92 4.5, 99 3.4"
              vector-effect="non-scaling-stroke"
            ></path>
          </svg>
        </span>
        <span class="say-sub">mail, gpg, a postcard</span>
      </span>
    </a>
  </header>

  <Divider from={90} to={300} />

  <div class="sections">
    <section>
      <p class="num" aria-hidden="true">
        01
      </p>
      <div class="body">
        <h2>Who I am</h2>
        <p>
          I study computer science at the Silesian University of Technology in Gliwice, in the
          seventh semester of the engineering degree.
        </p>
        <p>
          Most of my day, nearly every day, is spent in code. These days most of it goes to LOTA, my
          attestation project for Linux: it lives close to the kernel, and the work I used to do in
          the kernel itself carries on there. What made it upstream, in Linux and in Git, is on the
          <a href="/research/">research page</a>.
        </p>
        <p>
          I would like to stay at the university after the degree, to teach and to do research on
          operating systems.
        </p>
      </div>
    </section>

    <section>
      <p class="num" aria-hidden="true">
        02
      </p>
      <div class="body">
        <h2>Work</h2>
        <p>
          By day I am a software architect at FAMUR in Zabrze, where industrial processes become
          software. Before that, two years of freelance web work, closed in January.
        </p>
      </div>
    </section>
  </div>

  <StillWater />

  <p class="clue hand">the wolf has ten strokes.</p>
  <Seal glyph="終" size={48} tilt={3} label="end" class="about-end" />
</BaseLayout>

<style>
  .about-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2rem 4rem;
  }

  .about-head > div {
    flex: 999 1 32.5rem;
    min-width: 0;
    max-width: 42.5rem;
  }

  .about-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    font-size: 1.4375rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.5;
    color: var(--fg-dim);
  }

  .say {
    flex: 1 1 14rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin: 0 0 0.5rem;
    color: var(--fg-main);
    text-decoration: none;
    transform: rotate(-2deg);
  }

  .say > span {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .say-title {
    position: relative;
    width: fit-content;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .say-title svg {
    position: absolute;
    left: -2px;
    bottom: -0.3rem;
    width: calc(100% + 4px);
    height: 0.5rem;
    overflow: visible;
  }

  .say-title path {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .say:hover .say-title path,
  .say:focus-visible .say-title path {
    opacity: 1;
  }

  .say-sub {
    font-size: 1.0625rem;
    font-weight: 300;
    color: var(--fg-dim);
  }

  .say:focus-visible {
    outline: 2px solid var(--cursor);
    outline-offset: 4px;
  }

  .clue {
    margin: 4rem 0 0;
    font-weight: 300;
    font-size: 1rem;
    color: var(--fg-dim);
    opacity: 0.7;
    transform: rotate(-1.5deg);
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 5.5rem;
  }

  section {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 3rem;
  }

  .num {
    flex: 0 0 7.5rem;
    margin: 0;
    font-size: 3.5rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    color: var(--cursor);
  }

  .body {
    flex: 999 1 32.5rem;
    min-width: 0;
    max-width: 42.5rem;
  }

  .body h2 {
    margin: 0 0 1.125rem;
    font-size: 1.875rem;
    line-height: 1.25;
  }

  .body p {
    margin: 0 0 1rem;
  }

  :global(.about-end) {
    margin: 5.5rem auto 0;
  }

  @media (max-width: 47.99em) {
    .lede {
      font-size: 1.25rem;
    }

    .sections {
      gap: 3.5rem;
    }

    .num {
      flex-basis: 100%;
      font-size: 2.25rem;
    }

    .body h2 {
      font-size: 1.5rem;
    }
  }
</style>
