---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import SearchFilter from "../../components/SearchFilter.astro";
import { getCollection } from "astro:content";
import { calculateReadingStats } from "../../utils/reading-time";
import { dottedDate, writingSlug } from "../../utils/format";

const writings = (await getCollection("writings")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const numbered = writings.map((post, i) => ({
  post,
  num: String(writings.length - i).padStart(2, "0"),
  minutes: calculateReadingStats(post.body).minutes,
}));

const years: Array<{ year: number; entries: typeof numbered }> = [];
for (const entry of numbered) {
  const year = entry.post.data.pubDate.getFullYear();
  let group = years.find((g) => g.year === year);
  if (!group) {
    group = { year, entries: [] };
    years.push(group);
  }
  group.entries.push(entry);
}

const tagCounts = new Map<string, number>();
for (const post of writings) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 9)
  .map(([tag]) => tag);
---

<BaseLayout
  title="Writings"
  description="Essays, manifestos, notes, and reflections on sovereign computing and hypermedia."
>
  <div class="index-head">
    <div class="index-intro">
      <h1>Writings</h1>
      <p>
        Technical notes, manifestos, with maybe some touch of philosophical reflections on software
        engineering and digital sovereignty.
      </p>
    </div>
    <SearchFilter
      label="Filter writings"
      targetSelector=".writing-row"
      containerSelector=".writings-years"
    />
  </div>

  <p class="tag-row">
    <button type="button" class="tag is-current" data-tag="">
      #all
    </button>
    {tags.map((tag) => (
      <button type="button" class="tag" data-tag={tag}>
        #{tag}
      </button>
    ))}
  </p>

  <Divider from={180} to={420} />

  <div class="writings-years">
    {years.map((group) => (
      <section class="year">
        <p class="year-label" aria-hidden="true">
          {group.year}
        </p>
        <ol class="writing-list">
          {group.entries.map(({ post, num, minutes }) => (
            <li
              class="writing-row"
              data-search={`${post.data.title} ${post.data.description ?? ""} ${post.data.tags.join(" ")} ${post.data.category}`}
            >
              <span class="writing-num" aria-hidden="true">
                {num}
              </span>
              <span class="writing-body">
                <a href={`/writings/${writingSlug(post.id)}/`} class="writing-title">
                  {post.data.title}
                </a>
                {post.data.description && <span class="writing-desc">{post.data.description}</span>}
                <span class="writing-meta">
                  <span>{dottedDate(post.data.pubDate)}</span>
                  <span>~{minutes} min</span>
                  {post.data.tags.length > 0 && (
                    <span class="writing-tags">{post.data.tags.slice(0, 3).join(" · ")}</span>
                  )}
                </span>
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  {writings.length === 0 ? (
    <p class="hand closing">nothing written yet.</p>
  ) : (
    <p class="hand closing">that’s all, for now</p>
  )}
  <p class="hand seeds-link">
    <a href="/seeds/">not written yet →</a>
  </p>
</BaseLayout>

<script>
  (function () {
    var box = document.querySelector<HTMLElement>(".search-filter-box");
    var input = box?.querySelector<HTMLInputElement>(".live-search-input");
    var buttons = document.querySelectorAll<HTMLButtonElement>(".tag-row .tag");
    if (!box || !input) return;

    function mark(query: string) {
      buttons.forEach(function (btn) {
        btn.classList.toggle("is-current", btn.dataset.tag === query);
      });
    }

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        input!.value = btn.dataset.tag ?? "";
        input!.dispatchEvent(new Event("input"));
      });
    });

    box.addEventListener("filter-change", function (e) {
      mark((e as CustomEvent).detail.query);
    });

    // hide years whose writings are all filtered out
    box.addEventListener("filter-change", function () {
      document.querySelectorAll<HTMLElement>(".year").forEach(function (year) {
        var rows = year.querySelectorAll<HTMLElement>(".writing-row");
        var any = Array.prototype.some.call(rows, function (row: HTMLElement) {
          return row.style.display !== "none";
        });
        year.style.display = any ? "" : "none";
      });
    });
  })();
</script>

<style>
  .index-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .index-intro {
    flex: 999 1 30rem;
    min-width: 0;
    max-width: 40rem;
  }

  .index-intro h1 {
    margin: 0;
  }

  .index-intro p {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.125rem;
    margin: 1.75rem 0 0;
  }

  .tag {
    min-height: 32px;
    padding: 0.375rem 0;
    border: 0;
    background: none;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .tag:hover {
    color: var(--fg-main);
  }

  .tag.is-current {
    color: var(--cursor);
  }

  .year {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 3rem;
    align-items: flex-start;
  }

  .year + .year {
    margin-top: 3.5rem;
  }

  .year-label {
    flex: 0 0 10rem;
    margin: 0;
    font-size: 5.5rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    color: var(--border);
  }

  .writing-list {
    flex: 999 1 35rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .writing-row {
    display: flex;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px dashed var(--border);
  }

  .writing-row:first-child {
    padding-top: 0.5rem;
  }

  .writing-num {
    flex: none;
    width: 4rem;
    font-size: 2.75rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    color: var(--cursor);
  }

  .writing-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .writing-title {
    font-size: 1.5rem;
    line-height: 1.25;
    color: var(--fg-main);
    text-decoration: none;
  }

  .writing-title:hover {
    color: var(--fg-link-hover);
  }

  .writing-desc {
    max-width: 38.75rem;
    color: var(--fg-dim);
  }

  .writing-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.125rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .writing-tags {
    color: var(--accent-0);
  }

  .closing {
    margin: 3rem 0 0;
    text-align: center;
    font-size: 1.1875rem;
    transform: rotate(-1deg);
  }

  .seeds-link {
    margin: 0.75rem 0 0;
    text-align: center;
    font-size: 1rem;
    transform: rotate(0.6deg);
  }

  .seeds-link a {
    color: var(--fg-dim);
  }

  @media (max-width: 47.99em) {
    .index-intro h1 {
      font-size: 2.75rem;
    }

    .tag-row {
      margin-top: 1.25rem;
    }

    .year-label {
      flex-basis: 100%;
      font-size: 3.5rem;
    }

    .writing-row {
      gap: 0.875rem;
      padding: 1.5rem 0;
    }

    .writing-num {
      width: 2.125rem;
      font-size: 1.75rem;
    }

    .writing-title {
      font-size: 1.25rem;
    }
  }
</style>
