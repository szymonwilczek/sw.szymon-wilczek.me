---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { renderContentEntry } from "../../utils/org";
import { calculateReadingStats } from "../../utils/reading-time";

export async function getStaticPaths() {
  const writings = await getCollection("writings");
  return writings.map((post) => ({
    params: { slug: post.id.replace(/\.(org|md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { slug } = Astro.params;
const { html, Content } = await renderContentEntry(post);
const stats = calculateReadingStats(post.body);
const rawLines = post.body ? post.body.split("\n").length : 0;
---

<BaseLayout title={post.data.title} description={post.data.description || post.data.title}>
  <article class="writing-article">
    <header class="writing-header">
      <div class="back-link">
        <a href="/writings/">&larr; All writings</a>
      </div>
      <h1>{post.data.title}</h1>
      <div class="writing-meta">
        <span>Published: <FormattedDate date={post.data.pubDate} /></span>
        <span>Reading Time: <code>{stats.text}</code></span>
        <span>Category: <code>{post.data.category}</code></span>
        {
          post.data.tags.length > 0 && (
            <span>
              Tags: <code class="tag-list">{post.data.tags.join(", ")}</code>
            </span>
          )
        }
      </div>
    </header>

    <div class="writing-content">
      {Content ? <Content /> : <div class="org-content" set:html={html} />}
    </div>

    <footer class="raw-source-container">
      <hr />
      <div class="raw-source-bar">
        <div class="raw-source-info">
          <span class="raw-label">Plain Text Source:</span>
          <code>{post.id}</code>
        </div>
        <div class="raw-source-actions">
          <button type="button" id="toggle-raw-btn" class="btn-action raw-action-btn"
            >View raw .org source</button
          >
          <a
            href={`/writings/${slug}.org`}
            class="btn-action raw-action-btn"
            target="_blank"
            rel="noopener">Open raw buffer</a
          >
          <a
            href={`/writings/${slug}.org`}
            download={`${slug}.org`}
            class="btn-action raw-action-btn">Download .org</a
          >
        </div>
      </div>

      <div id="raw-code-drawer" class="raw-code-drawer" style="display: none;">
        <div class="raw-drawer-header">
          <span>
            Buffer: <code>{post.id}</code> ({rawLines} lines &middot; {stats.words} words)
          </span>
          <button type="button" id="copy-raw-btn" class="btn-action raw-copy-btn"
            >Copy buffer</button
          >
        </div>
        <pre class="raw-code-pre"><code>{post.body}</code></pre>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  (function () {
    var toggleBtn = document.getElementById("toggle-raw-btn");
    var drawer = document.getElementById("raw-code-drawer");
    var copyBtn = document.getElementById("copy-raw-btn");

    if (toggleBtn && drawer) {
      toggleBtn.addEventListener("click", function () {
        var isOpen = drawer.style.display !== "none";
        drawer.style.display = isOpen ? "none" : "block";
        toggleBtn.textContent = isOpen ? "View raw .org source" : "Hide raw source";
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", function () {
        var pre = document.querySelector(".raw-code-pre code");
        if (pre) {
          navigator.clipboard.writeText(pre.textContent || "").then(function () {
            copyBtn.textContent = "Copied";
            setTimeout(function () {
              copyBtn.textContent = "Copy buffer";
            }, 2000);
          });
        }
      });
    }
  })();
</script>

<style>
  .writing-header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .back-link {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .writing-header h1 {
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .writing-meta {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.9rem;
    color: var(--fg-dim);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .writing-content {
    margin-top: 2.5rem;
    line-height: 1.85;
  }

  .raw-source-container {
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .raw-source-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .raw-source-info {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .raw-label {
    color: var(--fg-dim);
  }

  .raw-source-actions {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-action,
  .raw-action-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: 1px solid var(--border) !important;
    color: var(--fg-main) !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.84rem !important;
    font-weight: 500 !important;
    padding: 0.3rem 0.75rem !important;
    border-radius: 0 !important;
    cursor: pointer !important;
    text-decoration: none !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    transition:
      background-color 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease !important;
  }

  .btn-action:hover,
  .raw-action-btn:hover {
    background-color: var(--fg-main) !important;
    color: var(--bg-main) !important;
    border-color: var(--fg-main) !important;
  }

  .btn-action:active,
  .raw-action-btn:active {
    background-color: var(--fg-link) !important;
    color: var(--bg-main) !important;
    border-color: var(--fg-link) !important;
  }

  .raw-code-drawer {
    margin-top: 1.25rem;
    border: 1px solid var(--border);
    background-color: var(--bg-dim);
    border-radius: 2px;
  }

  .raw-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background-color: var(--bg-main);
    border-bottom: 1px solid var(--border);
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.82rem;
    color: var(--fg-dim);
  }

  .raw-copy-btn {
    background: transparent !important;
    border: none !important;
    color: var(--fg-link) !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.82rem !important;
    font-weight: 400 !important;
    padding: 0 !important;
    margin: 0 !important;
    cursor: pointer !important;
    text-decoration: underline !important;
    text-underline-offset: 3px !important;
    transition: color 0.15s ease !important;
  }

  .raw-copy-btn:hover {
    color: var(--fg-link-hover) !important;
    background: transparent !important;
  }

  .raw-code-pre {
    margin: 0 !important;
    padding: 1.25rem !important;
    background: transparent !important;
    border: none !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.88rem !important;
    line-height: 1.6 !important;
    overflow-x: auto !important;
    white-space: pre-wrap !important;
    word-break: break-word !important;
  }
</style>
