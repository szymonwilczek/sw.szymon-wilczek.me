---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { renderContentEntry } from '../../utils/org';

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map((post) => ({
    params: { slug: post.id.replace(/\.(org|md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { html, Content } = await renderContentEntry(post);
---

<BaseLayout title={post.data.title} description={post.data.description || post.data.title}>
  <article class="writing-article">
    <header class="writing-header">
      <div class="back-link">
        <a href="/writings">&larr; All writings</a>
      </div>
      <h1>{post.data.title}</h1>
      <div class="writing-meta">
        <span>Published: <FormattedDate date={post.data.pubDate} /></span>
        <span>Category: <code>{post.data.category}</code></span>
        {post.data.tags.length > 0 && (
          <span>Tags: <code class="tag-list">{post.data.tags.join(', ')}</code></span>
        )}
      </div>
    </header>

    <div class="writing-content">
      {Content ? <Content /> : <div class="org-content" set:html={html} />}
    </div>
  </article>
</BaseLayout>

<style>
  .writing-header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .back-link {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .writing-header h1 {
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .writing-meta {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.9rem;
    color: var(--fg-dim);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .writing-content {
    margin-top: 2.5rem;
    line-height: 1.85;
  }
</style>
