---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { YEARS, CV } from "../data/years";
import { stone } from "../utils/stones";

const OFF = [0, 46, 14, 58];
const steps = YEARS.map((y, i) => ({
  ...y,
  now: y.year === "now",
  cx: 70 + OFF[i % OFF.length],
  ink: stone(70 + OFF[i % OFF.length], 55, 1.9, y.moss, `path/${y.year}`),
}));
---

<BaseLayout
  title="The years so far"
  description="Stepping stones from the gate to here: where I studied, what I built, and what I work on now. The CV as a PDF, too."
>
  <header class="path-head">
    <div>
      <h1>The years so far</h1>
      <p class="lede">
        A few stones from the gate to here. Each is a year, and on it what began then. The older
        ones have grown a little moss.
      </p>
    </div>
    <a class="sheet" href={CV} download>
      <svg width="44" height="54" viewBox="0 0 44 54" aria-hidden="true">
        <path
          class="sheet-paper"
          d="M4 3 L30 2 L41 13 L40 51 L5 52 Z"
          filter="url(#ps-tremble)"
        ></path>
        <path class="sheet-line" d="M30 2 L30 13 L41 13"></path>
        <path class="sheet-rules" d="M10 22 H34 M10 28 H32 M10 34 H35 M10 40 H26"></path>
      </svg>
      <span>
        <span class="sheet-say">the whole of it on one sheet</span>
        <span class="sheet-file">CV · PDF ↓</span>
      </span>
    </a>
  </header>

  <Divider from={420} to={640} />

  <svg class="defs" aria-hidden="true" focusable="false">
    <filter id="ps-tremble" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="2" seed="7"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="1.6"></feDisplacementMap>
    </filter>
    <filter id="ps-wash" x="-15%" y="-15%" width="130%" height="130%">
      <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="3" seed="5"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="6"></feDisplacementMap>
      <feGaussianBlur stdDeviation="0.9"></feGaussianBlur>
    </filter>
  </svg>

  <ol class="path">
    {steps.map((y) => (
      <li class:list={["step", { now: y.now }]}>
        <h2 class="year">
          <svg class="stone" viewBox="0 0 200 110" role="img" aria-label={y.year}>
            <ellipse class="stone-shadow" {...y.ink.shadow} filter="url(#ps-wash)" />
            <path class="stone-body" d={y.ink.body} filter="url(#ps-wash)" />
            {y.ink.moss && (
              <path
                class="stone-moss"
                d={y.ink.moss}
                opacity={y.ink.mossOpacity}
                filter="url(#ps-wash)"
              />
            )}
            <path class="stone-line" d={y.ink.body} filter="url(#ps-tremble)" />
            {y.ink.tufts && <path class="stone-tufts" d={y.ink.tufts} />}
            <text class="stone-year" x={y.cx} y={y.now ? 62 : 61} text-anchor="middle">
              {y.year}
            </text>
          </svg>
        </h2>
        <div class="said">
          {y.steps.map((s) => (
            <p>
              {s.when && <span class="when">{s.when}</span>}
              <span class="what">{s.what}</span>
              <span class="why">{s.why}</span>
            </p>
          ))}
        </div>
      </li>
    ))}
  </ol>

  <p class="end">
    <a class="sheet" href={CV} download>
      <svg width="44" height="54" viewBox="0 0 44 54" aria-hidden="true">
        <path
          class="sheet-paper"
          d="M4 3 L30 2 L41 13 L40 51 L5 52 Z"
          filter="url(#ps-tremble)"
        ></path>
        <path class="sheet-line" d="M30 2 L30 13 L41 13"></path>
        <path class="sheet-rules" d="M10 22 H34 M10 28 H32 M10 34 H35 M10 40 H26"></path>
      </svg>
      <span>
        <span class="sheet-say">the whole of it on one sheet</span>
        <span class="sheet-file">CV · PDF ↓</span>
      </span>
    </a>
  </p>
</BaseLayout>

<style>
  .path-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }

  .path-head > div {
    flex: 999 1 30rem;
    max-width: 40rem;
  }

  .path-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  .sheet {
    display: inline-flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0.35rem 0.7rem 0.35rem 0.35rem;
    border-radius: var(--radius-soft);
    color: var(--fg-main);
    text-decoration: none;
  }

  .sheet:hover {
    background: color-mix(in oklab, var(--paper), transparent 30%);
  }

  .sheet:hover .sheet-say {
    color: var(--cursor);
  }

  .sheet > span {
    display: flex;
    flex-direction: column;
  }

  .sheet svg {
    flex: none;
    overflow: visible;
    transition: rotate 0.3s;
  }

  .sheet:hover svg {
    rotate: -4deg;
  }

  .sheet-paper {
    fill: var(--paper);
    stroke: var(--fg-main);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .sheet-line {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 1.1;
  }

  .sheet-rules {
    stroke: var(--fg-dim);
    stroke-width: 1;
  }

  .sheet-say {
    font-family: var(--font-hand);
    font-size: 1.2rem;
  }

  .sheet-file {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .path {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 12.5rem 1fr;
    column-gap: 1.75rem;
    padding: 0.4rem 0;
  }

  .stone {
    width: 12.5rem;
    height: auto;
    overflow: visible;
  }

  .stone-shadow {
    fill: var(--fg-main);
    opacity: 0.12;
  }

  .stone-body {
    fill: var(--bg-alt);
  }

  .stone-moss {
    fill: var(--leaf);
  }

  .stone-line {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .stone-tufts {
    fill: none;
    stroke: var(--green);
    stroke-width: 1.2;
    stroke-linecap: round;
    opacity: 0.85;
  }

  .year {
    grid-area: 1 / 1 / 3 / 2;
    margin: 0;
    line-height: 0;
  }

  .stone-year {
    font-family: var(--font-mono);
    font-size: 22px;
    fill: var(--fg-dim);
  }

  .now .stone-year {
    font-family: var(--font-hand);
    font-size: 28px;
    fill: var(--red);
  }

  .said {
    grid-area: 1 / 2 / 3 / 3;
    padding-top: 1.4rem;
  }

  .said p {
    max-width: 38rem;
    margin: 0 0 1rem;
  }

  .when,
  .what,
  .why {
    display: block;
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .what {
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .why {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--fg-dim);
  }

  .end {
    margin: 2rem 0 0;
  }

  @media (max-width: 40em) {
    .step {
      grid-template-columns: 1fr;
    }

    .said {
      grid-area: auto;
      padding-top: 0.25rem;
    }
  }
</style>
