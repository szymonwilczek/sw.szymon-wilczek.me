---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { tray } from "../utils/dogu";

const { edge, floor, grain, pieces } = tray();
const first = pieces[0];
---

<BaseLayout
  title="Uses"
  description="What I work with, laid out the way a host lays out utensils before tea."
>
  <header class="uses-head">
    <div>
      <h1>Tools on a tray</h1>
      <p class="lede">
        What I work with, laid out the way a host lays out utensils before tea. Each piece stands
        for one tool; its tag says which.
      </p>
    </div>
    <p class="tally">{pieces.length} pieces</p>
  </header>

  <Divider from={480} to={700} />

  <p class="hint hand">
    <span class="hint-point">point at a piece to lift it; its tag says what it stands for.</span>
    <span class="hint-touch">tap a piece to read its tag.</span>
  </p>

  <div class="dogu">
    <section aria-label="The tray">
      <svg
        class="tray"
        viewBox="0 0 1000 600"
        role="group"
        aria-label="Tea tray seen from above, every tool I use on it"
      >
        <defs>
          <filter id="dg-soft" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="9"></feGaussianBlur>
          </filter>
          <filter id="dg-wob">
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.035"
              numOctaves="2"
              seed="4"
            ></feTurbulence>
            <feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
          </filter>
          <radialGradient id="dg-glaze" cx="0.42" cy="0.38" r="0.7">
            <stop offset="0" style="stop-color: var(--glaze-in)"></stop>
            <stop offset="0.7" style="stop-color: var(--glaze)"></stop>
            <stop offset="1" style="stop-color: var(--glaze-edge)"></stop>
          </radialGradient>
          <radialGradient id="dg-lac" cx="0.35" cy="0.3" r="0.8">
            <stop offset="0" style="stop-color: var(--lac-hi)"></stop>
            <stop offset="0.5" style="stop-color: var(--lac)"></stop>
            <stop offset="1" style="stop-color: var(--lac-deep)"></stop>
          </radialGradient>
        </defs>
        <path
          class="tray-shadow"
          d={edge}
          filter="url(#dg-soft)"
          transform="translate(10 16)"
        ></path>
        <path class="tray-edge" d={edge}></path>
        <path class="tray-floor" d={floor}></path>
        <path class="tray-grain" d={grain}></path>

        {pieces.map((p) => (
          <g
            class="ut"
            tabindex="0"
            role="button"
            data-id={p.id}
            data-tag={`${p.tag.x} ${p.tag.y} ${p.tag.rot}`}
            data-name={p.name}
            data-as={p.as}
            aria-label={`${p.name}, ${p.as}`}
            aria-pressed={p.id === first.id ? "true" : "false"}
            transform={`translate(${p.x} ${p.y}) rotate(${p.rot})`}
          >
            <path class="sh" d={p.outline} filter="url(#dg-soft)"></path>
            <g class="lift">
              {p.parts.map((part) => (
                <path
                  d={part.d}
                  fill={part.fill}
                  stroke={part.stroke}
                  stroke-width={part.sw}
                  opacity={part.o}
                  filter={part.filter}
                ></path>
              ))}
            </g>
          </g>
        ))}

        <g class="tag" transform={`translate(${first.tag.x} ${first.tag.y})`} aria-hidden="true">
          <path class="tag-thread" d="M0 0 C 10 -14, 18 -26, 30 -34"></path>
          <g class="tag-card" transform={`translate(26 -96) rotate(${first.tag.rot})`}>
            <path d="M0 8 L 8 0 L 176 0 L 176 62 L 8 62 L 0 54 Z"></path>
            <circle cx="10" cy="31" r="3"></circle>
            <text class="tag-name" x="22" y="24">
              {first.name}
            </text>
            <text class="tag-as" x="22" y="46">
              {first.as}
            </text>
          </g>
        </g>
      </svg>
    </section>

    <aside aria-label="The list, plainly">
      <p class="list-head">THE LIST, PLAINLY</p>
      <ul class="list">
        {pieces.map((p) => (
          <li data-id={p.id} class:list={{ shown: p.id === first.id }}>
            <span class="kanji" aria-hidden="true">
              {p.kanji}
            </span>
            <span class="name">
              {p.name} <span class="as hand">· {p.as}</span>
            </span>
            <span class="why">{p.why}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</BaseLayout>

<script>
  const pieces = [...document.querySelectorAll<SVGGElement>(".ut")];
  const rows = [...document.querySelectorAll<HTMLLIElement>(".list li")];
  const tag = document.querySelector<SVGGElement>(".tag")!;
  const card = tag.querySelector<SVGGElement>(".tag-card")!;
  let chosen = pieces.find((p) => p.ariaPressed === "true")!;

  // tie the tag to a piece and mark its row in the list
  const show = (piece: SVGGElement) => {
    const [x, y, rot] = piece.dataset.tag!.split(" ");
    const { name, as } = piece.dataset;

    tag.setAttribute("transform", `translate(${x} ${y})`);
    card.setAttribute("transform", `translate(26 -96) rotate(${rot})`);

    tag.querySelector(".tag-name")!.textContent = name!;
    tag.querySelector(".tag-as")!.textContent = as!;

    // swing it in again
    tag.classList.remove("swing");
    void tag.getBoundingClientRect();
    tag.classList.add("swing");
    for (const row of rows) row.classList.toggle("shown", row.dataset.id === piece.dataset.id);
  };

  for (const piece of pieces) {
    piece.addEventListener("pointerenter", () => show(piece));
    piece.addEventListener("focus", () => show(piece));
    piece.addEventListener("pointerleave", () => show(chosen));
    piece.addEventListener("blur", () => show(chosen));
    const pick = () => {
      chosen = piece;
      for (const p of pieces) p.setAttribute("aria-pressed", String(p === piece));
      show(piece);
    };
    piece.addEventListener("click", pick);
    piece.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      e.preventDefault();
      pick();
    });
  }
</script>

<style>
  .uses-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }

  .uses-head > div {
    flex: 999 1 30rem;
    max-width: 40rem;
  }

  .uses-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .tally {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .hint {
    margin: 1rem 0 0 0.375rem;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--fg-dim);
    transform: rotate(-1deg);
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-point {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  .dogu {
    display: grid;
    grid-template-columns: 1fr 18.75rem;
    gap: 2.25rem;
    align-items: start;
    margin-top: 1rem;
  }

  @media (max-width: 760px) {
    .dogu {
      grid-template-columns: 1fr;
    }
  }

  .tray {
    --bamboo: color-mix(in oklab, var(--tape), var(--cursor) 32%);
    --bamboo-dk: color-mix(in oklab, var(--bamboo), var(--fg-main) 40%);
    --bamboo-pale: color-mix(in oklab, var(--bamboo), var(--paper) 40%);
    --bamboo-deep: color-mix(in oklab, var(--bamboo), var(--fg-main) 25%);
    --glaze: color-mix(in oklab, var(--sea), var(--fg-main) 35%);
    --glaze-in: color-mix(in oklab, var(--glaze), var(--paper) 35%);
    --glaze-edge: color-mix(in oklab, var(--glaze), var(--fg-main) 30%);
    --glaze-rim: color-mix(in oklab, var(--glaze), var(--paper) 40%);
    --glaze-pool: color-mix(in oklab, var(--glaze), var(--fg-main) 35%);
    --glaze-run: color-mix(in oklab, var(--glaze), var(--paper) 50%);
    --lac: color-mix(in oklab, var(--red-warmer), var(--fg-main) 50%);
    --lac-hi: color-mix(in oklab, var(--lac), var(--paper) 35%);
    --lac-deep: color-mix(in oklab, var(--lac), #000 30%);
    --bronze: color-mix(in oklab, var(--cursor), var(--fg-main) 35%);
    --bronze-deep: color-mix(in oklab, var(--cursor), var(--fg-main) 55%);
    --silk-dk: color-mix(in oklab, var(--red), var(--fg-main) 40%);
    --silk-fold: color-mix(in oklab, var(--red), var(--fg-main) 15%);
    --wood: color-mix(in oklab, var(--tape), var(--fg-main) 25%);
    --wood-floor: color-mix(in oklab, var(--tape), var(--fg-main) 12%);
    --wood-edge: color-mix(in oklab, var(--tape), var(--fg-main) 55%);
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .tray-shadow {
    fill: #000;
    opacity: 0.18;
  }

  .tray-edge {
    fill: var(--wood);
    stroke: var(--wood-edge);
    stroke-width: 2;
  }

  .tray-floor {
    fill: var(--wood-floor);
    stroke: var(--wood-edge);
    opacity: 0.9;
  }

  .tray-grain {
    fill: none;
    stroke: var(--wood-edge);
    stroke-width: 0.8;
    opacity: 0.35;
  }

  .ut {
    cursor: pointer;
    outline: none;
  }

  .ut path {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ut .sh {
    fill: #000;
    opacity: 0.22;
    transform: translate(6px, 9px);
  }

  .ut .lift,
  .ut .sh {
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1),
      opacity 0.45s ease;
  }

  .ut:hover .lift,
  .ut:focus-visible .lift {
    transform: translateY(-7px);
  }

  .ut:hover .sh,
  .ut:focus-visible .sh {
    opacity: 0.3;
    transform: translate(14px, 22px);
  }

  .ut:focus-visible .lift {
    outline: 2px solid var(--fg-main);
  }

  .tag {
    pointer-events: none;
  }

  .tag-thread {
    fill: none;
    stroke: var(--fg-dim);
  }

  .tag-card path {
    fill: var(--paper);
    stroke: var(--border);
    stroke-width: 0.8;
  }

  .tag-card circle {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.8;
  }

  .tag-name {
    font-family: var(--font-body);
    font-size: 17px;
    fill: var(--fg-main);
  }

  .tag-as {
    font-family: var(--font-hand);
    font-size: 14px;
    fill: var(--fg-dim);
  }

  .tag.swing .tag-card {
    animation: tag-in 0.35s ease both;
  }

  @keyframes tag-in {
    from {
      opacity: 0;
      translate: 0 -8px;
      rotate: -4deg;
    }
  }

  aside {
    padding-top: 0.625rem;
  }

  .list-head {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--fg-dim);
  }

  .list {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    display: grid;
    grid-template-columns: 2.125rem 1fr;
    gap: 2px 10px;
    padding: 10px 0.25rem;
    border-bottom: 1px dashed var(--border);
    transition: background 0.3s ease;
  }

  .list li.shown {
    background: color-mix(in oklab, var(--bg-main), var(--tape) 50%);
  }

  .kanji {
    grid-row: span 2;
    font-family: var(--font-seal);
    font-size: 1.25rem;
    color: var(--red);
  }

  .as {
    font-weight: 300;
    font-size: 0.875rem;
    color: var(--fg-dim);
  }

  .why {
    font-size: 0.875rem;
    color: var(--fg-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .ut .lift,
    .ut .sh,
    .list li {
      transition: none;
    }

    .tag.swing .tag-card {
      animation: none;
    }
  }
</style>
