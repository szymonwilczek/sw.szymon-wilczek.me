---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import InkButton from "../components/InkButton.astro";
import WaxSeal from "../components/WaxSeal.astro";
import Mizusho from "../components/Mizusho.astro";
import Hagaki from "../components/Hagaki.astro";
import fs from "node:fs";
import path from "node:path";

const gpgPath = path.join(process.cwd(), "public", "szymon-wilczek.asc");
let asciiArmoredKey = "";
try {
  asciiArmoredKey = fs.readFileSync(gpgPath, "utf-8");
} catch {
  asciiArmoredKey = "-----BEGIN PGP PUBLIC KEY BLOCK-----\n...\n-----END PGP PUBLIC KEY BLOCK-----";
}

const keyId = "B8E9 4407 1CB7 EB8A";
const fingerprint = "3EE5 3281 2DF0 F36A B7A1 F178 B8E9 4407 1CB7 EB8A";
const groups = fingerprint.split(" ");

const links = [
  { label: "github", url: "https://github.com/szymonwilczek" },
  {
    label: "this garden’s source",
    url: "https://github.com/szymonwilczek/sw.szymon-wilczek.me",
  },
];
---

<BaseLayout
  title="Contact"
  description="Verified communication endpoints, email, and cryptographic GPG public key."
>
  <header class="contact-head">
    <h1>Contact &amp; identity</h1>
    <p class="lede">
      The most reliable way to reach me is plain electronic mail. For sensitive correspondence,
      security disclosures, or identity verification, please encrypt your message with my public
      key. If you are writing about work, my CV lies along the
      <a href="/path/">stepping stones</a>, as a PDF too.
    </p>
  </header>

  <Divider from={60} to={260} />

  <div class="sections">
    <section>
      <p class="num" aria-hidden="true">
        01
      </p>
      <div class="body">
        <h2 class="hand">write to me</h2>
        <a href="mailto:swilczek.lx@gmail.com" class="mail">
          swilczek.lx@gmail.com
          <svg viewBox="0 0 100 14" preserveAspectRatio="none" aria-hidden="true">
            <path d="M1 8 C 20 5, 44 10, 66 7 S 92 6, 99 4"></path>
          </svg>
        </a>
        <p class="or hand">or turn over a postcard:</p>
        <Hagaki />
      </div>
    </section>

    <section>
      <p class="num" aria-hidden="true">
        02
      </p>
      <div class="body">
        <h2 class="hand">verify me</h2>
        <p class="note">All git commits and software releases are signed with the key below.</p>

        <div class="key paper">
          <span class="tape key-tape" aria-hidden="true"></span>
          <div class="key-id">
            <WaxSeal glyph="鍵" size={52} />
            <div>
              <span>Szymon Wilczek &lt;swilczek.lx@gmail.com&gt;</span>
              <span class="dim">
                RSA 4096 · key id <span class="accent">{keyId}</span>
              </span>
            </div>
          </div>

          <p class="fp-label hand">fingerprint</p>
          <p class="fp">
            {groups.map((group, i) => (
              <span class:list={{ accent: i >= 6 }}>{group}</span>
            ))}
          </p>

          <div class="key-actions">
            <InkButton quiet id="copy-fingerprint" data-fingerprint={fingerprint}>
              copy fingerprint
            </InkButton>
            <InkButton quiet href="/szymon-wilczek.asc" download="szymon-wilczek.asc">
              download .asc
            </InkButton>
            <InkButton quiet id="toggle-key" aria-expanded="false" aria-controls="armored-key">
              view public key
            </InkButton>
          </div>

          <div id="armored-key" class="armored" hidden>
            <pre><code>{asciiArmoredKey}</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section>
      <p class="num" aria-hidden="true">
        03
      </p>
      <div class="body">
        <h2 class="hand">elsewhere</h2>
        <ul class="links">
          {links.map((link) => (
            <li>
              <span>{link.label}</span>
              <a href={link.url} rel="noopener">
                {link.url.replace("https://", "")}
              </a>
            </li>
          ))}
        </ul>
        <p class="threads">
          Sites I keep going back to hang on <a href="/links/">red threads</a>.
        </p>
      </div>
    </section>
  </div>

  <Mizusho />
</BaseLayout>

<script>
  import { earn } from "../utils/garden";

  document
    .querySelectorAll('a[href^="mailto:"]')
    .forEach((anchor) => anchor.addEventListener("click", () => earn("文")));

  const copy = document.getElementById("copy-fingerprint");
  copy?.addEventListener("click", () => {
    navigator.clipboard.writeText(copy.dataset.fingerprint || "").then(() => {
      const label = copy.lastChild!;
      const before = label.textContent;
      label.textContent = " copied ";
      setTimeout(() => (label.textContent = before), 2000);
    });
  });

  const toggle = document.getElementById("toggle-key");
  const key = document.getElementById("armored-key");
  toggle?.addEventListener("click", () => {
    if (!key) return;
    key.hidden = !key.hidden;
    toggle.setAttribute("aria-expanded", String(!key.hidden));
    toggle.lastChild!.textContent = key.hidden ? " view public key " : " hide public key ";
  });
</script>

<style>
  .contact-head {
    max-width: 45rem;
  }

  .contact-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  section {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 3rem;
  }

  .num {
    flex: 0 0 6rem;
    margin: 0;
    font-size: 3rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    color: var(--cursor);
  }

  .body {
    flex: 999 1 35rem;
    min-width: 0;
  }

  .body h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--fg-dim);
  }

  .mail {
    position: relative;
    display: inline-block;
    margin-top: 0.375rem;
    font-size: 2.75rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1.2;
    word-break: break-all;
    color: var(--fg-main);
    text-decoration: none;
  }

  .mail:hover,
  .mail:visited {
    color: var(--fg-main);
  }

  .mail svg {
    position: absolute;
    left: -2%;
    bottom: -10px;
    width: 104%;
    height: 14px;
  }

  .or {
    margin: 2.5rem 0 0;
    font-size: 1.25rem;
    color: var(--fg-dim);
  }

  .mail path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 2.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .note {
    max-width: 38.75rem;
    margin: 0.375rem 0 0;
  }

  .key {
    position: relative;
    margin-top: 1.75rem;
    padding: 2.125rem 2.5rem 1.875rem;
    border-radius: 3px 6px 4px 7px;
    transform: rotate(-0.4deg);
  }

  .key-tape {
    top: -10px;
    right: 3rem;
    width: 84px;
    height: 22px;
    transform: rotate(4deg);
  }

  .key-id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .key-id div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .dim {
    color: var(--fg-dim);
  }

  .accent {
    color: var(--cursor);
  }

  .fp-label {
    margin: 1.625rem 0 0.5rem;
    font-size: 1.0625rem;
  }

  .fp {
    display: grid;
    grid-template-columns: repeat(5, auto);
    justify-content: start;
    gap: 0.375rem 1.375rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  .key-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.375rem;
    margin-top: 1.875rem;
  }

  .armored {
    margin-top: 1.5rem;
  }

  .armored :global(.code-block-wrapper),
  .armored pre {
    margin: 0;
  }

  .armored pre {
    max-height: 21.25rem;
    background: var(--bg-main);
    font-size: 0.75rem;
  }

  .links {
    margin: 0.625rem 0 0;
    padding: 0;
    list-style: none;
  }

  .threads {
    margin: 1rem 0 0;
    color: var(--fg-dim);
  }

  .links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 1.25rem;
    margin: 0;
    padding: 0.875rem 0;
    border-bottom: 1px dashed var(--border);
  }

  .links span {
    flex: 0 0 8.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .links a {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 47.99em) {
    .sections {
      gap: 3.5rem;
    }

    .num {
      flex-basis: 100%;
      font-size: 2rem;
    }

    .mail {
      font-size: 1.6875rem;
    }

    .key {
      padding: 1.625rem 1.25rem 1.5rem;
    }

    .fp {
      grid-template-columns: repeat(2, auto);
      font-size: 1.1875rem;
    }

    .links span {
      flex-basis: 100%;
    }
  }
</style>
