---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<BaseLayout title="Szymon Wilczek">
  <section class="intro">
    <p>
      Hello. I am <strong>Szymon Wilczek</strong>. I am a software engineer,
      systems enthusiast, and free software (FOSS) advocate.
    </p>
    <p>
      This website serves as my personal, sovereign hypermedia space - a central
      repository for my software projects that didn't make to portfolio,
      tools, file archives, photography, and technical reflections on computing
      and engineering.
    </p>
  </section>

  <hr />

  <section class="section-block">
    <h2>Current Status</h2>
    <p>
      Currently focused on developing bespoke developer tooling, investigating
      low-level systems architecture, refining GNU Emacs workflows,
      and producing open technical documentation.
    </p>
  </section>

  {projects.length > 0 && (
    <section class="section-block">
      <h2>Featured Projects</h2>
      <ul class="project-list">
        {projects.map((project) => (
          <li>
            <a href={`/projects/${project.id}`}>{project.data.title}</a>
            {' — '}
            <span class="project-desc">{project.data.description}</span>
          </li>
        ))}
      </ul>
      <p>
        <a href="/projects">&rarr; View all projects</a>
      </p>
    </section>
  )}

  <section class="section-block">
    <h2>Index & Navigation</h2>
    <ul>
      <li><a href="/about">About</a> - biographical notes, engineering principles, and computing philosophy.</li>
      <li><a href="/projects">Projects</a> - bespoke tools, editors, and utilities with full design rationales.</li>
      <li><a href="/files">Files</a> - downloadable packages, software archives, and scripts with SHA-256 sums.</li>
      <li><a href="/photos">Photos</a> - curated photograph gallery rendered in warm autumnal tones.</li>
      <li><a href="/contact">Contact</a> - verified communication channels, email, and cryptographic PGP key.</li>
      <li><a href="/credits">Credits</a> - formal attributions and open tooling.</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 2rem;
  }

  .section-block {
    margin-top: 2.75rem;
  }

  .project-list {
    list-style-type: square;
    padding-left: 2rem;
  }

  .project-desc {
    color: var(--fg-dim);
  }
</style>
