---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import Karesansui from "../components/Karesansui.astro";
import NowPaper from "../components/NowPaper.astro";
import { getCollection } from "astro:content";
import { getAllAlbums } from "../utils/albums";
import { dottedDate, writingSlug } from "../utils/format";

const posts = (await getCollection("writings"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const albums = (await getAllAlbums()).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const files = await getCollection("files");

// with no files to list the sidebar shows second album
const lensAlbums = albums.slice(0, files.length > 0 ? 1 : 2);
const recentFiles = files.slice(0, 3);
---

<BaseLayout
  title="Szymon Wilczek"
  description="Essays on low-level computing and the philosophy of software, notes written in plain Org, files worth downloading, and photographs from places I walked through."
>
  <section class="hero">
    <div class="hero-text">
      <h1>
        Hello. I am <em>Szymon</em>,<br />
        and this is where I keep things.
      </h1>
      <p>
        Essays on low-level computing and the philosophy of software, notes written in plain Org,
        files worth downloading, and photographs from places I walked through. Nothing here is
        finished.
      </p>
      <p class="enso-hint hand">the garden is round?</p>
    </div>

    <NowPaper />
  </section>

  <Divider from={300} to={540} />

  <div class="home-grid">
    <section class="writings">
      <div class="section-head">
        <h2>Writings</h2>
        <a href="/writings/" class="hand-link">
          all of them →
        </a>
      </div>
      <ol class="post-list">
        {posts.map((post) => (
          <li>
            <span class="post-date">{dottedDate(post.data.pubDate)}</span>
            <span class="post-body">
              <a href={`/writings/${writingSlug(post.id)}/`} class="post-title">
                {post.data.title}
              </a>
              {post.data.description && <span class="post-desc">{post.data.description}</span>}
              {post.data.tags.length > 0 && (
                <span class="post-tags">{post.data.tags.slice(0, 3).join(" · ")}</span>
              )}
            </span>
          </li>
        ))}
      </ol>
    </section>

    <aside class="side">
      {lensAlbums.length > 0 && (
        <section>
          <h2>Lately, through a lens</h2>
          {lensAlbums.map((album) => (
            <figure class="lens">
              <a href={`/photos/${album.slug}/`}>
                <img
                  src={album.coverThumb}
                  alt={`${album.title}, ${album.dateFormatted}`}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption class="hand">
                {album.title}, {album.dateFormatted}
              </figcaption>
            </figure>
          ))}
        </section>
      )}

      {recentFiles.length > 0 && (
        <section>
          <h2>Files</h2>
          <ul class="file-list">
            {recentFiles.map((file) => (
              <li>
                <a href="/files/">{file.data.filename}</a>
                <span>{file.data.filesize}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>

  <Karesansui />
</BaseLayout>

<script>
  import "../scripts/enso";
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    align-items: flex-start;
    justify-content: space-between;
    margin-top: 1rem;
  }

  .hero-text {
    flex: 999 1 32.5rem;
    min-width: 0;
    max-width: 42.5rem;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.375rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .hero h1 em {
    font-weight: 400;
  }

  .hero p {
    max-width: 35rem;
    margin: 1rem 0 0;
    color: var(--fg-dim);
  }

  .hero p:first-of-type {
    margin-top: 1.75rem;
  }

  .hero p a {
    color: var(--fg-link);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .enso-hint {
    margin: 2rem 0 0;
    font-weight: 300;
    font-size: 1rem;
    color: var(--fg-dim);
    opacity: 0.55;
    transform: rotate(-1deg);
  }

  .hero :global(.enso-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .hero :global(.enso-stroke) {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.8;
    transition: opacity 0.9s ease;
  }

  .hero :global(.enso-stroke.is-fading) {
    opacity: 0;
  }

  .hero :global(.enso-stroke.is-kept) {
    stroke: var(--red);
    opacity: 0.85;
  }

  .hero :global(.enso-trail) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.6;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
    animation: enso-walk 1.2s ease-out both;
  }

  .hero :global(.enso-link) {
    position: absolute;
    z-index: 1;
    font-size: 1.125rem;
    white-space: nowrap;
    animation: enso-arrive 0.4s 1s ease-out both;
  }

  @keyframes enso-walk {
    from {
      stroke-dashoffset: 200;
      opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes enso-arrive {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.enso-stroke) {
      transition: none;
    }

    .hero :global(:is(.enso-trail, .enso-link)) {
      animation: none;
    }
  }

  .home-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
  }

  .home-grid h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-weight: 400;
  }

  .writings {
    flex: 999 1 35rem;
    min-width: 0;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .writings h2 {
    font-size: 1.75rem;
  }

  .hand-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-hand);
    font-size: 1.125rem;
    color: var(--fg-link);
    text-decoration: none;
  }

  .post-list {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .post-list li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.375rem 0;
    border-top: 1px dashed var(--border);
  }

  .post-date {
    padding-top: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-dim);
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .post-title {
    font-size: 1.3125rem;
    line-height: 1.3;
    color: var(--fg-main);
    text-decoration: none;
  }

  .post-title:hover {
    color: var(--fg-link-hover);
  }

  .post-desc {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--fg-dim);
  }

  .post-tags {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-0);
  }

  .side {
    flex: 1 1 17.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .side h2 {
    font-size: 1.375rem;
  }

  .lens {
    margin: 1.25rem 0 0;
  }

  .lens + .lens {
    margin-top: 2rem;
  }

  .lens img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: var(--radius-soft);
    filter: saturate(0.85);
  }

  .lens figcaption {
    margin-top: 0.625rem;
    font-size: 1.125rem;
  }

  .file-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .file-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .file-list span {
    color: var(--fg-dim);
  }

  @media (max-width: 47.99em) {
    .hero {
      gap: 2.5rem;
    }

    .writings h2 {
      font-size: 1.5rem;
    }

    .post-list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.375rem;
    }

    .post-date {
      padding-top: 0;
    }

    .post-title {
      font-size: 1.25rem;
    }
  }
</style>
