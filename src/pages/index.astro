---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { getCollection } from "astro:content";
import { CV } from "../data/years";
import { writingSlug } from "../utils/format";
import { dayMonthYear, patches } from "../utils/research";

const LEDGER_LENGTH = 9;

const essays = (await getCollection("writings")).map((post) => ({
  kind: "essay",
  date: post.data.pubDate,
  title: post.data.title,
  href: `/writings/${writingSlug(post.id)}/`,
}));
const merged = patches.map((patch) => ({
  kind: "patch",
  date: patch.authored,
  title: patch.subject,
  href: `/research/${patch.short}/`,
}));
const recent = [...essays, ...merged]
  .sort((former, latter) => latter.date.valueOf() - former.date.valueOf())
  .slice(0, LEDGER_LENGTH);
---

<BaseLayout
  title="Szymon Wilczek"
  description="Szymon Wilczek, a Computer Science student: open-source patches, essays, and some touch of philosophy."
>
  <section class="hero">
    <h1>Szymon Wilczek</h1>
    <p>
      B.Sc. Eng. student, Computer Science
      <br />
      Faculty of Automatic Control, Electronics and Computer Science
      <br />
      Silesian University of Technology, Gliwice
    </p>
  </section>

  <Divider from={300} to={540} />

  <div class="home-grid">
    <aside class="side">
      <dl>
        <dt>cv</dt>
        <dd>
          <a href={CV}>{CV.split("/").pop()}</a>
        </dd>
        <dt>code</dt>
        <dd>
          <a href="https://github.com/szymonwilczek">github.com/szymonwilczek</a>
        </dd>
        <dt>mail</dt>
        <dd>
          <a href="/contact/">contact &amp; gpg key</a>
        </dd>
      </dl>
      <p class="interests">
        I work on operating systems and the Linux kernel, filesystems, platform security (TPM,
        eBPF), and GNU Emacs.
      </p>
    </aside>

    <section>
      <p class="ledger-label">recent · newest first</p>
      <ul class="ledger">
        {recent.map((entry) => (
          <li class={entry.kind}>
            <span class="date">{dayMonthYear(entry.date)}</span>
            <span class="kind">{entry.kind}</span>
            <a href={entry.href}>{entry.title}</a>
          </li>
        ))}
      </ul>
      <p class="more">
        <a href="/research/">research →</a>
        <a href="/writings/">writings →</a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import "../scripts/enso";
</script>

<style>
  .hero {
    position: relative;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.875rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
  }

  .hero p {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    color: var(--fg-dim);
  }

  .hero :global(.enso-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .hero :global(.enso-stroke) {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.8;
    transition: opacity 0.9s ease;
  }

  .hero :global(.enso-stroke.is-fading) {
    opacity: 0;
  }

  .hero :global(.enso-stroke.is-kept) {
    stroke: var(--red);
    opacity: 0.85;
  }

  .hero :global(.enso-trail) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.6;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
    animation: enso-walk 1.2s ease-out both;
  }

  .hero :global(.enso-link) {
    position: absolute;
    z-index: 1;
    font-size: 1.125rem;
    white-space: nowrap;
    animation: enso-arrive 0.4s 1s ease-out both;
  }

  @keyframes enso-walk {
    from {
      stroke-dashoffset: 200;
      opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes enso-arrive {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.enso-stroke) {
      transition: none;
    }

    .hero :global(:is(.enso-trail, .enso-link)) {
      animation: none;
    }
  }

  .home-grid {
    display: grid;
    grid-template-columns: 18.75rem minmax(0, 1fr);
    gap: 3.5rem;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.375rem 0.875rem;
    align-items: baseline;
    margin: 0;
    font-size: 0.9375rem;
  }

  dt,
  .ledger-label,
  .date,
  .kind {
    font-family: var(--font-mono);
    color: var(--fg-dim);
  }

  dt {
    font-size: 0.6875rem;
    line-height: inherit;
  }

  dd {
    margin: 0;
  }

  .side a,
  .more a {
    text-underline-offset: 4px;
  }

  .interests {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--fg-dim);
  }

  .ledger-label {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .ledger {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .ledger li {
    display: grid;
    grid-template-columns: 6.875rem 4rem minmax(0, 1fr);
    gap: 0.125rem 1.125rem;
    align-items: baseline;
    padding: 0.6875rem 0;
    border-bottom: 1px dashed var(--border);
  }

  .date {
    font-size: 0.75rem;
  }

  .kind {
    font-size: 0.6875rem;
  }

  .ledger a {
    color: var(--fg-main);
    text-decoration: none;
  }

  .ledger a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .essay .kind {
    color: var(--fg-link);
  }

  .essay a {
    font-size: 1.0625rem;
  }

  .patch .kind {
    color: var(--red);
  }

  .patch a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .more {
    display: flex;
    gap: 1.5rem;
    margin: 1rem 0 0;
    font-size: 0.9375rem;
  }

  @media (max-width: 47.99em) {
    .home-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .ledger li {
      grid-template-columns: auto auto;
      justify-content: start;
    }

    .ledger a {
      grid-column: 1 / -1;
    }
  }
</style>
