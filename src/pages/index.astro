---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Szymon Wilczek"
  description="Software engineer, open-source creator, and systems explorer. Central archive for software projects, developer utilities, photography, and plain-text technical writings."
>
  <section class="intro">
    <p>
      Hello. I am <strong>Szymon Wilczek</strong>.
    </p>
    <p>
      This website is my sovereign hypermedia space: a central archive for my software projects,
      custom developer utilities, downloadable files, writings, photography, and plain-text essays.
    </p>
  </section>

  <hr />

  {
    projects.length > 0 && (
      <section class="section-block">
        <h2>Featured Projects</h2>
        <ul class="project-list">
          {projects.map((project) => (
            <li>
              <a href={`/projects/${project.id.replace(/\.(org|md|mdx)$/, "")}/`}>
                {project.data.title}
              </a>
              {" — "}
              <span class="project-desc">{project.data.description}</span>
            </li>
          ))}
        </ul>
        <p>
          <a href="/projects/">&rarr; View all projects</a>
        </p>
      </section>
    )
  }

  <section class="section-block">
    <h2>Navigation</h2>
    <ul>
      <li>
        <a href="/about/">About</a> - biographical context and open-source contributions.
      </li>
      <li>
        <a href="/writings/">Writings</a> - thoughts, essays on low-level computing, and systems design.
      </li>
      <li>
        <a href="/projects/">Projects</a> - tools, typefaces, and utilities.
      </li>
      <li>
        <a href="/files/">Files</a> - downloadable software packages, scripts and archives.
      </li>
      <li>
        <a href="/photos/">Photos</a> - photograph gallery (I sometimes take a photo).
      </li>
      <li>
        <a href="/contact/">Contact</a> - communication channels, web links, and PGP key.
      </li>
      <li>
        <a href="/credits/">Credits</a> - attributions, typography, and licenses.
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 2rem;
  }

  .section-block {
    margin-top: 2.75rem;
  }

  .project-list {
    list-style-type: square;
    padding-left: 2rem;
  }

  .project-desc {
    color: var(--fg-dim);
  }
</style>
