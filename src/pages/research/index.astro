---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Pill from "../../components/Pill.astro";
import { dayMonthYear, projects } from "../../utils/research";

const names = projects.map((project) => project.repo).join(", ");
---

<BaseLayout
  title="Research & upstream work"
  description={`Patches merged upstream into ${names}, each with its message and its diff.`}
>
  <header class="page-head">
    <h1>Research &amp; upstream work</h1>
    <p class="lede">
      Patches I wrote that were merged upstream, read straight from each project&rsquo;s history,
      and the issues I opened there that were resolved.
    </p>
  </header>

  <div class="sections">
    {projects.map((project) => (
      <section id={project.id}>
        <h2>{project.repo}</h2>
        <ul class="patches">
          {project.patches.map((patch) => (
            <li class="patch">
              <span class="date">{dayMonthYear(patch.authored)}</span>
              <div class="entry">
                <p class="subject">
                  {patch.area && <Pill>{patch.area}</Pill>}
                  <span class="title">{patch.title}</span>
                </p>
                <p class="meta">
                  <span class="sha">{patch.pull ? `#${patch.pull}` : patch.short}</span> · merged by{" "}
                  {patch.by}, {dayMonthYear(patch.merged)}
                  {patch.bot && (
                    <>
                      {" "}
                      · <span class="bot">{patch.bot}</span>
                    </>
                  )}
                </p>
              </div>
              <a
                class="view"
                href={`/research/${patch.short}/`}
                aria-label={`view patch: ${patch.subject}`}
              >
                view patch →
              </a>
            </li>
          ))}
          {project.issues.map((issue) => (
            <li class="patch">
              <span class="date">{dayMonthYear(issue.opened)}</span>
              <div class="entry">
                <p class="subject">
                  <Pill>issue</Pill>
                  <span class="title">{issue.title}</span>
                </p>
                <p class="meta">
                  <span class="sha">#{issue.number}</span> · resolved by {issue.by},{" "}
                  {dayMonthYear(issue.closed)}
                </p>
              </div>
              <a class="view" href={issue.url} aria-label={`view issue: ${issue.title}`}>
                view issue →
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {/* coming: talks, papers, the engineering thesis */}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--border);
  }

  .lede {
    max-width: 40rem;
    margin: 0.875rem 0 0;
    color: var(--fg-dim);
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    max-width: 58.75rem;
    margin-top: 2.75rem;
  }

  h2 {
    margin: 0 0 0.875rem;
  }

  .patches {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .patch {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 8.125rem;
    gap: 0.125rem 1.375rem;
    align-items: baseline;
    padding: 0.875rem 0;
    border-bottom: 1px dashed var(--border);
  }

  .date,
  .sha {
    font-family: var(--font-mono);
    color: var(--fg-dim);
  }

  .date {
    font-size: 0.75rem;
  }

  .entry {
    min-width: 0;
  }

  .subject {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
    align-items: baseline;
    margin: 0;
  }

  .title {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .meta {
    margin: 0.375rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--fg-dim);
  }

  .sha {
    font-size: 0.8125rem;
  }

  .bot {
    color: var(--red);
  }

  .view {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  @media (max-width: 47.99em) {
    .patch {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .date {
      grid-row: 1;
      grid-column: 2;
      white-space: nowrap;
    }

    .entry {
      display: contents;
    }

    .subject {
      display: contents;
    }

    .subject :global(.pill) {
      grid-row: 1;
      grid-column: 1;
      justify-self: start;
      margin-bottom: 0.5rem;
    }

    .title,
    .meta {
      grid-column: 1 / -1;
    }

    .view {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
