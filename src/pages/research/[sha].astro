---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Pill from "../../components/Pill.astro";
import { threads } from "../../data/threads";
import {
  botName,
  dayMonthYear,
  githubUrl,
  hostOf,
  name,
  patches,
  pullUrl,
  rawPatchUrl,
  repoUrl,
  reports,
  threadUrl,
  type Patch,
  type Trailer,
} from "../../utils/research";

export function getStaticPaths() {
  return patches.map((patch, i) => ({
    params: { sha: patch.short },
    props: { patch, newer: patches[i - 1], older: patches[i + 1] },
  }));
}

interface Props {
  patch: Patch;
  newer?: Patch;
  older?: Patch;
}

const { patch, newer, older } = Astro.props;

const PEBBLES_PER_FILE = 8;
const PEBBLES_TOTAL = 12;
const BLOBS = [
  "48% 52% 45% 55% / 55% 45% 52% 48%",
  "55% 45% 50% 50% / 45% 55% 48% 52%",
  "45% 55% 52% 48% / 50% 50% 55% 45%",
];

const MERGER = "maintainer · merged it";

const FENCE = /```[^\n]*\n([\s\S]*?)\n?```/g;
const CODE = /`([^`\n]+)`/g;
const BOLD = /\*\*(?!\s)([^*\n]+?)(?<!\s)\*\*/g;
const STARRED = /(^|[^\w*])\*(?!\s)([^*\n]+?)(?<!\s)\*(?![\w*])/g;
const UNDERSCORED = /(^|[^\w])_(?!\s)([^_\n]+?)(?<!\s)_(?!\w)/g;
const KEPT = /\u0000(\d+)\u0000/g;

function escaped(text: string): string {
  return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

// a comment in the little Markdown people write in one
function commentHtml(text: string): string {
  const kept: string[] = [];
  const keep = (html: string) => `\u0000${kept.push(html) - 1}\u0000`;
  return escaped(text.replace(/\r\n/g, "\n"))
    .replace(FENCE, (_, code) => keep(`<pre><code>${code}</code></pre>`))
    .replace(CODE, (_, code) => keep(`<code>${code}</code>`))
    .replace(BOLD, "<strong>$1</strong>")
    .replace(STARRED, "$1<em>$2</em>")
    .replace(UNDERSCORED, "$1<em>$2</em>")
    .replace(KEPT, (_, index) => kept[Number(index)]);
}

function signer(trailer: Trailer): { who: string; role: string; mono?: boolean } | undefined {
  if (trailer.key === "Fixes")
    return { who: trailer.value.split(" (")[0], role: "the commit it fixes", mono: true };
  if (!trailer.key.endsWith("-by")) return undefined;
  const who = trailer.value.includes(" <") ? name(trailer) : botName(trailer);
  if (trailer.key === "Signed-off-by") {
    if (who === patch.author) return { who, role: "author" };
    if (who === patch.by) return { who, role: MERGER };
    return { who, role: "signed it" };
  }
  return { who, role: `${trailer.key.slice(0, -"-by".length).toLowerCase()} it` };
}

// a pull request carries no trailers
const signed = patch.trailers.flatMap((trailer) => {
  const row = signer(trailer);
  return row ? [{ key: trailer.key, ...row }] : [];
});
const signers = [
  ...(signed.some((row) => row.who === patch.author)
    ? []
    : [{ key: "Author", who: patch.author, role: "author", mono: false }]),
  ...signed,
  ...(signed.some((row) => row.who === patch.by)
    ? []
    : [{ key: "Merged-by", who: patch.by, role: MERGER, mono: false }]),
];

const blocks = patch.prose.split(/\n{2,}/).map((text) => {
  const lines = text.split("\n");
  const typed =
    lines.every((line) => /^\s{2,}/.test(line)) || /^\d+\./.test(text) || /:\n\d+\./.test(text);
  return typed ? { typed, text } : { typed, text: lines.join(" ") };
});

function lineKind(line: string): string {
  if (line.startsWith("@@")) return "hunk";
  if (line.startsWith("+")) return "add";
  if (line.startsWith("-")) return "del";
  return "context";
}

function pebbles(additions: number, deletions: number, count: number) {
  const total = Math.max(additions + deletions, 1);
  const shown = Math.min(count, total);
  const adds = Math.round((shown * additions) / total);
  return Array.from({ length: shown }, (_, i) => ({
    add: i < adds,
    blob: BLOBS[i % BLOBS.length],
  }));
}

const lastSegment = (path: string) => path.split("/").at(-1)!;
function statName(path: string) {
  const segments = path.split("/");
  const shared =
    patch.files.filter((file) => lastSegment(file.name) === segments.at(-1)).length > 1;
  const name = segments.slice(shared ? -2 : -1).join("/");
  const dot = name.lastIndexOf(".");
  return dot > name.lastIndexOf("/") + 1
    ? { stem: name.slice(0, dot), extension: name.slice(dot) }
    : { stem: name, extension: "" };
}

const thread = threads[patch.short];
const versions = thread?.versions ?? [];
const discussed = threadUrl(patch, versions[0]?.url);
const pull = pullUrl(patch);
const elsewhere = [
  ...(discussed && discussed !== pull ? [{ href: discussed, text: hostOf(discussed) }] : []),
  ...reports(patch).map((href) => ({ href, text: `report · ${hostOf(href)}` })),
  ...(pull ? [{ href: pull, text: `pull request #${patch.pull}` }] : []),
  { href: rawPatchUrl(patch), text: "raw .patch" },
];
const mergedVersion = versions.at(-1);
const earlier = versions.slice(0, -1);
const patchTag =
  mergedVersion && earlier.length > 0 ? `[PATCH ${mergedVersion.version}]` : "[PATCH]";
const INITIALS_LENGTH = 2;
const initials = (who: string) =>
  who
    .split(" ")
    .map((word) => word[0])
    .join("")
    .slice(0, INITIALS_LENGTH);

const lagText =
  patch.lag === 0 ? "the same day" : `${patch.lag} ${patch.lag === 1 ? "day" : "days"} later`;
---

<BaseLayout
  title={patch.title}
  description={`${patch.subject} · merged into ${patch.repo} by ${patch.by}.`}
  breadcrumbs={[
    { name: "Research", url: "/research/" },
    { name: patch.title, url: `/research/${patch.short}/` },
  ]}
>
  <header class="patch-head">
    <p class="crumbs">
      <a href="/research/">research</a> / {patch.repo} / {patch.area && `${patch.area} / `}
      {patch.short}
    </p>
    <div class="title-row">
      <h1>{patch.title}</h1>
      <Pill href={repoUrl(patch.repo)} label={`${patch.repo} on GitHub`}>
        {patch.repo}
      </Pill>
    </div>
    <p class="tags">
      {patch.area && <Pill>{patch.area}</Pill>}
      <span class="counts">
        <span class="plus">+{patch.additions}</span> <span class="minus">−{patch.deletions}</span>
      </span>
      {patch.bot && <Pill tone="red">{patch.bot}</Pill>}
    </p>
  </header>

  {earlier.length > 0 && mergedVersion && (
    <div class="versions">
      <span class="label">versions</span>
      <div role="tablist" aria-label="Patch versions" data-versions>
        {versions.map((version) => {
          const shown = version === mergedVersion;
          return (
            <button
              type="button"
              role="tab"
              id={`tab-${version.version}`}
              aria-controls={`version-${version.version}`}
              aria-selected={shown ? "true" : "false"}
              tabindex={shown ? 0 : -1}
            >
              {version.version} · {version.sent}
              {shown && " · merged"}
            </button>
          );
        })}
      </div>
      <p class="versions-note">
        showing <span data-version-shown>{mergedVersion.version}, the version that was merged</span>{" "}
        · the message and the diff below change with the tab
      </p>
    </div>
  )}

  <div class="patch-grid">
    <article class="patch">
      {earlier.map((version) => (
        <div
          class="version"
          role="tabpanel"
          id={`version-${version.version}`}
          aria-labelledby={`tab-${version.version}`}
          data-shown-as={`${version.version}, as sent to the list`}
          hidden
        >
          <p class="mail">
            <span>From:</span> {patch.author} &lt;{patch.email}&gt;
            <br />
            <span>Date:</span> {version.sent}
            <br />
            <span>Subject:</span> [PATCH {version.version}] {patch.subject}
          </p>
          {version.message && <pre class="sent">{version.message}</pre>}
          {version.diff && (
            <section class="block">
              <p class="label">diff</p>
              <pre class="sent">{version.diff}</pre>
            </section>
          )}
          <a class="view" href={version.url}>
            this version on {hostOf(version.url)} →
          </a>
        </div>
      ))}
      <div
        class="version"
        role={mergedVersion && earlier.length > 0 ? "tabpanel" : undefined}
        id={mergedVersion && `version-${mergedVersion.version}`}
        aria-labelledby={
          mergedVersion && earlier.length > 0 ? `tab-${mergedVersion.version}` : undefined
        }
        data-shown-as={mergedVersion && `${mergedVersion.version}, the version that was merged`}
      >
        <p class="mail">
          <span>From:</span> {patch.author} &lt;{patch.email}&gt;
          <br />
          <span>Date:</span> {dayMonthYear(patch.authored)}
          <br />
          <span>Subject:</span> {pull ? patch.subject : `${patchTag} ${patch.subject}`}
          <br />
          {pull && (
            <>
              <span>Pull request:</span> #{patch.pull}
              <br />
            </>
          )}
          <span>Merged:</span> {dayMonthYear(patch.merged)}, by {patch.by}
        </p>

        {patch.html ? (
          <div class="message" set:html={patch.html} />
        ) : (
          <div class="message">
            {blocks.map((block) => (block.typed ? <pre>{block.text}</pre> : <p>{block.text}</p>))}
          </div>
        )}

        <section class="block">
          <p class="label">signed, reported, fixes</p>
          <ul class="signers">
            {signers.map((row) => (
              <li>
                <span class="key">{row.key}</span>
                <span>
                  <span class:list={["who", { mono: row.mono }]}>{row.who}</span>
                  <span class="role">{row.role}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>

        <section class="block">
          <p class="label">diff</p>
          {patch.files.map((file) => (
            <figure class="diff">
              <figcaption>
                {file.name}{" "}
                <span class="counts">
                  <span class="plus">+{file.additions}</span>{" "}
                  <span class="minus">−{file.deletions}</span>
                </span>
              </figcaption>
              <pre><code>{file.patch.split("\n").map((line) => (
              <span class:list={["line", lineKind(line)]}>{line || " "}</span>
            ))}</code></pre>
            </figure>
          ))}
        </section>
      </div>

      {thread && thread.messages.length > 0 && (
        <section class="block discussion">
          <p class="label">discussion · {pull ? "on the pull request" : "on the list"}</p>
          {versions.map((version) => {
            const said = thread.messages.filter((message) => message.version === version.version);
            return (
              said.length > 0 && (
                <>
                  <p class="label root">
                    {version.version} · {said.length} {said.length === 1 ? "message" : "messages"}
                  </p>
                  {said.map((message) => (
                    <div
                      class:list={["reply", { nested: message.depth > 0 }]}
                      style={`--depth: ${message.depth}`}
                    >
                      <article class:list={["said", message.kind]}>
                        {message.kind === "applied" && <span class="stamp">applied</span>}
                        <p class="said-head">
                          <span
                            class:list={["badge", { mine: message.role === "author" }]}
                            aria-hidden="true"
                          >
                            {initials(message.who)}
                          </span>
                          <span class="said-who">{message.who}</span>
                          <span class="said-role">{message.role}</span>
                          <span class="said-date">{message.date}</span>
                        </p>
                        {message.subject && <p class="said-subject">{message.subject}</p>}
                        {message.text && (
                          <div class="said-text" set:html={commentHtml(message.text)} />
                        )}
                      </article>
                    </div>
                  ))}
                </>
              )
            );
          })}
          {discussed && (
            <a class="view" href={discussed}>
              the whole thread on {hostOf(discussed)}
            </a>
          )}
        </section>
      )}

      <nav class="ends" aria-label="Other patches">
        {newer ? <a href={`/research/${newer.short}/`}>← newer: {newer.subject}</a> : <span />}
        {older && <a href={`/research/${older.short}/`}>older: {older.subject} →</a>}
      </nav>
    </article>

    <aside class="side">
      <div>
        <p class="label">commit</p>
        <p class="sha">{patch.short}</p>
        <p class="repo">
          <Pill href={repoUrl(patch.repo)} label={`${patch.repo} on GitHub`}>
            {patch.repo}
          </Pill>
        </p>
        <a class="view" href={githubUrl(patch)}>
          {hostOf(githubUrl(patch))} →
        </a>
      </div>

      <div>
        <p class="label">dates</p>
        <p class="dates">
          written {dayMonthYear(patch.authored)}
          <br />
          merged {dayMonthYear(patch.merged)}
          <br />
          <span class="dim">
            by {patch.by}, {lagText}
          </span>
        </p>
      </div>

      <div class="stat">
        <p class="label">diffstat</p>
        <ul>
          {patch.files.map((file) => (
            <li>
              <span class="file" title={file.name}>
                <span class="stem">{statName(file.name).stem}</span>
                <span>{statName(file.name).extension}</span>
              </span>
              <span class="dim">{file.additions + file.deletions}</span>
              <span class="pebbles" aria-hidden="true">
                {pebbles(file.additions, file.deletions, PEBBLES_PER_FILE).map((pebble) => (
                  <span class:list={{ add: pebble.add }} style={`border-radius: ${pebble.blob}`} />
                ))}
              </span>
            </li>
          ))}
        </ul>
        <p class="total">
          {patch.files.length} {patch.files.length === 1 ? "file" : "files"} ·{" "}
          <span class="plus">+{patch.additions}</span> <span class="minus">−{patch.deletions}</span>
          <span class="pebbles" aria-hidden="true">
            {pebbles(patch.additions, patch.deletions, PEBBLES_TOTAL).map((pebble) => (
              <span class:list={{ add: pebble.add }} style={`border-radius: ${pebble.blob}`} />
            ))}
          </span>
        </p>
      </div>

      <div>
        <p class="label">elsewhere</p>
        <p class="elsewhere">
          {elsewhere.map((link) => (
            <a href={link.href}>{link.text}</a>
          ))}
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import { earn } from "../../utils/garden";

  const lastLine = [...document.querySelectorAll(".diff .line")].at(-1);
  if (lastLine) {
    const seen = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      seen.disconnect();
      earn("修");
    });
    seen.observe(lastLine);
  }

  // a stem too long for the diffstat column is cut to three plain dots
  const DOTS = "...";
  const stems = [...document.querySelectorAll<HTMLElement>(".stat .stem")];
  const fit = () => {
    for (const stem of stems) {
      const full = (stem.dataset.full ??= stem.textContent ?? "");
      stem.textContent = full;
      if (stem.scrollWidth <= stem.clientWidth) continue;
      const fits = Math.floor((stem.clientWidth * full.length) / stem.scrollWidth);
      stem.textContent = full.slice(0, Math.max(fits - DOTS.length, 1)) + DOTS;
    }
  };
  const statList = document.querySelector(".stat ul");
  if (statList) new ResizeObserver(fit).observe(statList);

  // the version tabs: the merged one shows first, the others on a click
  for (const list of document.querySelectorAll<HTMLElement>("[data-versions]")) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const note = document.querySelector("[data-version-shown]");
    const show = (chosen: HTMLButtonElement) => {
      for (const tab of tabs) {
        const on = tab === chosen;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !on;
        if (on && note && panel) note.textContent = panel.dataset.shownAs ?? "";
      }
    };
    list.addEventListener("click", (event) => {
      const tab = (event.target as Element).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) show(tab);
    });
    list.addEventListener("keydown", (event) => {
      const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
      if (!step) return;
      const at = tabs.findIndex((tab) => tab.tabIndex === 0);
      const next = tabs[(at + step + tabs.length) % tabs.length];
      show(next);
      next.focus();
    });
  }
</script>

<style>
  .patch-head {
    margin-top: 3.5rem;
  }

  .crumbs,
  .label,
  .counts,
  .sha {
    font-family: var(--font-mono);
    color: var(--fg-dim);
  }

  .crumbs {
    margin: 0;
    font-size: 0.75rem;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    margin-top: 0.625rem;
  }

  h1 {
    margin: 0;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    align-items: center;
    margin: 0.625rem 0 0;
  }

  .counts {
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .plus {
    color: var(--fg-link);
  }

  .minus {
    color: var(--red);
  }

  .patch-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17.5rem;
    gap: 3.5rem;
    margin-top: 1.75rem;
  }

  .patch {
    min-width: 0;
  }

  .mail {
    margin: 0 0 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 4px 6px 5px 7px;
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .mail span {
    color: var(--fg-dim);
  }

  .message :global(p),
  .message :global(ul),
  .message :global(ol) {
    margin: 0 0 1rem;
    font-size: 1.0625rem;
  }

  .message :global(h1),
  .message :global(h2),
  .message :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.0625rem;
  }

  .message :global(img) {
    max-width: 100%;
    height: auto;
  }

  .message :global(pre) {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--border);
    border-radius: 0;
    background: var(--paper);
    font-size: 0.8125rem;
    white-space: pre-wrap;
  }

  .block {
    margin-top: 2rem;
  }

  .label {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .signers {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .signers li {
    display: grid;
    grid-template-columns: 9.375rem minmax(0, 1fr);
    gap: 0.125rem 1.125rem;
    align-items: baseline;
    padding: 0.5625rem 0;
    border-bottom: 1px dashed var(--border);
  }

  .key {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .who {
    font-size: 1rem;
  }

  .who.mono {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .role {
    display: block;
    font-size: 0.875rem;
    color: var(--fg-dim);
  }

  .diff {
    margin: 0 0 1.375rem;
    border: 1px solid var(--border);
    border-radius: 4px 6px 5px 7px;
    overflow: hidden;
  }

  .diff figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--border);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .diff :global(.code-block-wrapper) {
    margin: 0;
  }

  .diff pre {
    margin: 0;
    padding: 0.625rem 0;
    border-radius: 0;
    background: var(--paper);
    white-space: normal;
  }

  .line {
    display: block;
    padding: 0 0.875rem;
    white-space: pre;
  }

  .hunk {
    background: var(--bg-dim);
    color: var(--fg-dim);
  }

  .add {
    background: var(--bg-added-faint);
  }

  .del {
    background: var(--bg-removed-faint);
  }

  .ends {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
  }

  .side p {
    margin: 0;
  }

  .sha {
    font-size: 0.875rem;
    color: var(--fg-main);
  }

  .side .repo {
    margin-top: 0.375rem;
  }

  .view {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    text-underline-offset: 4px;
  }

  .dates,
  .elsewhere {
    font-size: 0.9375rem;
  }

  .dim {
    color: var(--fg-dim);
  }

  .stat {
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 5px 8px 6px 9px;
  }

  .stat ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stat li,
  .total {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .stat li {
    padding: 0.375rem 0;
  }

  .file {
    display: flex;
    flex: 1;
    min-width: 9ch;
    overflow: hidden;
    white-space: nowrap;
  }

  .stem {
    min-width: 4ch;
    overflow: hidden;
  }

  .side .total {
    flex-wrap: wrap;
    margin-top: 0.5rem;
    color: var(--fg-dim);
  }

  .pebbles {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .pebbles span {
    width: 9px;
