---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Credits & Attributions" description="Attributions, open source credits, and acknowledgements.">
	<article>
		<h1>Credits & Acknowledgements</h1>

		<hr />

		<section>
			<h2>Visual Palette</h2>
			<p>
				The color system of this site is directly ported from <strong>ef-themes</strong>, a collection of - I think - the best themes
				for GNU Emacs created by
				<a href="https://protesilaos.com" target="_blank" rel="noopener">Protesilaos Stavrou</a>.
			</p>

			<ul>
				<li>
					<strong><code>ef-autumn</code> (Dark Mode)</strong>
				</li>
				<li>
					<strong><code>ef-arcadia</code> (Light Mode)</strong>
				</li>
				<li>
					<strong><code>ef-day</code> (Alternate Light Preset)</strong>
				</li>
			</ul>

			<p>
				All color values in the stylesheets are 100% faithful to the upstream Lisp source definitions released under the GNU General
				Public License v3.0 or later.
			</p>
		</section>

		<hr />

		<section>
			<h2>Typography</h2>
			<ul>
				<li>
					<strong>Headings, Navigation & Monospace</strong> - <strong>Typus Mono 95</strong>, a customized monospace typeface
					created by me (<a href="https://github.com/szymonwilczek/typus-fonts" target="_blank" rel="noopener">
						Typus Mono repository
					</a>).
				</li>
				<li>
					<strong>Prose & Reading Body</strong> - <em>Literata</em> (designed by TypeTogether under the SIL Open Font License).
				</li>
			</ul>
		</section>
	</article>
</BaseLayout>
