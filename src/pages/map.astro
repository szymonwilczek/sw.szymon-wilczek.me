---
// Hidden map: the whole site drawn as a garden.
// Not linked from any page and left out of the sitemap; the riddle doors lead here.
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { getCollection } from "astro:content";
import { getAllAlbums } from "../utils/albums";
import { calculateReadingStats } from "../utils/reading-time";
import { writingSlug } from "../utils/format";
import { HANKO_EDGE } from "../utils/hanko";
import { PROJECTS } from "../utils/projects";
import { readBooks } from "../utils/books";
import { TOOLS } from "../utils/dogu";

const writings = (await getCollection("writings"))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  .map((post) => ({
    slug: writingSlug(post.id),
    title: post.data.title,
    minutes: calculateReadingStats(post.body).minutes,
  }));
const albums = (await getAllAlbums()).slice().reverse();
const files = await getCollection("files");
const booksRead = readBooks().filter((b) => b.state === "read").length;

// plants grow as tall as the essay is long
const step = Math.min(50, 260 / Math.max(writings.length - 1, 1));
const plants = writings.map((w, i) => {
  const x = Math.round(240 + i * step);
  const top = 676 - 40 - Math.min(w.minutes, 40) * 8;
  const mid = Math.round((676 + top) / 2);
  return { ...w, x, x1: x + (i % 2 ? 8 : -8), top, mid };
});

// lilies on the pond, one per album
const PADS = [
  [626, 400, -8],
  [684, 372, 6],
  [740, 410, -3],
  [786, 368, 10],
  [706, 438, -12],
];
const lilies = albums.map((album, i) => {
  const [x, y, r] = PADS[i] ?? [
    610 + ((i * 47) % 190),
    340 + ((i * 31) % 110),
    ((i * 7) % 20) - 10,
  ];
  return { ...album, x, y, r };
});

const STONES = [0, 1, 2, 3, 4].map((i) => ({ x: 340 + i * 92, y: 806 + (i % 2 ? -10 : 4) }));

const PAWS = [
  [1050, 600, -20],
  [1040, 572, -14],
  [1030, 546, -22],
  [1018, 514, -10],
  [1012, 380, -16],
  [1000, 350, -24],
  [984, 318, -30],
];

const GOOSE = "M-9 -2.9 Q-3.8 -1.1 0 0 Q3.6 -2.7 9.2 -5";
const KIGO = [
  [744, 232, 24, 1],
  [186, 150, -40, 0.8],
  [1010, 494, 70, 0.9],
];

// paths between places; a path is inked once its place has been walked
const PATHS = [
  { to: "/writings", d: "M156 846 C 168 790, 210 760, 238 712", via: [] },
  {
    to: "/photos",
    d: "M380 640 C 430 580, 500 560, 560 520 C 600 494, 610 470, 620 456",
    via: ["/writings"],
  },
  {
    to: "/files",
    d: "M812 452 C 850 500, 830 560, 880 590 C 906 606, 920 620, 930 636",
    via: ["/writings", "/photos"],
  },
  {
    to: "/files/verify",
    d: "M156 846 C 230 812, 300 806, 380 800 C 520 792, 700 806, 806 784",
    via: [],
  },
  { to: "/about", d: "M560 520 C 500 420, 420 320, 330 270", via: ["/writings", "/photos"] },
  { to: "/vault", d: "M820 330 C 860 280, 880 240, 892 208", via: ["/writings", "/photos"] },
  { to: "/contact", d: "M238 712 C 180 660, 120 640, 96 612", via: ["/writings"] },
  { to: "/projects", d: "M560 520 C 500 500, 440 470, 400 440", via: ["/writings", "/photos"] },
  { to: "/books", d: "M522 650 C 570 656, 620 690, 676 708", via: ["/writings"] },
  {
    to: "/uses",
    d: "M328 222 C 362 224, 404 216, 440 198",
    via: ["/writings", "/photos", "/about"],
  },
];

// trees in their seasons
let seed = 17;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const jit = (n: number) => (rnd() * 2 - 1) * n;
const CROWNS = [
  [152, 96, 26, 22],
  [992, 432, 24, 20],
  [710, 196, 24, 20],
];
const BLOSSOMS = CROWNS.flatMap(([x, y, rx, ry]) =>
  Array.from({ length: 9 }, () => [Math.round(x + jit(rx * 0.8)), Math.round(y + jit(ry * 0.7))]),
);
const FALLING = CROWNS.flatMap(([x, y, rx, ry]) =>
  Array.from({ length: 4 }, (_, i) => [
    Math.round(x + jit(rx * 1.4)),
    Math.round(y + ry + 10 + i * 12 + jit(4)),
  ]),
);

// sun and moon walk this arc over the top edge of the sheet
const ARC = Array.from({ length: 13 }, (_, i) => {
  const t = i / 12;
  return `${Math.round(80 + 940 * t)} ${Math.round(20 - 140 * Math.sin(Math.PI * t))}`;
});

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const PLACES = [
  {
    href: "/writings/",
    title: "writings · the bed",
    sub: plural(writings.length, "essay", "essays"),
  },
  { href: "/photos/", title: "photos · the pond", sub: plural(albums.length, "album", "albums") },
  { href: "/photos/stamps/", title: "the jetty", sub: "stamp album" },
  {
    href: "/projects/",
    title: "projects · the drying line",
    sub: plural(PROJECTS.length, "project", "projects"),
  },
  {
    href: "/books/",
    title: "books · the storehouse",
    sub: plural(booksRead, "book read", "books read"),
  },
  { href: "/files/", title: "files · the shed", sub: plural(files.length, "file", "files") },
  { href: "/files/verify/", title: "the bench", sub: "check a file against its tag" },
  { href: "/vault/", title: "the well, sealed", sub: "vault" },
  { href: "/about/", title: "stone lantern", sub: "about" },
  {
    href: "/uses/",
    title: "uses · the tea hut",
    sub: plural(TOOLS.length, "piece on a tray", "pieces on a tray"),
  },
  { href: "/contact/", title: "the mailbox", sub: "contact" },
  { href: "/seals/", title: "tracks?", sub: "the seal book" },
];
const place = (href: string) => PLACES.find((p) => p.href === href)!;
---

<BaseLayout
  title="A map of the garden"
  description="Everything here, drawn as the place it pretends to be."
  noindex
>
  <header class="map-head">
    <div>
      <p class="found hand">
        <svg class="hanko" width="26" height="26" viewBox="0 0 46 46" aria-hidden="true">
          <path class="hanko-edge" d={HANKO_EDGE}></path>
          <text x="23" y="31" text-anchor="middle">
            北
          </text>
        </svg>
        you found it.
      </p>
      <h1>A map of the garden</h1>
      <p class="lede">
        Everything here, drawn as the place it pretends to be. Touch anything on the map to walk
        there. Plants grow as tall as the essay is long; the places you have not been yet stay grey,
        and the paths you have walked are inked in brush. The sheet keeps your hour and your season.
      </p>
    </div>
    <p class="aside hand">
      not to scale. nothing here is.
      <span class="clock"></span>
    </p>
  </header>

  <Divider from={300} to={520} />

  <div class="too-small paper">
    <span class="tape too-small-tape" aria-hidden="true"></span>
    <p class="too-small-head hand">this map is drawn on a sheet too wide to unfold here.</p>
    <p>
      Some walks wait for a bigger table. Open it on a large screen and the garden will still be
      here, paths and all. Until then it is below, as a plain list.
    </p>
  </div>

  <div class="map-scroll">
