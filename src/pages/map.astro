          <rect class="hit" x="448" y="396" width="126" height="64"></rect>
          <path
            class="line"
            d="M570 404 C 548 406, 530 408, 508 410 M 570 418 C 548 420, 530 422, 508 424 M 520 404 L 518 430 M 540 404 L 540 428 M 560 404 L 560 426"
            stroke-width="1.3"
          ></path>
          <text class="label dim" x="452" y="452" font-size="15">
            the jetty · stamp album
          </text>
        </a>

        <!-- files -->
        <a
