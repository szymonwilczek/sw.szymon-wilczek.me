---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { getCollection } from "astro:content";
import { getAllAlbums } from "../utils/albums";
import { calculateReadingStats } from "../utils/reading-time";
import { writingSlug } from "../utils/format";
import { HANKO_EDGE } from "../utils/hanko";
import { PROJECTS } from "../utils/projects";
import { readBooks } from "../utils/books";
import { TOOLS } from "../data/uses";
import { weeks } from "../utils/nenrin";
import { LINKS } from "../data/links";
import { YEARS } from "../data/years";
import { stone } from "../utils/stones";

const writings = (await getCollection("writings"))
  .sort((former, latter) => former.data.pubDate.valueOf() - latter.data.pubDate.valueOf())
  .map((post) => ({
    slug: writingSlug(post.id),
    title: post.data.title,
    minutes: calculateReadingStats(post.body).minutes,
  }));
const albums = (await getAllAlbums()).slice().reverse();
const files = await getCollection("files");
const rings = weeks();
const booksRead = readBooks().filter((book) => book.state === "read").length;

// plants grow as tall as the essay is long
const step = Math.min(50, 260 / Math.max(writings.length - 1, 1));
const plants = writings.map((writing, i) => {
  const x = Math.round(240 + i * step);
  const top = 676 - 40 - Math.min(writing.minutes, 40) * 8;
  const midY = Math.round((676 + top) / 2);
  return { ...writing, x, x1: x + (i % 2 ? 8 : -8), top, mid: midY };
});

// lilies on the pond, one per album
const PADS = [
  [626, 400, -8],
  [684, 372, 6],
  [740, 410, -3],
  [786, 368, 10],
  [706, 438, -12],
];
const lilies = albums.map((album, i) => {
  const [x, y, rotation] = PADS[i] ?? [
    610 + ((i * 47) % 190),
    340 + ((i * 31) % 110),
    ((i * 7) % 20) - 10,
  ];
  return { ...album, x, y, r: rotation };
});

const STONES = [0, 1, 2, 3, 4].map((i) => {
  const x = 300 + i * 92;
  const y = 826 + (i % 2 ? -3 : 3);
  const year = YEARS[i]?.year ?? "";
  return { x, y, year, ink: stone(x, y, 0.64, YEARS[i]?.moss ?? 0, `map/${i}`) };
});

const PAWS = [
  [1050, 600, -20],
  [1040, 572, -14],
  [1030, 546, -22],
  [1018, 514, -10],
  [1012, 380, -16],
  [1000, 350, -24],
  [984, 318, -30],
];

const GOOSE = "M-9 -2.9 Q-3.8 -1.1 0 0 Q3.6 -2.7 9.2 -5";
const KIGO = [
  [744, 232, 24, 1],
  [186, 150, -40, 0.8],
  [1010, 494, 70, 0.9],
];

// paths between places; a path is inked once its place has been walked
const PATHS = [
  { to: "/writings", d: "M156 846 C 168 790, 210 760, 238 712", via: [] },
  {
    to: "/photos",
    d: "M380 640 C 430 580, 500 560, 560 520 C 600 494, 610 470, 620 456",
    via: ["/writings"],
  },
  {
    to: "/files",
    d: "M812 452 C 850 500, 830 560, 880 590 C 906 606, 920 620, 930 636",
    via: ["/writings", "/photos"],
  },
  {
    to: "/files/verify",
    d: "M156 846 C 230 812, 300 806, 380 800 C 520 792, 700 806, 806 784",
    via: [],
  },
  { to: "/about", d: "M560 520 C 500 420, 420 320, 330 270", via: ["/writings", "/photos"] },
  { to: "/vault", d: "M820 330 C 860 280, 880 240, 892 208", via: ["/writings", "/photos"] },
  {
    to: "/links",
    d: "M954 212 C 966 220, 978 224, 990 224",
    via: ["/writings", "/photos", "/vault"],
  },
  { to: "/contact", d: "M238 712 C 180 660, 120 640, 96 612", via: ["/writings"] },
  { to: "/projects", d: "M560 520 C 500 500, 440 470, 400 440", via: ["/writings", "/photos"] },
  { to: "/books", d: "M522 650 C 570 656, 620 690, 676 708", via: ["/writings"] },
  { to: "/changelog", d: "M110 545 C 150 530, 176 500, 172 468", via: ["/writings", "/contact"] },
  {
    to: "/uses",
    d: "M328 222 C 362 224, 404 216, 440 198",
    via: ["/writings", "/photos", "/about"],
  },
  {
    to: "/roji",
    d: "M762 716 C 770 724, 782 724, 794 716",
    via: ["/writings", "/books"],
  },
];

// trees in their seasons
let seed = 17;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const jitter = (amount: number) => (rand() * 2 - 1) * amount;
const CROWNS = [
  [152, 96, 26, 22],
  [992, 432, 24, 20],
  [710, 196, 24, 20],
];
const BLOSSOMS = CROWNS.flatMap(([x, y, radiusX, radiusY]) =>
  Array.from({ length: 9 }, () => [
    Math.round(x + jitter(radiusX * 0.8)),
    Math.round(y + jitter(radiusY * 0.7)),
  ]),
);
const FALLING = CROWNS.flatMap(([x, y, radiusX, radiusY]) =>
  Array.from({ length: 4 }, (_, i) => [
    Math.round(x + jitter(radiusX * 1.4)),
    Math.round(y + radiusY + 10 + i * 12 + jitter(4)),
  ]),
);

// sun and moon walk this arc over the top edge of the sheet
const ARC = Array.from({ length: 13 }, (_, i) => {
  const along = i / 12;
  return `${Math.round(80 + 940 * along)} ${Math.round(20 - 140 * Math.sin(Math.PI * along))}`;
});

const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;

const PLACES = [
  {
    href: "/writings/",
    title: "writings · the bed",
    sub: plural(writings.length, "essay", "essays"),
  },
  { href: "/photos/", title: "photos · the pond", sub: plural(albums.length, "album", "albums") },
  { href: "/photos/bookmarks/", title: "the jetty", sub: "bookmarks" },
  {
    href: "/projects/",
    title: "projects · the drying line",
    sub: plural(PROJECTS.length, "project", "projects"),
  },
  {
    href: "/books/",
    title: "books · the storehouse",
    sub: plural(booksRead, "book read", "books read"),
  },
  { href: "/files/", title: "files · the shed", sub: plural(files.length, "file", "files") },
  { href: "/files/verify/", title: "the bench", sub: "check a file against its tag" },
  { href: "/vault/", title: "the well, sealed", sub: "vault" },
  {
    href: "/links/",
    title: "links · the back gate",
    sub: plural(LINKS.length, "thread out", "threads out"),
  },
  { href: "/about/", title: "stone lantern", sub: "about" },
  {
    href: "/uses/",
    title: "uses · the tea hut",
    sub: plural(TOOLS.length, "tool in ink", "tools in ink"),
  },
  { href: "/roji/", title: "roji · the jar", sub: "a workshop behind a stone" },
  { href: "/engawa/", title: "engawa · the veranda", sub: "incense, a record, a quiet radio" },
  { href: "/contact/", title: "the mailbox", sub: "contact" },
  {
    href: "/changelog/",
    title: "changelog · the stump",
    sub: `${plural(rings.length, "ring", "rings")} · ${plural(
      rings.reduce((sum, week) => sum + week.n, 0),
      "commit",
      "commits",
    )}`,
  },
  { href: "/seals/", title: "tracks?", sub: "the seal book" },
  { href: "/path/", title: "stepping stones", sub: "the years so far · the CV" },
];
const place = (href: string) => PLACES.find((spot) => spot.href === href)!;
---

<BaseLayout
  title="A map of the garden"
  description="Everything here, drawn as the place it pretends to be."
>
  <header class="map-head">
    <div>
      <p class="found hand" hidden>
        <svg class="hanko" width="26" height="26" viewBox="0 0 46 46" aria-hidden="true">
          <path class="hanko-edge" d={HANKO_EDGE}></path>
          <text x="23" y="31" text-anchor="middle">
            北
          </text>
        </svg>
        you found it.
      </p>
      <script is:inline>
        if (new URLSearchParams(location.search).has("found")) {
          document.currentScript.previousElementSibling.hidden = false;
          history.replaceState(null, "", location.pathname + location.hash);
        }
      </script>
      <h1>A map of the garden</h1>
      <p class="lede">
        Everything here, drawn as the place it pretends to be. Touch anything on the map to walk
        there. Plants grow as tall as the essay is long; the places you have not been yet stay grey,
        and the paths you have walked are inked in brush. The sheet keeps your hour and your season.
      </p>
    </div>
    <p class="aside hand">
      not to scale. nothing here is.
      <span class="clock"></span>
    </p>
  </header>

  <Divider from={300} to={520} />

  <div class="too-small paper">
    <span class="tape too-small-tape" aria-hidden="true"></span>
    <p class="too-small-head hand">this map is drawn on a sheet too wide to unfold here.</p>
    <p>
      Some walks wait for a bigger table. Open it on a large screen and the garden will still be
      here, paths and all. Until then it is below, as a plain list.
    </p>
  </div>

  <div class="map-scroll">
    <div class="map-inner">
      <svg
        class="map"
        viewBox="0 -150 1100 1068"
        role="img"
        aria-label="Hand-drawn map of the site"
      >
        <!-- the sky over the top edge -->
        <path
          class="dusk-sky"
          d="M-10 6 C 200 -30, 420 -8, 620 -26 C 800 -40, 980 -14, 1110 -24 C 1112 0, 1112 20, 1110 30 C 800 36, 300 34, -10 30 Z"
        ></path>
        <path class="arc" d={`M${ARC.join(" L ")}`}></path>
        <g class="sun">
          <path d="M0 -22 C 13 -22, 23 -12, 22 1 C 21 14, 10 23, -2 22 C -14 21, -23 11, -22 -1 C -21 -13, -12 -21, 2 -22"></path>
          <circle r="15"></circle>
        </g>
        <g class="moon">
          <circle r="18"></circle>
          <path></path>
        </g>

        <!-- shadows -->
        <g class="shadows">
          <path data-at="300 240 18"></path>
          <path data-at="900 228 60"></path>
          <path data-at="945 768 70"></path>
          <path data-at="375 432 160"></path>
        </g>

        <!-- the wall -->
        <path
          class="line"
          d="M196 846 C 420 852, 760 840, 1062 848 C 1070 610, 1064 300, 1068 34 C 760 28, 420 38, 36 30 C 30 300, 38 610, 32 846 L 118 844"
          stroke-width="1.6"
        ></path>
        <path
          class="line fill-dim"
          d="M1068 34 C 1052 52, 1040 48, 1030 62 C 1046 66, 1058 60, 1068 72"
          stroke-width="1.2"
        ></path>
        <path
          class="line"
          d="M118 844 C 117 836, 119 828, 118 820 M 196 846 C 197 838, 195 830, 196 822"
          stroke-width="1.6"
        ></path>
        <text class="label dim" x="156" y="884" font-size="15" text-anchor="middle">
          the gate
        </text>

        <!-- the paths walked -->
        {PATHS.map((path) => (
          <path class="brush" data-path={path.to} data-via={path.via.join(" ")} d={path.d} />
        ))}
        {PATHS.map((path) => (
          <path class="walk" d={path.d} />
        ))}

        <circle class="here" cx="156" cy="840" r="7"></circle>
        <circle class="here-ring" cx="156" cy="840" r="14"></circle>
        <text class="label came" x="156" y="908" font-size="16" text-anchor="middle">
          you came in by the gate
        </text>

        <a
          href="/writings/"
          class="place"
          data-area="/writings"
          data-title={place("/writings/").title}
          data-sub={place("/writings/").sub}
        >
          <path
            class="soil"
            d="M210 560 C 290 550, 430 556, 520 562 C 528 610, 524 650, 520 690 C 430 698, 290 694, 214 690 C 206 650, 210 600, 210 560 Z"
            stroke-width="1.3"
          ></path>
          <text class="label" x="256" y="732" font-size="20">
            writings · {writings.length} essays
          </text>
        </a>
        {plants.map((plant) => (
          <a
            href={`/writings/${plant.slug}/`}
            class="place plant"
            data-area="/writings"
            data-slug={plant.slug}
            data-title={plant.title}
            data-sub={`${plant.minutes} min`}
          >
            <rect
              class="hit"
              x={plant.x - 18}
              y={plant.top - 10}
              width="36"
              height={676 - plant.top + 10}
            />
            <path
              class="stem"
              d={`M${plant.x} 676 C ${plant.x1} ${plant.mid}, ${plant.x} ${plant.mid}, ${plant.x} ${plant.top}`}
            />
            <path
              class="leafy"
              d={`M${plant.x} ${plant.mid + 10} c -10 -4, -16 -12, -16 -18 c 8 2, 14 8, 16 18 Z M ${plant.x} ${plant.mid - 14} c 10 -4, 16 -12, 16 -18 c -8 2, -14 8, -16 18 Z`}
            />
            <circle class="bud" cx={plant.x} cy={plant.top} r="3" />
          </a>
        ))}

        <a
          href="/photos/"
          class="place"
          data-area="/photos"
          data-title={place("/photos/").title}
          data-sub={place("/photos/").sub}
        >
          <path
            class="line fill-sea pond"
            d="M586 320 C 656 286, 776 300, 816 340 C 852 380, 826 450, 756 462 C 686 474, 606 470, 582 420 C 564 384, 556 340, 586 320 Z"
            stroke-width="1.4"
          ></path>
          <path
            class="line"
            d="M616 360 q 5 -3 10 0 M 706 340 q 5 -3 10 0 M 776 420 q 5 -3 10 0 M 656 440 q 5 -3 10 0"
            stroke-width="1"
          ></path>
          <text class="label" x="656" y="500" font-size="20">
            photos · {albums.length} albums
          </text>
        </a>
        {lilies.map((lily) => (
          <a
            href={`/photos/${lily.slug}/`}
            class="place lily"
            data-area="/photos"
            data-title={`${lily.stampNum} · ${lily.title}`}
            data-sub={`${lily.date.getFullYear()} · ${lily.photoCount} frames`}
          >
            <g transform={`translate(${lily.x} ${lily.y}) rotate(${lily.r})`}>
              <rect class="fill-paper ink-thin" x="-13" y="-15" width="26" height="30" />
              <rect class="fill-tape" x="-10" y="-12" width="20" height="18" />
              <text class="lily-n" x="0" y="13" text-anchor="middle">
                {lily.stampNum}
              </text>
            </g>
          </a>
        ))}
        <circle class="ripple" cx="786" cy="368" r="24" stroke-width="0.9" opacity="0.6"></circle>
        <circle class="ripple" cx="786" cy="368" r="34" stroke-width="0.7" opacity="0.35"></circle>
        <a
          href="/photos/bookmarks/"
          class="place"
          data-area="/photos/bookmarks"
          data-title={place("/photos/bookmarks/").title}
          data-sub={place("/photos/bookmarks/").sub}
        >
          <rect class="hit" x="440" y="240" width="164" height="84"></rect>
          <path
            class="line"
            transform="translate(30 -98) rotate(28 570 414)"
            d="M570 404 C 548 406, 530 408, 508 410 M 570 418 C 548 420, 530 422, 508 424 M 520 404 L 518 430 M 540 404 L 540 428 M 560 404 L 560 426"
            stroke-width="1.3"
          ></path>
          <text class="label dim" x="540" y="262" font-size="15" text-anchor="middle">
            the jetty · bookmarks
          </text>
        </a>

        <a
          href="/projects/"
          class="place"
          data-area="/projects"
          data-title={place("/projects/").title}
          data-sub={place("/projects/").sub}
        >
          <rect class="hit" x="284" y="312" width="182" height="124"></rect>
          <path class="line" d="M294 352 C 344 346, 404 350, 456 346" stroke-width="1.2"></path>
          <path
            class="line"
            d="M298 350 C 297 380, 299 410, 298 432 M 452 347 C 453 380, 451 410, 452 432"
            stroke-width="1.8"
          ></path>
          <g transform="translate(312 356) rotate(-3)">
            <path
              class="line fill-paper sheet"
              d="M0 0 C 12 -1, 24 1, 36 0 C 37 16, 36 30, 37 46 C 24 47, 12 46, 1 47 C -1 30, 1 16, 0 0 Z"
              stroke-width="0.9"
            ></path>
            <path
              class="stem"
              d="M18 40 C 17 30, 20 20, 18 11 M 18 27 c -6 -3, -8 -7, -9 -10 M 18 21 c 6 -3, 8 -7, 9 -10"
              stroke-width="1"
            ></path>
          </g>
          <g transform="translate(358 354) rotate(2)">
            <path
              class="line fill-paper sheet"
              d="M0 0 C 12 -1, 24 1, 36 0 C 37 16, 36 30, 37 46 C 24 47, 12 46, 1 47 C -1 30, 1 16, 0 0 Z"
              stroke-width="0.9"
            ></path>
            <circle class="line" cx="18" cy="20" r="8" stroke-width="1"></circle>
            <circle class="fill-ink" cx="18" cy="20" r="2"></circle>
          </g>
          <g transform="translate(404 357) rotate(-1)">
            <path
              class="line fill-paper sheet"
              d="M0 0 C 12 -1, 24 1, 36 0 C 37 16, 36 30, 37 46 C 24 47, 12 46, 1 47 C -1 30, 1 16, 0 0 Z"
              stroke-width="0.9"
            ></path>
            <path class="line" d="M7 32 l 6 -10 l 6 6 l 8 -14" stroke-width="1"></path>
          </g>
          <path
            class="flag"
            d="M314 352 l 6 4 M 362 350 l 6 4 M 406 352 l 6 4"
            stroke-width="1.4"
          ></path>
          <text class="label" x="172" y="326" font-size="18">
            projects · the drying line
          </text>
        </a>

        <a
          href="/books/"
          class="place"
          data-area="/books"
          data-title={place("/books/").title}
          data-sub={place("/books/").sub}
        >
          <path
            class="line fill-paper"
            d="M616 628 C 664 627, 712 629, 756 627 C 757 654, 755 682, 757 710 C 710 712, 664 710, 614 711 C 615 684, 613 656, 616 628 Z"
            stroke-width="1.4"
          ></path>
          <path
            class="line"
            d="M616 676 C 664 675, 712 677, 756 676 M 622 676 L 650 710 M 646 676 L 674 710 M 702 676 L 730 710 M 726 676 L 752 708 M 646 676 L 616 704 M 670 676 L 640 710 M 726 676 L 698 710 M 750 676 L 722 710"
            stroke-width="0.8"
            opacity="0.6"
          ></path>
          <path
            class="line fill-alt"
            d="M600 630 C 640 606, 730 604, 772 628 C 760 632, 752 628, 740 624 C 700 614, 664 614, 630 624 C 618 628, 610 632, 600 630 Z"
            stroke-width="1.5"
          ></path>
          <path
            class="line"
            d="M628 610 C 668 598, 708 598, 744 608 M 618 604 C 622 608, 626 610, 630 610 M 752 602 C 750 606, 746 608, 742 608"
            stroke-width="1.6"
          ></path>
          <path class="kura-dark" d="M676 710 L 676 660 L 704 660 L 704 710 Z"></path>
          <path
            class="kura-spines"
            d="M680 708 v -22 M 685 708 v -30 M 690 708 v -18 M 695 708 v -26 M 700 708 v -21"
          ></path>
          <path
            class="line fill-tape"
            d="M704 710 L 704 660 L 720 664 L 720 706 Z"
            stroke-width="1.1"
          ></path>
          <path
            class="line fill-alt"
            d="M630 642 h 16 v 16 h -16 Z M 728 642 h 16 v 16 h -16 Z"
            stroke-width="1"
          ></path>
          <path
            class="line"
            d="M635 642 v 16 M 641 642 v 16 M 733 642 v 16 M 739 642 v 16"
            stroke-width="0.8"
          ></path>
          <text class="label" x="600" y="748" font-size="18">
            books · the storehouse
          </text>
        </a>

        <a
          href="/somewhere-else/"
          class="place"
          data-seal-area="迷"
          data-title="the lost corner"
          data-sub="404 · a page that isn't"
        >
          <rect class="hit" x="604" y="82" width="170" height="80"></rect>
          <path
            class="line"
            d="M610 120 C 630 100, 670 96, 696 112 C 710 92, 750 96, 756 120"
            stroke-width="1.2"
            stroke-dasharray="3 6"
          ></path>
          <text class="label dim" x="618" y="150" font-size="16">
            the lost corner · 404
          </text>
        </a>

        <a
          href="/files/"
          class="place"
          data-area="/files"
          data-title={place("/files/").title}
          data-sub={place("/files/").sub}
        >
          <path
            class="line fill-alt"
            d="M866 672 C 890 650, 918 628, 944 612 C 972 630, 998 650, 1024 674 C 990 679, 900 679, 866 672 Z"
            stroke-width="1.5"
          ></path>
          <path
            class="line"
            d="M896 652 C 902 656, 906 662, 908 668 M 924 636 C 928 644, 930 654, 932 666 M 952 630 C 956 640, 960 652, 962 666 M 980 644 C 984 652, 988 660, 990 670"
            stroke-width="1"
            opacity="0.7"
          ></path>
          <path
            class="line fill-dim"
            d="M884 677 C 881 706, 886 736, 883 764 C 920 767, 972 763, 1006 766 C 1008 736, 1003 706, 1006 677"
            stroke-width="1.5"
          ></path>
          <path
            class="line fill-alt"
            d="M930 765 C 929 748, 931 730, 930 714 C 939 710, 951 711, 958 714 C 960 732, 957 748, 959 765"
            stroke-width="1.3"
          ></path>
          <circle class="fill-ink" cx="952" cy="740" r="1.8"></circle>
          <path class="line" d="M976 680 C 975 690, 976 696, 975 702" stroke-width="0.9"></path>
          <path
            class="line fill-paper window"
            d="M967 702 C 974 700, 980 701, 986 703 C 987 712, 985 720, 986 728 C 980 730, 973 729, 967 728 C 966 720, 968 710, 967 702 Z"
            stroke-width="1"
          ></path>
          <text class="label" x="884" y="800" font-size="18">
            files · the shed
          </text>
        </a>
        <a
          href="/files/verify/"
          class="place"
          data-area="/files/verify"
          data-title={place("/files/verify/").title}
          data-sub={place("/files/verify/").sub}
        >
          <rect class="hit" x="766" y="726" width="100" height="94"></rect>
          <path
            class="line"
            d="M800 760 C 818 756, 840 758, 858 762 M 806 762 C 806 772, 808 778, 806 784 M 852 763 C 853 772, 851 778, 852 784"
            stroke-width="2"
          ></path>
          <g transform="translate(830 744) rotate(-8)">
            <path
              class="fill-red"
              d="M-9 -9 Q0 -11 9 -9 Q11 0 9 9 Q0 11 -9 9 Q-11 0 -9 -9 Z"
              opacity="0.9"
            ></path>
