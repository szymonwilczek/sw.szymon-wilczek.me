<style>
  .map-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
  }

  .map-head > div {
    max-width: 37.5rem;
  }

  .found[hidden] {
    display: none;
  }

  .found {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 0.625rem;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--cursor);
  }

  .found .hanko {
    rotate: -6deg;
  }

  .map-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.125rem 0 0;
    color: var(--fg-dim);
  }

  .aside {
    margin: 0;
    font-weight: 300;
    font-size: 1.1875rem;
    color: var(--fg-dim);
    transform: rotate(-2deg);
  }

  .too-small {
    display: none;
    position: relative;
    margin: 0 0 2.5rem;
    padding: 1.5rem 1.25rem 1.25rem;
    transform: rotate(-0.6deg);
  }

  .too-small-tape {
    top: -0.6rem;
    left: 42%;
  }

  .too-small-head {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    color: var(--fg-main);
  }

  .too-small p:last-child {
    margin: 0;
    color: var(--fg-dim);
  }

  .map-inner {
    position: relative;
  }

  .map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-hand);
  }

  .line {
    fill: none;
    stroke: var(--fg-dim);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .faint {
    stroke: var(--border);
  }

  .fill-dim {
    fill: var(--bg-dim);
  }

  .fill-alt {
    fill: var(--bg-alt);
  }

  .fill-sea {
    fill: var(--sea);
  }

  .fill-paper {
    fill: var(--paper);
  }

  .fill-tape {
    fill: var(--tape);
  }

  .fill-red {
    fill: var(--red);
  }

  .fill-ink {
    fill: var(--fg-dim);
  }

  .ink-thin {
    stroke: var(--fg-main);
    stroke-width: 0.8;
  }

  .soil {
    fill: var(--bg-dim);
    stroke: var(--border);
  }

  .label {
    fill: var(--fg-main);
  }

  .label.dim {
    fill: var(--fg-dim);
  }

  .came {
    fill: var(--cursor);
  }

  .here {
    fill: var(--cursor);
  }

  .here-ring {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1;
    opacity: 0.5;
  }

  .walk {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.5;
    stroke-dasharray: 2 9;
    stroke-linecap: round;
  }

  .unseen {
    filter: grayscale(1);
    opacity: 0.4;
    transition:
      opacity 0.3s,
      filter 0.3s;
  }

  .unseen:is(:hover, :focus-visible) {
    opacity: 0.75;
  }

  .plain a.unseen {
    color: var(--fg-dim);
  }

  .brush {
    display: none;
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.45;
    pointer-events: none;
  }

  .brush.is-walked {
    display: inline;
  }

  .dusk-sky {
    display: none;
    fill: var(--bg-region);
    opacity: 0.32;
  }

  .is-dusk .dusk-sky {
    display: inline;
  }

  .arc {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
  }

  .sun,
  .moon {
    display: none;
  }

  .is-day .sun,
  .map:not(.is-day) .moon {
    display: inline;
  }

  .sun path {
    fill: none;
    stroke: var(--red);
    stroke-width: 3.2;
    stroke-linecap: round;
  }

  .sun circle {
    fill: var(--red);
    opacity: 0.82;
  }

  .moon circle {
    fill: var(--bg-alt);
    opacity: 0.5;
  }

  .moon path {
    fill: var(--fg-main);
    opacity: 0.85;
  }

  .shadows path {
    fill: var(--fg-main);
    pointer-events: none;
  }

  .glint {
    display: none;
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 1.2;
    stroke-linecap: round;
    opacity: 0.5;
  }

  .map:not(.is-day) .glint {
    display: inline;
  }

  .blossom,
  .falling,
  .snow {
    display: none;
    pointer-events: none;
  }

  .blossom circle {
    fill: var(--red);
    opacity: 0.55;
  }

  .falling circle {
    fill: var(--red);
    opacity: 0.7;
