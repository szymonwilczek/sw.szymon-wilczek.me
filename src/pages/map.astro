            <g transform={`translate(${lily.x} ${lily.y}) rotate(${lily.r})`}>
              <rect class="fill-paper ink-thin" x="-13" y="-15" width="26" height="30" />
              <rect class="fill-tape" x="-10" y="-12" width="20" height="18" />
              <text class="lily-n" x="0" y="13" text-anchor="middle">
                {lily.stampNum}
              </text>
            </g>
