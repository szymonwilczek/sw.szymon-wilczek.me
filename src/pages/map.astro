          <path d="M0 -22 C 13 -22, 23 -12, 22 1 C 21 14, 10 23, -2 22 C -14 21, -23 11, -22 -1 C -21 -13, -12 -21, 2 -22"></path>
          <circle r="15"></circle>
        </g>
        <g class="moon">
          <circle r="18"></circle>
          <path></path>
        </g>

