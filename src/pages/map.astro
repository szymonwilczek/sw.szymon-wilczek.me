    height: auto;
    overflow: visible;
    font-family: var(--font-hand);
  }

  .line {
    fill: none;
    stroke: var(--fg-dim);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .faint {
    stroke: var(--border);
  }

  .fill-dim {
