          you came in by the gate
        </text>

        <!-- writings -->
        <a
          href="/writings/"
          class="place"
          data-title={place("/writings/").title}
          data-sub={place("/writings/").sub}
        >
          <path
            class="soil"
            d="M210 560 C 290 550, 430 556, 520 562 C 528 610, 524 650, 520 690 C 430 698, 290 694, 214 690 C 206 650, 210 600, 210 560 Z"
            stroke-width="1.3"
          ></path>
          <path
            class="line faint"
            d="M226 684 C 300 680, 420 682, 504 680"
            stroke-dasharray="1 5"
          ></path>
          <text class="label" x="216" y="720" font-size="20">
            writings · {writings.length} essays
          </text>
        </a>
        {plants.map((p) => (
          <a
            href={`/writings/${p.slug}/`}
            class="place plant"
            data-slug={p.slug}
            data-title={p.title}
            data-sub={`${p.minutes} min`}
          >
            <rect class="hit" x={p.x - 18} y={p.top - 10} width="36" height={676 - p.top + 10} />
            <path
              class="stem"
              d={`M${p.x} 676 C ${p.x1} ${p.mid}, ${p.x} ${p.mid}, ${p.x} ${p.top}`}
            />
            <path
              class="leafy"
              d={`M${p.x} ${p.mid + 10} c -10 -4, -16 -12, -16 -18 c 8 2, 14 8, 16 18 Z M ${p.x} ${p.mid - 14} c 10 -4, 16 -12, 16 -18 c -8 2, -14 8, -16 18 Z`}
            />
            <circle class="bud" cx={p.x} cy={p.top} r="3" />
          </a>
        ))}

        <!-- photos -->
        <a
          href="/photos/"
          class="place"
          data-title={place("/photos/").title}
          data-sub={place("/photos/").sub}
