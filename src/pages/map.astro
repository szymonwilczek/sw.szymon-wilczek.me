  }

  .label {
    fill: var(--fg-main);
  }

  .label.dim {
    fill: var(--fg-dim);
  }

  .came {
    fill: var(--cursor);
  }

  .here {
    fill: var(--cursor);
  }

  .here-ring {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1;
    opacity: 0.5;
  }

  .walk {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.5;
    stroke-dasharray: 2 9;
    stroke-linecap: round;
  }

  .unseen {
    filter: grayscale(1);
    opacity: 0.4;
    transition:
      opacity 0.3s,
      filter 0.3s;
  }

  .unseen:is(:hover, :focus-visible) {
    opacity: 0.75;
  }

  .plain a.unseen {
    color: var(--fg-dim);
  }

  .brush {
    display: none;
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.45;
    pointer-events: none;
  }

  .brush.is-walked {
    display: inline;
  }

  .dusk-sky {
    display: none;
    fill: var(--bg-region);
    opacity: 0.32;
  }

  .is-dusk .dusk-sky {
    display: inline;
  }

  .arc {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
  }

  .sun,
  .moon {
    display: none;
  }

  .is-day .sun,
  .map:not(.is-day) .moon {
    display: inline;
  }

  .sun path {
    fill: none;
    stroke: var(--red);
    stroke-width: 3.2;
    stroke-linecap: round;
  }

  .sun circle {
    fill: var(--red);
    opacity: 0.82;
  }

