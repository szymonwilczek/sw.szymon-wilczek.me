          ></path>
          <path
            class="line"
            d="M896 652 C 902 656, 906 662, 908 668 M 924 636 C 928 644, 930 654, 932 666 M 952 630 C 956 640, 960 652, 962 666 M 980 644 C 984 652, 988 660, 990 670"
            stroke-width="1"
            opacity="0.7"
          ></path>
          <path
            class="line fill-dim"
            d="M884 677 C 881 706, 886 736, 883 764 C 920 767, 972 763, 1006 766 C 1008 736, 1003 706, 1006 677"
            stroke-width="1.5"
          ></path>
          <path
            class="line fill-alt"
            d="M930 765 C 929 748, 931 730, 930 714 C 939 710, 951 711, 958 714 C 960 732, 957 748, 959 765"
            stroke-width="1.3"
          ></path>
          <circle class="fill-ink" cx="952" cy="740" r="1.8"></circle>
          <path class="line" d="M976 680 C 975 690, 976 696, 975 702" stroke-width="0.9"></path>
          <path
            class="line fill-paper"
            d="M967 702 C 974 700, 980 701, 986 703 C 987 712, 985 720, 986 728 C 980 730, 973 729, 967 728 C 966 720, 968 710, 967 702 Z"
            stroke-width="1"
          ></path>
          <text class="label" x="872" y="792" font-size="18">
            files · the shed
          </text>
        </a>
        <a
          href="/files/verify/"
          class="place"
          data-title={place("/files/verify/").title}
          data-sub={place("/files/verify/").sub}
        >
          <rect class="hit" x="766" y="726" width="100" height="94"></rect>
          <path
            class="line"
            d="M800 760 C 818 756, 840 758, 858 762 M 806 762 C 806 772, 808 778, 806 784 M 852 763 C 853 772, 851 778, 852 784"
            stroke-width="2"
          ></path>
          <g transform="translate(830 744) rotate(-8)">
            <path
              class="fill-red"
              d="M-9 -9 Q0 -11 9 -9 Q11 0 9 9 Q0 11 -9 9 Q-11 0 -9 -9 Z"
              opacity="0.9"
            ></path>
            <text class="seal-glyph" x="0" y="5" text-anchor="middle" font-size="12">
              合
            </text>
          </g>
          <text class="label dim" x="770" y="812" font-size="14">
            the bench · verify
          </text>
        </a>

        <!-- vault -->
        <a
          href="/vault/"
          class="place"
          data-title={place("/vault/").title}
          data-sub={place("/vault/").sub}
        >
          <ellipse
            class="line fill-alt"
            cx="900"
            cy="172"
            rx="58"
            ry="22"
            stroke-width="1.5"
          ></ellipse>
          <path
            class="line fill-dim"
            d="M842 172 C 841 188, 843 202, 842 216 C 870 234, 930 234, 958 216 C 957 202, 959 188, 958 172"
            stroke-width="1.5"
          ></path>
          <path
            class="line faint"
            d="M850 198 C 858 199, 864 199, 870 200 M 884 208 C 892 207, 902 208, 910 208 M 924 202 C 934 201, 942 199, 950 198"
            stroke-width="1.2"
          ></path>
          <path
            class="fill-red"
            d="M900 152 C 908 151, 913 156, 914 162 C 917 169, 913 176, 906 179 C 898 182, 889 179, 886 172 C 883 165, 887 156, 894 153 C 896 152, 898 152, 900 152 Z"
          ></path>
          <text class="seal-glyph" x="900" y="171" text-anchor="middle" font-size="13">
            封
          </text>
          <text class="label" x="850" y="264" font-size="18">
            vault · the well, sealed
          </text>
        </a>

        <!-- about -->
        <a
          href="/about/"
          class="place"
          data-title={place("/about/").title}
          data-sub={place("/about/").sub}
        >
          <g class="glow">
            <circle cx="300" cy="186" r="46" opacity="0.1"></circle>
            <circle cx="300" cy="186" r="24" opacity="0.16"></circle>
          </g>
          <path
            class="line fill-dim"
            d="M300 150 C 300 146, 301 142, 300 138 M 280 160 C 286 152, 314 152, 320 160 C 312 163, 288 163, 280 160 Z"
            stroke-width="1.4"
          ></path>
          <path
            class="line fill-dim"
            d="M287 163 C 286 172, 288 184, 287 196 C 296 198, 304 198, 313 196 C 312 184, 314 172, 313 163"
            stroke-width="1.4"
          ></path>
          <path
            class="flame"
            d="M294 172 C 298 171, 302 171, 306 172 C 307 178, 306 184, 306 188 C 302 189, 298 189, 294 188 C 293 182, 294 177, 294 172 Z"
          ></path>
          <path
            class="line fill-dim"
            d="M276 200 C 288 194, 312 194, 324 200 C 312 204, 288 204, 276 200 Z M 293 204 C 292 216, 294 228, 292 238 M 307 204 C 308 216, 306 228, 308 238 M 282 240 C 294 236, 306 236, 318 240"
            stroke-width="1.4"
          ></path>
          <text class="label" x="252" y="268" font-size="18">
            about · stone lantern
          </text>
        </a>

        <!-- contact -->
        <a
          href="/contact/"
          class="place"
          data-title={place("/contact/").title}
          data-sub={place("/contact/").sub}
        >
          <rect class="hit" x="52" y="490" width="80" height="124"></rect>
          <path class="line" d="M90 610 C 89 590, 91 572, 90 552" stroke-width="1.6"></path>
          <path
            class="line fill-dim"
            d="M72 552 C 72 538, 78 530, 90 529 C 102 530, 108 538, 108 552 C 96 554, 84 554, 72 552 Z"
            stroke-width="1.4"
          ></path>
          <path
            class="flag"
            d="M108 538 C 113 537, 117 538, 120 539 C 121 543, 120 546, 121 549"
          ></path>
          <text class="label" x="58" y="512" font-size="17">
            contact
          </text>
        </a>

        <!-- the years so far -->
        <g
          class="place years"
          tabindex="0"
          data-title="stepping stones"
          data-sub="the years so far · [PLACEHOLDER] CV"
        >
          {STONES.map((s) => (
            <>
              <path
                class="line fill-alt"
                d={`M${s.x} ${s.y} c 10 -9, 30 -9, 38 -1 c 6 7, -2 15, -18 15 c -16 0, -28 -6, -20 -14 Z`}
                stroke-width="1.1"
              />
              <text class="stone-year" x={s.x + 18} y={s.y + 4} text-anchor="middle">
                20[YY]
              </text>
            </>
          ))}
          <text class="label dim" x="330" y="842" font-size="16">
            stepping stones · the years so far
          </text>
        </g>

        <!-- a wolf passed through -->
        <a
          href="/seals/"
          class="place"
          data-title={place("/seals/").title}
          data-sub={place("/seals/").sub}
        >
          <rect class="hit" x="970" y="300" width="96" height="320"></rect>
          <g class="paws">
            {PAWS.map(([x, y, r]) => (
              <g transform={`translate(${x} ${y}) rotate(${r})`}>
                <ellipse cx="0" cy="2" rx="2.6" ry="2.2" />
                <circle cx="-2.6" cy="-2.4" r="1" />
                <circle cx="0" cy="-3.4" r="1" />
                <circle cx="2.6" cy="-2.4" r="1" />
              </g>
            ))}
          </g>
          <text class="label dim" x="1034" y="680" font-size="14" transform="rotate(-72 1034 680)">
            tracks?
          </text>
        </a>

        <!-- 北 -->
        <g transform="translate(560 120)">
          <path
            class="fill-red"
            d="M0 -34 C 3 -24, 5 -14, 6 -6 L 0 0 L -6 -6 C -5 -14, -3 -24, 0 -34 Z"
          ></path>
          <path
            class="line"
            d="M0 34 C 3 24, 5 14, 6 6 L 0 0 L -6 6 C -5 14, -3 24, 0 34 Z M -34 0 C -24 3, -14 5, -6 6 L 0 0 L -6 -6 C -14 -5, -24 -3, -34 0 Z M 34 0 C 24 3, 14 5, 6 6 L 0 0 L 6 -6 C 14 -5, 24 -3, 34 0 Z"
            stroke-width="1.1"
          ></path>
          <text class="north" x="0" y="-42" text-anchor="middle">
            北
          </text>
        </g>

        <!-- trees -->
        <path
          class="leafy"
          d="M128 96 C 120 84, 128 70, 140 72 C 144 60, 162 60, 166 72 C 180 70, 186 86, 176 96 C 184 104, 176 118, 162 114 C 156 124, 138 124, 134 114 C 120 116, 116 102, 128 96 Z"
          stroke-width="1.2"
        ></path>
        <path class="line" d="M152 116 C 151 126, 153 136, 152 146" stroke-width="2"></path>
        <path
          class="leafy"
          d="M972 432 C 966 422, 972 410, 982 412 C 986 402, 1000 402, 1004 412 C 1016 410, 1020 424, 1012 432 C 1018 440, 1010 450, 1000 448 C 994 456, 980 456, 978 448 C 968 450, 964 438, 972 432 Z"
          stroke-width="1.2"
        ></path>
        <path class="line" d="M992 450 C 991 460, 993 468, 992 476" stroke-width="2"></path>
        <path
          class="leafy"
          d="M690 196 C 684 186, 690 174, 700 176 C 704 166, 718 166, 722 176 C 734 174, 738 188, 730 196 C 736 204, 728 214, 718 212 C 712 220, 698 220, 696 212 C 686 214, 682 202, 690 196 Z"
          stroke-width="1.2"
        ></path>
        <path class="line" d="M710 214 C 709 224, 711 232, 710 240" stroke-width="2"></path>

        <!-- the season -->
        {KIGO.map(([x, y, r, s]) => (
          <g transform={`translate(${x} ${y}) rotate(${r}) scale(${s})`} class="kigo-map">
            <path class="kigo-autumn" d={LEAF} />
            <path class="kigo-spring" d="M0 -6 C 5 -6, 7 0, 0 7 C -7 0, -5 -6, 0 -6 Z" />
            <circle class="kigo-winter" r="3.4" />
            <circle class="kigo-summer" r="2.2" />
          </g>
        ))}

        <g class="fireflies">
          <circle cx="232" cy="120" r="2"></circle>
          <circle cx="376" cy="212" r="1.6" opacity="0.7"></circle>
          <circle cx="660" cy="270" r="1.8"></circle>
          <circle cx="540" cy="620" r="1.4" opacity="0.6"></circle>
        </g>
      </svg>

      <div class="map-tag paper" role="status" hidden>
        <span class="map-tag-title"></span>
        <span class="map-tag-sub"></span>
      </div>
    </div>
  </div>

  <div class="legend hand">
    <span>
      <svg width="44" height="8" viewBox="0 0 44 8" aria-hidden="true">
        <path class="legend-walked" d="M2 4 C 14 2, 28 6, 42 4"></path>
      </svg>
      paths you have walked
    </span>
    <span>
      <svg width="44" height="8" viewBox="0 0 44 8" aria-hidden="true">
        <path class="legend-not" d="M2 4 C 14 2, 28 6, 42 4"></path>
      </svg>
      not yet
    </span>
    <span>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <circle class="legend-read" cx="7" cy="7" r="4"></circle>
      </svg>
      an essay you have read flowers
    </span>
    <a href="#plain" class="plain-link">
      the same, as a plain list ↓
    </a>
  </div>

  <section id="plain" class="plain" aria-label="The map as a list">
    <h2>The same, as a plain list</h2>
    <ul>
      {PLACES.map((p) => (
        <li>
          <a href={p.href}>{p.title}</a> <span>— {p.sub}</span>
          {p.href === "/writings/" && (
            <ul>
              {writings.map((w) => (
                <li>
                  <a href={`/writings/${w.slug}/`}>{w.title}</a> <span>— {w.minutes} min</span>
                </li>
              ))}
            </ul>
          )}
          {p.href === "/photos/" && (
            <ul>
              {albums.map((a) => (
                <li>
                  <a href={`/photos/${a.slug}/`}>{a.title}</a> <span>— {a.photoCount} frames</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li>
        stepping stones <span>— the years so far · [PLACEHOLDER] CV</span>
      </li>
    </ul>
  </section>
</BaseLayout>

<script>
  import { earn, load } from "../utils/garden";

  const svg = document.querySelector<SVGSVGElement>(".map")!;
  const inner = document.querySelector<HTMLElement>(".map-inner")!;
  const tag = document.querySelector<HTMLElement>(".map-tag")!;
  const state = load();

  earn("北");

  // paths walked are inked; the rest stay dotted
  const walked = (to: string) => state.paths.some((p) => p === to || p.startsWith(`${to}/`));
  svg.querySelectorAll<SVGPathElement>(".walk").forEach((path) => {
    path.classList.toggle("is-walked", walked(path.dataset.path!));
  });

  // an essay read to the end flowers
  svg.querySelectorAll<SVGElement>(".plant").forEach((plant) => {
    if (!state.read.includes(plant.dataset.slug!)) return;
    plant.classList.add("is-read");
    plant.dataset.sub += " · already read ✓";
  });

  // where the reader came in from
  const came = svg.querySelector(".came")!;
  try {
    const from = document.referrer ? new URL(document.referrer) : null;
    if (from && from.origin === location.origin && from.pathname !== location.pathname) {
      came.textContent = `you came in from ${decodeURI(from.pathname).replace(/(.)\/$/, "$1")}`;
    } else if (from && from.origin !== location.origin) {
      came.textContent = "you came in from outside";
    }
  } catch {
    // keep the gate
  }

  function dusk() {
    const bg = getComputedStyle(document.documentElement).getPropertyValue("--bg-main").trim();
    const probe = document.createElement("canvas").getContext("2d")!;
    probe.fillStyle = bg;
    const hex = probe.fillStyle.startsWith("#") ? probe.fillStyle : "#ffffff";
    const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
    svg.classList.toggle("is-dark", 0.299 * r + 0.587 * g + 0.114 * b < 96);
  }
  dusk();
  document.addEventListener("au-theme-change", dusk);

  let shown: Element | null = null;
  let touch = false;

  function show(place: Element) {
    const el = place as HTMLElement;
    tag.querySelector(".map-tag-title")!.textContent = el.dataset.title ?? "";
    tag.querySelector(".map-tag-sub")!.textContent = el.dataset.sub ?? "";
    tag.hidden = false;
    const box = place.getBoundingClientRect();
    const frame = inner.getBoundingClientRect();
    const left = box.left - frame.left + box.width / 2 - tag.offsetWidth / 2;
    tag.style.left = `${Math.max(4, Math.min(left, frame.width - tag.offsetWidth - 4))}px`;
    tag.style.top = `${Math.max(0, box.top - frame.top - tag.offsetHeight - 8)}px`;
    shown = place;
  }

  function hide() {
    tag.hidden = true;
    shown = null;
  }

  svg.querySelectorAll(".place").forEach((place) => {
    place.addEventListener("pointerenter", (e) => {
      if ((e as PointerEvent).pointerType === "mouse") show(place);
    });
    place.addEventListener("pointerleave", (e) => {
      if ((e as PointerEvent).pointerType === "mouse") hide();
    });
    place.addEventListener("focus", () => show(place));
    place.addEventListener("blur", hide);
    place.addEventListener("pointerdown", (e) => {
      touch = (e as PointerEvent).pointerType !== "mouse";
    });
    place.addEventListener("click", (e) => {
      if (touch && shown !== place) {
        e.preventDefault();
        show(place);
      }
    });
  });

  document.addEventListener("pointerdown", (e) => {
    if (!(e.target as Element).closest(".place")) hide();
  });
</script>

