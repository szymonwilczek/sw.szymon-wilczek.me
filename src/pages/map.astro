<script>
  import { earn, load, season, type Season } from "../utils/garden";

  const svg = document.querySelector<SVGSVGElement>(".map")!;
  const inner = document.querySelector<HTMLElement>(".map-inner")!;
  const tag = document.querySelector<HTMLElement>(".map-tag")!;
  const state = load();

  earn("北");

  // places not walked yet stay grey; the lost corner only counts once you got lost
  const walked = (to: string) => state.paths.some((p) => p === to || p.startsWith(`${to}/`));
  document.querySelectorAll<HTMLElement | SVGElement>("[data-area]").forEach((el) => {
    el.classList.toggle("unseen", !walked(el.dataset.area!));
  });
  svg.querySelectorAll<SVGElement>("[data-seal-area]").forEach((el) => {
    el.classList.toggle("unseen", !state.seals[el.dataset.sealArea!]);
  });

  // paths walked are inked, and so is the way to them from the gate
  svg.querySelectorAll<SVGPathElement>(".brush").forEach((brush) => {
    if (!walked(brush.dataset.path!)) return;
    brush.classList.add("is-walked");
    brush.dataset
      .via!.split(" ")
      .filter(Boolean)
      .forEach((to) => {
        svg.querySelector(`.brush[data-path="${to}"]`)!.classList.add("is-walked");
      });
  });

  // an essay read to the end flowers
  svg.querySelectorAll<SVGElement>(".plant").forEach((plant) => {
    if (!state.read.includes(plant.dataset.slug!)) return;
    plant.classList.add("is-read");
    plant.dataset.sub += " · already read ✓";
  });

  // where the reader came in from
  const came = svg.querySelector(".came")!;
  try {
    const from = document.referrer ? new URL(document.referrer) : null;
    if (from && from.origin === location.origin && from.pathname !== location.pathname) {
      came.textContent = `you came in from ${decodeURI(from.pathname).replace(/(.)\/$/, "$1")}`;
    } else if (from && from.origin !== location.origin) {
      came.textContent = "you came in from outside";
    }
  } catch {
    // keep the gate
  }

  // sheet keeps the reader's hour
  const DAYLIGHT: Record<Season, [number, number]> = {
    spring: [6, 19.25],
    summer: [4.75, 21],
    autumn: [7, 18],
    winter: [7.75, 15.75],
  };
  const NEW_MOON = Date.UTC(2000, 0, 6, 18, 14);
  const pad = (n: number) => String(n).padStart(2, "0");
  const clock = document.querySelector(".clock")!;
  let night = false;

  function moonPath(p: number, r: number) {
    const k = Math.cos(2 * Math.PI * p);
    const rx = Math.abs(k) * r;
    const [outer, inner] = p < 0.5 ? [1, k > 0 ? 0 : 1] : [0, k > 0 ? 1 : 0];
    return `M0 ${-r} A ${r} ${r} 0 0 ${outer} 0 ${r} A ${rx} ${r} 0 0 ${inner} 0 ${-r} Z`;
  }

  function sky() {
    const now = new Date();
    const asked = new URLSearchParams(location.search).get("hour");
    const h = asked !== null ? Number(asked) % 24 : now.getHours() + now.getMinutes() / 60;
    const s = season(now);
    const [rise, set] = DAYLIGHT[s];
    const day = h >= rise && h <= set;
    const t = day
      ? (h - rise) / (set - rise)
      : (h > set ? h - set : h + 24 - set) / (24 - set + rise);
    const lift = Math.sin(Math.PI * t);
    const sx = 80 + 940 * t;
    const sy = 20 - 140 * lift;
    const dusk = Math.abs(h - rise) < 1 || Math.abs(h - set) < 1;
    const phase = ((((now.getTime() - NEW_MOON) / 86400000 / 29.530588853) % 1) + 1) % 1;
    const light = (1 - Math.cos(2 * Math.PI * phase)) / 2;

    svg.querySelector(".sun")!.setAttribute("transform", `translate(${sx} ${sy})`);
    const moon = svg.querySelector(".moon")!;
    moon.setAttribute("transform", `translate(${sx} ${sy}) rotate(-20)`);
    moon.querySelector("path")!.setAttribute("d", moonPath(phase, 14));
    svg.classList.toggle("is-day", day);
    svg.classList.toggle("is-dusk", dusk);
    night = !day;

    const len = day ? 18 + (1 - lift) * 120 : 40 + (1 - lift) * 60;
    const shade = day ? 0.06 + 0.06 * lift : 0.05 * light;
    svg.querySelectorAll<SVGPathElement>(".shadows path").forEach((path) => {
      const [bx, by, w] = path.dataset.at!.split(" ").map(Number);
      const l = w > 100 ? len * 0.5 : len;
      const tx = bx + Math.max(-l, Math.min(l, (bx - sx) * 0.45));
      const ty = by + l;
      path.setAttribute(
        "d",
        `M${bx - w / 2} ${by} Q ${tx - w * 0.4} ${ty} ${tx} ${ty + 2} Q ${tx + w * 0.4} ${ty} ${bx + w / 2} ${by} Z`,
      );
      path.style.opacity = String(shade);
    });

    const kx = Math.max(610, Math.min(790, sx));
    svg
      .querySelector(".glint")!
      .setAttribute("d", `M${kx - 8} 384 q 8 -2 16 0 M ${kx - 2} 398 q 6 -2 12 0`);
    clock.textContent = `${pad(Math.floor(h))}:${pad(Math.floor((h % 1) * 60))} · ${s}${day ? (dusk ? " · dusk" : "") : " · night"}`;
    lamp();
  }

  // lantern is lit at dusk, at night, and in a dark theme
  let dark = false;
  function lamp() {
    svg.classList.toggle("is-lit", dark || night || svg.classList.contains("is-dusk"));
  }

  function dusk() {
    const bg = getComputedStyle(document.documentElement).getPropertyValue("--bg-main").trim();
    const probe = document.createElement("canvas").getContext("2d")!;
    probe.fillStyle = bg;
    const hex = probe.fillStyle.startsWith("#") ? probe.fillStyle : "#ffffff";
    const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
    dark = 0.299 * r + 0.587 * g + 0.114 * b < 96;
    lamp();
  }
  dusk();
  sky();
  setInterval(sky, 60_000);
  document.addEventListener("au-theme-change", dusk);

  let shown: Element | null = null;
  let touch = false;

  function show(place: Element) {
    const el = place as HTMLElement;
    tag.querySelector(".map-tag-title")!.textContent = el.dataset.title ?? "";
    tag.querySelector(".map-tag-sub")!.textContent = el.dataset.sub ?? "";
    tag.hidden = false;
    const box = place.getBoundingClientRect();
    const frame = inner.getBoundingClientRect();
    const left = box.left - frame.left + box.width / 2 - tag.offsetWidth / 2;
    tag.style.left = `${Math.max(4, Math.min(left, frame.width - tag.offsetWidth - 4))}px`;
    tag.style.top = `${Math.max(0, box.top - frame.top - tag.offsetHeight - 8)}px`;
    shown = place;
  }

  function hide() {
    tag.hidden = true;
    shown = null;
  }

  svg.querySelectorAll(".place").forEach((place) => {
    place.addEventListener("pointerenter", (e) => {
      if ((e as PointerEvent).pointerType === "mouse") show(place);
    });
    place.addEventListener("pointerleave", (e) => {
      if ((e as PointerEvent).pointerType === "mouse") hide();
    });
    place.addEventListener("focus", () => show(place));
    place.addEventListener("blur", hide);
    place.addEventListener("pointerdown", (e) => {
      touch = (e as PointerEvent).pointerType !== "mouse";
    });
    place.addEventListener("click", (e) => {
      if (touch && shown !== place) {
        e.preventDefault();
        show(place);
      }
    });
  });

  document.addEventListener("pointerdown", (e) => {
    if (!(e.target as Element).closest(".place")) hide();
  });
</script>

