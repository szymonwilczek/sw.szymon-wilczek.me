---
// Hidden map: the whole site drawn as a garden.
// Not linked from any page and left out of the sitemap; the riddle doors lead here.
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import { getCollection } from "astro:content";
import { getAllAlbums } from "../utils/albums";
import { calculateReadingStats } from "../utils/reading-time";
import { writingSlug } from "../utils/format";
import { HANKO_EDGE } from "../utils/hanko";

const writings = (await getCollection("writings"))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  .map((post) => ({
    slug: writingSlug(post.id),
    title: post.data.title,
    minutes: calculateReadingStats(post.body).minutes,
  }));
const albums = (await getAllAlbums()).slice().reverse();
const files = await getCollection("files");

// plants grow as tall as the essay is long
const step = Math.min(50, 260 / Math.max(writings.length - 1, 1));
const plants = writings.map((w, i) => {
  const x = Math.round(240 + i * step);
  const top = 676 - 40 - Math.min(w.minutes, 40) * 8;
  const mid = Math.round((676 + top) / 2);
  return { ...w, x, x1: x + (i % 2 ? 8 : -8), top, mid };
});

// lilies on the pond, one per album
const PADS = [
  [626, 400, -8],
  [684, 372, 6],
  [740, 410, -3],
  [786, 368, 10],
  [706, 438, -12],
];
const lilies = albums.map((album, i) => {
  const [x, y, r] = PADS[i] ?? [
    610 + ((i * 47) % 190),
    340 + ((i * 31) % 110),
    ((i * 7) % 20) - 10,
  ];
  return { ...album, x, y, r };
});

const STONES = [0, 1, 2, 3, 4].map((i) => ({ x: 340 + i * 92, y: 806 + (i % 2 ? -10 : 4) }));

const PAWS = [
  [1050, 600, -20],
  [1040, 572, -14],
  [1030, 546, -22],
  [1018, 514, -10],
  [1012, 380, -16],
  [1000, 350, -24],
  [984, 318, -30],
];

const LEAF =
  "M0 6 Q -4 5 -6 6 Q -9 5 -8 2 Q -11 0 -10 -2 Q -8 -3 -6 -2 Q -7 -6 -5 -7 Q -3 -6 -2 -4 Q -1 -8 0 -10 Q 1 -8 2 -4 Q 3 -6 5 -7 Q 7 -6 6 -2 Q 8 -3 10 -2 Q 11 0 8 2 Q 9 5 6 6 Q 4 5 0 6 Z";
const KIGO = [
  [744, 232, 24, 1],
  [186, 150, -40, 0.8],
  [1010, 494, 70, 0.9],
];

// paths between places; a path is inked once its place has been walked
const PATHS = [
  { to: "/writings", d: "M156 846 C 168 790, 210 760, 238 712" },
  { to: "/photos", d: "M380 640 C 430 580, 500 560, 560 520 C 600 494, 610 470, 620 456" },
  { to: "/files", d: "M812 452 C 850 500, 830 560, 880 590 C 906 606, 920 620, 930 636" },
  { to: "/files/verify", d: "M156 846 C 230 812, 300 806, 380 800 C 520 792, 700 806, 806 784" },
  { to: "/about", d: "M560 520 C 500 420, 420 320, 330 270" },
  { to: "/vault", d: "M820 330 C 860 280, 880 240, 892 208" },
  { to: "/contact", d: "M238 712 C 180 660, 120 640, 96 612" },
];

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const PLACES = [
  {
    href: "/writings/",
    title: "writings · the bed",
    sub: plural(writings.length, "essay", "essays"),
  },
  { href: "/photos/", title: "photos · the pond", sub: plural(albums.length, "album", "albums") },
  { href: "/photos/stamps/", title: "the jetty", sub: "stamp album" },
  { href: "/files/", title: "files · the shed", sub: plural(files.length, "file", "files") },
  { href: "/files/verify/", title: "the bench", sub: "check a file against its tag" },
  { href: "/vault/", title: "the well, sealed", sub: "vault" },
  { href: "/about/", title: "stone lantern", sub: "about" },
  { href: "/contact/", title: "the mailbox", sub: "contact" },
  { href: "/seals/", title: "tracks?", sub: "the seal book" },
];
const place = (href: string) => PLACES.find((p) => p.href === href)!;
---

<BaseLayout
  title="A map of the garden"
  description="Everything here, drawn as the place it pretends to be."
  noindex
>
  <header class="map-head">
    <div>
      <p class="found hand">
        <svg class="hanko" width="26" height="26" viewBox="0 0 46 46" aria-hidden="true">
          <path class="hanko-edge" d={HANKO_EDGE}></path>
          <text x="23" y="31" text-anchor="middle">
            北
          </text>
        </svg>
        you found it.
      </p>
      <h1>A map of the garden</h1>
      <p class="lede">
        Everything here, drawn as the place it pretends to be. Touch anything on the map to walk
        there. Plants grow as tall as the essay is long; the paths you have already walked are inked
        in.
      </p>
    </div>
    <p class="aside hand">not to scale. nothing here is.</p>
  </header>

  <Divider from={300} to={520} />

  <p class="touch-hint hand">drag to wander → · tap a place to read its tag, tap again to go</p>

  <div class="map-scroll">
    <div class="map-inner">
      <svg class="map" viewBox="0 0 1100 880" role="img" aria-labelledby="map-title">
        <title id="map-title">Hand-drawn map of the site</title>

        <!-- the wall -->
        <path
          class="line"
          d="M196 846 C 420 852, 760 840, 1062 848 C 1070 610, 1064 300, 1068 34 C 760 28, 420 38, 36 30 C 30 300, 38 610, 32 846 L 118 844"
          stroke-width="1.6"
        ></path>
        <path
          class="line fill-dim"
          d="M1068 34 C 1052 52, 1040 48, 1030 62 C 1046 66, 1058 60, 1068 72"
          stroke-width="1.2"
        ></path>
        <path
          class="line"
          d="M118 844 C 117 836, 119 828, 118 820 M 196 846 C 197 838, 195 830, 196 822"
          stroke-width="1.6"
        ></path>
        <text class="label dim" x="128" y="872" font-size="15">
          the gate
        </text>

        {PATHS.map((path) => (
          <path class="walk" data-path={path.to} d={path.d} />
        ))}

        <circle class="here" cx="156" cy="840" r="7"></circle>
        <circle class="here-ring" cx="156" cy="840" r="14"></circle>
