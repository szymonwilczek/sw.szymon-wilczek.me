---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import InkButton from "../../components/InkButton.astro";
import SearchFilter from "../../components/SearchFilter.astro";
import WaxSeal from "../../components/WaxSeal.astro";
import { getCollection } from "astro:content";
import { dottedDate } from "../../utils/format";

const files = (await getCollection("files")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const TILTS = [-0.4, 0.5, -0.2];
---

<BaseLayout
  title="Files"
  description="Standalone utilities, snapshots, packages and sealed archives, each with its SHA-256."
>
  <header class="files-head">
    <div>
      <h1>Files &amp; archives</h1>
      <p class="lede">
        Archive of standalone utilities, snapshots, packages, and sealed archives. Every file
        carries its SHA-256.
      </p>
      <a class="check hand" href="/files/verify/">check a download against its tag →</a>
    </div>
    <SearchFilter
      placeholder="filename, category or sha-256…"
      targetSelector=".file"
      containerSelector=".files"
    />
  </header>

  <Divider from={520} to={760} />

  <ol class="files">
    {files.map((file, i) => (
      <li
        class="file"
        data-search={`${file.data.title} ${file.data.filename} ${file.data.category} ${file.data.description} ${file.data.sha256} ${file.data.encrypted ? "sealed encrypted" : ""}`}
      >
        <p class="file-num" aria-hidden="true">
          {String(i + 1).padStart(2, "0")}
        </p>

        <article class="tag" style={`--tilt: ${TILTS[i % TILTS.length]}deg`}>
          <svg class="corner" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
            <path class="corner-fold" d="M0 0 L 0 24 C 9 25, 18 26, 26 26 Z" />
            <path
              class="corner-edge"
              d="M0.5 0.5 C 1 9, 0.6 17, 0.8 25 C 9 25.4, 17 25.2, 25.5 25.5"
            />
          </svg>
          <span class="hole" aria-hidden="true" />
          <svg class="string" width="24" height="60" viewBox="0 0 24 60" aria-hidden="true">
            <path d="M7 4 C 1 12, 12 22, 6 34 C 2 44, 10 52, 4 60" />
          </svg>

          <div class="tag-body">
            <div class="tag-head">
              <h2>{file.data.title}</h2>
              {file.data.encrypted && <span class="sealed hand">sealed</span>}
              <span class="tag-date">{dottedDate(file.data.date)}</span>
            </div>
            <p class="tag-desc">{file.data.description}</p>

            <dl>
              <dt>file</dt>
              <dd>
                {file.data.filename} <span class="dim">· {file.data.filesize}</span>
              </dd>
              <dt>kind</dt>
              <dd class="kind">{file.data.category.toLowerCase()}</dd>
              <dt>sha-256</dt>
              <dd class="sha">{file.data.sha256}</dd>
            </dl>

            <div class="actions">
              {file.data.encrypted ? (
                <>
                  <WaxSeal size={44} />
                  <InkButton class="unlock" aria-expanded="false">
                    unlock &amp; download
                  </InkButton>
                </>
              ) : (
                file.data.downloadUrl && (
                  <InkButton href={file.data.downloadUrl} download={file.data.filename}>
                    download ↓
                  </InkButton>
                )
              )}
            </div>

            {file.data.encrypted && (
              <form
                class="unseal"
                hidden
                data-filename={file.data.filename}
                data-url={file.data.encryptedUrl}
                data-salt={file.data.salt}
                data-iv={file.data.iv}
              >
                <label>
                  <span>passphrase</span>
                  <input type="password" autocomplete="off" required />
                  <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M0 4.2 C 22 3, 46 5.4, 70 3.6 S 92 4.6, 100 3.8" />
                  </svg>
                </label>
                <InkButton type="submit">break the seal</InkButton>
                <p class="status hand" role="status" />
              </form>
            )}
          </div>
        </article>
      </li>
    ))}
  </ol>

  {files.length === 0 ? (
    <p class="empty hand">nothing here yet.</p>
  ) : (
    <p class="verify hand">
      verify before you trust: <code>sha256sum -c</code>
    </p>
  )}
</BaseLayout>

<script>
  function bytes(b64: string) {
    return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
  }

  // AES-256-GCM with a PBKDF2 key, decrypted in the browser and saved
  async function unseal(form: HTMLFormElement, passphrase: string) {
    const { url, salt, iv, filename } = form.dataset;
    const resp = await fetch(url!);
    if (!resp.ok) throw new Error("fetch");
    const data = await resp.arrayBuffer();

    const material = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(passphrase),
      "PBKDF2",
      false,
      ["deriveKey"],
    );
    const key = await crypto.subtle.deriveKey(
      { name: "PBKDF2", salt: bytes(salt!), iterations: 100000, hash: "SHA-256" },
      material,
      { name: "AES-GCM", length: 256 },
      false,
      ["decrypt"],
    );
    const plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: bytes(iv!) }, key, data);

    const href = URL.createObjectURL(new Blob([plain], { type: "application/octet-stream" }));
    const a = document.createElement("a");
    a.href = href;
    a.download = filename!;
    a.click();
    setTimeout(() => URL.revokeObjectURL(href), 3000);
  }

  document.querySelectorAll<HTMLElement>(".file").forEach((file) => {
    const toggle = file.querySelector<HTMLButtonElement>(".unlock");
    const form = file.querySelector<HTMLFormElement>(".unseal");
    if (!toggle || !form) return;

    const input = form.querySelector("input")!;
    const submit = form.querySelector<HTMLButtonElement>("button")!;
    const status = form.querySelector(".status")!;

    toggle.addEventListener("click", () => {
      form.hidden = !form.hidden;
      toggle.setAttribute("aria-expanded", String(!form.hidden));
      if (!form.hidden) input.focus();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submit.disabled = true;
      status.textContent = "breaking the seal…";
      try {
        await unseal(form, input.value);
        status.textContent = "opened. the download should start.";
        input.value = "";
      } catch {
        status.textContent = "that isn’t the word.";
        input.select();
      } finally {
        submit.disabled = false;
      }
    });
  });
</script>

<style>
  .files-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .files-head > div {
    flex: 999 1 30rem;
    min-width: 0;
    max-width: 40rem;
  }

  .files-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .check {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 1.0625rem;
  }

  .files {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .file {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem 2.5rem;
  }

  .file-num {
    flex: 0 0 6rem;
    margin: 0;
    font-size: 3rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1;
    color: var(--cursor);
  }

  .tag {
    --hole: 1.25rem;
    flex: 999 1 35rem;
    min-width: 0;
    position: relative;
    padding: 1.875rem 2.5rem 1.75rem;
    background: var(--paper);
    border-radius: 2px 0 3px 4px;
    box-shadow:
      0 1px 0 var(--border),
      0 16px 26px -22px rgba(0, 0, 0, 0.5);
    clip-path: polygon(0 0, calc(100% - 26px) 0, 100% 26px, 100% 100%, 0 100%);
    transform: rotate(var(--tilt));
  }

  .corner {
    position: absolute;
    top: 0;
    right: 0;
  }

  .corner-fold {
    fill: var(--bg-alt);
  }

  .corner-edge {
    fill: none;
    stroke: var(--border);
  }

  .hole {
    position: absolute;
    top: 50%;
    left: var(--hole);
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border-radius: 50%;
    background: var(--bg-main);
    box-shadow: inset 0 0 0 1.5px var(--border);
  }

  .string {
    position: absolute;
    top: 50%;
    left: var(--hole);
    margin: -4px 0 0 -6px;
  }

  .string path {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.1;
    stroke-linecap: round;
  }

  .tag-body {
    padding-left: 1.75rem;
  }

  .tag-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .tag-head h2 {
    margin: 0;
    font-size: 1.5625rem;
    line-height: 1.25;
  }

  .sealed {
    display: inline-block;
    font-size: 1.0625rem;
    font-weight: 400;
    color: var(--red);
    transform: rotate(-3deg);
  }

  .tag-date {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .tag-desc {
    max-width: 38.75rem;
    margin: 0.625rem 0 0;
    color: var(--fg-dim);
  }

  dl {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 0.375rem 1.125rem;
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  dt {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1rem;
    font-weight: 300;
    color: var(--fg-dim);
  }

  dd {
    margin: 0;
    color: var(--fg-main);
  }

  .dim {
    color: var(--fg-dim);
  }

  .kind {
    color: var(--accent-0);
  }

  dd.sha {
    font-size: 0.6875rem;
    color: var(--fg-dim);
    word-break: break-all;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.375rem;
  }

  .actions:empty {
    display: none;
  }

  .unseal {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.875rem 1.25rem;
    margin-top: 1.25rem;
  }

  .unseal[hidden] {
    display: none;
  }

  .unseal label {
    flex: 1 1 12.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .unseal label span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .unseal input {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg-main);
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.2em;
    outline: none;
  }

  .unseal label svg {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 8px;
  }

  .unseal label path {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .unseal label:focus-within path {
    stroke: var(--cursor);
  }

  .status {
    flex-basis: 100%;
    margin: 0;
    font-size: 1.0625rem;
  }

  .status:empty {
    display: none;
  }

  .empty,
  .verify {
    margin: 4rem 0 0;
    font-size: 1.1875rem;
    text-align: center;
    transform: rotate(-1deg);
  }

  .verify code {
    padding: 0;
    background: none;
    font-size: 0.8125rem;
  }

  @media (max-width: 47.99em) {
    .files {
      gap: 2.5rem;
    }

    .file-num {
      flex-basis: 100%;
      font-size: 2rem;
    }

    .tag {
      --hole: 0.875rem;
      padding: 1.5rem 1.25rem 1.375rem;
      transform: none;
    }

    .tag-body {
      padding-left: 1.375rem;
    }

    .tag-head h2 {
      font-size: 1.3125rem;
    }

    dl {
      grid-template-columns: 4rem minmax(0, 1fr);
    }
  }
</style>
