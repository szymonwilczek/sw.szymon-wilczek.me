---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import WaxSeal from "../../components/WaxSeal.astro";
import { getCollection } from "astro:content";

const files = (await getCollection("files")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// the same numbers the tags carry on /files
const tags = files.map((file, i) => ({
  num: String(i + 1).padStart(2, "0"),
  title: file.data.title,
  sha256: file.data.sha256.toLowerCase(),
}));
---

<BaseLayout
  title="Verify a file"
  description="Check a downloaded file against the SHA-256 on its tag. The hash is computed in your browser; nothing is uploaded."
>
  <header class="verify-head">
    <p class="crumbs" data-host={Astro.site!.host}>
      <a href="/files/">files</a> / verify
    </p>
    <h1>Is it the same file?</h1>
    <p class="lede">
      Every tag on <a href="/files/">files</a> carries a SHA-256. Drop what you downloaded and your
      browser hashes it and compares it with each tag.
    </p>
  </header>

  <Divider from={520} to={760} />

  <div class="verify" data-tags={JSON.stringify(tags)}>
    <label class="tray">
      <input class="tray-input" type="file" />
      <svg class="tray-edge" viewBox="0 0 400 160" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M6 8 C 90 4, 210 9, 393 5 C 396 50, 392 110, 395 153 C 280 157, 120 152, 7 155 C 3 110, 8 50, 6 8 Z"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>
      <svg class="tray-arrow" width="34" height="40" viewBox="0 0 34 40" aria-hidden="true">
        <path d="M17 3 C 16 13, 18 23, 17 33"></path>
        <path d="M8 25 C 12 28, 15 31, 17 34 C 19 31, 23 27, 27 24"></path>
      </svg>
      <span class="tray-main">drop a downloaded file here</span>
      <span class="tray-sub hand">or tap to choose one · nothing is uploaded</span>
    </label>

    <section class="card reading paper" hidden aria-live="polite">
      <p class="card-name"></p>
      <svg class="brush" viewBox="0 0 400 14" preserveAspectRatio="none" aria-hidden="true">
        <path class="brush-track" d="M3 8 C 100 5, 220 10, 397 6" pathLength="1"></path>
        <path class="brush-ink" d="M3 8 C 100 5, 220 10, 397 6" pathLength="1"></path>
      </svg>
      <p class="card-note hand">
        <span class="pct">0</span>% · hashing in your browser
      </p>
    </section>

    <section class="card match paper" hidden aria-live="polite">
      <WaxSeal glyph="合" size={56} class="card-seal" />
      <h2>it's the same file.</h2>
      <p class="card-name"></p>
      <p class="card-tag"></p>
      <p class="hash">
        <mark></mark>
        <span></span>
      </p>
    </section>

    <section class="card mismatch paper" hidden aria-live="polite">
      <svg class="card-seal hanko" width="56" height="56" viewBox="0 0 46 46" aria-hidden="true">
        <path d="M4 5 Q23 2 42 4 Q45 23 43 42 Q23 45 3 43 Q1 23 4 5 Z"></path>
        <text x="23" y="31" text-anchor="middle">
          違
        </text>
      </svg>
      <h2>no tag carries this hash.</h2>
      <p class="card-name"></p>
      <p class="hash">
        <s></s>
      </p>
      <p class="card-note hand">
        Don't trust it. Download again from <a href="/files">this page</a>, or
        <a href="/contact">write to me</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { earn } from "../../utils/garden";

  interface Tag {
    num: string;
    title: string;
    sha256: string;
  }

  const root = document.querySelector<HTMLElement>(".verify")!;
  const tags: Tag[] = JSON.parse(root.dataset.tags ?? "[]");
  const tray = root.querySelector<HTMLLabelElement>(".tray")!;
  const input = root.querySelector<HTMLInputElement>(".tray-input")!;
  const cards = {
    reading: root.querySelector<HTMLElement>(".reading")!,
    match: root.querySelector<HTMLElement>(".match")!,
    mismatch: root.querySelector<HTMLElement>(".mismatch")!,
  };

  function show(which: keyof typeof cards, name: string) {
    for (const [key, card] of Object.entries(cards)) card.hidden = key !== which;
    cards[which].querySelector(".card-name")!.textContent = name;
  }

  function progress(fraction: number) {
    const pct = Math.round(fraction * 100);
    cards.reading.style.setProperty("--done", String(fraction));
    cards.reading.querySelector(".pct")!.textContent = String(pct);
  }

  /** Reads the file in chunks so the brush can follow, then hashes it whole */
  async function hash(file: File): Promise<string> {
    const reader = file.stream().getReader();
    const bytes = new Uint8Array(file.size);
    let read = 0;
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      bytes.set(value, read);
      read += value.length;
      progress(file.size ? read / file.size : 1);
    }
    const digest = await crypto.subtle.digest("SHA-256", bytes);
    return Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, "0")).join("");
  }

  async function check(file: File) {
    progress(0);
    show("reading", file.name);
    const sum = await hash(file);
    const tag = tags.find((t) => t.sha256 === sum);
    if (tag) {
      show("match", file.name);
      cards.match.querySelector(".card-tag")!.textContent =
        `Matches tag No. ${tag.num} — ${tag.title}`;
      cards.match.querySelector(".hash mark")!.textContent = sum.slice(0, 16);
      cards.match.querySelector(".hash span")!.textContent = sum.slice(16);
      earn("合");
    } else {
      show("mismatch", file.name);
      cards.mismatch.querySelector(".hash s")!.textContent = sum;
    }
  }

  input.addEventListener("change", () => {
    const file = input.files?.[0];
    if (file) check(file);
    input.value = "";
  });

  tray.addEventListener("dragover", (event) => {
    event.preventDefault();
    tray.classList.add("is-over");
  });
  tray.addEventListener("dragleave", () => tray.classList.remove("is-over"));
  tray.addEventListener("drop", (event) => {
    event.preventDefault();
    tray.classList.remove("is-over");
    const file = event.dataTransfer?.files[0];
    if (file) check(file);
  });
</script>

<style>
  .verify-head {
    max-width: 40rem;
  }

  .crumbs {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-dim);
  }

  .verify-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.25rem 0 0;
    color: var(--fg-dim);
  }

  .verify {
    display: grid;
    gap: 2rem;
    max-width: 36rem;
    margin: 0 auto;
  }

  .tray {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2.5rem 1.5rem;
    text-align: center;
    cursor: pointer;
  }

  .tray-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .tray-edge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tray-edge path {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.4;
    stroke-dasharray: 7 6;
    stroke-linecap: round;
    transition: stroke 0.2s;
  }

  .tray-arrow path {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s;
  }

  .tray:is(:hover, .is-over, :focus-within) .tray-edge path {
    stroke: var(--red);
  }

  .tray:is(:hover, .is-over) .tray-arrow path {
    transform: translateY(3px);
  }

  .tray:focus-within {
    outline: none;
  }

  .tray-main {
    font-size: 1.125rem;
  }

  .tray-sub {
    color: var(--fg-dim);
    font-size: 1.0625rem;
  }

  .card {
    position: relative;
    padding: 1.75rem 1.75rem 1.5rem;
    transform: rotate(-0.4deg);
  }

  .card[hidden] {
    display: none;
  }

  .card h2 {
    margin: 0 0 0.5rem;
    padding-right: 4rem;
    font-weight: 400;
  }

  .card h2::before {
    display: none;
  }

  .card-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    word-break: break-all;
  }

  .card-tag {
    margin: 0.5rem 0 0;
    color: var(--fg-dim);
  }

  .card-note {
    margin: 0.75rem 0 0;
    color: var(--fg-dim);
    font-size: 1.0625rem;
  }

  .card :global(.card-seal) {
    position: absolute;
    top: -0.75rem;
    right: 1rem;
    transform: rotate(8deg);
  }

  .hanko {
    opacity: 0.5;
  }

  .hanko path {
    fill: var(--red);
  }

  .hanko text {
    fill: var(--bg-main);
    font-family: var(--font-seal);
    font-size: 22px;
  }

  .hash {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--fg-dim);
    word-break: break-all;
  }

  .hash mark {
    background: none;
    color: var(--fg-main);
  }

  .hash s {
    text-decoration-color: var(--red);
    text-decoration-thickness: 1.5px;
  }

  .brush {
    display: block;
    width: 100%;
    height: 14px;
    margin: 1rem 0 0;
  }

  .brush path {
    fill: none;
    stroke-linecap: round;
  }

  .brush-track {
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .brush-ink {
    stroke: var(--red);
    stroke-width: 4;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--done, 0));
  }

  @media (max-width: 40rem) {
    .tray {
      padding: 2rem 1rem;
    }

    .card {
      padding: 1.5rem 1.25rem 1.25rem;
    }

    .card :global(.card-seal) {
      width: 46px;
      height: 46px;
    }
  }
</style>
