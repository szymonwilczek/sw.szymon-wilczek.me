---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { renderContentEntry } from '../../utils/org';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.(org|md|mdx)$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { slug } = Astro.params;
const { html, Content } = await renderContentEntry(project);
const rawLines = project.body ? project.body.split('\n').length : 0;
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="project-article">
    <header class="project-header">
      <div class="back-link">
        <a href="/projects">&larr; All projects</a>
      </div>
      <h1>{project.data.title}</h1>
      <div class="project-meta">
        <span>Published: <FormattedDate date={project.data.pubDate} /></span>
        {project.data.repo && (
          <span>
            Source Repository: <a href={project.data.repo} target="_blank" rel="noopener">{project.data.repo.replace(/^https?:\/\//, '')}</a>
          </span>
        )}
        <span>Status: <code>{project.data.status}</code></span>
      </div>
    </header>

    <div class="project-content">
      {Content ? <Content /> : <div class="org-content" set:html={html} />}
    </div>

    <footer class="raw-source-container">
      <hr />
      <div class="raw-source-bar">
        <div class="raw-source-info">
          <span class="raw-label">Plain Text Source:</span>
          <code>{project.id}</code>
        </div>
        <div class="raw-source-actions">
          <button type="button" id="toggle-raw-btn" class="raw-action-btn">
            [ View raw .org source ]
          </button>
          <a href={`/projects/${slug}.org`} class="raw-action-btn" target="_blank" rel="noopener">
            [ Open raw buffer ]
          </a>
          <a href={`/projects/${slug}.org`} download={`${slug}.org`} class="raw-action-btn">
            [ Download .org ]
          </a>
        </div>
      </div>

      <div id="raw-code-drawer" class="raw-code-drawer" style="display: none;">
        <div class="raw-drawer-header">
          <span>Buffer: <code>{project.id}</code> ({rawLines} lines)</span>
          <button type="button" id="copy-raw-btn" class="raw-copy-btn">[ Copy buffer ]</button>
        </div>
        <pre class="raw-code-pre"><code>{project.body}</code></pre>
      </div>
    </footer>
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    var toggleBtn = document.getElementById('toggle-raw-btn');
    var drawer = document.getElementById('raw-code-drawer');
    var copyBtn = document.getElementById('copy-raw-btn');

    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', function () {
        var isOpen = drawer.style.display !== 'none';
        drawer.style.display = isOpen ? 'none' : 'block';
        toggleBtn.textContent = isOpen ? '[ View raw .org source ]' : '[ Hide raw source ]';
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var pre = document.querySelector('.raw-code-pre code');
        if (pre) {
          navigator.clipboard.writeText(pre.textContent || '').then(function () {
            copyBtn.textContent = '[ ✓ Copied buffer ]';
            setTimeout(function () { copyBtn.textContent = '[ Copy buffer ]'; }, 2000);
          });
        }
      });
    }
  })();
</script>

<style>
  .project-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .back-link {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .project-header h1 {
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .project-meta {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.9rem;
    color: var(--fg-dim);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-content {
    margin-top: 2.25rem;
  }

  .raw-source-container {
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .raw-source-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .raw-source-info {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .raw-label {
    color: var(--fg-dim);
  }

  .raw-source-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .raw-action-btn {
    display: inline-flex !important;
    align-items: center !important;
    background-color: var(--bg-button) !important;
    border: 1px solid var(--border) !important;
    color: var(--fg-button) !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.84rem !important;
    font-weight: 600 !important;
    padding: 0.4rem 0.85rem !important;
    cursor: pointer !important;
    border-radius: 2px !important;
    text-decoration: none !important;
    line-height: 1.4 !important;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease !important;
  }

  .raw-action-btn:hover {
    background-color: var(--bg-button-hover) !important;
    color: var(--fg-button-hover) !important;
    border-color: var(--fg-button-hover) !important;
  }

  .raw-code-drawer {
    margin-top: 1.25rem;
    border: 1px solid var(--border);
    background-color: var(--bg-dim);
    border-radius: 2px;
  }

  .raw-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background-color: var(--bg-main);
    border-bottom: 1px solid var(--border);
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.82rem;
    color: var(--fg-dim);
  }

  .raw-copy-btn {
    background-color: var(--bg-button) !important;
    border: 1px solid var(--border) !important;
    color: var(--fg-button) !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.8rem !important;
    font-weight: 600 !important;
    padding: 0.25rem 0.6rem !important;
    cursor: pointer !important;
    border-radius: 2px !important;
    transition: all 0.15s ease !important;
  }

  .raw-copy-btn:hover {
    background-color: var(--bg-button-hover) !important;
    color: var(--fg-button-hover) !important;
    border-color: var(--fg-button-hover) !important;
  }

  .raw-code-pre {
    margin: 0 !important;
    padding: 1.25rem !important;
    background: transparent !important;
    border: none !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.88rem !important;
    line-height: 1.6 !important;
    overflow-x: auto !important;
    white-space: pre-wrap !important;
    word-break: break-word !important;
  }
</style>
