---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import SearchFilter from "../../components/SearchFilter.astro";
import Specimen from "../../components/Specimen.astro";
import { PROJECTS, blot, inkOf, languages, repoPath } from "../../utils/projects";
import { repoStats, yearOfInk, type RepoStats } from "../../utils/github";
import { hash, rng } from "../../utils/stamp";
import { projectsList } from "../../utils/schema";

const stats = new Map<string, RepoStats>();
for (const project of PROJECTS) {
  const repo = repoPath(project.url);
  const fetched = repo.site ? null : await repoStats(repo.path);
  if (fetched) stats.set(project.title, fetched);
}

// Without stats from GitHub, "last touched" falls back to when work started
const touched = (project: (typeof PROJECTS)[number]) =>
  stats.get(project.title)?.pushed ?? project.date;
const hasStats = stats.size > 0;
const sampled = [...stats.values()].some((entry) => entry.sample);

const pinned = PROJECTS.filter((project) => project.pinned);
const rest = PROJECTS.filter((project) => !project.pinned).sort((former, latter) =>
  hasStats
    ? touched(latter).localeCompare(touched(former))
    : latter.date.localeCompare(former.date),
);
const langs = languages(PROJECTS);

// A year in ink: every commit of every repository, one blot per day
const year = yearOfInk([...stats.values()].map((entry) => entry.days));
const commits = year.flat().reduce((total, day) => total + day, 0);
const busiest = Math.max(1, ...year.flat());
const jitter = rng(hash("year-in-ink"));
const dots = year.flatMap((week, weekIndex) =>
  week.flatMap((count, dayIndex) => {
    const shiftX = jitter() - 0.5;
    const shiftY = jitter() - 0.5;
    if (!count) return [];
    const strength = Math.sqrt(count / busiest);
    return [
      {
        x: weekIndex * 9 + 4 + shiftX,
        y: dayIndex * 9 + 4 + shiftY,
        r: 1.2 + strength * 2.4,
        o: 0.15 + strength * 0.75,
      },
    ];
  }),
);
const RING =
  "M8 6 C 40 1, 80 2, 95 12 C 101 26, 84 38, 50 38 C 18 39, 1 32, 3 18 C 4 10, 14 4, 30 3";

// each sheet keeps its number in the herbarium and lies a little crooked
const sheetNumber = (project: (typeof PROJECTS)[number]) => PROJECTS.indexOf(project) + 1;
const tilt = (project: (typeof PROJECTS)[number]) => (((sheetNumber(project) * 29) % 9) - 4) / 10;

const search = (project: (typeof PROJECTS)[number]) =>
  `${project.title} ${project.language} ${project.excerpt} ${project.badge ?? ""} ${repoPath(project.url).path}`;
---

<BaseLayout
  title="Projects"
  description="Repositories kept in my garden. Most of these began as a question. Some of them are still answering it."
  collection
  graph={[projectsList(Astro.url, [...pinned, ...rest])]}
>
  <header class="projects-head">
    <div>
      <h1>Projects</h1>
      <p class="lede">Most of these began as a question. Some of them are still answering it.</p>
    </div>
    {commits > 0 && (
      <figure class="ink">
        <svg viewBox="0 0 468 64" role="img" aria-label={`${commits} commits over the last year`}>
          {dots.map((dot) => (
            <circle
              cx={dot.x.toFixed(1)}
              cy={dot.y.toFixed(1)}
              r={dot.r.toFixed(1)}
              opacity={dot.o.toFixed(2)}
            />
          ))}
        </svg>
        <figcaption>
          <span>a year in ink</span>
          {sampled && <span class="sampled">sample ink · no GITHUB_TOKEN here</span>}
          <span>{commits} commits</span>
        </figcaption>
      </figure>
    )}
  </header>

  <Divider from={640} to={860} />

  <div class="tools">
    <div class="langs" role="group" aria-label="Filter by language">
      <button class="lang hand own-focus" type="button" data-lang="" aria-pressed="true">
        <span>
          all <span class="n">{PROJECTS.length}</span>
        </span>
        <svg class="ring" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
          <path d={RING} pathLength="1" vector-effect="non-scaling-stroke"></path>
        </svg>
      </button>
      {langs.map(([lang, count]) => (
        <button class="lang hand own-focus" type="button" data-lang={lang} aria-pressed="false">
          <svg class="blot" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d={blot(`chip-${lang}`, 4.6)} fill={inkOf(lang)} />
          </svg>
          <span>
            {lang} <span class="n">{count}</span>
          </span>
          <svg class="ring" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
            <path d={RING} pathLength="1" vector-effect="non-scaling-stroke" />
          </svg>
        </button>
      ))}
    </div>
    <SearchFilter
      placeholder="name, language or a word…"
      targetSelector=".project"
      containerSelector=".projects"
    />
  </div>

  <div class="projects">
    <p class="section hand">pressed and kept —</p>
    <div class="pinned">
      {pinned.map((item) => (
        <article class="project" data-lang={item.language} data-search={search(item)}>
          <Specimen
            project={item}
            stats={stats.get(item.title)}
            no={sheetNumber(item)}
            tilt={tilt(item)}
          />
        </article>
      ))}
    </div>

    <div class="rest-head">
      <p class="section hand">the rest of the herbarium —</p>
      <p class="sort hand" role="group" aria-label="Order">
        by{" "}
        {hasStats && (
          <>
            <button type="button" data-sort="touched" aria-pressed="true">
              last touched
              <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
                <path d="M2 4 C 30 2, 60 6, 98 3" vector-effect="non-scaling-stroke" />
              </svg>
            </button>{" "}
            ·{" "}
          </>
        )}
        <button type="button" data-sort="started" aria-pressed={String(!hasStats)}>
          collected
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 4 C 30 2, 60 6, 98 3" vector-effect="non-scaling-stroke"></path>
          </svg>
        </button>{" "}
        ·{" "}
        <button type="button" data-sort="name" aria-pressed="false">
          name
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 4 C 30 2, 60 6, 98 3" vector-effect="non-scaling-stroke"></path>
          </svg>
        </button>
      </p>
    </div>

    <ul class="rest">
      {rest.map((item) => (
        <li
          class="project row"
          data-lang={item.language}
          data-search={search(item)}
          data-started={item.date}
          data-name={item.title.toLowerCase()}
          data-touched={touched(item)}
        >
          <Specimen
            project={item}
            stats={stats.get(item.title)}
            no={sheetNumber(item)}
            tilt={tilt(item)}
            small
          />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<script>
  const projects = document.querySelectorAll<HTMLElement>(".project");
  const chips = document.querySelectorAll<HTMLButtonElement>(".lang");

  // language chips narrow the list on top of the text filter
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const lang = chip.dataset.lang;
      chips.forEach((other) => other.setAttribute("aria-pressed", String(other === chip)));
      projects.forEach((project) =>
        project.classList.toggle("lang-off", !!lang && project.dataset.lang !== lang),
      );
    }),
  );

  const list = document.querySelector<HTMLElement>(".rest")!;
  const sorts = document.querySelectorAll<HTMLButtonElement>(".sort button");
  const rows = [...list.querySelectorAll<HTMLElement>(".row")];

  sorts.forEach((button) =>
    button.addEventListener("click", () => {
      const key = button.dataset.sort!;
      sorts.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
      const sorted = [...rows].sort((former, latter) =>
        key === "name"
          ? former.dataset.name!.localeCompare(latter.dataset.name!)
          : latter.dataset[key]!.localeCompare(former.dataset[key]!),
      );
      list.append(...sorted);
    }),
  );
</script>

<style>
  .projects-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
  }

  .projects-head > div {
    flex: 1 1 28rem;
    max-width: 37.5rem;
  }

  .projects-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.125rem 0 0;
    color: var(--fg-dim);
  }

  .ink {
    flex: 0 1 27.5rem;
    margin: 0;
  }

  .ink svg {
    display: block;
    width: 100%;
  }

  .ink circle {
    fill: var(--fg-main);
  }

  .ink figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    color: var(--fg-dim);
  }

  .sampled {
    order: 3;
    flex-basis: 100%;
    color: var(--red);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
  }

  .lang {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0.25rem 0.5rem;
    border: 0;
    background: none;
    color: var(--fg-dim);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
  }

  .lang[aria-pressed="true"] {
    color: var(--fg-main);
  }

  .lang:focus-visible {
    outline: none;
  }

  .n {
    font-size: 0.8em;
    opacity: 0.75;
  }

  .ring {
    position: absolute;
    top: 50%;
    left: -8px;
    width: calc(100% + 16px);
    max-width: none;
    height: 2.2em;
    transform: translateY(-50%);
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .ring path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .lang[aria-pressed="true"] .ring {
    opacity: 1;
  }

  .lang:focus-visible .ring {
    opacity: 0.5;
  }

  .lang[aria-pressed="true"]:focus-visible .ring {
    opacity: 1;
  }

  .lang[aria-pressed="true"]:focus-visible .ring path {
    stroke-width: 2.6;
  }

  .lang:focus-visible .ring path {
    stroke-dasharray: 1;
    animation: ring-draw 0.28s ease-out both;
  }

  @keyframes ring-draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang:focus-visible .ring path {
      animation: none;
    }
  }

  .blot {
    flex: none;
  }

  .section {
    margin: 4rem 0 1.25rem;
    font-size: 1.1875rem;
    font-weight: 300;
    color: var(--fg-dim);
  }

  .lang-off {
    display: none !important;
  }

  .pinned {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 2rem;
  }

  .rest-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin: 4rem 0 1.375rem;
  }

  .rest-head .section {
    margin: 0;
  }

  .sort {
    margin: 0;
    font-size: 1rem;
    color: var(--fg-dim);
  }

  .sort button {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .sort button[aria-pressed="true"] {
    color: var(--fg-main);
  }

  .sort svg {
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 8px;
    opacity: 0;
  }

  .sort path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .sort button[aria-pressed="true"] svg {
    opacity: 1;
  }

  .rest {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.75rem 1.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 47.99em) {
    .section,
    .rest-head {
      margin-top: 2.75rem;
    }

    .pinned {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
