---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import SearchFilter from "../../components/SearchFilter.astro";
import Specimen from "../../components/Specimen.astro";
import { PROJECTS, blot, inkOf, languages, repoPath } from "../../utils/projects";
import { repoStats, yearOfInk, type RepoStats } from "../../utils/github";
import { hash, rng } from "../../utils/stamp";

const stats = new Map<string, RepoStats>();
for (const p of PROJECTS) {
  const repo = repoPath(p.url);
  const s = repo.site ? null : await repoStats(repo.path);
  if (s) stats.set(p.title, s);
}

// Without stats from GitHub, "last touched" falls back to when work started
const touched = (p: (typeof PROJECTS)[number]) => stats.get(p.title)?.pushed ?? p.date;
const hasStats = stats.size > 0;
const sampled = [...stats.values()].some((s) => s.sample);

const pinned = PROJECTS.filter((p) => p.pinned);
const rest = PROJECTS.filter((p) => !p.pinned).sort((a, b) =>
  hasStats ? touched(b).localeCompare(touched(a)) : b.date.localeCompare(a.date),
);
const langs = languages(PROJECTS);

// A year in ink: every commit of every repository, one blot per day
const year = yearOfInk([...stats.values()].map((s) => s.days));
const commits = year.flat().reduce((a, b) => a + b, 0);
const busiest = Math.max(1, ...year.flat());
const jitter = rng(hash("year-in-ink"));
const dots = year.flatMap((week, w) =>
  week.flatMap((n, d) => {
    const dx = jitter() - 0.5;
    const dy = jitter() - 0.5;
    if (!n) return [];
    const v = Math.sqrt(n / busiest);
    return [{ x: w * 9 + 4 + dx, y: d * 9 + 4 + dy, r: 1.2 + v * 2.4, o: 0.15 + v * 0.75 }];
  }),
);
const RING =
  "M8 6 C 40 1, 80 2, 95 12 C 101 26, 84 38, 50 38 C 18 39, 1 32, 3 18 C 4 10, 14 4, 30 3";

// each sheet keeps its number in the herbarium and lies a little crooked
const no = (p: (typeof PROJECTS)[number]) => PROJECTS.indexOf(p) + 1;
const tilt = (p: (typeof PROJECTS)[number]) => (((no(p) * 29) % 9) - 4) / 10;

const search = (p: (typeof PROJECTS)[number]) =>
  `${p.title} ${p.language} ${p.excerpt} ${p.badge ?? ""} ${repoPath(p.url).path}`;
---

<BaseLayout
  title="Projects"
  description="Repositories kept in the garden: a name, one line, a language and the way to the code."
>
  <header class="projects-head">
    <div>
      <h1>Projects</h1>
      <p class="lede">
        Seventeen repositories, most of them still breathing. No case studies: each is a name, one
        line, a language and the way to its code.
      </p>
    </div>
    {commits > 0 && (
      <figure class="ink">
        <svg viewBox="0 0 468 64" role="img" aria-label={`${commits} commits over the last year`}>
          {dots.map((d) => (
            <circle
              cx={d.x.toFixed(1)}
              cy={d.y.toFixed(1)}
              r={d.r.toFixed(1)}
              opacity={d.o.toFixed(2)}
            />
          ))}
        </svg>
        <figcaption>
          <span>a year in ink</span>
          {sampled && <span class="sampled">sample ink · no GITHUB_TOKEN here</span>}
          <span>{commits} commits</span>
        </figcaption>
      </figure>
    )}
  </header>

  <Divider from={640} to={860} />

  <div class="tools">
    <div class="langs" role="group" aria-label="Filter by language">
      <button class="lang hand" type="button" data-lang="" aria-pressed="true">
        <span>all <span class="n">{PROJECTS.length}</span></span>
        <svg class="ring" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
          <path d={RING} vector-effect="non-scaling-stroke"></path>
        </svg>
      </button>
      {langs.map(([lang, n]) => (
        <button class="lang hand" type="button" data-lang={lang} aria-pressed="false">
          <svg class="blot" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d={blot(`chip-${lang}`, 4.6)} fill={inkOf(lang)} />
          </svg>
          <span>{lang} <span class="n">{n}</span></span>
          <svg class="ring" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
            <path d={RING} vector-effect="non-scaling-stroke" />
          </svg>
        </button>
      ))}
    </div>
    <SearchFilter
      placeholder="name, language or a word…"
      targetSelector=".project"
      containerSelector=".projects"
    />
  </div>

  <div class="projects">
    <p class="section hand">pressed and kept —</p>
    <div class="pinned">
      {pinned.map((p) => (
        <article class="project" data-lang={p.language} data-search={search(p)}>
          <Specimen project={p} stats={stats.get(p.title)} no={no(p)} tilt={tilt(p)} />
        </article>
      ))}
    </div>

    <div class="rest-head">
      <p class="section hand">the rest of the herbarium —</p>
      <p class="sort hand" role="group" aria-label="Order">
        by{" "}
        {hasStats && (
          <>
            <button type="button" data-sort="touched" aria-pressed="true">
              last touched
              <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
                <path d="M2 4 C 30 2, 60 6, 98 3" vector-effect="non-scaling-stroke" />
              </svg>
            </button>{" "}
            ·{" "}
          </>
        )}
        <button type="button" data-sort="started" aria-pressed={String(!hasStats)}>
          collected
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 4 C 30 2, 60 6, 98 3" vector-effect="non-scaling-stroke"></path>
          </svg>
        </button>{" "}
        ·{" "}
        <button type="button" data-sort="name" aria-pressed="false">
          name
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 4 C 30 2, 60 6, 98 3" vector-effect="non-scaling-stroke"></path>
          </svg>
        </button>
      </p>
    </div>

    <ul class="rest">
      {rest.map((p) => (
        <li
          class="project row"
          data-lang={p.language}
          data-search={search(p)}
          data-started={p.date}
          data-name={p.title.toLowerCase()}
          data-touched={touched(p)}
        >
          <Specimen project={p} stats={stats.get(p.title)} no={no(p)} tilt={tilt(p)} small />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<script>
  const projects = document.querySelectorAll<HTMLElement>(".project");
  const chips = document.querySelectorAll<HTMLButtonElement>(".lang");

  // language chips narrow the list on top of the text filter
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const lang = chip.dataset.lang;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      projects.forEach((p) => p.classList.toggle("lang-off", !!lang && p.dataset.lang !== lang));
    }),
  );

  const list = document.querySelector<HTMLElement>(".rest")!;
  const sorts = document.querySelectorAll<HTMLButtonElement>(".sort button");
  const rows = [...list.querySelectorAll<HTMLElement>(".row")];

  sorts.forEach((button) =>
    button.addEventListener("click", () => {
      const key = button.dataset.sort!;
      sorts.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      const sorted = [...rows].sort((a, b) =>
        key === "name"
          ? a.dataset.name!.localeCompare(b.dataset.name!)
          : b.dataset[key]!.localeCompare(a.dataset[key]!),
      );
      list.append(...sorted);
    }),
  );
</script>

<style>
  .projects-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
  }

  .projects-head > div {
    flex: 1 1 28rem;
    max-width: 37.5rem;
  }

  .projects-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.125rem 0 0;
    color: var(--fg-dim);
  }

  .ink {
    flex: 0 1 27.5rem;
    margin: 0;
  }

  .ink svg {
    display: block;
    width: 100%;
  }

  .ink circle {
    fill: var(--fg-main);
  }

  .ink figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    color: var(--fg-dim);
  }

  .sampled {
    order: 3;
    flex-basis: 100%;
    color: var(--red);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
  }

  .lang {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0.25rem 0.5rem;
    border: 0;
    background: none;
    color: var(--fg-dim);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
  }

  .lang[aria-pressed="true"] {
    color: var(--fg-main);
  }

  .lang:focus-visible {
    outline: none;
  }

  .n {
    font-size: 0.8em;
    opacity: 0.75;
  }

  .ring {
    position: absolute;
    top: 50%;
    left: -8px;
    width: calc(100% + 16px);
    max-width: none;
    height: 2.2em;
    transform: translateY(-50%);
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .ring path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .lang[aria-pressed="true"] .ring {
    opacity: 1;
  }

  .lang:focus-visible .ring {
    opacity: 0.5;
  }

  .lang[aria-pressed="true"]:focus-visible .ring {
    opacity: 1;
  }

  .lang[aria-pressed="true"]:focus-visible .ring path {
    stroke-width: 2.6;
  }

  .blot {
    flex: none;
  }

  .section {
    margin: 4rem 0 1.25rem;
    font-size: 1.1875rem;
    font-weight: 300;
    color: var(--fg-dim);
  }

  .lang-off {
    display: none !important;
  }

  .pinned {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 2rem;
  }

  .rest-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin: 4rem 0 1.375rem;
  }

  .rest-head .section {
    margin: 0;
  }

  .sort {
    margin: 0;
    font-size: 1rem;
    color: var(--fg-dim);
  }

  .sort button {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .sort button[aria-pressed="true"] {
    color: var(--fg-main);
  }

  .sort svg {
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 8px;
    opacity: 0;
  }

  .sort path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .sort button[aria-pressed="true"] svg {
    opacity: 1;
  }

  .rest {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.75rem 1.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 47.99em) {
    .section,
    .rest-head {
      margin-top: 2.75rem;
    }

    .pinned {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
