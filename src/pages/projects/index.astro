---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Divider from "../../components/Divider.astro";
import SearchFilter from "../../components/SearchFilter.astro";
import { PROJECTS, blot, inkOf, languages, repoPath, since } from "../../utils/projects";

const pinned = PROJECTS.filter((p) => p.pinned);
const rest = PROJECTS.filter((p) => !p.pinned).sort((a, b) => b.date.localeCompare(a.date));
const langs = languages(PROJECTS);

const CARD_TILTS = [-0.6, 0.5, -0.3, 0.7, -0.5, 0.4];
const STAMP_TILTS = [-4, 3, -2, 5, -3, 2];

const search = (p: (typeof PROJECTS)[number]) =>
  `${p.title} ${p.language} ${p.excerpt} ${p.badge ?? ""} ${repoPath(p.url).path}`;
---

<BaseLayout
  title="Projects"
  description="Repositories kept in the garden: a name, one line, a language and the way to the code."
>
  <header class="projects-head">
    <div>
      <h1>Projects</h1>
      <p class="lede">
        Seventeen repositories, most of them still breathing. No case studies: each is a name, one
        line, a language and the way to its code.
      </p>
    </div>
  </header>

  <Divider from={640} to={860} />

  <div class="tools">
    <div class="langs" role="group" aria-label="Filter by language">
      <button class="lang hand" type="button" data-lang="" aria-pressed="true">
        all <span class="n">{PROJECTS.length}</span>
        <svg class="ring" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
          <path
            d="M8 6 C 40 1, 80 2, 95 12 C 101 26, 84 38, 50 38 C 18 39, 1 32, 3 18 C 4 10, 14 4, 30 3"
            vector-effect="non-scaling-stroke"
          ></path>
        </svg>
      </button>
      {langs.map(([lang, n]) => (
        <button class="lang hand" type="button" data-lang={lang} aria-pressed="false">
          <svg class="blot" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d={blot(`chip-${lang}`, 4.6)} fill={inkOf(lang)} />
          </svg>
          {lang} <span class="n">{n}</span>
          <svg class="ring" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M8 6 C 40 1, 80 2, 95 12 C 101 26, 84 38, 50 38 C 18 39, 1 32, 3 18 C 4 10, 14 4, 30 3"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </button>
      ))}
    </div>
    <SearchFilter
      placeholder="name, language or a word…"
      targetSelector=".project"
      containerSelector=".projects"
    />
  </div>

  <div class="projects">
    <p class="section hand">pinned —</p>
    <div class="pinned">
      {pinned.map((p, i) => {
        const repo = repoPath(p.url);
        return (
          <article
            class="project card"
            data-lang={p.language}
            data-search={search(p)}
            style={`--tilt: ${CARD_TILTS[i % CARD_TILTS.length]}deg`}
          >
            <div class="card-head">
              <svg class="book" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3.2 2.4 C 6.2 2.2, 10 2.4, 12.8 2.5 L 12.9 11.2 C 9.8 11, 6.4 11.1, 3.6 11.3 C 2.8 11.4, 2.3 11.9, 2.4 12.6 C 2.5 13.3, 3 13.6, 3.7 13.6 L 5 13.6 M 2.4 12.6 L 2.5 3.4 C 2.5 2.9, 2.8 2.5, 3.2 2.4 Z M 9 13.6 L 12.8 13.5 L 12.9 11.2 M 5.2 12.4 L 5.2 15.4 L 6.2 14.5 L 7.2 15.4 L 7.2 12.4" />
              </svg>
              <h2>
                <a class="name" href={p.url}>
                  {p.title}
                </a>
              </h2>
              {p.badge && (
                <span class="stamp" style={`--tilt: ${STAMP_TILTS[i % STAMP_TILTS.length]}deg`}>
                  {p.badge}
                </span>
              )}
            </div>
            <p class="repo">
              {repo.path}
              {repo.site && " · site"}
            </p>
            <p class="excerpt">{p.excerpt}</p>
            <p class="meta">
              <span class="meta-lang">
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                  <path d={blot(p.title)} fill={inkOf(p.language)} />
                </svg>
                {p.language}
              </span>
              <span>{since(p.date)}</span>
            </p>
          </article>
        );
      })}
    </div>

    <div class="rest-head">
      <p class="section hand">everything else —</p>
      <p class="sort hand" role="group" aria-label="Order">
        by{" "}
        <button type="button" data-sort="started" aria-pressed="true">
          started
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 4 C 30 2, 60 6, 98 3" vector-effect="non-scaling-stroke"></path>
          </svg>
        </button>{" "}
        ·{" "}
        <button type="button" data-sort="name" aria-pressed="false">
          name
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 4 C 30 2, 60 6, 98 3" vector-effect="non-scaling-stroke"></path>
          </svg>
        </button>
      </p>
    </div>

    <ul class="rest">
      {rest.map((p, i) => (
        <li
          class:list={["project", "row", { archived: p.archived }]}
          data-lang={p.language}
          data-search={search(p)}
          data-started={p.date}
          data-name={p.title.toLowerCase()}
        >
          <div class="row-head">
            <h2>
              <a class="name" href={p.url}>
                {p.title}
              </a>
            </h2>
            {p.badge && (
              <span class="stamp" style={`--tilt: ${-3 + (i % 3) * 3}deg`}>
                {p.badge}
              </span>
            )}
            {p.archived && <span class="moss hand">archived — kept, not tended</span>}
          </div>
          <p class="excerpt">{p.excerpt}</p>
          <p class="meta">
            <span class="meta-lang">
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <path d={blot(p.title)} fill={inkOf(p.language)} />
              </svg>
              {p.language}
            </span>
            <span>{since(p.date)}</span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<script>
  const projects = document.querySelectorAll<HTMLElement>(".project");
  const chips = document.querySelectorAll<HTMLButtonElement>(".lang");

  // language chips narrow the list on top of the text filter
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const lang = chip.dataset.lang;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      projects.forEach((p) => p.classList.toggle("lang-off", !!lang && p.dataset.lang !== lang));
    }),
  );

  const list = document.querySelector<HTMLElement>(".rest")!;
  const sorts = document.querySelectorAll<HTMLButtonElement>(".sort button");
  const rows = [...list.querySelectorAll<HTMLElement>(".row")];

  sorts.forEach((button) =>
    button.addEventListener("click", () => {
      const key = button.dataset.sort!;
      sorts.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      const sorted = [...rows].sort((a, b) =>
        key === "name"
          ? a.dataset.name!.localeCompare(b.dataset.name!)
          : b.dataset[key]!.localeCompare(a.dataset[key]!),
      );
      list.append(...sorted);
    }),
  );
</script>

<style>
  .projects-head > div {
    max-width: 37.5rem;
  }

  .projects-head h1 {
    margin: 0;
  }

  .lede {
    margin: 1.125rem 0 0;
    color: var(--fg-dim);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
  }

  .lang {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 0;
    background: none;
    color: var(--fg-dim);
    font-size: 1.0625rem;
    cursor: pointer;
  }

  .lang[aria-pressed="true"] {
    color: var(--fg-main);
  }

  .n {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .ring {
    position: absolute;
    inset: -4px -6px;
    width: calc(100% + 12px);
    height: calc(100% + 8px);
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .ring path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .lang[aria-pressed="true"] .ring {
    opacity: 1;
  }

  .blot,
  .meta-lang svg,
  .book {
    flex: none;
  }

  .section {
    margin: 4rem 0 1.25rem;
    font-size: 1.1875rem;
    font-weight: 300;
    color: var(--fg-dim);
  }

  .lang-off {
    display: none !important;
  }

  .pinned {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.75rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.375rem 1.125rem;
    background: var(--paper);
    border-radius: 3px 5px 4px 6px;
    box-shadow:
      0 1px 0 var(--border),
      0 18px 28px -24px rgba(0, 0, 0, 0.55);
    transform: rotate(var(--tilt));
  }

  .card-head,
  .row-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .row-head {
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
  }

  .book path {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h2 {
    min-width: 0;
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  .card h2 {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .name {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--fg-link);
  }

  .stamp {
    flex: none;
    display: inline-block;
    padding: 1px 7px 0;
    border: 1.4px solid var(--red);
    border-radius: 3px 2px 4px 2px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--red);
    opacity: 0.85;
    transform: rotate(var(--tilt));
  }

  .repo {
    margin: 0.125rem 0 0 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
    overflow-wrap: anywhere;
  }

  .excerpt {
    margin: 0.75rem 0 1rem;
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--fg-dim);
  }

  .card .excerpt {
    flex: 1;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1.125rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .rest-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 4rem;
  }

  .rest-head .section {
    margin: 0;
  }

  .sort {
    margin: 0;
    font-size: 1rem;
    color: var(--fg-dim);
  }

  .sort button {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .sort button[aria-pressed="true"] {
    color: var(--fg-main);
  }

  .sort svg {
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 8px;
    opacity: 0;
  }

  .sort path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .sort button[aria-pressed="true"] svg {
    opacity: 1;
  }

  .rest {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px dashed var(--border);
  }

  .row {
    padding: 1.375rem 0;
    border-bottom: 1px dashed var(--border);
  }

  .row .excerpt {
    margin: 0.375rem 0 0.75rem;
  }

  .archived {
    opacity: 0.62;
  }

  .moss {
    flex: none;
    font-size: 0.9375rem;
    color: var(--accent-0);
    transform: rotate(-2deg);
  }

  @media (max-width: 47.99em) {
    .section {
      margin-top: 2.75rem;
    }

    .rest-head {
      margin-top: 2.75rem;
    }

    .card {
      transform: none;
    }
  }
</style>
