---
// A language pressed as a small hanko, in the ink the theme lends it
import { abbrOf, inkOf } from "../utils/projects";

interface Props {
  language: string;
  size?: number;
  tilt?: number;
}

const { language, size = 26, tilt = 0 } = Astro.props;
const abbr = abbrOf(language);
---

<svg
  class="lang-seal"
  width={size}
  height={size}
  viewBox="0 0 26 26"
  aria-hidden="true"
  style={tilt ? `transform: rotate(${tilt}deg)` : undefined}
>
  <path d="M3 3.5 Q13 2 23 3 Q24 13 23 23 Q13 24 3 23 Q2 13 3 3.5 Z" fill={inkOf(language)}></path>
  <text x="13" y="17" text-anchor="middle" font-size={abbr.length > 2 ? 8 : 10}>{abbr}</text>
</svg>

<style>
  .lang-seal {
    flex: none;
  }

  path {
    opacity: 0.9;
  }

  text {
    font-family: var(--font-mono);
    font-weight: 600;
    fill: var(--bg-main);
  }
</style>
