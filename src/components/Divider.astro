---
interface Props {
  from?: number;
  to?: number;
  class?: string;
}

const { from = 90, to = 300, class: className } = Astro.props;

const line = "M0 14 C 120 12, 180 17, 260 14 S 420 10, 520 15 S 700 17, 780 13 S 930 14, 1000 14";
const crack =
  `M${from} 13 C ${from + 40} 12, ${from + 80} 16, ${from + 130} 12 L ${from + 146} 6 ` +
  `M ${from + 130} 12 C ${from + 170} 10, ${from + 200} 15, ${to} 15 L ${to + 12} 22`;

// winter snow rests on the plain line after the crack
const clipId = `snow-${from}-${to}`;
const snowStart = to + 40;
const snow =
  `M${snowStart} 18 C ${snowStart + 2} 11, ${snowStart + 10} 9, ${snowStart + 22} 8.6 C ${snowStart + 32} 7.4, ${snowStart + 42} 7.8, ${snowStart + 52} 9.2 ` +
  `C ${snowStart + 64} 8.8, ${snowStart + 76} 9.4, ${snowStart + 86} 10.8 C ${snowStart + 94} 11, ${snowStart + 102} 12, ${snowStart + 108} 18 Z ` +
  `M${from - 70} 18 C ${from - 67} 11.6, ${from - 58} 10.6, ${from - 48} 11 ` +
  `C ${from - 40} 10.6, ${from - 34} 11.8, ${from - 30} 18 Z`;
const snowEdge =
  `M${snowStart + 3} 15 C ${snowStart + 5} 11, ${snowStart + 12} 9, ${snowStart + 22} 8.6 C ${snowStart + 32} 7.4, ${snowStart + 42} 7.8, ${snowStart + 52} 9.2 ` +
  `C ${snowStart + 64} 8.8, ${snowStart + 76} 9.4, ${snowStart + 86} 10.8 C ${snowStart + 94} 11, ${snowStart + 101} 12, ${snowStart + 105} 15`;

// ornaments sit in an unstretched layer anchored at the end of the crack
const anchor = `left: calc(${to / 10}% - 105px)`;
---

<div class:list={["divider", className]} aria-hidden="true">
  <svg class="divider-art" viewBox="0 0 1000 28" preserveAspectRatio="none">
    <clipPath id={clipId}>
      <path d={`${line} L 1000 0 L 0 0 Z`}></path>
    </clipPath>
    <g class="kigo-winter" clip-path={`url(#${clipId})`}>
      <path d={snow} class="snow"></path>
      <path d={snowEdge} class="snow-edge" vector-effect="non-scaling-stroke"></path>
    </g>
    <path d={line} class="divider-line" vector-effect="non-scaling-stroke"></path>
    <path d={crack} class="divider-crack" vector-effect="non-scaling-stroke"></path>
  </svg>

  <svg class="kigo" viewBox="-70 -30 140 60" width="210" height="90" style={anchor}>
    <g class="kigo-spring">
      <g class="petals">
        <circle cx="-6" cy="-12" r="3.2"></circle>
        <circle cx="-0.5" cy="-9" r="3.2"></circle>
        <circle cx="-2.5" cy="-3" r="3.2"></circle>
        <circle cx="-9.5" cy="-3" r="3.2"></circle>
        <circle cx="-11.5" cy="-9" r="3.2"></circle>
      </g>
      <circle cx="-6" cy="-7.5" r="1.6" class="pistil"></circle>
      <ellipse
        cx="26"
        cy="9"
        rx="3.2"
        ry="1.9"
        class="petal-loose"
        transform="rotate(30 26 9)"
      ></ellipse>
    </g>

    <g class="kigo-summer">
      <g class="glow">
        <circle cx="-44" cy="-18" r="6"></circle>
        <circle cx="30" cy="-22" r="5"></circle>
      </g>
      <g class="flies">
        <circle cx="-44" cy="-18" r="1.9" style="--d: 0s"></circle>
        <circle cx="-12" cy="-9" r="1.4" style="--d: 1.1s"></circle>
        <circle cx="30" cy="-22" r="1.7" style="--d: 0.5s"></circle>
        <circle cx="54" cy="-8" r="1.2" style="--d: 1.7s"></circle>
      </g>
    </g>

    <g class="kigo-autumn">
      <g class="geese">
        <path
          d="M-1 -24.2 Q3.1 -22.8 6 -22 Q8.8 -24.1 13.1 -25.9"
          style="--w: 1.3; opacity: 0.9"
        ></path>
        <path
          d="M11 -18.4 Q14.5 -17.2 17 -16.5 Q19.4 -18.3 23.1 -19.8"
          style="--w: 1.15; opacity: 0.8"
        ></path>
        <path
          d="M21.6 -13.7 Q24.7 -12.6 27 -12 Q29.2 -13.6 32.5 -15"
          style="--w: 1.05; opacity: 0.7"
        ></path>
        <path
          d="M-10.6 -16.8 Q-7.4 -15.7 -5 -15 Q-2.8 -16.7 0.7 -18.1"
          style="--w: 1.05; opacity: 0.65"
        ></path>
        <path
          d="M33.6 -9.4 Q36.2 -8.5 38 -8 Q39.8 -9.3 42.5 -10.4"
          style="--w: 0.9; opacity: 0.5"
        ></path>
      </g>
    </g>

    <g class="kigo-winter flakes">
      <path d="M40 -26 L 40 -18 M 36.5 -24 L 43.5 -20 M 36.5 -20 L 43.5 -24"></path>
      <path
        d="M64 -14 L 64 -8 M 61.4 -12.5 L 66.6 -9.5 M 61.4 -9.5 L 66.6 -12.5"
        opacity="0.7"
      ></path>
      <path
        d="M-30 -24 L -30 -19 M -32.2 -22.8 L -27.8 -20.2 M -32.2 -20.2 L -27.8 -22.8"
        opacity="0.55"
      ></path>
      <circle cx="52" cy="-2" r="1.2"></circle>
      <circle cx="-14" cy="-16" r="1"></circle>
    </g>
  </svg>
</div>

<style>
  .divider {
    position: relative;
    height: 28px;
    overflow-x: clip;
    margin: 3.5rem 0 4rem;
  }

  .divider-art {
    display: block;
    width: 100%;
    height: 28px;
    overflow: visible;
  }

  .divider path {
    fill: none;
  }

  .divider-line {
    stroke: var(--border);
    stroke-width: 1;
  }

  .divider-crack {
    stroke: var(--cursor);
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* seasons: only the reader's current one is drawn */
  .kigo {
    position: absolute;
    top: -31px;
    overflow: visible;
    pointer-events: none;
  }

  .kigo-spring,
  .kigo-summer,
  .kigo-autumn,
  .kigo-winter {
    display: none;
  }

  :global([data-season="spring"]) .kigo-spring,
  :global([data-season="summer"]) .kigo-summer,
  :global([data-season="autumn"]) .kigo-autumn,
  :global([data-season="winter"]) .kigo-winter {
    display: inline;
  }

  .petals circle {
    fill: var(--red);
    opacity: 0.55;
  }

  .pistil {
    fill: var(--cursor);
  }

  .petal-loose {
    fill: var(--red);
    opacity: 0.45;
  }

  .glow circle {
    fill: var(--cursor);
    opacity: 0.18;
  }

  .flies circle {
    fill: var(--cursor);
    animation: glimmer 3.2s ease-in-out var(--d) infinite;
  }

  @keyframes glimmer {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 0.25;
    }
  }

  .geese path {
    stroke: var(--fg-main);
    stroke-width: var(--w);
    stroke-linecap: round;
  }

  :global(.kigo-drift) .geese {
    animation: geese-in 4.2s cubic-bezier(0.2, 0.6, 0.3, 1) both;
  }

  @keyframes geese-in {
    0% {
      opacity: 0;
      transform: translate(-70px, 10px);
    }
    25% {
      opacity: 1;
    }
    100% {
      transform: none;
    }
  }

  .divider .snow {
    fill: #f4f1ea;
  }

  .divider .snow-edge {
    stroke: var(--border);
    stroke-width: 0.8;
    stroke-linecap: round;
  }

  .flakes path {
    stroke: var(--fg-dim);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .flakes circle {
    fill: var(--fg-dim);
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .flies circle,
    :global(.kigo-drift) .geese {
      animation: none;
    }
  }

  @media (max-width: 47.99em) {
    .divider {
      margin: 2.25rem 0 2.5rem;
    }
  }
</style>
