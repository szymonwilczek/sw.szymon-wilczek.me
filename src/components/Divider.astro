---
interface Props {
  from?: number;
  to?: number;
  class?: string;
}

const { from = 90, to = 300, class: className } = Astro.props;

const line = "M0 14 C 120 12, 180 17, 260 14 S 420 10, 520 15 S 700 17, 780 13 S 930 14, 1000 14";
const crack =
  `M${from} 13 C ${from + 40} 12, ${from + 80} 16, ${from + 130} 12 L ${from + 146} 6 ` +
  `M ${from + 130} 12 C ${from + 170} 10, ${from + 200} 15, ${to} 15 L ${to + 12} 22`;

// winter snow rests on the plain line after the crack
const clipId = `snow-${from}-${to}`;
const s = to + 40;
const snow =
  `M${s} 18 C ${s + 2} 11, ${s + 10} 9, ${s + 22} 8.6 C ${s + 32} 7.4, ${s + 42} 7.8, ${s + 52} 9.2 ` +
  `C ${s + 64} 8.8, ${s + 76} 9.4, ${s + 86} 10.8 C ${s + 94} 11, ${s + 102} 12, ${s + 108} 18 Z ` +
  `M${from - 70} 18 C ${from - 67} 11.6, ${from - 58} 10.6, ${from - 48} 11 ` +
  `C ${from - 40} 10.6, ${from - 34} 11.8, ${from - 30} 18 Z`;
const snowEdge =
  `M${s + 3} 15 C ${s + 5} 11, ${s + 12} 9, ${s + 22} 8.6 C ${s + 32} 7.4, ${s + 42} 7.8, ${s + 52} 9.2 ` +
  `C ${s + 64} 8.8, ${s + 76} 9.4, ${s + 86} 10.8 C ${s + 94} 11, ${s + 101} 12, ${s + 105} 15`;

// leaf with rounded lobes
const leaf =
  "M0 6 Q -4 5 -6 6 Q -9 5 -8 2 Q -11 0 -10 -2 Q -8 -3 -6 -2 Q -7 -6 -5 -7 Q -3 -6 -2 -4 " +
  "Q -1 -8 0 -10 Q 1 -8 2 -4 Q 3 -6 5 -7 Q 7 -6 6 -2 Q 8 -3 10 -2 Q 11 0 8 2 Q 9 5 6 6 Q 4 5 0 6 Z";

// ornaments sit in an unstretched layer anchored at the end of the crack
const anchor = `left: calc(${to / 10}% - 105px)`;
---

<div class:list={["divider", className]} aria-hidden="true">
  <svg class="divider-art" viewBox="0 0 1000 28" preserveAspectRatio="none">
    <clipPath id={clipId}>
      <path d={`${line} L 1000 0 L 0 0 Z`}></path>
    </clipPath>
    <g class="kigo-winter" clip-path={`url(#${clipId})`}>
      <path d={snow} class="snow"></path>
      <path d={snowEdge} class="snow-edge" vector-effect="non-scaling-stroke"></path>
    </g>
    <path d={line} class="divider-line" vector-effect="non-scaling-stroke"></path>
    <path d={crack} class="divider-crack" vector-effect="non-scaling-stroke"></path>
  </svg>

  <svg class="kigo" viewBox="-70 -30 140 60" width="210" height="90" style={anchor}>
    <g class="kigo-spring">
      <g class="petals">
        <circle cx="-6" cy="-12" r="3.2"></circle>
        <circle cx="-0.5" cy="-9" r="3.2"></circle>
        <circle cx="-2.5" cy="-3" r="3.2"></circle>
        <circle cx="-9.5" cy="-3" r="3.2"></circle>
        <circle cx="-11.5" cy="-9" r="3.2"></circle>
      </g>
      <circle cx="-6" cy="-7.5" r="1.6" class="pistil"></circle>
      <ellipse
        cx="26"
        cy="9"
        rx="3.2"
        ry="1.9"
        class="petal-loose"
        transform="rotate(30 26 9)"
      ></ellipse>
    </g>

    <g class="kigo-summer">
      <g class="glow">
        <circle cx="-44" cy="-18" r="6"></circle>
        <circle cx="30" cy="-22" r="5"></circle>
      </g>
      <g class="flies">
        <circle cx="-44" cy="-18" r="1.9" style="--d: 0s"></circle>
        <circle cx="-12" cy="-9" r="1.4" style="--d: 1.1s"></circle>
        <circle cx="30" cy="-22" r="1.7" style="--d: 0.5s"></circle>
        <circle cx="54" cy="-8" r="1.2" style="--d: 1.7s"></circle>
      </g>
    </g>

    <g class="kigo-autumn">
      <g class="leaf-fall">
        <g transform="translate(34 -4) rotate(-22) scale(1.1)">
          <path d={leaf} class="leaf"></path>
          <path d="M0 6 C 0.5 8, 1.5 9.5, 3 10.5" class="stem"></path>
        </g>
      </g>
    </g>

    <g class="kigo-winter flakes">
      <path d="M40 -26 L 40 -18 M 36.5 -24 L 43.5 -20 M 36.5 -20 L 43.5 -24"></path>
      <path
        d="M64 -14 L 64 -8 M 61.4 -12.5 L 66.6 -9.5 M 61.4 -9.5 L 66.6 -12.5"
        opacity="0.7"
      ></path>
      <path
        d="M-30 -24 L -30 -19 M -32.2 -22.8 L -27.8 -20.2 M -32.2 -20.2 L -27.8 -22.8"
        opacity="0.55"
      ></path>
      <circle cx="52" cy="-2" r="1.2"></circle>
      <circle cx="-14" cy="-16" r="1"></circle>
    </g>
  </svg>
</div>

<style>
  .divider {
    position: relative;
    height: 28px;
    overflow-x: clip;
    margin: 3.5rem 0 4rem;
  }

  .divider-art {
    display: block;
    width: 100%;
    height: 28px;
    overflow: visible;
  }

  .divider path {
    fill: none;
  }

  .divider-line {
    stroke: var(--border);
    stroke-width: 1;
  }

  .divider-crack {
    stroke: var(--cursor);
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* seasons: only the reader's current one is drawn */
  .kigo {
    position: absolute;
    top: -31px;
    overflow: visible;
    pointer-events: none;
  }

  .kigo-spring,
  .kigo-summer,
  .kigo-autumn,
  .kigo-winter {
    display: none;
  }

  :global([data-season="spring"]) .kigo-spring,
  :global([data-season="summer"]) .kigo-summer,
  :global([data-season="autumn"]) .kigo-autumn,
  :global([data-season="winter"]) .kigo-winter {
    display: inline;
  }

  .petals circle {
    fill: var(--red);
    opacity: 0.55;
  }

  .pistil {
    fill: var(--cursor);
  }

  .petal-loose {
    fill: var(--red);
    opacity: 0.45;
  }

  .glow circle {
    fill: var(--cursor);
    opacity: 0.18;
  }

  .flies circle {
    fill: var(--cursor);
    animation: glimmer 3.2s ease-in-out var(--d) infinite;
  }

  @keyframes glimmer {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 0.25;
    }
  }

  .divider .leaf {
    fill: var(--red);
    stroke: var(--red-warmer);
    stroke-width: 0.4;
    stroke-linejoin: round;
  }

  .divider .stem {
    stroke: var(--red-warmer);
    stroke-width: 0.8;
    stroke-linecap: round;
  }

  :global(.kigo-drift) .leaf-fall {
    animation: leaf-fall 3.4s cubic-bezier(0.3, 0.1, 0.3, 1) both;
  }

  @keyframes leaf-fall {
    0% {
      opacity: 0;
      transform: translate(-40px, -90px) rotate(50deg);
    }
    15% {
      opacity: 1;
    }
    40% {
      transform: translate(-6px, -58px) rotate(-18deg);
    }
    65% {
      transform: translate(-30px, -26px) rotate(26deg);
    }
    85% {
      transform: translate(-8px, -6px) rotate(-6deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .divider .snow {
    fill: #f4f1ea;
  }

  .divider .snow-edge {
    stroke: var(--border);
    stroke-width: 0.8;
    stroke-linecap: round;
  }

  .flakes path {
    stroke: var(--fg-dim);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .flakes circle {
    fill: var(--fg-dim);
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .flies circle,
    :global(.kigo-drift) .leaf-fall {
      animation: none;
    }
  }

  @media (max-width: 47.99em) {
    .divider {
      margin: 2.25rem 0 2.5rem;
    }
  }
</style>
