---
import Navigation from './Navigation.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const currentYear = new Date().getFullYear();
---

<aside id="site-sidebar" class="site-sidebar" aria-label="Site Sidebar">
  <div class="sidebar-top">
    <div class="sidebar-header-row">
      <header class="sidebar-header">
        <a href="/" class="site-title">Szymon Wilczek</a>
      </header>
      <button id="menu-close" class="drawer-close-btn" aria-label="Close navigation menu">
        [Close]
      </button>
    </div>
    <hr class="sidebar-divider" />
    <Navigation currentPath={currentPath} />
  </div>

  <div class="sidebar-bottom">
    <footer class="sidebar-footer">
      <p>(C) {currentYear} Szymon Wilczek</p>
    </footer>
  </div>
</aside>

<script>
  function setupMobileDrawer() {
    const sidebar = document.getElementById('site-sidebar');
    const openBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('menu-close');
    const backdrop = document.getElementById('drawer-backdrop');

    if (!sidebar) return;

    function openMenu() {
      document.body.classList.add('menu-open');
      sidebar?.classList.add('is-open');
      openBtn?.setAttribute('aria-expanded', 'true');
      closeBtn?.focus();
    }

    function closeMenu() {
      document.body.classList.remove('menu-open');
      sidebar?.classList.remove('is-open');
      openBtn?.setAttribute('aria-expanded', 'false');
      openBtn?.focus();
    }

    openBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    sidebar.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 1024) {
          closeMenu();
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.body.classList.contains('menu-open')) {
        closeMenu();
      }
    });
  }

  setupMobileDrawer();
  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>

<style>
  .site-sidebar {
    background-color: var(--bg-dim);
    color: var(--fg-main);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 1000;
  }

  /* Desktop layout */
  @media (min-width: 64em) {
    .site-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-width, 275px);
      padding: 3rem 2rem 2rem 2rem;
      border-right: 1px solid var(--border);
      overflow-y: auto;
    }

    .drawer-close-btn {
      display: none !important;
    }
  }

  /* Mobile sliding drawer */
  @media (max-width: 63.99em) {
    .site-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 290px;
      max-width: 85vw;
      padding: 1.5rem;
      border-right: 1px solid var(--border);
      overflow-y: auto;
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: none;
    }

    .site-sidebar.is-open {
      transform: translateX(0);
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.7);
    }

    .sidebar-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
    }

    .drawer-close-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--yellow-warmer);
      font-family: "Typus Mono 95", "Typus Mono", monospace;
      font-size: 0.82rem;
      padding: 0.2rem 0.5rem;
      cursor: pointer;
      border-radius: 2px;
    }

    .drawer-close-btn:hover {
      color: var(--cyan-cooler);
      background-color: var(--bg-alt);
    }
  }

  .site-title {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--fg-main);
    text-decoration: none;
    display: block;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .site-title:hover {
    color: var(--yellow-warmer);
    text-decoration: none;
  }

  .sidebar-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.15rem 0;
  }

  .sidebar-footer {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.85rem;
    color: var(--fg-dim);
    line-height: 1.4;
    padding-top: 1.5rem;
  }

  .sidebar-footer p {
    margin: 0;
  }
</style>
