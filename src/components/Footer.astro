---
import { HANKO_EDGE } from "../utils/hanko";

const currentYear = new Date().getFullYear();

const links = [
  { href: "/map/", label: "map" },
  { href: "/contact/", label: "contact" },
  { href: "/credits/", label: "credits" },
  { href: "/rss.xml", label: "rss" },
  { href: "/vault/", label: "vault" },
];
---

<footer class="site-footer">
  <nav aria-label="Secondary" class="footer-nav">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a href="/seals/" class="seal-count" aria-label="seal book" hidden>
      <svg width="14" height="14" viewBox="0 0 46 46" aria-hidden="true">
        <path d={HANKO_EDGE}></path>
        <text x="23" y="31" text-anchor="middle">
          狼
        </text>
      </svg>
      <span class="seal-count-n"></span>
    </a>
  </nav>
  <span>
    © {currentYear} Szymon Wilczek · built with Astro ·
    <span data-theme-id>au-salina-night</span>
    <span class="kigo-word" hidden>
      · <span class="kigo-glyph"></span>
      <span class="kigo-romaji"></span>
    </span>
  </span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--fg-dim);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .footer-nav a {
    color: inherit;
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--fg-main);
  }

  .seal-count {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .seal-count[hidden] {
    display: none;
  }

  .seal-count path {
    fill: var(--red);
  }

  .seal-count text {
    fill: var(--paper);
    font-family: var(--font-seal);
    font-size: 26px;
  }

  .seal-count-n {
    color: var(--fg-main);
  }

  .kigo-word {
    cursor: help;
  }

  .kigo-glyph {
    font-family: var(--font-seal);
    font-size: 0.9375rem;
    color: var(--red);
  }

  @media (max-width: 47.99em) {
    .site-footer {
      margin-top: 4rem;
    }
  }
</style>

<script>
  import { season, SEASONS } from "../utils/garden";

  // season word: glyph and romaji
  const currentSeason = season();
  const word = document.querySelector<HTMLElement>(".kigo-word");
  if (word) {
    word.querySelector(".kigo-glyph")!.textContent = SEASONS[currentSeason].glyph;
    word.querySelector(".kigo-romaji")!.textContent = SEASONS[currentSeason].romaji;
    word.title = `${currentSeason}, then ${SEASONS[currentSeason].next}`;
    word.hidden = false;
  }
</script>

<script is:inline>
  (function () {
    function show() {
      var themeId = window.auTheme.resolve(window.auTheme.get());
      document.querySelectorAll("[data-theme-id]").forEach(function (label) {
        label.textContent = "au-" + themeId;
      });
    }

    document.addEventListener("au-theme-change", show);
    show();
  })();
</script>
