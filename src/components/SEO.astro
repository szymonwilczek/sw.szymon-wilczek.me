---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  author?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
  prevUrl?: string;
  nextUrl?: string;
  collection?: boolean;
  wordCount?: number;
  graph?: Record<string, unknown>[];
}

const SITE_DESCRIPTION =
  "The garden of Szymon Wilczek: low-level computing, Linux and Emacs, open-source projects, photographs, and small rooms drawn in ink.";

const {
  title = "Szymon Wilczek",
  description = SITE_DESCRIPTION,
  image = "/og-default.png",
  imageAlt = "Szymon Wilczek - Software Engineer",
  type = "website",
  pubDate,
  updatedDate,
  category,
  tags = [],
  author = "Szymon Wilczek",
  noindex = false,
  breadcrumbs,
  prevUrl,
  nextUrl,
  collection = false,
  wordCount,
  graph = [],
} = Astro.props;

const siteUrl = Astro.site!.origin;
const pageTitle = title === "Szymon Wilczek" ? title : `${title} · Szymon Wilczek`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(
  image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`,
  siteUrl,
);

const ogImageSize =
  image === "/og-default.png" || image.startsWith("/og/") ? { width: 1200, height: 630 } : {};

const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const defaultKeywords = [
  "Szymon Wilczek",
  "software engineer",
  "systems programming",
  "C",
  "Linux",
  "GNU Emacs",
  "open source",
  "typography",
  "photography",
];
const allKeywords = Array.from(new Set([...tags, ...defaultKeywords]));

// auto-construct breadcrumb list if not explicitly provided
let breadcrumbItems = breadcrumbs;
if (!breadcrumbItems && Astro.url.pathname !== "/") {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  breadcrumbItems = [{ name: "Home", url: `${siteUrl}/` }];
  let currentPath = "";
  for (let i = 0; i < segments.length; i++) {
    const seg = segments[i];
    currentPath += `/${seg}`;
    if (i === segments.length - 1 && title !== "Szymon Wilczek") {
      breadcrumbItems.push({ name: title, url: `${siteUrl}${currentPath}/` });
    } else {
      const segName = seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, " ");
      breadcrumbItems.push({ name: segName, url: `${siteUrl}${currentPath}/` });
    }
  }
}

// One JSON-LD graph per page
const personId = `${siteUrl}/#identity`;
const websiteId = `${siteUrl}/#website`;
const pageId = `${canonicalURL.href}#webpage`;
const breadcrumbId = `${canonicalURL.href}#breadcrumb`;

const person = {
  "@type": "Person",
  "@id": personId,
  name: "Szymon Wilczek",
  givenName: "Szymon",
  familyName: "Wilczek",
  url: `${siteUrl}/`,
  image: {
    "@type": "ImageObject",
    "@id": `${siteUrl}/#avatar`,
    url: `${siteUrl}/avatar.png`,
    width: 1254,
    height: 1254,
  },
  email: "mailto:swilczek.lx@gmail.com",
  jobTitle: "Software Engineer",
  description:
    "Software engineer working close to the metal: C, Linux and GNU Emacs, open-source tools, typography and photography.",
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Silesian University of Technology",
    sameAs: "https://en.wikipedia.org/wiki/Silesian_University_of_Technology",
  },
  sameAs: ["https://github.com/szymonwilczek"],
  knowsAbout: [
    "Systems programming",
    "C",
    "Linux",
    "GNU Emacs",
    "Open-source software",
    "Typography and type design",
    "Photography",
  ],
};

const website = {
  "@type": "WebSite",
  "@id": websiteId,
  url: `${siteUrl}/`,
  name: "Szymon Wilczek",
  description: SITE_DESCRIPTION,
  author: { "@id": personId },
  publisher: { "@id": personId },
  inLanguage: "en",
};

const breadcrumb =
  breadcrumbItems && breadcrumbItems.length > 1
    ? {
        "@type": "BreadcrumbList",
        "@id": breadcrumbId,
        itemListElement: breadcrumbItems.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: item.url,
        })),
      }
    : null;

const PAGE_TYPES = { website: "WebPage", article: "WebPage", profile: "ProfilePage" } as const;

const webpage = {
  "@type": PAGE_TYPES[type],
  ...(collection ? { "@type": ["WebPage", "CollectionPage"] } : {}),
  "@id": pageId,
  url: canonicalURL.href,
  name: pageTitle,
  description,
  isPartOf: { "@id": websiteId },
  about: { "@id": personId },
  inLanguage: "en",
  primaryImageOfPage: { "@type": "ImageObject", url: ogImageURL.href },
  ...(breadcrumb ? { breadcrumb: { "@id": breadcrumbId } } : {}),
  ...(type === "profile" ? { mainEntity: { "@id": personId } } : {}),
  ...(type === "article" ? { mainEntity: { "@id": `${canonicalURL.href}#article` } } : {}),
  ...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
};

const article =
  type === "article"
    ? {
        "@type": "BlogPosting",
        "@id": `${canonicalURL.href}#article`,
        mainEntityOfPage: { "@id": pageId },
        isPartOf: { "@id": websiteId },
        headline: title,
        name: title,
        description,
        image: { "@type": "ImageObject", url: ogImageURL.href, ...ogImageSize },
        datePublished: pubDate?.toISOString(),
        dateModified: (updatedDate ?? pubDate)?.toISOString(),
        author: { "@id": personId },
        publisher: { "@id": personId },
        keywords: tags.length > 0 ? tags : undefined,
        articleSection: category || "Essay",
        wordCount,
        inLanguage: "en",
      }
    : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [person, website, webpage, breadcrumb, article, ...graph].filter(Boolean),
};
---

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="creator" content={author} />
<meta name="publisher" content={author} />
<meta name="keywords" content={allKeywords.join(", ")} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#dad8cf" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101414" />

<link rel="canonical" href={canonicalURL} />

{prevUrl && <link rel="prev" href={prevUrl} />}
{nextUrl && <link rel="next" href={nextUrl} />}

<meta property="og:site_name" content="Szymon Wilczek" />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:alt" content={imageAlt} />
{ogImageSize.width && <meta property="og:image:width" content={String(ogImageSize.width)} />}
{ogImageSize.height && <meta property="og:image:height" content={String(ogImageSize.height)} />}

{type === "article" && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === "article" && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{type === "article" && <meta property="article:author" content={`${siteUrl}/about/`} />}
{type === "article" && category && <meta property="article:section" content={category} />}
{type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:creator" content="@szymonwilczek" />
<meta name="twitter:site" content="@szymonwilczek" />

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="alternate" type="application/rss+xml" title="Szymon Wilczek RSS Feed" href="/rss.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context" />
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM Full Text" />
<link rel="author" href="/about/" />
<link rel="me" href="https://github.com/szymonwilczek" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
