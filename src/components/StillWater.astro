---
// A strip of still water at the end of the photo pages and /about
// Carry the maple leaf to the far bank with waves alone to earn seal.

import { artUrl } from "../utils/art";
import { LAYOUTS } from "../utils/water";

// drawings live in /art/; only the one this screen shows is fetched up front
const layouts = [
  { name: "wide", L: LAYOUTS.wide, media: "(min-width: 48em)" },
  { name: "tall", L: LAYOUTS.tall, media: "(max-width: 47.99em)" },
] as const;
---

<figure class="still-water">
  {layouts.map(({ name, L: layout, media }) => (
    <>
      <link
        rel="preload"
        href={artUrl(`water-${name}`)}
        as="fetch"
        crossorigin="anonymous"
        fetchpriority="low"
        media={media}
      />
      <svg
        class={`water water-${name}`}
        viewBox={`0 0 ${layout.W} ${layout.H}`}
        role="img"
        aria-label="Still water with stones and a maple leaf. Move across it and the surface bends; tap to drop a pebble."
        data-layout={name}
        data-art={artUrl(`water-${name}`)}
        data-media={media}
      />
    </>
  ))}
</figure>

<style>
  .still-water {
    margin: 5rem 0 0;
  }

  .water {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: none;
    cursor: crosshair;
    user-select: none;
    -webkit-user-select: none;
  }

  .water-tall {
    display: none;
  }

  .water :global(.water-bank) {
    fill: var(--bg-dim);
  }

  .water :global(.water-bed) {
    fill: var(--sea);
  }

  .water :global(.water-edge) {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.2;
    opacity: 0.7;
  }

  .water :global(.water-lines) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .water :global(.water-glints) {
    fill: none;
    stroke: var(--bg-main);
    stroke-width: 1.1;
    stroke-linecap: round;
    opacity: 0.45;
  }

  .water :global(.water-rings) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.9;
    opacity: 0.6;
  }

  .water :global(.pad-leaf) {
    fill: var(--leaf);
    stroke: var(--fg-dim);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  .water :global(.pad-vein) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.6;
    opacity: 0.6;
  }

  .water :global(.stone-shadow) {
    fill: var(--fg-dim);
    opacity: 0.14;
  }

  .water :global(.stone-body) {
    fill: var(--bg-alt);
    stroke: var(--fg-main);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .water :global(.stone-facet) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .water :global(.stone-moss) {
    fill: var(--leaf);
    stroke: var(--fg-dim);
    stroke-width: 0.6;
    opacity: 0.9;
  }

  .water :global(.leaf-blade) {
    fill: var(--red);
    opacity: 0.9;
  }

  .water :global(.leaf-ink),
  .water :global(.leaf-stem) {
    fill: none;
    stroke: var(--red-warmer);
    stroke-width: 6;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.65;
  }

  .water :global(.water-seal) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s ease,
      visibility 1.2s;
  }

  .water :global(.water-seal.on) {
    opacity: 1;
    visibility: visible;
  }

  .water :global(.water-seal path) {
    fill: var(--red);
    opacity: 0.92;
  }

  .water :global(.water-seal text) {
    font-family: var(--font-seal);
    font-size: 22px;
    fill: var(--bg-main);
  }

  figcaption {
    margin: 0.5rem 0.25rem 0 auto;
    width: fit-content;
    font-weight: 300;
    font-size: 1rem;
    color: var(--fg-dim);
    opacity: 0.7;
    transform: rotate(-1deg);
  }

  @media (max-width: 47.99em) {
    .still-water {
      margin-top: 3.5rem;
    }

    .water-wide {
      display: none;
    }

    .water-tall {
      display: block;
    }
  }
</style>

<script>
  import { earn, load } from "../utils/garden";
  import { smooth } from "../utils/stamp";
  import { LAYOUTS, inPond, inStone } from "../utils/water";
  import { fillArt } from "../scripts/art";

  type Point = [number, number];
  type Ring = { x: number; y: number; born: number; a: number };

  const FLAT = 0.42;
  const SPEED = 0.075; // px per ms
  const LIFE = 3600;
  const WAVE = 36; // crest to crest
  const BAND = 26; // how wide the train of crests is
  const SVG_NAMESPACE = "http://www.w3.org/2000/svg";
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));
  const fixed = (value: number) => value.toFixed(1);

  function setup(svg: SVGSVGElement) {
    const layout = LAYOUTS[svg.dataset.layout as "wide" | "tall"];
    const lines: Point[][] = JSON.parse(svg.dataset.lines ?? "[]");
    const linePaths = [...svg.querySelectorAll<SVGPathElement>(".water-lines path")];
    const calm: Array<[number, number, number]> = JSON.parse(svg.dataset.calm ?? "[]");
    const calmPaths = [...svg.querySelectorAll<SVGPathElement>(".water-glints path")];
    const ringLayer = svg.querySelector<SVGGElement>(".water-rings")!;
    const pads = [...svg.querySelectorAll<SVGGElement>(".pad")];
    const padAt = layout.pads.map(([x, y]) => [x, y]);
    const leafEl = svg.querySelector<SVGGElement>(".water-leaf")!;
    const seal = svg.querySelector<SVGGElement>(".water-seal")!;
    const leaf = { x: layout.leaf[0], y: layout.leaf[1], vx: 0, vy: 0, a: -0.4 };
    let rings: Ring[] = [];
    let now = 0;

    if (load().seals["波"]) seal.classList.add("on");

    function swell(ring: Ring, x: number, y: number) {
      const age = now - ring.born;
      const distance = Math.hypot(x - ring.x, (y - ring.y) / FLAT);
      const fromCrest = distance - age * SPEED;
      if (Math.abs(fromCrest) > BAND * 1.6) return 0;
      const fade = (1 - age / LIFE) ** 2;
      const front = Math.exp(-((fromCrest / BAND) ** 2));
      return (ring.a * fade * front) / Math.sqrt(1 + (age * SPEED) / 40);
    }

    const lift = (x: number, y: number) => {
      let height = 0;
      for (const ring of rings) {
        const strength = swell(ring, x, y);
        if (strength) {
          const distance = Math.hypot(x - ring.x, (y - ring.y) / FLAT);
          height +=
            strength * Math.sin(((distance - (now - ring.born) * SPEED) / WAVE) * Math.PI * 2);
        }
      }
      return clamp(height, -2.5, 2.5);
    };

    function drift() {
      for (const ring of rings) {
        const strength = swell(ring, leaf.x, leaf.y);
        if (!strength) continue;
        const awayX = leaf.x - ring.x;
        const awayY = (leaf.y - ring.y) / FLAT;
        const distance = Math.hypot(awayX, awayY) || 1;
        leaf.vx += (awayX / distance) * strength * 0.05;
        leaf.vy += (awayY / distance) * strength * 0.05 * FLAT;
      }
      leaf.vx *= 0.975;
      leaf.vy *= 0.975;
      move(leaf.x + leaf.vx, leaf.y + leaf.vy);
      leaf.a += leaf.vx * 0.004;
      return Math.abs(leaf.vx) + Math.abs(leaf.vy) > 0.01;
    }

    function move(nextX: number, nextY: number) {
      if (
        inPond(layout, nextX, nextY) &&
        inPond(layout, nextX + 16, nextY) &&
        !inStone(layout, nextX, nextY, 6)
      ) {
        leaf.x = nextX;
        leaf.y = nextY;
      } else {
        leaf.vx *= -0.3;
        leaf.vy *= -0.3;
      }
      if (leaf.x > layout.goal.x && leaf.y < layout.goal.y && earn("波")) seal.classList.add("on");
    }

    function draw() {
      lines.forEach((points, lineIndex) => {
        linePaths[lineIndex].setAttribute(
          "d",
          smooth(
            points.map(([x, y]): Point => [x, y + lift(x, y)]),
            false,
          ),
        );
      });

      calm.forEach(([x, y, length], glintIndex) => {
        calmPaths[glintIndex].setAttribute(
          "d",
          `M${fixed(x)} ${fixed(y + lift(x, y))} q${fixed(length / 2)} -1.2 ${fixed(length)} 0`,
        );
      });

      ringLayer.replaceChildren(
        ...rings.flatMap((ring) => {
          const age = now - ring.born;
          const radius = age * SPEED;
          const fade = (1 - age / LIFE) ** 2;
          return [0, WAVE].flatMap((back) => {
            if (radius - back < 2) return [];
            const ellipse = document.createElementNS(SVG_NAMESPACE, "ellipse");
            ellipse.setAttribute("cx", fixed(ring.x));
            ellipse.setAttribute("cy", fixed(ring.y));
            ellipse.setAttribute("rx", fixed(radius - back));
            ellipse.setAttribute("ry", fixed((radius - back) * FLAT));
            ellipse.setAttribute(
              "opacity",
              (fade * Math.min(1, ring.a / 1.6) * (back ? 0.45 : 0.9)).toFixed(2),
            );
            return [ellipse];
          });
        }),
      );

      pads.forEach((pad, padIndex) => {
        const [x, y] = padAt[padIndex];
        pad.setAttribute("transform", `translate(${x} ${fixed(y + lift(x, y) * 0.6)})`);
      });
      leafEl.setAttribute(
        "transform",
        `translate(${fixed(leaf.x)} ${fixed(leaf.y + lift(leaf.x, leaf.y) * 0.5)}) rotate(${fixed((leaf.a * 180) / Math.PI)})`,
      );
    }

    let frame = 0;
    function loop(time: number) {
      frame = 0;
      now = time;
      rings = rings.filter((ring) => time - ring.born < LIFE);
      const moving = drift();
      draw();
      if (rings.length || moving) frame = requestAnimationFrame(loop);
    }

    function drop(x: number, y: number, strength: number) {
      rings.push({ x, y, born: performance.now(), a: strength });
      if (rings.length > 40) rings.shift();
      if (!frame) frame = requestAnimationFrame(loop);
    }

    const toWater = (event: PointerEvent): Point => {
      const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(
        svg.getScreenCTM()!.inverse(),
      );
      return [point.x, point.y];
    };

    function stillRing([x, y]: Point) {
      const ripple = document.createElementNS(SVG_NAMESPACE, "ellipse");
      ripple.setAttribute("cx", fixed(x));
      ripple.setAttribute("cy", fixed(y));
      ripple.setAttribute("rx", "18");
      ripple.setAttribute("ry", "8");
      ringLayer.append(ripple);
      setTimeout(() => ripple.remove(), 1200);
      const distance = Math.hypot(leaf.x - x, leaf.y - y);
      if (distance < 70 && distance > 0.1) {
        move(leaf.x + ((leaf.x - x) / distance) * 30, leaf.y + ((leaf.y - y) / distance) * 30);
        draw();
      }
    }

    let last: Point | null = null;
    svg.addEventListener("pointermove", (event) => {
      if (still.matches) return;
      const point = toWater(event);
      if (!last) {
        last = point;
        return;
      }
      const distance = Math.hypot(point[0] - last[0], point[1] - last[1]);
      if (distance < 28) return;
      if (inPond(layout, point[0], point[1]))
        drop(point[0], point[1], Math.min(0.5 + distance * 0.012, 1.1));
      last = point;
    });
    svg.addEventListener("pointerdown", (event) => {
      const point = toWater(event);
      if (still.matches) return stillRing(point);
      if (inPond(layout, point[0], point[1])) {
        drop(point[0], point[1], 2.4);
        setTimeout(() => drop(point[0], point[1], 1), 220);
      }
      last = event.pointerType === "mouse" ? point : null;
    });
    const leave = () => (last = null);
    svg.addEventListener("pointerleave", leave);
    svg.addEventListener("pointerup", (event) => event.pointerType !== "mouse" && leave());
    svg.addEventListener("pointercancel", leave);
  }

  document.querySelectorAll<SVGSVGElement>(".still-water .water").forEach((svg) => {
    const media = matchMedia(svg.dataset.media!);
    let filled = false;
    const fill = () => {
      if (filled || !media.matches) return;
      filled = true;
      fillArt(svg).then(() => setup(svg));
    };
    fill();
    media.addEventListener("change", fill);
  });
</script>
