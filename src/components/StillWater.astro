---
// A strip of still water at the end of the photo pages and /about
// Carry the maple leaf to the far bank with waves alone to earn seal.

import { smooth } from "../utils/sand";
import { MOMIJI } from "../utils/momiji";
import { LAYOUTS, makeWater } from "../utils/water";

const layouts = (["wide", "tall"] as const).map((name) => ({
  name,
  L: LAYOUTS[name],
  water: makeWater(LAYOUTS[name]),
}));
---

<figure class="still-water">
  {layouts.map(({ name, L, water }) => (
    <svg
      class={`water water-${name}`}
      viewBox={`0 0 ${L.W} ${L.H}`}
      role="img"
      aria-label="Still water with stones and a maple leaf. Move across it and the surface bends; tap to drop a pebble."
      data-layout={name}
      data-lines={JSON.stringify(water.lines.map((l) => l.pts))}
      data-calm={JSON.stringify(water.calm)}
    >
      <path class="water-bank" d={water.bank} />
      <path class="water-bed" d={water.edge} />
      <path class="water-edge" d={water.edge} />
      <g class="water-lines">
        {water.lines.map((l) => (
          <path d={smooth(l.pts, false)} stroke-width={l.w} opacity={l.o} />
        ))}
      </g>
      <g class="water-glints">
        {water.calm.map(([x, y, len]) => (
          <path d={`M${x} ${y} q${len / 2} -1.2 ${len} 0`} />
        ))}
      </g>
      <g class="water-rings" />
      {water.pads.map((p) => (
        <g class="pad" transform={`translate(${p.x} ${p.y})`}>
          <path class="pad-leaf" d={p.d} />
          <path class="pad-vein" d={p.vein} />
        </g>
      ))}
      {water.stones.map((s) => (
        <g class="stone">
          <path class="stone-shadow" d={s.shadow} />
          <path class="stone-body" d={s.d} />
          <path class="stone-facet" d={s.facet} />
          {s.moss && <path class="stone-moss" d={s.moss} />}
        </g>
      ))}
      <g class="water-leaf" transform={`translate(${L.leaf[0]} ${L.leaf[1]}) rotate(-23)`}>
        <g transform="scale(0.13)">
          <path class="leaf-stem" d={MOMIJI.stem} />
          <path class="leaf-blade" d={MOMIJI.outline} />
          <path class="leaf-ink" d={MOMIJI.outline} transform="translate(5 -4)" />
        </g>
      </g>
      <g
        class="water-seal"
        transform={`translate(${name === "wide" ? 900 : 300} ${name === "wide" ? 30 : 20}) rotate(-6) scale(0.8)`}
      >
        <path class="water-bank" d={water.bank} />
        <path class="water-bed" d={water.edge} />
        <path class="water-edge" d={water.edge} />
        <g class="water-lines">
          {water.lines.map((l) => (
            <path d={smooth(l.pts, false)} stroke-width={l.w} opacity={l.o} />
          ))}
        </g>
        <g class="water-glints">
          {water.calm.map(([x, y, len]) => (
            <path d={`M${x} ${y} q${len / 2} -1.2 ${len} 0`} />
          ))}
        </g>
        <clipPath id={`pond-${name}`}>
          <path d={water.edge} />
        </clipPath>
        <g class="water-rings" clip-path={`url(#pond-${name})`} />
        {water.pads.map((p) => (
          <g class="pad" transform={`translate(${p.x} ${p.y})`}>
            <path class="pad-leaf" d={p.d} />
            <path class="pad-vein" d={p.vein} />
          </g>
        ))}
        {water.stones.map((s) => (
          <g class="stone">
            <path class="stone-shadow" d={s.shadow} />
            <path class="stone-body" d={s.d} />
            <path class="stone-facet" d={s.facet} />
            {s.moss && <path class="stone-moss" d={s.moss} />}
          </g>
        ))}
        <g class="water-leaf" transform={`translate(${L.leaf[0]} ${L.leaf[1]}) rotate(-23)`}>
          <g transform="scale(0.13)">
            <path class="leaf-stem" d={MOMIJI.stem} />
            <path class="leaf-blade" d={MOMIJI.outline} />
            <path class="leaf-ink" d={MOMIJI.outline} transform="translate(5 -4)" />
          </g>
        </g>
        <g
          class="water-seal"
          transform={`translate(${name === "wide" ? 900 : 300} ${name === "wide" ? 30 : 20}) rotate(-6) scale(0.8)`}
        >
          <path d="M4 5 Q23 2 42 4 Q45 23 43 42 Q23 45 3 43 Q1 23 4 5 Z" />
          <text x="23" y="31" text-anchor="middle">
            波
          </text>
        </g>
      </svg>
    ))
  }
  <figcaption class="hand">the water was here before you.</figcaption>
</figure>

<style>
  .still-water {
    margin: 5rem 0 0;
  }

  .water {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: none;
    cursor: crosshair;
    user-select: none;
    -webkit-user-select: none;
  }

  .water-tall {
    display: none;
  }

  .water-bank {
    fill: var(--bg-dim);
  }

  .water-bed {
    fill: var(--sea);
  }

  .water-edge {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.2;
    opacity: 0.7;
  }

  .water-lines {
    fill: none;
    stroke: var(--fg-dim);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .water-glints {
    fill: none;
    stroke: var(--bg-main);
    stroke-width: 1.1;
    stroke-linecap: round;
    opacity: 0.45;
  }

  .water-rings {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.9;
    opacity: 0.6;
  }

  .pad-leaf {
    fill: var(--leaf);
    stroke: var(--fg-dim);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  .pad-vein {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.6;
    opacity: 0.6;
  }

  .stone-shadow {
    fill: var(--fg-dim);
    opacity: 0.14;
  }

  .stone-body {
    fill: var(--bg-alt);
    stroke: var(--fg-main);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .stone-facet {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .stone-moss {
    fill: var(--leaf);
    stroke: var(--fg-dim);
    stroke-width: 0.6;
    opacity: 0.9;
  }

  .leaf-blade {
    fill: var(--red);
    opacity: 0.9;
  }

  .leaf-ink,
  .leaf-stem {
    fill: none;
    stroke: var(--red-warmer);
    stroke-width: 6;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.65;
  }

  .water-seal {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s ease,
      visibility 1.2s;
  }

  .water-seal.on {
    opacity: 1;
    visibility: visible;
  }

  .water-seal path {
    fill: var(--red);
    opacity: 0.92;
  }

  .water-seal text {
    font-family: var(--font-seal);
    font-size: 22px;
    fill: var(--bg-main);
  }

  figcaption {
    margin: 0.5rem 0.25rem 0 auto;
    width: fit-content;
    font-weight: 300;
    font-size: 1rem;
    color: var(--fg-dim);
    opacity: 0.7;
    transform: rotate(-1deg);
  }

  @media (max-width: 47.99em) {
    .still-water {
      margin-top: 3.5rem;
    }

    .water-wide {
      display: none;
    }

    .water-tall {
      display: block;
    }
  }
</style>

<script>
  import { earn, load } from "../utils/garden";
  import { smooth } from "../utils/sand";
  import { LAYOUTS, inPond, inStone } from "../utils/water";

  type Point = [number, number];
  type Ring = { x: number; y: number; born: number; a: number };

  const FLAT = 0.42;
  const SPEED = 0.075; // px per ms
  const LIFE = 3600;
  const WAVE = 36; // crest to crest
  const BAND = 26; // how wide the train of crests is
  const NS = "http://www.w3.org/2000/svg";
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const f = (n: number) => n.toFixed(1);

  document.querySelectorAll<SVGSVGElement>(".still-water .water").forEach((svg) => {
    const L = LAYOUTS[svg.dataset.layout as "wide" | "tall"];
    const lines: Point[][] = JSON.parse(svg.dataset.lines ?? "[]");
    const linePaths = [...svg.querySelectorAll<SVGPathElement>(".water-lines path")];
    const calm: Array<[number, number, number]> = JSON.parse(svg.dataset.calm ?? "[]");
    const calmPaths = [...svg.querySelectorAll<SVGPathElement>(".water-glints path")];
    const ringLayer = svg.querySelector<SVGGElement>(".water-rings")!;
    const pads = [...svg.querySelectorAll<SVGGElement>(".pad")];
    const padAt = L.pads.map(([x, y]) => [x, y]);
    const leafEl = svg.querySelector<SVGGElement>(".water-leaf")!;
    const seal = svg.querySelector<SVGGElement>(".water-seal")!;
    const leaf = { x: L.leaf[0], y: L.leaf[1], vx: 0, vy: 0, a: -0.4 };
    let rings: Ring[] = [];
    let now = 0;

    if (load().seals["波"]) seal.classList.add("on");

    function swell(r: Ring, x: number, y: number) {
      const age = now - r.born;
      const d = Math.hypot(x - r.x, (y - r.y) / FLAT);
      const off = d - age * SPEED;
      if (Math.abs(off) > BAND * 1.6) return 0;
      const fade = (1 - age / LIFE) ** 2;
      const front = Math.exp(-((off / BAND) ** 2));
      return (r.a * fade * front) / Math.sqrt(1 + (age * SPEED) / 40);
    }

    const lift = (x: number, y: number) => {
      let h = 0;
      for (const r of rings) {
        const s = swell(r, x, y);
        if (s) {
          const d = Math.hypot(x - r.x, (y - r.y) / FLAT);
          h += s * Math.sin(((d - (now - r.born) * SPEED) / WAVE) * Math.PI * 2);
        }
      }
      return clamp(h, -2.5, 2.5);
    };

    function drift() {
      for (const r of rings) {
        const s = swell(r, leaf.x, leaf.y);
        if (!s) continue;
        const dx = leaf.x - r.x;
        const dy = (leaf.y - r.y) / FLAT;
        const d = Math.hypot(dx, dy) || 1;
        leaf.vx += (dx / d) * s * 0.05;
        leaf.vy += (dy / d) * s * 0.05 * FLAT;
      }
      leaf.vx *= 0.975;
      leaf.vy *= 0.975;
      move(leaf.x + leaf.vx, leaf.y + leaf.vy);
      leaf.a += leaf.vx * 0.004;
      return Math.abs(leaf.vx) + Math.abs(leaf.vy) > 0.01;
    }

    function move(nx: number, ny: number) {
      if (inPond(L, nx, ny) && inPond(L, nx + 16, ny) && !inStone(L, nx, ny, 6)) {
        leaf.x = nx;
        leaf.y = ny;
      } else {
        leaf.vx *= -0.3;
        leaf.vy *= -0.3;
      }
      if (leaf.x > L.goal.x && leaf.y < L.goal.y && earn("波")) seal.classList.add("on");
    }

    function draw() {
      lines.forEach((pts, l) => {
        linePaths[l].setAttribute(
          "d",
          smooth(
            pts.map(([x, y]): Point => [x, y + lift(x, y)]),
            false,
          ),
        );
      });

      calm.forEach(([x, y, len], c) => {
        calmPaths[c].setAttribute(
          "d",
          `M${f(x)} ${f(y + lift(x, y))} q${f(len / 2)} -1.2 ${f(len)} 0`,
        );
      });

      ringLayer.replaceChildren(
        ...rings.flatMap((r) => {
          const age = now - r.born;
          const rx = age * SPEED;
          const fade = (1 - age / LIFE) ** 2;
          return [0, WAVE].flatMap((back) => {
            if (rx - back < 2) return [];
            const e = document.createElementNS(NS, "ellipse");
            e.setAttribute("cx", f(r.x));
            e.setAttribute("cy", f(r.y));
            e.setAttribute("rx", f(rx - back));
            e.setAttribute("ry", f((rx - back) * FLAT));
            e.setAttribute(
              "opacity",
              (fade * Math.min(1, r.a / 1.6) * (back ? 0.45 : 0.9)).toFixed(2),
            );
            return [e];
          });
        }),
      );

      pads.forEach((p, n) => {
        const [x, y] = padAt[n];
        p.setAttribute("transform", `translate(${x} ${f(y + lift(x, y) * 0.6)})`);
      });
      leafEl.setAttribute(
        "transform",
        `translate(${f(leaf.x)} ${f(leaf.y + lift(leaf.x, leaf.y) * 0.5)}) rotate(${f((leaf.a * 180) / Math.PI)})`,
      );
    }

    let frame = 0;
    function loop(t: number) {
      frame = 0;
      now = t;
      rings = rings.filter((r) => t - r.born < LIFE);
      const moving = drift();
      draw();
      if (rings.length || moving) frame = requestAnimationFrame(loop);
    }

    function drop(x: number, y: number, a: number) {
      rings.push({ x, y, born: performance.now(), a });
      if (rings.length > 40) rings.shift();
      if (!frame) frame = requestAnimationFrame(loop);
    }

    const toWater = (e: PointerEvent): Point => {
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
      return [p.x, p.y];
    };

    function stillRing([x, y]: Point) {
      const r = document.createElementNS(NS, "ellipse");
      r.setAttribute("cx", f(x));
      r.setAttribute("cy", f(y));
      r.setAttribute("rx", "18");
      r.setAttribute("ry", "8");
      ringLayer.append(r);
      setTimeout(() => r.remove(), 1200);
      const d = Math.hypot(leaf.x - x, leaf.y - y);
      if (d < 70 && d > 0.1) {
        move(leaf.x + ((leaf.x - x) / d) * 30, leaf.y + ((leaf.y - y) / d) * 30);
        draw();
      }
    }

    let last: Point | null = null;
    svg.addEventListener("pointermove", (e) => {
      if (still.matches) return;
      const q = toWater(e);
      if (!last) {
        last = q;
        return;
      }
      const d = Math.hypot(q[0] - last[0], q[1] - last[1]);
      if (d < 28) return;
      if (inPond(L, q[0], q[1])) drop(q[0], q[1], Math.min(0.5 + d * 0.012, 1.1));
      last = q;
    });
    svg.addEventListener("pointerdown", (e) => {
      const q = toWater(e);
      if (still.matches) return stillRing(q);
      if (inPond(L, q[0], q[1])) {
        drop(q[0], q[1], 2.4);
        setTimeout(() => drop(q[0], q[1], 1), 220);
      }
      last = e.pointerType === "mouse" ? q : null;
    });
    const leave = () => (last = null);
    svg.addEventListener("pointerleave", leave);
    svg.addEventListener("pointerup", (e) => e.pointerType !== "mouse" && leave());
    svg.addEventListener("pointercancel", leave);
  });
</script>
