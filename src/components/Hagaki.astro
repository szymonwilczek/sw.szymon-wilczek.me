---
// Postcard to write on the back of.

const MAIL = "swilczek.lx@gmail.com";

function perforated(w: number, h: number, r: number, step: number) {
  const f = (n: number) => Math.round(n * 10) / 10;
  const side = (x0: number, y0: number, dx: number, dy: number, len: number) => {
    let s = "";
    for (let t = step / 2; t < len; t += step) {
      const x = x0 + dx * t;
      const y = y0 + dy * t;
      s += ` L ${f(x - dx * r)} ${f(y - dy * r)} A ${r} ${r} 0 0 0 ${f(x + dx * r)} ${f(y + dy * r)}`;
    }
    return s;
  };
  return (
    "M0 0" +
    side(0, 0, 1, 0, w) +
    ` L ${w} 0` +
    side(w, 0, 0, 1, h) +
    ` L ${w} ${h}` +
    side(w, h, -1, 0, w) +
    ` L 0 ${h}` +
    side(0, h, 0, -1, h) +
    " Z"
  );
}

const EDGE = perforated(96, 116, 2.6, 8);
---

<div class="hagaki" data-mail={MAIL}>
  <div class="card paper">
    <div class="card-back">
      <div class="write">
        <label for="hagaki-msg" class="hand">
          dear Szymon,
        </label>
        <textarea id="hagaki-msg" rows="7" placeholder="a few lines are plenty"></textarea>
        <label for="hagaki-from" class="hand from-label">
          from (so I can write back)
        </label>
        <input id="hagaki-from" type="text" placeholder="your name" autocomplete="name" />
      </div>

      <div class="rule" aria-hidden="true"></div>

      <div class="address">
        <div class="marks" aria-hidden="true">
          <svg class="stamp" width="96" height="116" viewBox="0 0 96 116">
            <path class="stamp-paper" d={EDGE}></path>
            <rect class="stamp-sky" x="9" y="9" width="78" height="98"></rect>
            <path
              class="stamp-hill"
              d="M9 78 C 22 70, 30 60, 44 58 C 54 57, 60 64, 70 62 C 78 61, 84 56, 87 54 L 87 107 L 9 107 Z"
            ></path>
            <path
              class="stamp-sea"
              d="M9 88 C 24 82, 40 84, 54 80 C 66 77, 78 80, 87 76 L 87 107 L 9 107 Z"
            ></path>
            <path
              class="stamp-waves"
              d="M14 92 q 6 -4 12 0 M 40 96 q 6 -4 12 0 M 64 92 q 6 -4 12 0"
            ></path>
            <circle class="stamp-sun" cx="64" cy="30" r="9"></circle>
            <text class="stamp-kanji season-kanji" x="22" y="40">
              秋
            </text>
            <text class="stamp-no" x="48" y="104" text-anchor="middle">
              SW · 07
            </text>
          </svg>
          <svg class="postmark" width="104" height="104" viewBox="0 0 104 104">
            <circle cx="52" cy="52" r="40" stroke-width="1.6"></circle>
            <circle cx="52" cy="52" r="30" stroke-width="0.9"></circle>
            <text class="postmark-date" x="52" y="48" text-anchor="middle"></text>
            <text class="postmark-kanji" x="52" y="62" text-anchor="middle">
              <tspan class="season-kanji">秋</tspan> · 庭
            </text>
            <path
              d="M92 36 C 110 32, 130 40, 150 36 M 94 52 C 112 48, 132 56, 152 52 M 92 68 C 110 64, 130 72, 150 68"
              stroke-width="1.3"
              stroke-linecap="round"
            ></path>
          </svg>
        </div>
        <div class="lines">
          <p>Szymon Wilczek</p>
          <p class="mono">{MAIL}</p>
          <p class="hand">the garden, by the post box</p>
        </div>
      </div>
    </div>
  </div>

  <div class="box">
    <svg class="mailbox" width="120" height="170" viewBox="0 0 120 170" aria-hidden="true">
      <path class="post" d="M58 168 C 57 140, 59 120, 58 96"></path>
      <path
        class="body"
        d="M14 98 C 14 52, 30 26, 58 24 C 86 26, 104 52, 104 98 C 74 101, 44 101, 14 98 Z"
      ></path>
      <path class="slot" d="M30 54 C 46 52, 70 52, 88 54"></path>
      <path class="flag" d="M104 64 C 110 63, 114 64, 118 65 C 119 72, 118 78, 119 84"></path>
      <text x="58" y="82" text-anchor="middle">
        〒
      </text>
    </svg>
    <a class="post-it" href={`mailto:${MAIL}`}>
      post it
    </a>
    <p class="status hand" aria-live="polite">
      nothing goes through this site.
    </p>
    <button class="again" type="button" hidden>
      another card
    </button>
  </div>
</div>

<style>
  .hagaki {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2.5rem 3.5rem;
    margin-top: 1.5rem;
  }

  .card {
    position: relative;
    flex: 999 1 35rem;
    min-width: 0;
    max-width: 47.5rem;
    padding: 1.875rem 2rem;
    border-radius: 3px 5px 4px 6px;
    --shade: rgb(0 0 0 / 0.42);
    --shade: light-dark(rgb(0 0 0 / 0.42), rgb(0 0 0 / 0.85));
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.06), transparent 40%, rgb(0 0 0 / 0.05)),
      var(--paper);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 1px 1px rgb(0 0 0 / 0.12),
      2px 4px 8px -4px var(--shade),
      20px 24px 28px -22px var(--shade);
    transform: rotate(-0.6deg);
    transition:
      transform 0.7s cubic-bezier(0.5, 0, 0.75, 0.4),
      opacity 0.3s ease 0.45s;
  }

  .hagaki.posted .card {
    transform: translate(32rem, 7.5rem) rotate(-7deg) scale(0.18);
    opacity: 0;
    pointer-events: none;
  }

  .card-back {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
  }

  .write {
    flex: 1 1 17.5rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .write label {
    font-size: 1.125rem;
  }

  .write .from-label {
    margin-top: 0.875rem;
    font-size: 1rem;
  }

  textarea {
    margin-top: 0.375rem;
    width: 100%;
    box-sizing: border-box;
    resize: none;
    border: 0;
    padding: 0 2px;
    background: transparent
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 33px,
        var(--border) 33px,
        var(--border) 34px
      );
    background-attachment: local;
    color: var(--fg-main);
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 34px;
    outline: none;
  }

  input {
    margin-top: 0.125rem;
    min-height: 40px;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: var(--fg-main);
    font-family: var(--font-hand);
    font-size: 1.1875rem;
    outline: none;
  }

  textarea:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--cursor);
    outline-offset: 4px;
  }

  .rule {
    flex: 0 0 1px;
    align-self: stretch;
    background: var(--border);
    opacity: 0.7;
  }

  .address {
    flex: 0 1 14.5rem;
    min-width: 12.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .marks {
    position: relative;
    align-self: flex-end;
    width: 150px;
    height: 120px;
  }

  .stamp {
    position: absolute;
    right: 6px;
    top: 0;
    transform: rotate(2deg);
  }

  .stamp-paper {
    fill: var(--bg-main);
    stroke: var(--border);
    stroke-width: 0.6;
  }

  .stamp-sky {
    fill: var(--sky);
  }

  .stamp-hill {
    fill: var(--leaf);
  }

  .stamp-sea {
    fill: var(--sea);
  }

  .stamp-waves {
    fill: none;
    stroke: var(--fg-dim);
    stroke-linecap: round;
  }

  .stamp-sun {
    fill: var(--red);
    opacity: 0.85;
  }

  .stamp-kanji {
    font-family: var(--font-seal);
    font-size: 20px;
    fill: var(--fg-main);
  }

  .stamp-no {
    font-family: var(--font-mono);
    font-size: 7px;
    fill: var(--fg-main);
  }

  .postmark {
    position: absolute;
    left: -10px;
    top: 16px;
    overflow: visible;
    transform: rotate(-14deg);
    opacity: 0.78;
  }

  .postmark circle,
  .postmark path {
    fill: none;
    stroke: var(--fg-main);
  }

  .postmark text {
    fill: var(--fg-main);
  }

  .postmark-date {
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .postmark-kanji {
    font-family: var(--font-seal);
    font-size: 12px;
  }

  .lines {
    font-size: 1.0625rem;
    line-height: 2;
  }

  .lines p {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }

  .lines .mono {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .box {
    flex: 1 1 12.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.125rem;
  }

  .mailbox path {
    fill: none;
  }

  .mailbox .post {
    stroke: var(--fg-dim);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .mailbox .body {
    fill: var(--bg-dim);
    stroke: var(--fg-dim);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .mailbox .slot {
    stroke: var(--fg-main);
    stroke-width: 3.4;
    stroke-linecap: round;
  }

  .mailbox .flag {
    stroke: var(--red);
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 104px 64px;
    transition: transform 0.4s ease 0.55s;
  }

  .hagaki.posted .flag {
    transform: rotate(-80deg);
  }

  .mailbox text {
    font-family: var(--font-seal);
    font-size: 18px;
    fill: var(--fg-dim);
  }

  .post-it {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.375rem;
    border: 1.5px solid var(--fg-main);
    border-radius: 26px 20px 24px 22px;
    color: var(--fg-main);
    font-family: var(--font-hand);
    font-size: 1.125rem;
    text-decoration: none;
  }

  .post-it:hover {
    border-color: var(--cursor);
  }

  .status {
    min-height: 4.2em;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .again[hidden] {
    display: block;
    visibility: hidden;
  }

  .again {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg-link);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .mailbox .flag {
      transition: none;
    }
  }

  @media (max-width: 47.99em) {
    .card {
      padding: 1.375rem 1.125rem;
    }

    .rule {
      display: none;
    }

    .hagaki.posted .card {
      transform: translate(2.5rem, 16rem) rotate(8deg) scale(0.3);
    }
  }
</style>

<script>
  import { SEASONS, season } from "../utils/garden";

  const root = document.querySelector<HTMLElement>(".hagaki");

  if (root) {
    const mail = root.dataset.mail!;
    const msg = root.querySelector<HTMLTextAreaElement>("#hagaki-msg")!;
    const from = root.querySelector<HTMLInputElement>("#hagaki-from")!;
    const post = root.querySelector<HTMLAnchorElement>(".post-it")!;
    const status = root.querySelector<HTMLElement>(".status")!;
    const again = root.querySelector<HTMLButtonElement>(".again")!;
    const now = season();
    const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
    const today = new Date();
    const pad = (n: number) => String(n).padStart(2, "0");

    root.querySelectorAll(".season-kanji").forEach((t) => (t.textContent = SEASONS[now].glyph));
    root.querySelector(".postmark-date")!.textContent =
      `${pad(today.getDate())} · ${ROMAN[today.getMonth()]} · ${String(today.getFullYear()).slice(2)}`;
    root.querySelector(".stamp-no")!.textContent = `SW · ${pad(today.getMonth() + 1)}`;

    const quiet = "nothing goes through this site.";
    const write = () => {
      const sign = from.value.trim() ? `\n\n-- \n${from.value.trim()}` : "";
      const body = (msg.value + sign).replace(/\r\n?/g, "\n");
      post.href =
        `mailto:${mail}?subject=${encodeURIComponent(`a postcard from the garden (${now})`)}` +
        `&body=${encodeURIComponent(body)}`;
      const n = msg.value.length;
      status.textContent = n
        ? `${n} letters, about ${Math.max(1, Math.round(n / 28))} lines of card`
        : quiet;
    };
    msg.addEventListener("input", write);
    from.addEventListener("input", write);
    write();

    post.addEventListener("click", () => {
      root.classList.add("posted");
      status.textContent = "in the box. your mail app has the card now; send it from there.";
      again.hidden = false;
    });

    again.addEventListener("click", () => {
      root.classList.remove("posted");
      again.hidden = true;
      msg.value = "";
      write();
      msg.focus();
    });
  }
</script>
