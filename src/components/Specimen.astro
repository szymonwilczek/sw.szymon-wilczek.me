---
// One repository pressed on a herbarium sheet

import type { RepoStats } from "../utils/github";
import { commitCount, inkStroke } from "../utils/github";
import { blot, inkOf, repoPath, type Project } from "../utils/projects";
import { deckle, kindInk, pencilLoop, sketch } from "../utils/specimen";

interface Props {
  project: Project;
  stats?: RepoStats;
  no: number;
  small?: boolean;
  tilt?: number;
}

const { project, stats, no: sheetNumber, small = false, tilt = 0 } = Astro.props;
const repo = repoPath(project.url);
const drawing = sketch(project.title);
const lang = inkOf(project.language);
const edge = small ? deckle(project.title, 300, 220, 4, 8) : deckle(project.title, 400, 320, 5, 9);
const strokeHeight = small ? 14 : 26;
const stroke = stats?.days.length ? inkStroke(stats.days, 300, strokeHeight) : "";
const collected = project.date.slice(0, 7).replace("-", "·");
const when = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<div
  class:list={["sheet", { small, archived: project.archived }]}
  style={`--tilt: ${tilt}deg; --lang: ${lang}`}
>
  <svg
    class="paper-edge"
    viewBox={small ? "0 0 300 220" : "0 0 400 320"}
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d={edge}></path>
  </svg>

  <div class="head">
    <figure class="drawing">
      <svg viewBox="0 0 60 60" aria-hidden="true">
        <path class="wash" d={drawing.wash}></path>
        <g class="pen">
          {drawing.strokes.map((penStroke) => (
            <path d={penStroke.d} stroke-width={penStroke.w} />
          ))}
        </g>
      </svg>
      {!small && <span class="tape tape-a" />}
      {!small && <span class="tape tape-b" />}
    </figure>
    <div class="title">
      <h2>
        <a class="name" href={project.url}>
          {project.title}
        </a>
      </h2>
      {!small && (
        <p class="repo">
          {repo.path}
          {repo.site && " · site"}
        </p>
      )}
      <p class="excerpt">{project.excerpt}</p>
    </div>
  </div>

  {stroke && (
    <figure class="stroke">
      <svg viewBox={`0 0 300 ${strokeHeight}`} preserveAspectRatio="none" aria-hidden="true">
        <path d={stroke} />
      </svg>
      {!small && stats && (
        <figcaption>
          <span>a year ago</span>
          <span>{commitCount(stats.days)} commits</span>
          <span>now</span>
        </figcaption>
      )}
    </figure>
  )}

  <div class="foot">
    {small ? (
      <p class="line">
        <svg class="blot" width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
          <path d={blot(`slip-${project.title}`)} fill={lang} />
        </svg>
        {project.language} · {collected}
        {stats && <> · ★ {stats.stars}</>}
      </p>
    ) : (
      <div class="slip">
        <p>
          <svg class="blot" width="15" height="15" viewBox="0 0 14 14" aria-hidden="true">
            <path d={blot(`slip-${project.title}`)} fill={lang} />
          </svg>
          <span class="no">
            No. {String(sheetNumber).padStart(3, "0")} · {project.language}
          </span>
        </p>
        <p>
          collected {collected}
          {stats && (
            <>
              {" "}
              · ★ {stats.stars}
              <span class="visually-hidden"> stars</span> · ⑂ {stats.forks}
              <span class="visually-hidden"> forks</span>
            </>
          )}
        </p>
        {stats?.last && (
          <p class="last hand">
            last: {stats.last.subject} ·
            <time datetime={stats.last.date}>{when(stats.last.date)}</time>
          </p>
        )}
      </div>
    )}
    {project.badge && (
      <span class="kind hand" style={`--kind: ${kindInk(project.badge)}`}>
        {project.badge}
        <svg viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true">
          <path d={pencilLoop(project.title)} vector-effect="non-scaling-stroke" />
        </svg>
      </span>
    )}
  </div>
  {project.archived && <p class="moss hand">pressed long ago, kept, not tended</p>}
</div>

<style>
  .sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.875rem 1.875rem 1.5rem;
    transform: rotate(var(--tilt));
  }

  .sheet.small {
    padding: 1.25rem 1.25rem 1rem;
  }

  .sheet > :not(.paper-edge) {
    position: relative;
  }

  .paper-edge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 12px 14px rgb(0 0 0 / 0.13));
  }

  .small .paper-edge {
    filter: drop-shadow(0 8px 10px rgb(0 0 0 / 0.1));
  }

  .paper-edge path {
    fill: var(--paper);
  }

  .archived .paper-edge path {
    opacity: 0.75;
  }

  .head {
    display: flex;
    align-items: flex-start;
    gap: 1.375rem;
  }

  .small .head {
    gap: 0.875rem;
  }

  .drawing {
    position: relative;
    flex: none;
    width: 6.5rem;
    height: 6.5rem;
    margin: 0;
  }

  .small .drawing {
    width: 3.125rem;
    height: 3.125rem;
  }

  .drawing svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .wash {
    fill: var(--lang);
    opacity: 0.2;
  }

  .pen {
    fill: none;
    stroke: var(--fg-main);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .archived .pen {
    opacity: 0.55;
  }

  .tape {
    position: absolute;
    width: 2.125rem;
    height: 0.6875rem;
    background: var(--tape);
    opacity: 0.85;
  }

  .tape-a {
    left: -0.625rem;
    top: 0.25rem;
    transform: rotate(-28deg);
  }

  .tape-b {
    right: -0.5rem;
    bottom: 0.375rem;
    width: 1.875rem;
    transform: rotate(-24deg);
  }

  .title {
    flex: 1;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-size: 1.5625rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .small h2 {
    font-size: 1.1875rem;
    line-height: 1.25;
  }

  .name {
    color: var(--fg-main);
  }

  .repo {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
    overflow-wrap: anywhere;
  }

  .excerpt {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--fg-dim);
  }

  .small .excerpt {
    margin-top: 0.375rem;
    font-size: 0.90625rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stroke {
    margin: auto 0 0;
    padding-top: 1.25rem;
  }

  .small .stroke {
    padding-top: 0.875rem;
  }

  .stroke svg {
    display: block;
    width: 100%;
    height: 1.5rem;
  }

  .small .stroke svg {
    height: 0.75rem;
  }

  .stroke path {
    fill: var(--fg-main);
    opacity: 0.6;
  }

  .small .stroke path {
    opacity: 0.5;
  }

  .stroke figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 0.1875rem;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    color: var(--fg-dim);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.875rem;
    margin-top: 1.125rem;
  }

  .sheet:not(:has(.stroke)) .foot {
    margin-top: auto;
    padding-top: 1.125rem;
  }

  .small .foot {
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  .blot {
    flex: none;
  }

  .slip {
    min-width: 0;
    max-width: 100%;
    padding: 0.5rem 0.75rem 0.4375rem;
    border: 1px solid var(--border);
    border-radius: 2px 4px 3px 5px;
    background: var(--bg-main);
    transform: rotate(-0.8deg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--fg-dim);
  }

  .slip p,
  .line {
    margin: 0;
  }

  .slip p:first-child,
  .line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .line {
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .no {
    color: var(--fg-main);
  }

  .slip .last {
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .kind {
    position: relative;
    display: inline-block;
    margin: 0 0.375rem 0.25rem 0;
    padding: 0.125rem 0.625rem;
    font-size: 0.9375rem;
    color: var(--kind);
    transform: rotate(-4deg);
  }

  .small .kind {
    margin: 0;
    padding: 0 0.5rem;
    font-size: 0.8125rem;
    transform: rotate(-3deg);
  }

  .kind svg {
    position: absolute;
    inset: -3px -6px;
    width: calc(100% + 12px);
    max-width: none;
    height: calc(100% + 6px);
    overflow: visible;
  }

  .kind path {
    fill: none;
    stroke: var(--kind);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.85;
  }

  .moss {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--fg-dim);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 47.99em) {
    .sheet {
      padding: 1.5rem 1.375rem 1.25rem;
      transform: none;
    }

    .drawing {
      width: 4.75rem;
      height: 4.75rem;
    }

    .small .drawing {
      width: 3.125rem;
      height: 3.125rem;
    }

    h2 {
      font-size: 1.375rem;
    }
  }
</style>
