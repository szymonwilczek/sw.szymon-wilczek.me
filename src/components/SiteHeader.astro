---
import Seal from "./Seal.astro";

const normalize = (path: string) => path.replace(/\/$/, "") || "/";
const current = normalize(Astro.url.pathname);
const isActive = (href: string) => current.startsWith(normalize(href));

const links = [
  { href: "/writings/", label: "writings" },
  { href: "/photos/", label: "photos" },
  { href: "/projects/", label: "projects" },
  { href: "/files/", label: "files" },
  { href: "/about/", label: "about" },
];

const menu = [...links, { href: "/contact/", label: "contact" }];

function brush(seed: string) {
  let state = 0;
  for (const character of seed) state = (state * 31 + character.charCodeAt(0)) >>> 0;
  const rand = (range: number) => {
    state = (state * 1103515245 + 12345) >>> 0;
    return (((state >>> 8) % 1000) / 1000) * range;
  };
  const fixed = (value: number) => value.toFixed(1);
  return (
    `M2 ${fixed(5 + rand(2))} C ${fixed(12 + rand(8))} ${fixed(3 + rand(3))}, ${fixed(30 + rand(8))} ${fixed(7 + rand(3))}, ` +
    `${fixed(46 + rand(8))} ${fixed(5 + rand(2))} S ${fixed(62 + rand(4))} ${fixed(4 + rand(3))}, 68 ${fixed(3 + rand(3))}`
  );
}
---

<header class="mobile-header">
  <a href="/" class="site-brand">
    <Seal glyph="狼" size={36} />
    <span class="brand-name">Szymon Wilczek</span>
  </a>
  <button
    id="menu-open"
    type="button"
    class="icon-button"
    aria-label="Open menu"
    aria-controls="menu-sheet"
    aria-expanded="false"
  >
    <svg width="28" height="20" viewBox="0 0 28 20" aria-hidden="true">
      <path d="M2 3 C 9 2, 18 4, 26 2.5 M3 10 C 10 9, 17 11, 24 9.5 M2 17 C 8 16, 14 18, 19 16.5"></path>
    </svg>
  </button>
</header>

<dialog id="menu-sheet" class="menu-sheet" aria-label="Menu" tabindex="-1">
  <div class="menu-paper">
    <div class="menu-top">
      <a href="/" class="site-brand">
        <Seal glyph="狼" size={36} />
        <span class="brand-name">Szymon Wilczek</span>
      </a>
    </div>

    <nav aria-label="Main">
      <ol class="menu-list">
        {menu.map((link, i) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
              <span class="menu-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="menu-label">{link.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <button type="button" class="menu-theme" data-theme-open>
      <span class="theme-dots" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span>M-x au-themes-select</span>
      <span class="menu-theme-current" data-theme-label>
        salina · night
      </span>
    </button>

    <p class="menu-extra">
      <a href="/credits/">credits</a>
      <a href="/rss.xml">rss</a>
      <a href="/vault/">vault</a>
    </p>
  </div>
  <svg class="menu-blind" aria-hidden="true">
    <path class="menu-hem"></path>
    <path class="menu-hem"></path>
    <path class="menu-stroke"></path>
    <path class="menu-hairs"></path>
  </svg>
  <button id="menu-close" type="button" class="icon-button" aria-label="Close menu">
    <svg width="28" height="20" viewBox="0 0 28 20" aria-hidden="true">
      <path d="M6 2 C 11 7, 16 12, 22 18.5"></path>
      <path d=""></path>
      <path d="M5.5 18 C 12 12, 17 7, 22 1.5"></path>
    </svg>
  </button>
</dialog>

<header class="site-header">
  <a href="/" class="site-brand">
    <Seal glyph="狼" ring class="brand-seal" />
    <span class="brand-text">
      <span class="brand-name">Szymon Wilczek</span>
      <span class="brand-domain">{Astro.site!.host}</span>
    </span>
  </a>

  <nav class="site-nav" aria-label="Main">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={["nav-link", { active: isActive(link.href) }]}
        aria-current={isActive(link.href) ? "page" : undefined}
      >
        {link.label}
        <svg class="brush" viewBox="0 0 70 12" preserveAspectRatio="none" aria-hidden="true">
          <path d={brush(link.label)} vector-effect="non-scaling-stroke" />
        </svg>
      </a>
    ))}
    <button
      id="theme-toggle"
      type="button"
      class="theme-button"
      aria-label="Choose colour theme"
      data-theme-open
    >
      <span class="theme-dots" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span data-theme-label>salina · night</span>
    </button>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--fg-main);
    text-decoration: none;
  }

  .site-brand:hover {
    color: var(--fg-main);
    text-decoration: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-size: 1.25rem;
    letter-spacing: 0.01em;
  }

  .brand-domain {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
    font-size: 1.0625rem;
  }

  .nav-link {
    position: relative;
    padding: 0.25rem 0;
    color: var(--fg-dim);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--fg-main);
    text-decoration: none;
  }

  .brush {
    position: absolute;
    left: -4px;
    bottom: -6px;
    width: calc(100% + 8px);
    height: 12px;
    overflow: visible;
    clip-path: inset(-4px calc(100% + 4px) -4px -4px);
    transition: clip-path 0.12s ease-in;
  }

  .nav-link:hover .brush,
  .nav-link:focus-visible .brush,
  .nav-link.active .brush {
    clip-path: inset(-4px -4px -4px -4px);
    transition: clip-path 0.38s cubic-bezier(0.3, 0.6, 0.35, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .brush,
    .nav-link:hover .brush {
      transition: none;
    }
  }

  .brush path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  .theme-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .theme-button:hover {
    color: var(--fg-main);
    border-color: var(--fg-dim);
  }

  .theme-dots {
    display: flex;
  }

  .theme-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--cursor);
  }

  .theme-dots span + span {
    margin-left: -5px;
    background: var(--red);
  }

  .mobile-header,
  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
  }

  .mobile-header {
    --bar-pad: 0.5rem;
    --bar-slide: 0.32s;
    position: sticky;
    top: 0;
    z-index: 30;
    margin: calc(-1 * var(--bar-pad)) calc(-1 * var(--gutter));
    padding: var(--bar-pad) var(--gutter);
    transition:
      translate var(--bar-slide) cubic-bezier(0.3, 0.6, 0.35, 1),
      background-color var(--bar-slide) ease,
      box-shadow var(--bar-slide) ease;
  }

  .mobile-header.is-floating {
    background-color: var(--bg-main);
    box-shadow: 0 1px 0 var(--border);
  }

  .mobile-header.is-tucked {
    translate: 0 calc(-100% - var(--bar-pad));
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-header {
      transition: none;
    }
  }

  .mobile-header .site-brand,
  .menu-top .site-brand {
    gap: 0.75rem;
  }

  .mobile-header .brand-name,
  .menu-top .brand-name {
    font-size: 1.125rem;
  }

  .icon-button {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .icon-button path {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .menu-sheet {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg-main);
    overflow: hidden;
  }

  .menu-paper {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: 1.25rem var(--gutter);
    padding-bottom: calc(1.25rem + 2rem);
    overflow-y: auto;
    background: var(--bg-main);
  }

  #menu-close {
    position: absolute;
    top: 0;
    left: 0;
  }

  :global(html:has(.menu-sheet[open])) #menu-open {
    visibility: hidden;
  }

  .menu-blind {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .menu-hem {
    fill: var(--fg-main);
    fill-opacity: 0.045;
  }

  .menu-stroke {
    fill: var(--fg-main);
    fill-opacity: 0.86;
  }

  .menu-hairs {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 1.1;
    stroke-opacity: 0.7;
    stroke-linecap: round;
  }

  :global(html:has(.menu-sheet[open])) {
    overflow: hidden;
  }

  .menu-sheet:focus {
    outline: none;
  }

  .menu-sheet::backdrop {
    background: transparent;
  }

  .menu-list {
    margin: 2.75rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .menu-list li {
    border-top: 1px dashed var(--border);
  }

  .menu-list a {
    display: flex;
    align-items: baseline;
    gap: 1.125rem;
    padding: clamp(0.5rem, 1.2vh, 0.875rem) 0;
    color: var(--fg-main);
    text-decoration: none;
  }

  .menu-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--cursor);
  }

  .menu-label {
    font-size: 2.125rem;
    font-weight: 300;
    line-height: 1.1;
  }

  .menu-list a[aria-current="page"] .menu-label {
    color: var(--cursor);
  }

  .menu-theme {
    margin-top: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 48px;
    padding: 0 1rem;
    border: 1px solid var(--border);
    border-radius: 24px 20px 23px 21px;
    background: transparent;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .menu-theme .theme-dots span {
    width: 12px;
    height: 12px;
  }

  .menu-theme .theme-dots span + span {
    margin-left: -6px;
  }

  .menu-theme-current {
    margin-left: auto;
    color: var(--fg-main);
  }

  .menu-extra {
    margin: 1.125rem 0 0;
    display: flex;
    gap: 1.125rem;
    font-family: var(--font-hand);
    font-weight: 300;
    font-size: 1.0625rem;
  }

  .menu-extra a {
    color: var(--fg-dim);
    text-decoration: none;
  }

  @media (min-width: 48em) {
    .mobile-header,
    .menu-sheet {
      display: none !important;
    }
  }

  @media (max-width: 47.99em) {
    .site-header {
      display: none;
    }
  }
</style>

<script>
  import "../scripts/menu-blind";
</script>

<script is:inline>
  (function () {
    function label() {
      var text = window.auTheme.resolve(window.auTheme.get()).replace("-", " · ");
      document.querySelectorAll("[data-theme-label]").forEach(function (themeLabel) {
        themeLabel.textContent = text;
      });
    }

    var sheet = document.getElementById("menu-sheet");

    // phone bar
    var bar = document.querySelector(".mobile-header");
    var SCROLL_NOISE = 6;
    var lastY = Math.max(0, scrollY);
    var stuckFrom = bar.offsetTop;
    var queued = false;

    function follow() {
      queued = false;
      var y = Math.max(0, scrollY);
      var floating = y > stuckFrom;
      if (Math.abs(y - lastY) < SCROLL_NOISE && floating) return;
      bar.classList.toggle("is-floating", floating);
      bar.classList.toggle("is-tucked", floating && y > lastY && !sheet.open);
      lastY = y;
    }

    addEventListener(
      "scroll",
      function () {
        if (queued) return;
        queued = true;
        requestAnimationFrame(follow);
      },
      { passive: true },
    );

    document.addEventListener("au-theme-change", label);
    document.addEventListener("DOMContentLoaded", label);
    label();
  })();
</script>
