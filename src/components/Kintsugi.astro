---
// A tea bowl broken into six shards on the lost page.
// The whole bowl earns a seal, and stays mended after.

type Point = [number, number];

const CORNERS: Record<string, Point> = {
  a: [170, 118],
  b: [215, 112],
  c: [260, 116],
  d: [300, 113],
  e: [345, 117],
  f: [390, 112],
  g: [430, 118],
  h: [433, 158],
  i: [430, 198],
  j: [416, 240],
  k: [390, 272],
  l: [354, 291],
  m: [346, 296],
  n: [348, 316],
  o: [252, 316],
  p: [254, 296],
  q: [246, 291],
  r: [210, 272],
  s: [184, 240],
  t: [170, 198],
  u: [167, 158],
  X1: [252, 148],
  X2: [236, 187],
  X3: [286, 196],
  X4: [336, 150],
  X5: [326, 181],
  X6: [386, 199],
  X7: [300, 254],
};

const SHARDS = [
  { id: "A", pts: "a b c X1 X2 t u", off: [-150, 40], rot: -24 },
  { id: "B", pts: "c d e X4 X5 X3 X2 X1", off: [60, -56], rot: 18 },
  { id: "C", pts: "e f g h i X6 X5 X4", off: [170, 70], rot: 30 },
  { id: "D1", pts: "t X2 X3 X7 r s", off: [-170, 110], rot: 14 },
  { id: "D2", pts: "X3 X5 X6 i j k X7", off: [200, 112], rot: -16 },
  { id: "E", pts: "r X7 k l m n o p q", off: [-60, 74], rot: -10 },
];

const CRACKS = [
  ["c X1 X2", "A", "B"],
  ["t X2", "A", "D1"],
  ["X2 X3", "B", "D1"],
  ["e X4 X5", "B", "C"],
  ["X3 X5", "B", "D2"],
  ["X5 X6 i", "C", "D2"],
  ["X3 X7", "D1", "D2"],
  ["r X7", "D1", "E"],
  ["X7 k", "D2", "E"],
];

const pointsOf = (names: string) => names.split(" ").map((name) => CORNERS[name]);
const poly = (names: string) =>
  "M" +
  pointsOf(names)
    .map(([x, y]) => `${x} ${y}`)
    .join(" L ") +
  " Z";
const line = (names: string) =>
  "M" +
  pointsOf(names)
    .map(([x, y]) => `${x} ${y}`)
    .join(" L ");

const BOWL = poly("a b c d e f g h i j k l m n o p q r s t u");
const GLAZE =
  "M160 104 L 440 104 L 432 160 C 414 168, 408 196, 400 204 C 392 200, 390 176, 372 172 C 352 178, 346 214, 336 218 C 328 212, 324 182, 302 178 C 282 184, 276 206, 268 208 C 260 202, 256 174, 236 172 C 216 176, 206 198, 198 198 C 192 188, 188 166, 166 160 Z";
const RIM = "M172 121 C 214 115, 258 120, 300 116 S 390 115, 428 121";
---

<figure class="kintsugi">
  <svg
    class="bowl"
    viewBox="-150 20 900 430"
    role="group"
    aria-label="A broken tea bowl. Drag the pieces back into place, or focus one and press Enter."
  >
    <defs>
      {SHARDS.map((shard) => (
        <clipPath id={`kin-${shard.id}`}>
          <path d={poly(shard.pts)} />
        </clipPath>
      ))}
    </defs>
    <path class="table" d="M140 318 C 230 314, 370 314, 460 318"></path>
    <path class="ghost" d={BOWL}></path>
    {SHARDS.map((shard, index) => {
      return (
        <g
          class="shard"
          tabindex="0"
          role="button"
          aria-label={`piece ${index + 1} of 6`}
          data-id={shard.id}
          data-off={JSON.stringify(shard.off)}
          data-rot={shard.rot}
        >
          <path class="shard-shadow" d={poly(shard.pts)} transform="translate(4 6)" />
          <path class="shard-clay" d={poly(shard.pts)} />
          <path class="shard-glaze" d={GLAZE} clip-path={`url(#kin-${shard.id})`} />
          <path class="shard-rim" d={RIM} clip-path={`url(#kin-${shard.id})`} />
          <path class="shard-edge" d={poly(shard.pts)} />
        </g>
      );
    })}
    {CRACKS.map(([edge, sideA, sideB]) => (
      <path class="gold" d={line(edge)} pathLength="1" data-a={sideA} data-b={sideB} />
    ))}
    <g class="kin-seal" transform="translate(452 286) rotate(-6) scale(0.9)">
      <path d="M4 5 Q23 2 42 4 Q45 23 43 42 Q23 45 3 43 Q1 23 4 5 Z"></path>
      <text x="23" y="31" text-anchor="middle">
        継
      </text>
    </g>
  </svg>
  <figcaption class="hand">
    <span class="said-before">a bowl broke here too. put it back together, if you like.</span>
    <span class="said-after">whole again, and more itself for having broken.</span>
  </figcaption>
</figure>

<style>
  .kintsugi {
    margin: 5rem 0 0;
  }

  .bowl {
    display: block;
    width: 100%;
    max-width: 56rem;
    height: auto;
    margin: 0 auto;
    overflow: visible;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .table {
    fill: none;
    stroke: var(--border);
    stroke-linecap: round;
  }

  .ghost {
    fill: none;
    stroke: var(--border);
    stroke-dasharray: 3 5;
    stroke-linejoin: round;
  }

  .shard {
    transform-box: fill-box;
    transform-origin: center;
    cursor: grab;
    outline: none;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .shard.lifted {
    cursor: grabbing;
    transition: none;
  }

  .shard.home {
    cursor: default;
  }

  .shard-shadow {
    fill: var(--fg-main);
    opacity: 0.12;
    transition: opacity 0.3s ease;
  }

  .shard.lifted .shard-shadow {
    opacity: 0.22;
  }

  .shard.home .shard-shadow {
    opacity: 0;
  }

  .shard-clay {
    fill: var(--bg-alt);
  }

  .shard-glaze {
    fill: var(--fg-main);
    opacity: 0.72;
  }

  .shard-rim {
    fill: none;
    stroke: var(--bg-main);
    stroke-width: 1.2;
    opacity: 0.5;
  }

  .shard-edge {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  .shard:focus-visible .shard-edge {
    stroke: var(--cursor);
    stroke-width: 2;
  }

  .gold {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    pointer-events: none;
    transition:
      stroke-dashoffset 1.6s ease-in-out,
      opacity 0.3s ease;
  }

  .gold.on {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .kin-seal {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s ease 0.8s,
      visibility 1.2s 0.8s;
  }

  .kintsugi.whole .kin-seal {
    opacity: 1;
    visibility: visible;
  }

  .kin-seal path {
    fill: var(--red);
    opacity: 0.92;
  }

  .kin-seal text {
    font-family: var(--font-seal);
    font-size: 22px;
    fill: var(--bg-main);
  }

  figcaption {
    margin: 0.75rem auto 0;
    width: fit-content;
    font-weight: 300;
    font-size: 1.0625rem;
    color: var(--fg-dim);
    transform: rotate(-1deg);
  }

  .said-after,
  .kintsugi.whole .said-before {
    display: none;
  }

  .kintsugi.whole .said-after {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .shard,
    .gold {
      transition: none;
    }
  }

  @media (max-width: 47.99em) {
    .kintsugi {
      margin-top: 3.5rem;
    }
  }
</style>

<script>
  import { earn, load } from "../utils/garden";

  const figure = document.querySelector<HTMLElement>(".kintsugi");
  const svg = figure?.querySelector<SVGSVGElement>(".bowl");

  if (figure && svg) {
    const TURN = 140;
    const SNAP = 30;
    const shards = [...svg.querySelectorAll<SVGGElement>(".shard")];
    const golds = [...svg.querySelectorAll<SVGPathElement>(".gold")];
    const home = new Set<string>();
    const offsets = new Map<string, [number, number]>();
    const mended = !!load().seals["継"];

    const place = (shard: SVGGElement) => {
      const id = shard.dataset.id!;
      const [offsetX, offsetY] = offsets.get(id)!;
      const distance = Math.hypot(offsetX, offsetY);
      const rotation = Number(shard.dataset.rot);
      const tilt = home.has(id) ? 0 : distance >= TURN ? rotation : (rotation * distance) / TURN;
      shard.style.transform = `translate(${offsetX.toFixed(1)}px, ${offsetY.toFixed(1)}px) rotate(${tilt.toFixed(1)}deg)`;
    };

    const settle = () => {
      golds.forEach((gold) =>
        gold.classList.toggle("on", home.has(gold.dataset.a!) && home.has(gold.dataset.b!)),
      );
      if (home.size === shards.length && !figure.classList.contains("whole")) {
        figure.classList.add("whole");
        earn("継");
      }
    };

    const putHome = (shard: SVGGElement) => {
      home.add(shard.dataset.id!);
      offsets.set(shard.dataset.id!, [0, 0]);
      shard.classList.add("home");
      shard.removeAttribute("tabindex");
      shard.setAttribute("aria-label", "a mended piece");
      place(shard);
      settle();
    };

    const narrow = matchMedia("(max-width: 47.99em)").matches;
    const spread = narrow ? 0.55 : 1;
    if (narrow) svg.setAttribute("viewBox", "40 40 520 380");

    shards.forEach((shard) => {
      const [startX, startY]: [number, number] = JSON.parse(shard.dataset.off!);
      offsets.set(shard.dataset.id!, [startX * spread, startY * spread]);
      if (mended) putHome(shard);
      else place(shard);
    });
    if (mended) figure.classList.add("whole");

    const toBowl = (event: PointerEvent): [number, number] => {
      const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(
        svg.getScreenCTM()!.inverse(),
      );
      return [point.x, point.y];
    };

    let drag: { g: SVGGElement; from: [number, number]; at: [number, number] } | null = null;

    shards.forEach((shard) => {
      shard.addEventListener("pointerdown", (event) => {
        if (home.has(shard.dataset.id!)) return;
        event.preventDefault();
        svg.setPointerCapture(event.pointerId);
        // the piece being carried is drawn above the others
        shard.parentNode!.insertBefore(shard, golds[0]);
        shard.classList.add("lifted");
        drag = { g: shard, from: toBowl(event), at: [...offsets.get(shard.dataset.id!)!] };
      });
      shard.addEventListener("keydown", (event) => {
        if ((event.key === "Enter" || event.key === " ") && !home.has(shard.dataset.id!)) {
          event.preventDefault();
          putHome(shard);
        }
      });
    });

    svg.addEventListener("pointermove", (event) => {
      if (!drag) return;
      const [x, y] = toBowl(event);
      offsets.set(drag.g.dataset.id!, [
        drag.at[0] + x - drag.from[0],
        drag.at[1] + y - drag.from[1],
      ]);
      place(drag.g);
    });

    const drop = () => {
      if (!drag) return;
      const shard = drag.g;
      drag = null;
      shard.classList.remove("lifted");
      const [offsetX, offsetY] = offsets.get(shard.dataset.id!)!;
      if (Math.hypot(offsetX, offsetY) < SNAP) putHome(shard);
    };
    svg.addEventListener("pointerup", drop);
    svg.addEventListener("pointercancel", drop);
  }
</script>
