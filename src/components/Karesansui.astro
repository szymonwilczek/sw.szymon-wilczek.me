---
// A strip of dry garden above the home footer.
// Drag across it and the lines part like sand; leave it and the rake comes back
// and smooths them.
import { artUrl } from "../utils/art";
---

<figure class="karesansui">
  <link
    rel="preload"
    href={artUrl("sand")}
    as="fetch"
    crossorigin="anonymous"
    fetchpriority="low"
  />
  <svg
    class="sand"
    viewBox="0 0 1000 190"
    role="img"
    aria-label="Raked sand garden with three stones"
    data-art={artUrl("sand")}
  ></svg>
  <figcaption class="hand">rake it. it remembers nothing.</figcaption>
</figure>

<style>
  .karesansui {
    margin: 5rem 0 0;
  }

  .sand {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: none;
    cursor: crosshair;
    user-select: none;
    -webkit-user-select: none;
  }

  .sand :global(.sand-bed) {
    fill: var(--bg-dim);
  }

  .sand :global(.sand-grains) {
    fill: var(--border);
    opacity: 0.5;
  }

  .sand :global(.sand-lines),
  .sand :global(.sand-kept) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sand :global(.sand-kept) {
    stroke-width: 1.3;
    opacity: 0.75;
  }

  .sand :global(.stone-shadow) {
    fill: var(--fg-dim);
    opacity: 0.14;
  }

  .sand :global(.stone-body) {
    fill: var(--bg-alt);
    stroke: var(--fg-main);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .sand :global(.stone-facet) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .sand :global(.stone-moss) {
    fill: var(--leaf);
    stroke: var(--fg-dim);
    stroke-width: 0.6;
    opacity: 0.9;
  }

  .sand :global(.sand-rake) {
    fill: var(--fg-main);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .sand :global(.sand-rake.on) {
    opacity: 0.55;
  }

  .sand :global(.sand-leaf-blade) {
    fill: var(--red);
    opacity: 0.9;
  }

  .sand :global(.sand-leaf-ink),
  .sand :global(.sand-leaf-stem) {
    fill: none;
    stroke: var(--red-warmer);
    stroke-width: 6;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.65;
  }

  figcaption {
    margin: 0.5rem 0.25rem 0 auto;
    width: fit-content;
    font-weight: 300;
    font-size: 1rem;
    color: var(--fg-dim);
    opacity: 0.7;
    transform: rotate(-1deg);
  }

  @media (max-width: 47.99em) {
    .karesansui {
      margin-top: 3.5rem;
    }
  }
</style>

<script>
  import { earn } from "../utils/garden";
  import { smooth, SMALL_STONE, STONE_SHAPES } from "../utils/sand";
  import { fillArt } from "../scripts/art";

  type Point = [number, number];

  const svg = document.querySelector<SVGSVGElement>(".sand");
  const narrow = matchMedia("(max-width: 47.99em)");

  // on a phone the strip shows the stones closer, so there is sand to rake
  if (svg) {
    const frame = () =>
      svg.setAttribute("viewBox", narrow.matches ? "180 0 660 190" : "0 0 1000 190");
    frame();
    narrow.addEventListener("change", frame);
    fillArt(svg).then(() => setup(svg));
  }

  function setup(svg: SVGSVGElement) {
    const base: Point[][] = JSON.parse(svg.dataset.lines ?? "[]");
    const paths = Array.from(svg.querySelectorAll<SVGPathElement>(".sand-lines path")).slice(
      0,
      base.length,
    );
    const shown = base.map((line) => line.map((): Point => [0, 0]));
    const want = base.map((line) => line.map((): Point => [0, 0]));
    const kept = svg.querySelector<SVGGElement>(".sand-kept")!;
    const teeth = svg.querySelector<SVGGElement>(".sand-rake")!;
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const RING_KEY = "sand-ring-pts";

    const toSand = (event: PointerEvent): Point => {
      const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(
        svg.getScreenCTM()!.inverse(),
      );
      return [point.x, point.y];
    };

    const ringPath = (stroke: Point[]) =>
      smooth(
        stroke.filter((_, i) => i % 2 === 0),
        false,
      );

    function keepRing(path: string) {
      const ring = document.createElementNS("http://www.w3.org/2000/svg", "path");
      ring.setAttribute("d", path);
      kept.append(ring);
    }

    const nearSmall = ([pointX, pointY]: Point) => {
      const { x, y, rx, ry } = SMALL_STONE;
      const distance = Math.hypot((pointX - x) / rx, (pointY - y) / ry);
      return distance >= 1 && distance <= 5;
    };

    try {
      sessionStorage.removeItem("sand-ring");
      const saved: unknown = JSON.parse(sessionStorage.getItem(RING_KEY) ?? "null");
      const isPoint = (value: unknown): value is Point =>
        Array.isArray(value) && value.length === 2 && value.every(Number.isFinite);
      if (
        Array.isArray(saved) &&
        saved.length > 2 &&
        saved.every((point) => isPoint(point) && nearSmall(point))
      )
        keepRing(ringPath(saved));
      else sessionStorage.removeItem(RING_KEY);
    } catch {
      // the ring is only for this visit anyway
    }

    // nothing is pushed into a stone
    function aroundStones(x: number, y: number, offset: Point) {
      for (const stone of STONE_SHAPES) {
        const scaledX = (x + offset[0] - stone.x) / (stone.rx + 4);
        const scaledY = (y + offset[1] - stone.y) / (stone.ry + 4);
        const scaled = Math.hypot(scaledX, scaledY);
        if (scaled < 1 && scaled > 0.001) {
          offset[0] = stone.x + (x + offset[0] - stone.x) / scaled - x;
          offset[1] = stone.y + (y + offset[1] - stone.y) / scaled - y;
        }
      }
    }

    // rake drags every line and ring near it the way it moves
    const REACH = 30;
    let last: Point | null = null;
    function rake(point: Point) {
      const [rakeX, rakeY] = point;
      const [moveX, moveY] = last ? [rakeX - last[0], rakeY - last[1]] : [0, 0];
      last = point;
      const moved = Math.hypot(moveX, moveY);
      if (moved > 0.5) {
        const dirX = moveX / moved;
        const dirY = moveY / moved;
        teeth.querySelectorAll("circle").forEach((tooth, toothIndex) => {
          tooth.setAttribute("cx", (rakeX - dirY * (toothIndex - 2) * 6).toFixed(1));
          tooth.setAttribute("cy", (rakeY + dirX * (toothIndex - 2) * 6).toFixed(1));
        });
        teeth.classList.add("on");
      }
      base.forEach((line, lineIndex) => {
        line.forEach(([x, y], i) => {
          const offset = want[lineIndex][i];
          const gapX = x + offset[0] - rakeX;
          if (Math.abs(gapX) > REACH) return;
          const dist = Math.hypot(gapX, y + offset[1] - rakeY);
          if (dist > REACH) return;
          const fall = (1 - dist / REACH) ** 2;
          offset[0] += moveX * fall * 0.6;
          offset[1] += moveY * fall * 0.6;
          const magnitude = Math.hypot(offset[0], offset[1]);
          if (magnitude > 16) {
            offset[0] *= 16 / magnitude;
            offset[1] *= 16 / magnitude;
          }
          aroundStones(x, y, offset);
        });
      });
      wake();
    }

    let frameId = 0;
    let lastMove = 0;
    let settleFrom = 0;

    function draw() {
      const time = performance.now();
      // after a few still seconds the rake comes back: slow, then all at once
      if (time - lastMove > 3000) {
        if (!settleFrom) settleFrom = time;
        const tug = still.matches ? 1 : Math.min(1, ((time - settleFrom) / 2600) ** 3);
        for (const line of want) {
          for (const offset of line) {
            offset[0] *= 1 - tug;
            offset[1] *= 1 - tug;
          }
        }
      }
      let moving = false;
      base.forEach((line, lineIndex) => {
        let changed = false;
        const points = line.map(([x, y], i) => {
          const current = shown[lineIndex][i];
          const wanted = want[lineIndex][i];
          for (const axis of [0, 1]) {
            const gap = wanted[axis] - current[axis];
            if (Math.abs(gap) > 0.05) {
              current[axis] += still.matches ? gap : gap * 0.3;
              changed = true;
            } else current[axis] = wanted[axis];
          }
          return [x + current[0], y + current[1]] as Point;
        });
        if (changed) {
          moving = true;
          paths[lineIndex].setAttribute("d", smooth(points, false));
        }
      });
      const resting = want.every((line) =>
        line.every((offset) => Math.abs(offset[0]) < 0.05 && Math.abs(offset[1]) < 0.05),
      );
      if (moving || !resting) frameId = requestAnimationFrame(draw);
      else frameId = 0;
    }

    function wake() {
      lastMove = performance.now();
      settleFrom = 0;
      if (!frameId) frameId = requestAnimationFrame(draw);
    }

    // full ring round the smallest stone, in one stroke, earns seal
    let stroke: Point[] = [];
    function ring(): Point[] | null {
      const { x, y, rx, ry } = SMALL_STONE;
      let sweep = 0;
      let from = 0;
      let prev: number | null = null;
      for (let i = 0; i < stroke.length; i++) {
        const [pointX, pointY] = stroke[i];
        const unitX = (pointX - x) / rx;
        const unitY = (pointY - y) / ry;
        if (!nearSmall([pointX, pointY])) {
          prev = null;
          sweep = 0;
          continue;
        }
        const angle = Math.atan2(unitY, unitX);
        if (prev === null) from = i;
        else sweep += ((angle - prev + 3 * Math.PI) % (2 * Math.PI)) - Math.PI;
        prev = angle;
        if (Math.abs(sweep) > (345 * Math.PI) / 180) return stroke.slice(from, i + 1);
      }
      return null;
    }

    let down = false;
    svg.addEventListener("pointerdown", (event) => {
      down = true;
      last = null;
      stroke = [toSand(event)];
      svg.setPointerCapture(event.pointerId);
      rake(stroke[0]);
    });
    svg.addEventListener("pointermove", (event) => {
      if (!down) return;
      const point = toSand(event);
      stroke.push(point);
      rake(point);
    });
    const lift = () => {
      if (!down) return;
      down = false;
      last = null;
      teeth.classList.remove("on");
      const loop = ring();
      if (loop && !kept.childElementCount) {
        const path = ringPath(loop);
        keepRing(path);
        try {
          sessionStorage.setItem(
            RING_KEY,
            JSON.stringify(loop.map(([x, y]) => [+x.toFixed(1), +y.toFixed(1)])),
          );
        } catch {
          // kept on the page, at least
        }
        earn("石");
      }
      stroke = [];
    };
    svg.addEventListener("pointerup", lift);
    svg.addEventListener("pointercancel", lift);
  }
</script>
