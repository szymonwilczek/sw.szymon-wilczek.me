---
// A strip of dry garden above the home footer.
// Drag across it and the lines part like sand; leave it and the rake comes back
// and smooths them.
import { makeSand, smooth } from "../utils/sand";
import { MOMIJI } from "../utils/momiji";

const sand = makeSand();
---

<figure class="karesansui">
  <svg
    class="sand"
    viewBox="0 0 1000 190"
    role="img"
    aria-label="Raked sand garden with three stones"
    data-lines={JSON.stringify([...sand.lines, ...sand.rings].map((l) => l.pts))}
  >
    <defs>
      <clipPath id="sand-clip">
        <path d={sand.edge}></path>
      </clipPath>
    </defs>
    <path class="sand-bed" d={sand.edge}></path>
    <g class="sand-grains">
      {sand.grains.map((g) => (
        <circle cx={g.x} cy={g.y} r={g.r} />
      ))}
    </g>
    <g class="sand-lines">
      {sand.lines.map((l) => (
        <path d={smooth(l.pts, false)} stroke-width={l.w} opacity={l.o} />
      ))}
      {sand.rings.map((r) => (
        <path d={smooth(r.pts, false)} stroke-width={r.w} opacity={r.o} />
      ))}
    </g>
    <g class="sand-kept" clip-path="url(#sand-clip)"></g>
    {sand.stones.map((s) => (
      <g class="stone">
        <path class="stone-shadow" d={s.shadow} />
        <path class="stone-body" d={s.d} />
        <path class="stone-facet" d={s.facet} />
        {s.moss && <path class="stone-moss" d={s.moss} />}
      </g>
    ))}
    <g class="sand-rake" aria-hidden="true">
      {[0, 1, 2, 3, 4].map(() => (
        <circle r="1.8" />
      ))}
    </g>
    <g class="sand-leaf" transform="translate(806 97) rotate(-28) scale(0.14)">
      <path class="sand-leaf-stem" d={MOMIJI.stem}></path>
      <path class="sand-leaf-blade" d={MOMIJI.outline}></path>
      <path class="sand-leaf-ink" d={MOMIJI.outline} transform="translate(5 -4)"></path>
    </g>
  </svg>
  <figcaption class="hand">rake it. it remembers nothing.</figcaption>
</figure>

<style>
  .karesansui {
    margin: 5rem 0 0;
  }

  .sand {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: none;
    cursor: crosshair;
    user-select: none;
    -webkit-user-select: none;
  }

  .sand-bed {
    fill: var(--bg-dim);
  }

  .sand-grains {
    fill: var(--border);
    opacity: 0.5;
  }

  .sand-lines,
  .sand-kept {
    fill: none;
    stroke: var(--fg-dim);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sand-kept {
    stroke-width: 1.3;
    opacity: 0.75;
  }

  .stone-shadow {
    fill: var(--fg-dim);
    opacity: 0.14;
  }

  .stone-body {
    fill: var(--bg-alt);
    stroke: var(--fg-main);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .stone-facet {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .stone-moss {
    fill: var(--leaf);
    stroke: var(--fg-dim);
    stroke-width: 0.6;
    opacity: 0.9;
  }

  .sand-rake {
    fill: var(--fg-main);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .sand-rake.on {
    opacity: 0.55;
  }

  .sand-leaf-blade {
    fill: var(--red);
    opacity: 0.9;
  }

  .sand-leaf-ink,
  .sand-leaf-stem {
    fill: none;
    stroke: var(--red-warmer);
    stroke-width: 6;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.65;
  }

  figcaption {
    margin: 0.5rem 0.25rem 0 auto;
    width: fit-content;
    font-weight: 300;
    font-size: 1rem;
    color: var(--fg-dim);
    opacity: 0.7;
    transform: rotate(-1deg);
  }

  @media (max-width: 47.99em) {
    .karesansui {
      margin-top: 3.5rem;
    }
  }
</style>

<script>
  import { earn } from "../utils/garden";
  import { smooth, SMALL_STONE, STONE_SHAPES } from "../utils/sand";

  type Point = [number, number];

  const svg = document.querySelector<SVGSVGElement>(".sand");

  if (svg) {
    const base: Point[][] = JSON.parse(svg.dataset.lines ?? "[]");
    const paths = Array.from(svg.querySelectorAll<SVGPathElement>(".sand-lines path")).slice(
      0,
      base.length,
    );
    const now = base.map((line) => line.map((): Point => [0, 0]));
    const want = base.map((line) => line.map((): Point => [0, 0]));
    const kept = svg.querySelector<SVGGElement>(".sand-kept")!;
    const teeth = svg.querySelector<SVGGElement>(".sand-rake")!;
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const narrow = matchMedia("(max-width: 47.99em)");
    const KEY = "sand-ring-pts";

    // on a phone the strip shows the stones closer, so there is sand to rake
    const frame = () =>
      svg.setAttribute("viewBox", narrow.matches ? "180 0 660 190" : "0 0 1000 190");
    frame();
    narrow.addEventListener("change", frame);

    const toSand = (e: PointerEvent): Point => {
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
      return [p.x, p.y];
    };

    const ringPath = (stroke: Point[]) =>
      smooth(
        stroke.filter((_, i) => i % 2 === 0),
        false,
      );

    function keepRing(d: string) {
      const ring = document.createElementNS("http://www.w3.org/2000/svg", "path");
      ring.setAttribute("d", d);
      kept.append(ring);
    }

    const nearSmall = ([px, py]: Point) => {
      const { x, y, rx, ry } = SMALL_STONE;
      const r = Math.hypot((px - x) / rx, (py - y) / ry);
      return r >= 1 && r <= 5;
    };

    try {
      sessionStorage.removeItem("sand-ring");
      const saved: unknown = JSON.parse(sessionStorage.getItem(KEY) ?? "null");
      const isPoint = (q: unknown): q is Point =>
        Array.isArray(q) && q.length === 2 && q.every(Number.isFinite);
      if (
        Array.isArray(saved) &&
        saved.length > 2 &&
        saved.every((q) => isPoint(q) && nearSmall(q))
      )
        keepRing(ringPath(saved));
      else sessionStorage.removeItem(KEY);
    } catch {
      // the ring is only for this visit anyway
    }

    // nothing is pushed into a stone
    function aroundStones(x: number, y: number, o: Point) {
      for (const s of STONE_SHAPES) {
        const ex = (x + o[0] - s.x) / (s.rx + 4);
        const ey = (y + o[1] - s.y) / (s.ry + 4);
        const e = Math.hypot(ex, ey);
        if (e < 1 && e > 0.001) {
          o[0] = s.x + (x + o[0] - s.x) / e - x;
          o[1] = s.y + (y + o[1] - s.y) / e - y;
        }
      }
    }

    // rake drags every line and ring near it the way it moves
    const REACH = 30;
    let last: Point | null = null;
    function rake(p: Point) {
      const [px, py] = p;
      const [vx, vy] = last ? [px - last[0], py - last[1]] : [0, 0];
      last = p;
      const len = Math.hypot(vx, vy);
      if (len > 0.5) {
        const ux = vx / len;
        const uy = vy / len;
        teeth.querySelectorAll("circle").forEach((c, k) => {
          c.setAttribute("cx", (px - uy * (k - 2) * 6).toFixed(1));
          c.setAttribute("cy", (py + ux * (k - 2) * 6).toFixed(1));
        });
        teeth.classList.add("on");
      }
      base.forEach((line, l) => {
        line.forEach(([x, y], i) => {
          const o = want[l][i];
          const dx = x + o[0] - px;
          if (Math.abs(dx) > REACH) return;
          const dist = Math.hypot(dx, y + o[1] - py);
          if (dist > REACH) return;
          const fall = (1 - dist / REACH) ** 2;
          o[0] += vx * fall * 0.6;
          o[1] += vy * fall * 0.6;
          const m = Math.hypot(o[0], o[1]);
          if (m > 16) {
            o[0] *= 16 / m;
            o[1] *= 16 / m;
          }
          aroundStones(x, y, o);
        });
      });
      wake();
    }

    let frameId = 0;
    let lastMove = 0;
    let settleFrom = 0;

    function draw() {
      const t = performance.now();
      // after a few still seconds the rake comes back: slow, then all at once
      if (t - lastMove > 3000) {
        if (!settleFrom) settleFrom = t;
        const k = still.matches ? 1 : Math.min(1, ((t - settleFrom) / 2600) ** 3);
        for (const line of want) {
          for (const o of line) {
            o[0] *= 1 - k;
            o[1] *= 1 - k;
          }
        }
      }
      let moving = false;
      base.forEach((line, l) => {
        let changed = false;
        const pts = line.map(([x, y], i) => {
          const n = now[l][i];
          const w = want[l][i];
          for (const a of [0, 1]) {
            const d = w[a] - n[a];
            if (Math.abs(d) > 0.05) {
              n[a] += still.matches ? d : d * 0.3;
              changed = true;
            } else n[a] = w[a];
          }
          return [x + n[0], y + n[1]] as Point;
        });
        if (changed) {
          moving = true;
          paths[l].setAttribute("d", smooth(pts, false));
        }
      });
      const resting = want.every((line) =>
        line.every((o) => Math.abs(o[0]) < 0.05 && Math.abs(o[1]) < 0.05),
      );
      if (moving || !resting) frameId = requestAnimationFrame(draw);
      else frameId = 0;
    }

    function wake() {
      lastMove = performance.now();
      settleFrom = 0;
      if (!frameId) frameId = requestAnimationFrame(draw);
    }

    // full ring round the smallest stone, in one stroke, earns seal
    let stroke: Point[] = [];
    function ring(): Point[] | null {
      const { x, y, rx, ry } = SMALL_STONE;
      let sweep = 0;
      let from = 0;
      let prev: number | null = null;
      for (let i = 0; i < stroke.length; i++) {
        const [px, py] = stroke[i];
        const nx = (px - x) / rx;
        const ny = (py - y) / ry;
        if (!nearSmall([px, py])) {
          prev = null;
          sweep = 0;
          continue;
        }
        const a = Math.atan2(ny, nx);
        if (prev === null) from = i;
        else sweep += ((a - prev + 3 * Math.PI) % (2 * Math.PI)) - Math.PI;
        prev = a;
        if (Math.abs(sweep) > (345 * Math.PI) / 180) return stroke.slice(from, i + 1);
      }
      return null;
    }

    let down = false;
    svg.addEventListener("pointerdown", (e) => {
      down = true;
      last = null;
      stroke = [toSand(e)];
      svg.setPointerCapture(e.pointerId);
      rake(stroke[0]);
    });
    svg.addEventListener("pointermove", (e) => {
      if (!down) return;
      const p = toSand(e);
      stroke.push(p);
      rake(p);
    });
    const lift = () => {
      if (!down) return;
      down = false;
      last = null;
      teeth.classList.remove("on");
      const loop = ring();
      if (loop && !kept.childElementCount) {
        const d = ringPath(loop);
        keepRing(d);
        try {
          sessionStorage.setItem(
            KEY,
            JSON.stringify(loop.map(([x, y]) => [+x.toFixed(1), +y.toFixed(1)])),
          );
        } catch {
          // kept on the page, at least
        }
        earn("石");
      }
      stroke = [];
    };
    svg.addEventListener("pointerup", lift);
    svg.addEventListener("pointercancel", lift);
  }
</script>
