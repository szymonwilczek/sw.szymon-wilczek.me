---
import { FILTERS, hash, rng, smooth, wobblyLine, wobblyRing } from "../utils/tea/ink.js";

interface Props {
  seed: string;
}

const { seed } = Astro.props;
const rand = rng(hash(`${seed}·kept`));
const WIDTH = 600;
const HEIGHT = 236;
const fixed = (value: number) => value.toFixed(1);
const jitter = (amount: number) => (rand() - 0.5) * 2 * amount;

function edge(from: [number, number], to: [number, number], step = 28, wobble = 0.6) {
  const count = Math.max(2, Math.round(Math.hypot(to[0] - from[0], to[1] - from[1]) / step));
  return Array.from({ length: count }, (_, index): [number, number] => [
    from[0] + ((to[0] - from[0]) * index) / count + jitter(wobble),
    from[1] + ((to[1] - from[1]) * index) / count + jitter(wobble),
  ]);
}
const corners: [number, number][] = [
  [4, 5],
  [WIDTH - 4, 3],
  [WIDTH - 3, HEIGHT - 3],
  [5, HEIGHT - 4],
];
const outline = smooth(
  corners.flatMap((corner, i) => edge(corner, corners[(i + 1) % 4])),
  true,
);
const pool = wobblyRing(rand, WIDTH / 2 + 8, HEIGHT * 0.62, WIDTH * 0.47, HEIGHT * 0.44, 4, 14);
const fibres = Array.from({ length: 7 }, () => {
  const fibreX = 14 + rand() * (WIDTH - 28),
    fibreY = 14 + rand() * (HEIGHT - 28),
    fibreLength = 6 + rand() * 14,
    fibreAngle = rand() * Math.PI;
  return wobblyLine(
    rand,
    [
      [fibreX, fibreY],
      [
        fibreX + Math.cos(fibreAngle) * fibreLength * 0.5,
        fibreY + Math.sin(fibreAngle) * fibreLength * 0.5 + 1.5,
      ],
      [fibreX + Math.cos(fibreAngle) * fibreLength, fibreY + Math.sin(fibreAngle) * fibreLength],
    ],
    0.6,
  );
});

const FOLD = 46;
const FOLD_TOP = [FOLD - 3, 0];
const FOLD_SIDE = [0, FOLD - 3];
const FOLD_TIP = [FOLD * 0.14, FOLD * 0.26];
const FOLD_CURVE = [FOLD * 0.64, FOLD * 0.64];
const flap = `M${FOLD_TOP} Q${fixed(FOLD * 0.55)} ${fixed(FOLD * 0.05)} ${FOLD_TIP} Q${fixed(FOLD * 0.2)} ${fixed(FOLD * 0.7)} ${FOLD_SIDE} Q${FOLD_CURVE} ${FOLD_TOP} Z`;
const under = wobblyRing(rand, FOLD * 0.62, FOLD * 0.62, FOLD * 0.3, FOLD * 0.18, 1, 10);
---

<span class="kept-paper" aria-hidden="true">
  <svg class="kept-pool" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} preserveAspectRatio="none">
    <defs set:html={FILTERS} />
    <path d={pool} filter="url(#bk-pool)"></path>
  </svg>
  <svg class="kept-sheet" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} preserveAspectRatio="none">
    <path class="kept-wash" d={outline} transform="translate(2 1.5)" filter="url(#bk-wash)"></path>
    <path class="kept-body" d={outline}></path>
    <path class="kept-age" d={outline}></path>
    {fibres.map((fibre) => (
      <path class="kept-fibre" d={fibre} />
    ))}
    <path class="kept-edge" d={outline} filter="url(#bk-tremble)"></path>
  </svg>
  <svg class="kept-corner" viewBox={`0 0 ${FOLD} ${FOLD}`} width={FOLD} height={FOLD}>
    <path class="kept-under" d={under} filter="url(#bk-pool)"></path>
    <path
      class="kept-flap-wash"
      d={flap}
      transform="translate(1.5 1)"
      filter="url(#bk-wash)"
    ></path>
    <path class="kept-flap" d={flap}></path>
    <path class="kept-flap-edge" d={flap} filter="url(#bk-tremble)"></path>
  </svg>
</span>

<style>
  .kept-paper {
    --kept-tea: color-mix(in srgb, var(--red-warmer) 60%, var(--paper));
    --kept-pool: color-mix(in srgb, var(--fg-main) 16%, var(--paper));
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .kept-paper svg {
    overflow: visible;
  }

  .kept-pool,
  .kept-sheet {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .kept-pool path {
    fill: var(--kept-pool);
    opacity: 0.5;
  }

  .kept-sheet {
    mask:
      linear-gradient(#000, #000) top / 100% calc(100% - 46px) no-repeat,
      linear-gradient(#000, #000) left bottom / calc(100% - 46px) 46px no-repeat,
      linear-gradient(to bottom right, #000 50%, transparent 50%) right bottom / 46px 46px no-repeat;
  }

  .kept-sheet path {
    vector-effect: non-scaling-stroke;
  }

  .kept-wash {
    fill: var(--kept-tea);
    opacity: 0.4;
  }

  .kept-body {
    fill: var(--paper);
  }

  .kept-age {
    fill: var(--tape);
    opacity: 0.22;
  }

  .kept-fibre {
    fill: none;
    stroke: color-mix(in srgb, var(--fg-main) 55%, var(--paper));
    stroke-width: 0.5;
    stroke-linecap: round;
    opacity: 0.2;
  }

  .kept-edge,
  .kept-flap-edge {
    fill: none;
    stroke: color-mix(in srgb, var(--fg-main) 90%, var(--paper));
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.8;
  }

  .kept-corner {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  .kept-under {
    fill: var(--kept-pool);
    opacity: 0.75;
  }

  .kept-flap {
    fill: color-mix(in srgb, var(--paper) 70%, var(--tape));
  }

  .kept-flap-wash {
    fill: var(--kept-tea);
    opacity: 0.35;
  }
</style>
