---
import { FILTERS, hash, rng, smooth, wline, wring } from "../utils/tea/ink.js";

interface Props {
  seed: string;
}

const { seed } = Astro.props;
const r = rng(hash(`${seed}·kept`));
const W = 600;
const H = 236;
const f = (n: number) => n.toFixed(1);
const jit = (a: number) => (r() - 0.5) * 2 * a;

function edge(a: [number, number], b: [number, number], step = 28, j = 0.6) {
  const n = Math.max(2, Math.round(Math.hypot(b[0] - a[0], b[1] - a[1]) / step));
  return Array.from({ length: n }, (_, k): [number, number] => [
    a[0] + ((b[0] - a[0]) * k) / n + jit(j),
    a[1] + ((b[1] - a[1]) * k) / n + jit(j),
  ]);
}
const corners: [number, number][] = [
  [4, 5],
  [W - 4, 3],
  [W - 3, H - 3],
  [5, H - 4],
];
const outline = smooth(
  corners.flatMap((p, i) => edge(p, corners[(i + 1) % 4])),
  true,
);
const pool = wring(r, W / 2 + 8, H * 0.62, W * 0.47, H * 0.44, 4, 14);
const fibres = Array.from({ length: 7 }, () => {
  const x = 14 + r() * (W - 28),
    y = 14 + r() * (H - 28),
    l = 6 + r() * 14,
    a = r() * Math.PI;
  return wline(
    r,
    [
      [x, y],
      [x + Math.cos(a) * l * 0.5, y + Math.sin(a) * l * 0.5 + 1.5],
      [x + Math.cos(a) * l, y + Math.sin(a) * l],
    ],
    0.6,
  );
});

const c = 46;
const P1 = [c - 3, 0];
const P2 = [0, c - 3];
const T = [c * 0.14, c * 0.26];
const F = [c * 0.64, c * 0.64];
const flap = `M${P1} Q${f(c * 0.55)} ${f(c * 0.05)} ${T} Q${f(c * 0.2)} ${f(c * 0.7)} ${P2} Q${F} ${P1} Z`;
const under = wring(r, c * 0.62, c * 0.62, c * 0.3, c * 0.18, 1, 10);
---

<span class="kept-paper" aria-hidden="true">
  <svg class="kept-pool" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
    <defs set:html={FILTERS} />
    <path d={pool} filter="url(#bk-pool)"></path>
  </svg>
  <svg class="kept-sheet" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
    <path class="kept-wash" d={outline} transform="translate(2 1.5)" filter="url(#bk-wash)"></path>
    <path class="kept-body" d={outline}></path>
    <path class="kept-age" d={outline}></path>
    {fibres.map((d) => (
      <path class="kept-fibre" d={d} />
    ))}
    <path class="kept-edge" d={outline} filter="url(#bk-tremble)"></path>
  </svg>
  <svg class="kept-corner" viewBox={`0 0 ${c} ${c}`} width={c} height={c}>
    <path class="kept-under" d={under} filter="url(#bk-pool)"></path>
    <path
      class="kept-flap-wash"
      d={flap}
      transform="translate(1.5 1)"
      filter="url(#bk-wash)"
    ></path>
    <path class="kept-flap" d={flap}></path>
    <path class="kept-flap-edge" d={flap} filter="url(#bk-tremble)"></path>
  </svg>
</span>

<style>
  .kept-paper {
    --kept-tea: color-mix(in srgb, var(--red-warmer) 60%, var(--paper));
    --kept-pool: color-mix(in srgb, var(--fg-main) 16%, var(--paper));
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .kept-paper svg {
    overflow: visible;
  }

  .kept-pool,
  .kept-sheet {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .kept-pool path {
    fill: var(--kept-pool);
    opacity: 0.5;
  }

  .kept-sheet {
    mask:
      linear-gradient(#000, #000) top / 100% calc(100% - 46px) no-repeat,
      linear-gradient(#000, #000) left bottom / calc(100% - 46px) 46px no-repeat,
      linear-gradient(to bottom right, #000 50%, transparent 50%) right bottom / 46px 46px no-repeat;
  }

  .kept-sheet path {
    vector-effect: non-scaling-stroke;
  }

  .kept-wash {
    fill: var(--kept-tea);
    opacity: 0.4;
  }

  .kept-body {
    fill: var(--paper);
  }

  .kept-age {
    fill: var(--tape);
    opacity: 0.22;
  }

  .kept-fibre {
    fill: none;
    stroke: color-mix(in srgb, var(--fg-main) 55%, var(--paper));
    stroke-width: 0.5;
    stroke-linecap: round;
    opacity: 0.2;
  }

  .kept-edge,
  .kept-flap-edge {
    fill: none;
    stroke: color-mix(in srgb, var(--fg-main) 90%, var(--paper));
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.8;
  }

  .kept-corner {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  .kept-under {
    fill: var(--kept-pool);
    opacity: 0.75;
  }

  .kept-flap {
    fill: color-mix(in srgb, var(--paper) 70%, var(--tape));
  }

  .kept-flap-wash {
    fill: var(--kept-tea);
    opacity: 0.35;
  }
</style>
