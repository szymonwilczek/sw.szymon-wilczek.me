---
// Pampas grass under the moon at the end of an essay.
// Hold them open in front of the hare and it earns a seal.

import { artUrl } from "../utils/art";
import { makeField } from "../utils/susuki";

// The drawings live in /art/; only the one this screen shows is fetched up front.
const fields = [
  { name: "wide", field: makeField(false), media: "(min-width: 48em)" },
  { name: "tall", field: makeField(true), media: "(max-width: 47.99em)" },
] as const;
---

<figure class="susuki">
  {fields.map(({ name, field, media }) => (
    <>
      <link
        rel="preload"
        href={artUrl(`grass-${name}`)}
        as="fetch"
        crossorigin="anonymous"
        media={media}
      />
      <svg
        class={`grass grass-${name}`}
        viewBox={`0 0 ${field.W} ${field.H}`}
        role="img"
        aria-label="Pampas grass under the moon. Move through it and it parts, then eases back."
        data-layout={name}
        data-art={artUrl(`grass-${name}`)}
        data-media={media}
      />
    </>
  ))}
  <figcaption class="hand">
    <span class="said-before">the grass hides half the moon.</span>
    <span class="said-after">someone up there has been pounding mochi all along.</span>
  </figcaption>
</figure>

<style>
  .susuki {
    margin: 4rem 0 0;
  }

  .grass {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .grass-tall {
    display: none;
  }

  .grass :global(.moon) {
    fill: var(--paper);
    stroke: var(--border);
  }

  .grass :global(.moon-rabbit) {
    fill: var(--border);
    stroke: var(--border);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.22;
    transition: opacity 2.4s ease;
  }

  .susuki.found :global(.moon-rabbit) {
    opacity: 0.42;
  }

  .grass :global(.blades) {
    fill: none;
    stroke: var(--fg-dim);
    stroke-linecap: round;
  }

  .grass :global(.plumes) {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.62;
  }

  .grass :global(.ground) {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .grass :global(.grass-seal) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s ease,
      visibility 1.2s;
  }

  .susuki.found :global(.grass-seal) {
    opacity: 1;
    visibility: visible;
  }

  .grass :global(.grass-seal path) {
    fill: var(--red);
    opacity: 0.92;
  }

  .grass :global(.grass-seal text) {
    font-family: var(--font-seal);
    font-size: 22px;
    fill: var(--bg-main);
  }

  figcaption {
    margin: 0.5rem 0.25rem 0 auto;
    width: fit-content;
    font-weight: 300;
    font-size: 1rem;
    color: var(--fg-dim);
    opacity: 0.7;
    transform: rotate(-1deg);
  }

  .said-after,
  .susuki.found .said-before {
    display: none;
  }

  .susuki.found .said-after {
    display: inline;
  }

  @media (max-width: 47.99em) {
    .susuki {
      margin-top: 3rem;
    }

    .grass-wide {
      display: none;
    }

    .grass-tall {
      display: block;
    }
  }
</style>

<script>
  import { earn, load } from "../utils/garden";
  import { bladePath, makeField } from "../utils/susuki";
  import { fillArt } from "../scripts/art";

  const figure = document.querySelector<HTMLElement>(".susuki");
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

  if (figure && load().seals["兎"]) figure.classList.add("found");

  function setup(svg: SVGSVGElement) {
    const tall = svg.dataset.layout === "tall";
    const field = makeField(tall);
    const blades = field.blades.map((b) => ({ ...b, th: 0, om: 0 }));
    const paths = [...svg.querySelectorAll<SVGPathElement>(".blades path")];
    const plumes = [...svg.querySelectorAll<SVGPathElement>(".plumes path")];
    const R = tall ? 52 : 62;
    let held = 0;

    function watch() {
      let open = 0;
      let count = 0;
      for (const b of blades) {
        if (Math.abs(b.x - field.moon.x) < field.moon.r) {
          open += Math.abs(b.th);
          count++;
        }
      }

      if (count) held += (open / count - held) * 0.05;
      if (held > 0.12 && !figure!.classList.contains("found")) {
        figure!.classList.add("found");
        earn("兎");
      }
    }

    function draw() {
      let p = 0;
      blades.forEach((b, i) => {
        const shape = bladePath(b, b.th);
        paths[i].setAttribute("d", shape.d);
        if (b.plume) plumes[p++].setAttribute("d", shape.plume);
      });
    }

    let frame = 0;
    function loop() {
      frame = 0;
      let busy = 0;
      for (const b of blades) {
        b.om += -0.01 * b.th - 0.17 * b.om;
        b.th = clamp(b.th + b.om, -0.9, 0.9);
        busy = Math.max(busy, Math.abs(b.om) * 60, Math.abs(b.th));
      }
      watch();
      draw();
      if (busy > 0.004) frame = requestAnimationFrame(loop);
    }

    const toField = (e: PointerEvent): [number, number] => {
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
      return [p.x, p.y];
    };

    let last: [number, number] | null = null;
    svg.addEventListener("pointermove", (e) => {
      const q = toField(e);
      if (last) {
        const vx = q[0] - last[0];
        for (const b of blades) {
          const ang = b.lean + b.th;
          const bx = b.x + Math.sin(ang) * b.L * 0.6;
          const by = b.y - Math.cos(ang) * b.L * 0.6;
          if (q[1] < b.y - b.L * 1.05) continue;
          const d = Math.hypot(bx - q[0], (by - q[1]) * 0.5);
          if (d > R) continue;
          const fall = 1 - d / R;
          if (still.matches) b.th = Math.sign(b.x - q[0]) * 0.6 * fall;
          else b.om += (clamp(vx, -40, 40) * 0.0011 + Math.sign(b.x - q[0]) * 0.009) * fall;
        }
      }
      last = q;
      if (still.matches) {
        watch();
        draw();
      } else if (!frame) frame = requestAnimationFrame(loop);
    });

    const leave = () => {
      last = null;
      if (!still.matches) return;
      for (const b of blades) b.th = 0;
      draw();
    };
    svg.addEventListener("pointerleave", leave);
    svg.addEventListener("pointercancel", leave);
  }

  figure?.querySelectorAll<SVGSVGElement>(".grass").forEach((svg) => {
    const mq = matchMedia(svg.dataset.media!);
    let filled = false;
    const fill = () => {
      if (filled || !mq.matches) return;
      filled = true;
      fillArt(svg).then(() => setup(svg));
    };
    fill();
    mq.addEventListener("change", fill);
  });
</script>
