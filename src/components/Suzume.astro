---
// Tree sparrow that rewards the pause.
// The third time it stays with you it leaves a seal.
---

<div class="suzume" aria-hidden="true">
  <div class="sz-x">
    <div class="sz-y">
      <svg class="sz-bird" width="104" height="88" viewBox="-40 -64 80 68">
        <g class="sz-face">
          <g class="sz-pitch">
            <g class="sz-far">
              <path
                class="sz-far-wing"
                d="M6 -24 C -4 -33, -18 -35, -30 -32 C -24 -27, -12 -23, 2 -22 Z"
              ></path>
            </g>
            <g class="sz-sit">
              <path
                class="sz-wash"
                d="M-12 -15 L -29 -10 C -31 -8, -30 -6, -27 -5.5 L -11 -9 Z"
              ></path>
              <path
                class="sz-body"
                d="M-16 -16 C -14 -24, -4 -28, 6 -27 C 6 -34, 12 -38, 17 -37 C 23 -36, 25 -31, 24 -27 C 25 -22, 22 -17, 18 -13 C 14 -6, 4 -3, -4 -5 C -10 -7, -14 -11, -16 -16 Z"
              ></path>
              <path
                class="sz-belly"
                d="M-14 -13 C -8 -6, 4 -3, 14 -8 C 8 -10, -4 -9, -14 -13 Z"
              ></path>
              <path
                class="sz-back"
                d="M-14 -18 C -8 -25, 0 -27, 6 -26 C 4 -22, -6 -19, -14 -18 Z"
              ></path>
              <g class="sz-fold">
                <path
                  class="sz-wing"
                  d="M-11 -19 C -4 -25, 6 -25, 11 -19 C 8 -14, 0 -11, -9 -12 C -14 -13, -14 -17, -11 -19 Z"
                ></path>
                <path
                  class="sz-streaks"
                  d="M-8 -20 l 5 -1 M -5 -17 l 6 -1.5 M -1 -14 l 6 -1.5 M -10 -15 l 4 0"
                ></path>
                <path class="sz-bar" d="M-6 -21.5 C -1 -23, 4 -22.5, 8 -20.5"></path>
              </g>
              <g>
                <path
                  class="sz-cap"
                  d="M7 -30 C 8 -35, 13 -38, 18 -37 C 22 -36.5, 24 -34, 24 -31 C 21 -32.5, 17 -33, 13 -32 C 11 -31.5, 9 -30.5, 7 -30 Z"
                ></path>
                <ellipse class="sz-ink" cx="13" cy="-26.5" rx="2.4" ry="1.8"></ellipse>
                <path class="sz-lore" d="M18.5 -31 C 20 -31.5, 22 -31, 24 -29.5"></path>
                <circle class="sz-ink" cx="19.2" cy="-31" r="1.3"></circle>
                <path class="sz-ink" d="M23.6 -30.6 L 29 -28.6 L 23.8 -27 Z"></path>
                <path
                  class="sz-ink"
                  d="M22 -25.5 C 23.5 -23, 22.5 -20, 19.5 -19.5 C 18.5 -21.5, 19.5 -24, 22 -25.5 Z"
                ></path>
              </g>
              <path
                class="sz-legs"
                d="M1 -4.5 L 0 0 M 7 -4.5 L 8 0 M -3 0 l 5 0 M 5 0 l 5.5 0"
              ></path>
            </g>
            <g class="sz-near">
              <path
                class="sz-wing"
                d="M6 -22 C -4 -31, -18 -34, -32 -30 C -28 -27, -26 -25, -24 -24 C -18 -21, -8 -19, 2 -19 Z"
              ></path>
              <path
                class="sz-streaks"
                d="M-30 -29.5 C -27 -27, -24 -25.5, -20 -24.5 M -24 -31 C -20 -28, -16 -26, -12 -24.5 M -16 -32 C -12 -28.5, -8 -26, -3 -24"
              ></path>
            </g>
          </g>
        </g>
      </svg>
    </div>
  </div>
</div>

<style>
  .suzume {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 5;
    pointer-events: none;
    visibility: hidden;
  }

  .suzume.here {
    visibility: visible;
  }

  .sz-bird {
    position: absolute;
    left: -52px;
    top: -83px;
    width: 104px;
    max-width: none;
    height: 88px;
    overflow: visible;
  }

  .sz-face,
  .sz-pitch,
  .sz-sit,
  .sz-near,
  .sz-far {
    transform-box: view-box;
  }

  .sz-face {
    transform-origin: 0 0;
    transition: transform 0.45s ease-in-out;
  }

  .sz-pitch {
    transform-origin: 0 -16px;
    transition: transform 0.4s ease-out;
  }

  .sz-sit {
    transform-origin: 0 0;
  }

  .suzume.settling .sz-sit {
    animation: sz-settle 0.45s ease-out;
  }

  @keyframes sz-settle {
    35% {
      transform: scale(1.04, 0.93);
    }
  }

  .sz-near,
  .sz-far {
    transform-origin: 5px -21px;
    opacity: 0;
    transition:
      transform var(--flap, 130ms) ease-in-out,
      opacity 0.22s ease-in-out;
  }

  .sz-fold,
  .sz-legs {
    transition: opacity 0.22s ease-in-out;
  }

  .suzume.flying .sz-near,
  .suzume.flying .sz-far {
    opacity: 1;
  }

  .suzume.flying .sz-fold,
  .suzume.flying:not(.landing) .sz-legs {
    opacity: 0;
  }

  .sz-body {
    fill: var(--bg-main);
    stroke: var(--fg-main);
    stroke-width: 0.75;
    stroke-linejoin: round;
  }

  .sz-belly {
    fill: var(--fg-dim);
    opacity: 0.18;
  }

  .sz-back {
    fill: var(--red);
    opacity: 0.3;
  }

  .sz-wing {
    fill: var(--red);
    fill-opacity: 0.45;
    stroke: var(--fg-main);
    stroke-width: 0.7;
    stroke-linejoin: round;
  }

  .sz-far-wing {
    fill: var(--fg-dim);
    opacity: 0.3;
  }

  .sz-wash {
    fill: var(--fg-dim);
    fill-opacity: 0.55;
    stroke: var(--fg-main);
    stroke-width: 0.75;
    stroke-linejoin: round;
  }

  .sz-streaks {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 0.8;
    stroke-linecap: round;
    opacity: 0.65;
  }

  .sz-bar {
    fill: none;
    stroke: var(--bg-main);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .sz-cap {
    fill: var(--red);
    opacity: 0.6;
  }

  .sz-ink {
    fill: var(--fg-main);
  }

  .sz-lore,
  .sz-legs {
    fill: none;
    stroke: var(--fg-main);
    stroke-width: 1.1;
    stroke-linecap: round;
  }

  .sz-lore {
    stroke-width: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .suzume.settling .sz-sit {
      animation: none;
    }
  }

  @media print {
    .suzume {
      display: none;
    }
  }
</style>

<script>
  import { earn, update } from "../utils/garden";

  const root = document.querySelector<HTMLElement>(".suzume");

  if (root) {
    const IDLE = 25_000;
    const FLAP = 130;
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const moverX = root.querySelector<HTMLElement>(".sz-x")!;
    const moverY = root.querySelector<HTMLElement>(".sz-y")!;
    const face = root.querySelector<SVGGElement>(".sz-face")!;
    const pitch = root.querySelector<SVGGElement>(".sz-pitch")!;
    const near = root.querySelector<SVGGElement>(".sz-near")!;
    const far = root.querySelector<SVGGElement>(".sz-far")!;

    type Phase = "away" | "gliding" | "landing" | "sitting" | "leaving";
    let phase: Phase = "away";
    let idle = 0;
    let step = 0;
    let flapping = 0;
    let wingDown = false;

    const moveTo = (x: number, y: number, timingX: string, timingY: string) => {
      moverX.style.transition = `transform ${timingX}`;
      moverY.style.transition = `transform ${timingY}, opacity 0.5s ease`;
      moverX.style.transform = `translateX(${x}px)`;
      moverY.style.transform = `translateY(${y}px)`;
    };

    const wings = (degrees: number) => {
      near.style.transform = `rotate(${degrees}deg)`;
      far.style.transform = `rotate(${degrees * 0.8 - 6}deg)`;
    };

    const flap = (active: boolean) => {
      clearInterval(flapping);
      root.style.setProperty("--flap", `${FLAP}ms`);
      if (!active) return;
      flapping = window.setInterval(() => {
        wingDown = !wingDown;
        wings(wingDown ? 18 : -62);
      }, FLAP);
    };

    const pose = (next: Phase) => {
      phase = next;
      root.classList.toggle("flying", next !== "sitting");
      root.classList.toggle("landing", next === "landing");
      const lean = { away: 0, gliding: 6, landing: -12, sitting: 0, leaving: -18 }[next];
      pitch.style.transform = `rotate(${lean}deg)`;
      face.style.transform = "scaleX(-1)";
    };

    function perch(): [number, number] | null {
      const viewHeight = innerHeight;
      for (const divider of document.querySelectorAll<HTMLElement>(".divider")) {
        const box = divider.getBoundingClientRect();
        if (box.top > viewHeight * 0.15 && box.bottom < viewHeight * 0.9 && box.width > 200) {
          return [box.left + box.width * (0.56 + Math.random() * 0.14), box.top + 14];
        }
      }
      return null;
    }

    function arrive() {
      const spot = perch();
      // no divider in view: keep waiting, as long as the reader keeps still
      if (!spot) {
        idle = window.setTimeout(arrive, 3000);
        return;
      }
      const [perchX, perchY] = spot;
      root.classList.add("here");
      if (still.matches) {
        moveTo(perchX, perchY, "0s", "0s");
        moverY.style.opacity = "1";
        pose("sitting");
        sat();
        return;
      }

      moverY.style.opacity = "0";
      moveTo(innerWidth + 80, Math.max(-60, perchY - 260), "0s", "0s");
      pose("gliding");
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          moverY.style.opacity = "1";
          moveTo(
            perchX,
            perchY,
            "1.5s cubic-bezier(.15,.55,.35,1)",
            "1.5s cubic-bezier(.45,0,.55,1)",
          );
          flap(true);
          step = window.setTimeout(() => {
            flap(false);
            wings(-8);
            step = window.setTimeout(() => {
              root.style.setProperty("--flap", "0.3s");
              wings(40);
              pose("landing");
              step = window.setTimeout(() => {
                root.style.setProperty("--flap", "0.25s");
                wings(-20);
                pose("sitting");
                root.classList.add("settling");
                step = window.setTimeout(() => root.classList.remove("settling"), 450);
                sat();
              }, 300);
            }, 550);
          }, 500);
        }),
      );
    }

    function sat() {
      const state = update((saved) => {
        saved.sparrow = (saved.sparrow || 0) + 1;
      });
      if (state.sparrow >= 3) earn("雀");
    }

    function leave() {
      clearTimeout(step);
      root.classList.remove("settling");
      if (phase === "away" || phase === "leaving") return;
      if (still.matches) {
        root.classList.remove("here");
        phase = "away";
        return;
      }
      const x = parseFloat(moverX.style.transform.slice(11)) || 0;
      pose("leaving");
      flap(true);
      moveTo(x - 520, -240, "1.8s cubic-bezier(.55,0,.8,.6)", "1.8s cubic-bezier(.2,.5,.4,1)");
      moverY.style.transition += ", opacity 0.9s ease 0.9s";
      moverY.style.opacity = "0";
      step = window.setTimeout(() => {
        flap(false);
        root.classList.remove("here");
        phase = "away";
      }, 1900);
    }

    // any sign of the reader sends it off and starts the wait over
    const stir = () => {
      leave();
      clearTimeout(idle);
      idle = window.setTimeout(arrive, IDLE);
    };
    for (const type of ["pointermove", "pointerdown", "keydown", "wheel", "scroll", "touchstart"])
      addEventListener(type, stir, { passive: true });
    stir();
  }
</script>
