---
import { BODY, VIEWBOX } from "./signature-ink";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={["signature", className]} viewBox={VIEWBOX} role="img" aria-label="Wilczek">
  <filter id="signature-wash" x="-15%" y="-15%" width="130%" height="130%">
    <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="3" seed="5" />
    <feDisplacementMap in="SourceGraphic" scale="6" />
    <feGaussianBlur stdDeviation="0.9" />
  </filter>
  <Fragment set:html={BODY} />
</svg>

<noscript>
  <style is:inline>
    .signature .signature-bit { opacity: 1; animation: none; }
    .signature .signature-wash { opacity: 0.14; animation: none; }
  </style>
</noscript>

<script>
  const signature = document.querySelector<SVGSVGElement>(".signature");
  if (signature) {
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        seen.disconnect();
        signature.classList.add("is-signing");
      },
      { threshold: 0.6 },
    );
    seen.observe(signature);
  }
</script>

<style>
  .signature {
    display: block;
    overflow: visible;
  }

  .signature :global(:is(.signature-bit, .signature-wash)) {
    opacity: 0;
  }

  .signature.is-signing :global(.signature-bit) {
    animation: signature-on 0.01s linear forwards;
  }

  .signature.is-signing :global(.signature-wash) {
    animation: signature-wash 0.9s ease-out forwards;
  }

  @keyframes signature-on {
    to {
      opacity: 1;
    }
  }

  @keyframes signature-wash {
    to {
      opacity: 0.14;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature :global(.signature-bit) {
      opacity: 1;
    }

    .signature :global(.signature-wash) {
      opacity: 0.14;
    }

    .signature.is-signing :global(:is(.signature-bit, .signature-wash)) {
      animation: none;
    }
  }
</style>
