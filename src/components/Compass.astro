---
// Riddle door: a little compass by "Now" whose needle is lost.
// It turns in clicked steps, by drag or arrows; set to new seal it holds, then opens the map.
---

<div
  class="compass"
  role="slider"
  tabindex="0"
  aria-label="compass, needle a little lost"
  aria-valuemin="0"
  aria-valuemax="330"
  aria-valuenow="0"
  aria-valuetext="north"
>
  <svg viewBox="-80 -86 160 160" aria-hidden="true">
    <path
      class="compass-rim"
      d="M0 -62 C 34 -63, 63 -34, 62 0 C 63 34, 34 62, 0 62 C -34 63, -62 34, -62 0 C -63 -34, -34 -61, 0 -62 Z"
    ></path>
    <text class="compass-north" x="0" y="-68" text-anchor="middle">
      北
    </text>
    <g class="compass-needle">
      <path
        class="compass-point"
        d="M0 -46 C 3 -30, 5 -16, 6 -6 L 0 0 L -6 -6 C -5 -16, -3 -30, 0 -46 Z"
      ></path>
      <path
        class="compass-tail"
        d="M0 46 C 3 30, 5 16, 6 6 L 0 0 L -6 6 C -5 16, -3 30, 0 46 Z"
      ></path>
    </g>
  </svg>
</div>

<style>
  .compass {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    cursor: grab;
    touch-action: none;
    outline: none;
  }

  .compass:active {
    cursor: grabbing;
  }

  .compass svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .compass-rim {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.4;
  }

  .compass:focus-visible .compass-rim {
    stroke: var(--cursor);
    stroke-width: 2;
  }

  .compass-north {
    fill: var(--fg-main);
    font-family: var(--font-seal);
    font-size: 26px;
  }

  .compass-needle {
    rotate: var(--angle, 0deg);
    transition: rotate 0.18s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .compass-point {
    fill: var(--red);
  }

  .compass-tail {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1;
  }

  .compass.is-north .compass-rim {
    stroke: var(--red);
  }

  @media (prefers-reduced-motion: reduce) {
    .compass-needle {
      transition: none;
    }
  }
</style>

<script>
  import { findDoor } from "../utils/garden";

  const STEP = 30;

  document.querySelectorAll<HTMLElement>(".compass").forEach((compass) => {
    const needle = compass.querySelector<SVGGElement>(".compass-needle")!;
    let angle = STEP * (1 + Math.floor(Math.random() * (360 / STEP - 1)));
    let timer = 0;

    function set(next: number) {
      next = ((next % 360) + 360) % 360;
      if (next === angle) return;
      angle = next;
      needle.style.setProperty("--angle", `${angle}deg`);
      compass.setAttribute("aria-valuenow", String(angle));
      compass.setAttribute("aria-valuetext", angle === 0 ? "north" : `${angle} degrees`);
      compass.classList.toggle("is-north", angle === 0);
      clearTimeout(timer);
      if (angle !== 0) return;
      timer = window.setTimeout(() => {
        findDoor("compass");
        location.href = "/map/?found";
      }, 900);
    }

    needle.style.setProperty("--angle", `${angle}deg`);
    compass.setAttribute("aria-valuenow", String(angle));
    compass.setAttribute("aria-valuetext", `${angle} degrees`);

    compass.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === "ArrowUp") set(angle + STEP);
      else if (e.key === "ArrowLeft" || e.key === "ArrowDown") set(angle - STEP);
      else return;
      e.preventDefault();
    });

    // dragging turns the needle by how far the pointer went round, in steps
    let last = 0;
    let turned = 0;
    let start = 0;

    function bearing(e: PointerEvent) {
      const box = compass.getBoundingClientRect();
      const x = e.clientX - (box.left + box.width / 2);
      const y = e.clientY - (box.top + box.height / 2);
      return (Math.atan2(x, -y) * 180) / Math.PI;
    }

    compass.addEventListener("pointerdown", (e) => {
      compass.setPointerCapture(e.pointerId);
      last = bearing(e);
      turned = 0;
      start = angle;
    });
    compass.addEventListener("pointermove", (e) => {
      if (!compass.hasPointerCapture(e.pointerId)) return;
      const now = bearing(e);
      turned += ((now - last + 540) % 360) - 180;
      last = now;
      set(start + Math.round(turned / STEP) * STEP);
    });
  });
</script>
