---
import type { RepoStats } from "../utils/github";
import { blot, inkOf, since, type Project } from "../utils/projects";

interface Props {
  project: Project;
  stats?: RepoStats;
}

const { project, stats } = Astro.props;
---

<p class="meta">
  <span>
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path d={blot(project.title)} fill={inkOf(project.language)}></path>
    </svg>
    {project.language}
  </span>
  {
    stats && (
      <>
        <span title="stars">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 1.6 L 9.9 5.8 L 14.4 6.2 L 11 9.2 L 12 13.8 L 8 11.4 L 4.1 13.9 L 5 9.3 L 1.6 6.3 L 6.2 5.8 Z" />
          </svg>
          {stats.stars}
          <span class="visually-hidden">stars</span>
        </span>
        <span title="forks">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4.5 4.6 C 4.4 7.4, 5 8.6, 8 9 C 11 8.6, 11.6 7.4, 11.5 4.6 M 8 9 L 8 11.3" />
            <circle cx="4.5" cy="3.2" r="1.6" />
            <circle cx="11.5" cy="3.2" r="1.6" />
            <circle cx="8" cy="12.9" r="1.6" />
          </svg>
          {stats.forks}
          <span class="visually-hidden">forks</span>
        </span>
      </>
    )
  }
  <span>{since(project.date)}</span>
</p>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1.125rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  svg {
    flex: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  span[title] path,
  span[title] circle {
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
