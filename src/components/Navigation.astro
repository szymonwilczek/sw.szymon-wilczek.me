---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const normalizedCurrent = normalize(currentPath);

const links = [
  { href: '/about', label: '[About]' },
  { href: '/contact', label: '[Contact]' },
  { href: '/projects', label: '[Projects]' },
  { href: '/photos', label: '[Photos]' },
  { href: '/files', label: '[Files]' },
  { href: '/credits', label: '[Credits]' },
  { href: '/rss.xml', label: '[Feed RSS]' },
];
---

<nav class="sidebar-nav" aria-label="Main Navigation">
  <ul class="nav-list">
    {links.map((link) => {
      const isExternal = link.href.endsWith('.xml');
      const isActive = !isExternal && (
        normalizedCurrent === normalize(link.href) || 
        (link.href !== '/' && normalizedCurrent.startsWith(normalize(link.href)))
      );

      return (
        <li class="nav-item">
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive }]}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'alternate' : undefined}
            type={isExternal ? 'application/rss+xml' : undefined}
          >
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .sidebar-nav {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 1.05rem;
    margin: 1.25rem 0;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-item {
    margin: 0;
    padding: 0;
    display: block;
  }

  .nav-link {
    color: var(--yellow-warmer);
    text-decoration: none;
    display: inline-block;
    padding: 0.15rem 0;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--cyan-cooler);
    text-decoration: underline;
  }

  .nav-link.active {
    color: var(--green-warmer);
    font-weight: 700;
  }
</style>
