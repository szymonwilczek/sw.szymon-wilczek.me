---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const normalizedCurrent = normalize(currentPath);

const links = [
  { href: '/about', label: '[About]' },
  { href: '/contact', label: '[Contact]' },
  { href: '/projects', label: '[Projects]' },
  { href: '/photos', label: '[Photos]' },
  { href: '/files', label: '[Files]' },
  { href: '/credits', label: '[Credits]' },
  { href: '/rss.xml', label: '[Feed RSS]' },
];
---

<nav class="site-nav" aria-label="Main Navigation">
  {links.map((link) => {
    const isExternal = link.href.endsWith('.xml');
    const isActive = !isExternal && (
      normalizedCurrent === normalize(link.href) || 
      (link.href !== '/' && normalizedCurrent.startsWith(normalize(link.href)))
    );

    return (
      <a
        href={link.href}
        class:list={{ active: isActive }}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'alternate' : undefined}
        type={isExternal ? 'application/rss+xml' : undefined}
      >
        {link.label}
      </a>
    );
  })}
</nav>
