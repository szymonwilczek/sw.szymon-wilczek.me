---
// Tray of still water at the end of the colophon.
---

<div class="endpaper">
  <p class="hint hand">
    <span class="fine">click for a drop · drag slowly to comb</span>
    <span class="coarse">tap for a drop · drag a finger slowly to comb</span>
  </p>
  <div class="tray">
    <canvas
      class="water"
      role="img"
      aria-label="Marbling tray. Tap to drop ink, drag to comb it."
    ></canvas>
    <canvas class="sheet" aria-hidden="true"></canvas>
  </div>
  <div class="controls">
    <button class="lay" type="button">
      lay the paper
    </button>
    <button class="still" type="button">
      still the water
    </button>
    <span class="status hand" aria-live="polite"></span>
  </div>
</div>

<style>
  .hint {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    color: var(--cursor);
  }

  .coarse {
    display: none;
  }

  @media (pointer: coarse) {
    .fine {
      display: none;
    }

    .coarse {
      display: inline;
    }
  }

  .tray {
    position: relative;
    padding: 0.875rem;
    background: var(--bg-alt);
    border-radius: 6px 9px 7px 10px;
  }

  canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }

  .water {
    touch-action: none;
    cursor: crosshair;
  }

  .sheet {
    position: absolute;
    inset: 0.875rem;
    width: calc(100% - 1.75rem);
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.6s ease;
  }

  .endpaper.printed .sheet {
    opacity: 1;
  }

  .endpaper.printed .water {
    cursor: default;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }

  button {
    min-height: 44px;
    background: none;
    border-radius: 22px 18px 21px 19px;
    cursor: pointer;
  }

  .lay {
    padding: 0 1.125rem;
    border: 1.5px solid var(--fg-main);
    color: var(--fg-main);
    font-size: 1rem;
  }

  .lay:hover {
    border-color: var(--cursor);
  }

  .still {
    padding: 0 1rem;
    border: 1px solid var(--border);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .status {
    font-size: 1.0625rem;
    color: var(--fg-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }
</style>

<script>
  import { earn } from "../utils/garden";

  type Pt = [number, number];
  interface Drop {
    pts: Pt[];
    ink: boolean;
  }

  const root = document.querySelector<HTMLElement>(".endpaper");

  if (root) {
    const water = root.querySelector<HTMLCanvasElement>(".water")!;
    const sheet = root.querySelector<HTMLCanvasElement>(".sheet")!;
    const status = root.querySelector<HTMLElement>(".status")!;
    const N = 90;
    const narrow = matchMedia("(max-width: 47.99em)");

    let W = 0;
    let H = 0;
    let drops: Drop[] = [];
    let ink = true;
    let printed = false;
    let fibres: Pt[][] = [];

    function grain(seed: number) {
      return () => {
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function ring(cx: number, cy: number, r: number): Pt[] {
      const pts: Pt[] = [];
      for (let i = 0; i < N; i++) {
        const a = (i / N) * Math.PI * 2;
        pts.push([cx + Math.cos(a) * r, cy + Math.sin(a) * r]);
      }
      return pts;
    }

    function drop(cx: number, cy: number, r: number, wet: boolean) {
      const r2 = r * r;
      for (const d of drops)
        for (const p of d.pts) {
          const dx = p[0] - cx;
          const dy = p[1] - cy;
          const k = Math.sqrt(1 + r2 / (dx * dx + dy * dy || 1e-6));
          p[0] = cx + dx * k;
          p[1] = cy + dy * k;
        }
      drops.push({ pts: ring(cx, cy, r), ink: wet });
      if (drops.length > 60) drops.shift();
    }

    function comb(ax: number, ay: number, bx: number, by: number) {
      const dx = bx - ax;
      const dy = by - ay;
      const len = Math.hypot(dx, dy);
      if (len < 0.5) return;
      const mx = dx / len;
      const my = dy / len;
      const z = len * 0.9;
      const lam = 26;
      for (const d of drops) {
        for (const p of d.pts) {
          const px = p[0] - bx;
          const py = p[1] - by;
          const dist = Math.abs(px * my - py * mx) + Math.max(0, px * mx + py * my) * 0.6;
          const s = z * (lam / (dist + lam)) ** 2;
          p[0] += mx * s;
          p[1] += my * s;
        }

        const out: Pt[] = [];
        for (let i = 0; i < d.pts.length; i++) {
          const a = d.pts[i];
          const b = d.pts[(i + 1) % d.pts.length];
          out.push(a);
          if (Math.hypot(b[0] - a[0], b[1] - a[1]) > 9 && d.pts.length + out.length < 900)
            out.push([(a[0] + b[0]) / 2, (a[1] + b[1]) / 2]);
        }
        d.pts = out;
      }
    }

    function begin() {
      W = narrow.matches ? 360 : 1000;
      H = narrow.matches ? 440 : 420;
      drops = [];
      ink = true;
      const cx = W * 0.42;
      const cy = H * 0.5;
      for (let i = 0; i < 9; i++) drop(cx, cy, 34 - i, i % 2 === 0);
      drop(W * 0.74, H * 0.36, 26, true);
      drop(W * 0.74, H * 0.36, 18, false);
      drop(W * 0.74, H * 0.36, 14, true);
      comb(W * 0.2, H * 0.62, W * 0.34, H * 0.56);
      const rnd = grain(41);
      fibres = [];
      for (let i = 0; i < 70; i++) {
        const x = rnd() * W;
        const y = rnd() * H;
        const a = rnd() * Math.PI;
        fibres.push([
          [x, y],
          [x + Math.cos(a) * 6, y + (rnd() * 2 - 1) * 3],
          [x + Math.cos(a) * 12, y + Math.sin(a) * 6],
        ]);
      }
      setPrinted(false);
      size();
    }

    function colours() {
      const css = getComputedStyle(document.documentElement);
      const v = (name: string) => css.getPropertyValue(name).trim();
      return { paper: v("--paper"), ink: v("--fg-main"), border: v("--border"), red: v("--red") };
    }

    function fit(canvas: HTMLCanvasElement, scale: number) {
      canvas.width = Math.round(W * scale);
      canvas.height = Math.round(H * scale);
      const ctx = canvas.getContext("2d")!;
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
      return ctx;
    }

    function paint(ctx: CanvasRenderingContext2D) {
      const c = colours();
      ctx.fillStyle = c.paper;
      ctx.fillRect(0, 0, W, H);
      for (const d of drops) {
        ctx.beginPath();
        const n = d.pts.length;
        const mid = (i: number): Pt => {
          const a = d.pts[i % n];
          const b = d.pts[(i + 1) % n];
          return [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
        };
        ctx.moveTo(...mid(0));
        for (let i = 1; i <= n; i++) ctx.quadraticCurveTo(...d.pts[i % n], ...mid(i));
        ctx.closePath();
        ctx.globalAlpha = d.ink ? 0.78 : 1;
        ctx.fillStyle = d.ink ? c.ink : c.paper;
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    async function print(ctx: CanvasRenderingContext2D) {
      const c = colours();
      paint(ctx);
      ctx.globalAlpha = 0.35;
      ctx.fillStyle = c.paper;
      ctx.fillRect(0, 0, W, H);
      ctx.globalAlpha = 0.5;
      ctx.strokeStyle = c.border;
      ctx.lineWidth = 0.6;
      ctx.beginPath();
      for (const [a, b, e] of fibres) {
        ctx.moveTo(a[0], a[1]);
        ctx.quadraticCurveTo(b[0], b[1], e[0], e[1]);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;
      try {
        await document.fonts.load('19px "Yuji Syuku"', "流");
      } catch {
        // the serif fallback still reads
      }
      ctx.save();
      ctx.translate(W - 34, H - 34);
      ctx.rotate((-5 * Math.PI) / 180);
      ctx.beginPath();
      ctx.moveTo(-14, -14);
      ctx.quadraticCurveTo(0, -16, 14, -14);
      ctx.quadraticCurveTo(16, 0, 14, 14);
      ctx.quadraticCurveTo(0, 16, -14, 14);
      ctx.quadraticCurveTo(-16, 0, -14, -14);
      ctx.globalAlpha = 0.92;
      ctx.fillStyle = c.red;
      ctx.fill();
      ctx.globalAlpha = 1;
      ctx.fillStyle = c.paper;
      ctx.font = '19px "Yuji Syuku", serif';
      ctx.textAlign = "center";
      ctx.fillText("流", 0, 7);
      ctx.restore();
    }

    let ctx: CanvasRenderingContext2D;
    function size() {
      ctx = fit(water, Math.min(2, devicePixelRatio || 1) * (water.clientWidth / W || 1));
      draw();
    }

    function draw() {
      paint(ctx);
      if (!printed) status.textContent = `${drops.length} rings on the water`;
    }

    function setPrinted(on: boolean) {
      printed = on;
      root!.classList.toggle("printed", on);
    }

    const stamp = () => {
      const d = new Date();
      const pad = (n: number) => String(n).padStart(2, "0");
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    };

    async function lay() {
      if (printed || !drops.length) return;
      setPrinted(true);
      await print(fit(sheet, water.width / W));

      const file = document.createElement("canvas");
      await print(fit(file, 2400 / W));
      const name = `endpaper-${stamp()}.png`;
      file.toBlob((blob) => {
        if (!blob) return;
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = name;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      }, "image/png");
      status.textContent = `printed. saved as ${name}`;
      earn("流");
    }

    function still() {
      drops = [];
      ink = true;
      setPrinted(false);
      draw();
    }

    const local = (e: PointerEvent): Pt => {
      const r = water.getBoundingClientRect();
      return [((e.clientX - r.left) / r.width) * W, ((e.clientY - r.top) / r.height) * H];
    };

    let press: Pt | null = null;
    let last: Pt = [0, 0];
    let moved = false;

    water.addEventListener("pointerdown", (e) => {
      if (printed) return;
      press = last = local(e);
      moved = false;
      water.setPointerCapture(e.pointerId);
    });

    water.addEventListener("pointermove", (e) => {
      if (!press || printed) return;
      const q = local(e);
      if (!moved && Math.hypot(q[0] - press[0], q[1] - press[1]) < 4) return;
      moved = true;
      comb(last[0], last[1], q[0], q[1]);
      last = q;
      draw();
    });

    const up = () => {
      if (press && !moved && !printed) {
        drop(press[0], press[1], 16 + Math.random() * 14, ink);
        ink = !ink;
        draw();
      }
      press = null;
    };
    water.addEventListener("pointerup", up);
    water.addEventListener("pointercancel", () => (press = null));

    root.querySelector(".lay")!.addEventListener("click", lay);
    root.querySelector(".still")!.addEventListener("click", still);

    narrow.addEventListener("change", begin);
    new ResizeObserver(size).observe(water);
    document.addEventListener("au-theme-change", () => {
      draw();
      if (printed) print(fit(sheet, water.width / W));
    });

    begin();
  }
</script>
