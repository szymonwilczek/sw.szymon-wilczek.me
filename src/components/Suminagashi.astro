---
// Tray of still water at the end of the colophon.
---

<div class="endpaper">
  <p class="hint hand">
    <span class="fine">click for a drop · drag slowly to comb</span>
    <span class="coarse">tap for a drop · drag a finger slowly to comb</span>
  </p>
  <div class="tray">
    <canvas
      class="water"
      role="img"
      aria-label="Marbling tray. Tap to drop ink, drag to comb it."
    ></canvas>
    <canvas class="sheet" aria-hidden="true"></canvas>
  </div>
  <div class="controls">
    <button class="lay" type="button">
      lay the paper
    </button>
    <button class="still" type="button">
      still the water
    </button>
    <span class="status hand" aria-live="polite"></span>
  </div>
</div>

<style>
  .hint {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    color: var(--cursor);
  }

  .coarse {
    display: none;
  }

  @media (pointer: coarse) {
    .fine {
      display: none;
    }

    .coarse {
      display: inline;
    }
  }

  .tray {
    position: relative;
    padding: 0.875rem;
    background: var(--bg-alt);
    border-radius: 6px 9px 7px 10px;
  }

  canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }

  .water {
    touch-action: none;
    cursor: crosshair;
  }

  .sheet {
    position: absolute;
    inset: 0.875rem;
    width: calc(100% - 1.75rem);
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.6s ease;
  }

  .endpaper.printed .sheet {
    opacity: 1;
  }

  .endpaper.printed .water {
    cursor: default;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }

  button {
    min-height: 44px;
    background: none;
    border-radius: 22px 18px 21px 19px;
    cursor: pointer;
  }

  .lay {
    padding: 0 1.125rem;
    border: 1.5px solid var(--fg-main);
    color: var(--fg-main);
    font-size: 1rem;
  }

  .lay:hover {
    border-color: var(--cursor);
  }

  .still {
    padding: 0 1rem;
    border: 1px solid var(--border);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .status {
    font-size: 1.0625rem;
    color: var(--fg-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }
</style>

<script>
  import { earn } from "../utils/garden";

  type Pt = [number, number];
  interface Drop {
    pts: Pt[];
    ink: boolean;
  }

  const root = document.querySelector<HTMLElement>(".endpaper");

  if (root) {
    const water = root.querySelector<HTMLCanvasElement>(".water")!;
    const sheet = root.querySelector<HTMLCanvasElement>(".sheet")!;
    const status = root.querySelector<HTMLElement>(".status")!;
    const RING_POINTS = 90;
    const narrow = matchMedia("(max-width: 47.99em)");

    let width = 0;
    let height = 0;
    let drops: Drop[] = [];
    let inkNext = true;
    let printed = false;
    let fibres: Pt[][] = [];

    function grain(seed: number) {
      return () => {
        seed = (seed + 0x6d2b79f5) | 0;
        let state = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        state = (state + Math.imul(state ^ (state >>> 7), 61 | state)) ^ state;
        return ((state ^ (state >>> 14)) >>> 0) / 4294967296;
      };
    }

    function ring(cx: number, cy: number, radius: number): Pt[] {
      const points: Pt[] = [];
      for (let i = 0; i < RING_POINTS; i++) {
        const angle = (i / RING_POINTS) * Math.PI * 2;
        points.push([cx + Math.cos(angle) * radius, cy + Math.sin(angle) * radius]);
      }
      return points;
    }

    function drop(atX: number, atY: number, radius: number, wet: boolean) {
      const radiusSquared = radius * radius;
      for (const blot of drops)
        for (const point of blot.pts) {
          const offsetX = point[0] - atX;
          const offsetY = point[1] - atY;
          const push = Math.sqrt(
            1 + radiusSquared / (offsetX * offsetX + offsetY * offsetY || 1e-6),
          );
          point[0] = atX + offsetX * push;
          point[1] = atY + offsetY * push;
        }
      drops.push({ pts: ring(atX, atY, radius), ink: wet });
      if (drops.length > 60) drops.shift();
    }

    // water under the ink
    const CELL = 10;
    const TINE_REACH = 9;
    const TINE_FELT = 3; // reaches out from the tine before the water feels nothing
    const GRIP = 0.95;
    const WATER_HOLD = 0.82;
    const SPREAD = 0.12;
    const TOP_SPEED = 12; // px a frame
    const PRESSURE_PASSES = 10;
    const STILL_SPEED = 0.03;
    const FRAME_MS = 1000 / 60;
    const MOST_FRAMES = 3;
    const SHORTEST_STROKE = 0.5;
    const TREMBLE_TURN = 0.18;
    const TREMBLE_PULL = 0.2;
    const SWAY = 2.5;
    const SWAY_WAVE = 30;
    const GAP_MOST = 9;
    const GAP_LEAST = 1.5;
    const RING_LEAST = 12;
    const POINT_BUDGET = 18000;
    const CROWDED = 0.6;
    const GAP_CROWDED = 5;
    const PAPER_MARGIN = 30;
    const GAP_OFF_PAPER = 40;
    const HAND_STEP = 6;
    const SETTLE_FRAMES = 240;

    let columns = 0;
    let rows = 0;
    let flowX = new Float32Array(0);
    let flowY = new Float32Array(0);
    let pushX = new Float32Array(0);
    let pushY = new Float32Array(0);
    let pushHold = new Float32Array(0);
    let pressure = new Float32Array(0);
    let divergence = new Float32Array(0);
    let travelled = 0;
    const swayPhase = Math.random() * Math.PI * 2;
    let frame = 0;
    let lastTime = 0;

    function pour() {
      columns = Math.ceil(width / CELL);
      rows = Math.ceil(height / CELL);
      const cells = columns * rows;
      [flowX, flowY, pushX, pushY, pushHold, pressure, divergence] = Array.from(
        { length: 7 },
        () => new Float32Array(cells),
      );
    }

    const tremble = (amount: number) => (Math.random() * 2 - 1) * amount;

    function stir(fromX: number, fromY: number, toX: number, toY: number) {
      const spanX = toX - fromX;
      const spanY = toY - fromY;
      const lengthSquared = spanX * spanX + spanY * spanY;
      const length = Math.sqrt(lengthSquared);
      if (length < SHORTEST_STROKE) return;
      travelled += length;
      const turn = tremble(TREMBLE_TURN);
      const pull = 1 + tremble(TREMBLE_PULL);
      const moveX = (spanX * Math.cos(turn) - spanY * Math.sin(turn)) * pull;
      const moveY = (spanX * Math.sin(turn) + spanY * Math.cos(turn)) * pull;
      const sway = SWAY * Math.sin((travelled / SWAY_WAVE) * Math.PI * 2 + swayPhase);
      const startX = fromX - (spanY / length) * sway;
      const startY = fromY + (spanX / length) * sway;
      const felt = TINE_REACH * TINE_FELT;
      const firstColumn = Math.max(0, Math.floor((Math.min(startX, startX + spanX) - felt) / CELL));
      const lastColumn = Math.min(
        columns - 1,
        Math.floor((Math.max(startX, startX + spanX) + felt) / CELL),
      );
      const firstRow = Math.max(0, Math.floor((Math.min(startY, startY + spanY) - felt) / CELL));
      const lastRow = Math.min(
        rows - 1,
        Math.floor((Math.max(startY, startY + spanY) + felt) / CELL),
      );
      for (let row = firstRow; row <= lastRow; row++)
        for (let column = firstColumn; column <= lastColumn; column++) {
          const cellX = (column + 0.5) * CELL - startX;
          const cellY = (row + 0.5) * CELL - startY;
          const along = Math.min(1, Math.max(0, (cellX * spanX + cellY * spanY) / lengthSquared));
          const awayX = cellX - spanX * along;
          const awayY = cellY - spanY * along;
          const weight = Math.exp(-(awayX * awayX + awayY * awayY) / (TINE_REACH * TINE_REACH));
          const cell = row * columns + column;
          pushX[cell] += weight * moveX;
          pushY[cell] += weight * moveY;
          pushHold[cell] = Math.max(pushHold[cell], weight);
        }
      wake();
    }

    const at = (column: number, row: number) =>
      Math.min(rows - 1, Math.max(0, row)) * columns + Math.min(columns - 1, Math.max(0, column));

    // water takes the comb, shares, flows round, and slows
    // true while it still moves
    function flow(frames: number) {
      for (let cell = 0; cell < flowX.length; cell++) {
        const grip = Math.min(1, pushHold[cell]);
        flowX[cell] = flowX[cell] * (1 - grip) + (GRIP * pushX[cell]) / frames;
        flowY[cell] = flowY[cell] * (1 - grip) + (GRIP * pushY[cell]) / frames;
      }
      pushX.fill(0);
      pushY.fill(0);
      pushHold.fill(0);

      const sharedX = flowX.slice();
      const sharedY = flowY.slice();
      for (let row = 0; row < rows; row++)
        for (let column = 0; column < columns; column++) {
          const around = [
            at(column - 1, row),
            at(column + 1, row),
            at(column, row - 1),
            at(column, row + 1),
          ];
          const cell = row * columns + column;
          const meanX = around.reduce((sum, other) => sum + sharedX[other], 0) / around.length;
          const meanY = around.reduce((sum, other) => sum + sharedY[other], 0) / around.length;
          flowX[cell] += (meanX - flowX[cell]) * SPREAD;
          flowY[cell] += (meanY - flowY[cell]) * SPREAD;
        }

      // water cannot pile up or open a hole
      for (let row = 0; row < rows; row++)
        for (let column = 0; column < columns; column++)
          divergence[row * columns + column] =
            (flowX[at(column + 1, row)] -
              flowX[at(column - 1, row)] +
              flowY[at(column, row + 1)] -
              flowY[at(column, row - 1)]) /
            2;
      pressure.fill(0);
      for (let pass = 0; pass < PRESSURE_PASSES; pass++)
        for (let row = 0; row < rows; row++)
          for (let column = 0; column < columns; column++)
            pressure[row * columns + column] =
              (pressure[at(column - 1, row)] +
                pressure[at(column + 1, row)] +
                pressure[at(column, row - 1)] +
                pressure[at(column, row + 1)] -
                divergence[row * columns + column]) /
              4;

      const hold = WATER_HOLD ** frames;
      let fastest = 0;
      for (let row = 0; row < rows; row++)
        for (let column = 0; column < columns; column++) {
          const cell = row * columns + column;
          const wall = column === 0 || column === columns - 1 || row === 0 || row === rows - 1;
          flowX[cell] -= (pressure[at(column + 1, row)] - pressure[at(column - 1, row)]) / 2;
          flowY[cell] -= (pressure[at(column, row + 1)] - pressure[at(column, row - 1)]) / 2;
          flowX[cell] *= wall ? 0 : hold;
          flowY[cell] *= wall ? 0 : hold;
          const speed = Math.hypot(flowX[cell], flowY[cell]);
          if (speed > TOP_SPEED) {
            flowX[cell] *= TOP_SPEED / speed;
            flowY[cell] *= TOP_SPEED / speed;
          }
          fastest = Math.max(fastest, Math.abs(flowX[cell]), Math.abs(flowY[cell]));
        }

      for (const blot of drops)
        for (const point of blot.pts) {
          const [speedX, speedY] = sample(point);
          point[0] += speedX * frames;
          point[1] += speedY * frames;
        }
      refine();

      if (fastest >= STILL_SPEED) return true;
      flowX.fill(0);
      flowY.fill(0);
      return false;
    }

    function sample([x, y]: Pt): Pt {
      const gridX = Math.min(columns - 1, Math.max(0, x / CELL - 0.5));
      const gridY = Math.min(rows - 1, Math.max(0, y / CELL - 0.5));
      const left = Math.floor(gridX);
      const top = Math.floor(gridY);
      const right = Math.min(columns - 1, left + 1);
      const bottom = Math.min(rows - 1, top + 1);
      const shareX = gridX - left;
      const shareY = gridY - top;
      const mix = (field: Float32Array) =>
        (field[top * columns + left] * (1 - shareX) + field[top * columns + right] * shareX) *
          (1 - shareY) +
        (field[bottom * columns + left] * (1 - shareX) + field[bottom * columns + right] * shareX) *
          shareY;
      return [mix(flowX), mix(flowY)];
    }

    const offPaper = ([x, y]: Pt) =>
      x < -PAPER_MARGIN ||
      y < -PAPER_MARGIN ||
      x > width + PAPER_MARGIN ||
      y > height + PAPER_MARGIN;

    // stretched rings get points between, crowded ones lose some
    function refine() {
      let total = drops.reduce((sum, blot) => sum + blot.pts.length, 0);
      const crowd = Math.max(0, (total / POINT_BUDGET - CROWDED) / (1 - CROWDED));
      const least = GAP_LEAST + (GAP_CROWDED - GAP_LEAST) * Math.min(1, crowd);
      for (const blot of drops) {
        const refined: Pt[] = [];
        let dropped = 0;
        for (let i = 0; i < blot.pts.length; i++) {
          const current = blot.pts[i];
          const next = blot.pts[(i + 1) % blot.pts.length];
          const kept = refined.at(-1);
          const unseen = offPaper(current) && (!kept || offPaper(kept));
          if (
            kept &&
            blot.pts.length - dropped > RING_LEAST &&
            Math.hypot(current[0] - kept[0], current[1] - kept[1]) <
              (unseen ? GAP_OFF_PAPER : least)
          ) {
            dropped++;
            total--;
            continue;
          }
          refined.push(current);
          if (
            Math.hypot(next[0] - current[0], next[1] - current[1]) > GAP_MOST &&
            total < POINT_BUDGET &&
            !(offPaper(current) && offPaper(next))
          ) {
            refined.push([(current[0] + next[0]) / 2, (current[1] + next[1]) / 2]);
            total++;
          }
        }
        blot.pts = refined;
      }
    }

    function wake() {
      if (frame) return;
      lastTime = performance.now() - FRAME_MS;
      frame = requestAnimationFrame(tick);
    }

    function tick(now: number) {
      const frames = Math.min(MOST_FRAMES, Math.max(0, now - lastTime) / FRAME_MS) || 1;
      lastTime = now;
      const moving = flow(frames);
      draw();
      frame = moving ? requestAnimationFrame(tick) : 0;
    }

    // stroke of the comb at the pace of a hand
    function combThrough(fromX: number, fromY: number, toX: number, toY: number) {
      const steps = Math.ceil(Math.hypot(toX - fromX, toY - fromY) / HAND_STEP);
      for (let step = 0; step < steps; step++) {
        const share = (from: number, to: number, at: number) => from + ((to - from) * at) / steps;
        stir(
          share(fromX, toX, step),
          share(fromY, toY, step),
          share(fromX, toX, step + 1),
          share(fromY, toY, step + 1),
        );
        flow(1);
      }
      for (let settled = 0; settled < SETTLE_FRAMES && flow(1); settled++);
      cancelAnimationFrame(frame);
      frame = 0;
    }

    function begin() {
      width = narrow.matches ? 360 : 1000;
      height = narrow.matches ? 440 : 420;
      drops = [];
      inkNext = true;
      pour();
      const centerX = width * 0.42;
      const centerY = height * 0.5;
      for (let i = 0; i < 9; i++) drop(centerX, centerY, 34 - i, i % 2 === 0);
      drop(width * 0.74, height * 0.36, 26, true);
      drop(width * 0.74, height * 0.36, 18, false);
      drop(width * 0.74, height * 0.36, 14, true);
      combThrough(width * 0.2, height * 0.62, width * 0.34, height * 0.56);
      const rand = grain(41);
      fibres = [];
      for (let i = 0; i < 70; i++) {
        const x = rand() * width;
        const y = rand() * height;
        const angle = rand() * Math.PI;
        fibres.push([
          [x, y],
          [x + Math.cos(angle) * 6, y + (rand() * 2 - 1) * 3],
          [x + Math.cos(angle) * 12, y + Math.sin(angle) * 6],
        ]);
      }
      setPrinted(false);
      size();
    }

    function colours() {
      const styles = getComputedStyle(document.documentElement);
      const read = (name: string) => styles.getPropertyValue(name).trim();
      return {
        paper: read("--paper"),
        ink: read("--fg-main"),
        border: read("--border"),
        red: read("--red"),
      };
    }

    function fit(canvas: HTMLCanvasElement, scale: number) {
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      const context = canvas.getContext("2d")!;
      context.setTransform(scale, 0, 0, scale, 0, 0);
      return context;
    }

    function paint(context: CanvasRenderingContext2D) {
      const palette = colours();
      context.fillStyle = palette.paper;
      context.fillRect(0, 0, width, height);
      for (const blot of drops) {
        context.beginPath();
        const count = blot.pts.length;
        const midpoint = (i: number): Pt => {
          const current = blot.pts[i % count];
          const next = blot.pts[(i + 1) % count];
          return [(current[0] + next[0]) / 2, (current[1] + next[1]) / 2];
        };
        context.moveTo(...midpoint(0));
        for (let i = 1; i <= count; i++)
          context.quadraticCurveTo(...blot.pts[i % count], ...midpoint(i));
        context.closePath();
        context.globalAlpha = blot.ink ? 0.78 : 1;
        context.fillStyle = blot.ink ? palette.ink : palette.paper;
        context.fill();
      }
      context.globalAlpha = 1;
    }

    async function print(context: CanvasRenderingContext2D) {
      const palette = colours();
      paint(context);
      context.globalAlpha = 0.35;
      context.fillStyle = palette.paper;
      context.fillRect(0, 0, width, height);
      context.globalAlpha = 0.5;
      context.strokeStyle = palette.border;
      context.lineWidth = 0.6;
      context.beginPath();
      for (const [start, control, end] of fibres) {
        context.moveTo(start[0], start[1]);
        context.quadraticCurveTo(control[0], control[1], end[0], end[1]);
      }
      context.stroke();
      context.globalAlpha = 1;
      try {
        await document.fonts.load('19px "Yuji Syuku"', "流");
      } catch {
        // the serif fallback still reads
      }
      context.save();
      context.translate(width - 34, height - 34);
      context.rotate((-5 * Math.PI) / 180);
      context.beginPath();
      context.moveTo(-14, -14);
      context.quadraticCurveTo(0, -16, 14, -14);
      context.quadraticCurveTo(16, 0, 14, 14);
      context.quadraticCurveTo(0, 16, -14, 14);
      context.quadraticCurveTo(-16, 0, -14, -14);
      context.globalAlpha = 0.92;
      context.fillStyle = palette.red;
      context.fill();
      context.globalAlpha = 1;
      context.fillStyle = palette.paper;
      context.font = '19px "Yuji Syuku", serif';
      context.textAlign = "center";
      context.fillText("流", 0, 7);
      context.restore();
    }

    let waterContext: CanvasRenderingContext2D;
    function size() {
      waterContext = fit(
        water,
        Math.min(2, devicePixelRatio || 1) * (water.clientWidth / width || 1),
      );
      draw();
    }

    function draw() {
      paint(waterContext);
      if (!printed) status.textContent = `${drops.length} rings on the water`;
    }

    function setPrinted(isPrinted: boolean) {
      printed = isPrinted;
      root!.classList.toggle("printed", isPrinted);
    }

    const stamp = () => {
      const today = new Date();
      const twoDigits = (value: number) => String(value).padStart(2, "0");
      return `${today.getFullYear()}-${twoDigits(today.getMonth() + 1)}-${twoDigits(today.getDate())}`;
    };

    async function lay() {
      if (printed || !drops.length) return;
      setPrinted(true);
      await print(fit(sheet, water.width / width));

      const file = document.createElement("canvas");
      await print(fit(file, 2400 / width));
      const name = `endpaper-${stamp()}.png`;
      file.toBlob((blob) => {
        if (!blob) return;
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = name;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
      }, "image/png");
      status.textContent = `printed. saved as ${name}`;
      earn("流");
    }

    function still() {
      drops = [];
      flowX.fill(0);
      flowY.fill(0);
      inkNext = true;
      setPrinted(false);
      draw();
    }

    const local = (event: PointerEvent): Pt => {
      const box = water.getBoundingClientRect();
      return [
        ((event.clientX - box.left) / box.width) * width,
        ((event.clientY - box.top) / box.height) * height,
      ];
    };

    let press: Pt | null = null;
    let last: Pt = [0, 0];
    let moved = false;

    water.addEventListener("pointerdown", (event) => {
      if (printed) return;
      press = last = local(event);
      moved = false;
      water.setPointerCapture(event.pointerId);
    });

    water.addEventListener("pointermove", (event) => {
      if (!press || printed) return;
      const point = local(event);
      if (!moved && Math.hypot(point[0] - press[0], point[1] - press[1]) < 4) return;
      moved = true;
      stir(last[0], last[1], point[0], point[1]);
      last = point;
    });

    const release = () => {
      if (press && !moved && !printed) {
        drop(press[0], press[1], 16 + Math.random() * 14, inkNext);
        inkNext = !inkNext;
        draw();
      }
      press = null;
    };
    water.addEventListener("pointerup", release);
    water.addEventListener("pointercancel", () => (press = null));

    root.querySelector(".lay")!.addEventListener("click", lay);
    root.querySelector(".still")!.addEventListener("click", still);

    narrow.addEventListener("change", begin);
    new ResizeObserver(size).observe(water);
    document.addEventListener("au-theme-change", () => {
      draw();
      if (printed) print(fit(sheet, water.width / width));
    });

    begin();
  }
</script>
