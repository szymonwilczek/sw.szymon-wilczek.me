---
// At the end of long pages, a pebble.
---

<div class="pebble-row" hidden>
  <button type="button" class="pebble" aria-label="Back to the top of the page">
    <svg class="pebble-arrow" width="16" height="30" viewBox="0 0 16 30" aria-hidden="true">
      <path d="M8 28 C 7 20, 9 12, 8 3 M 2 9 L 8 2 L 14 9"></path>
    </svg>
    <svg class="pebble-stone" width="48" height="34" viewBox="0 0 48 34" aria-hidden="true">
      <path d="M22 32 C 8 32, 2 22, 9 13 C 16 4, 34 3, 41 12 C 48 22, 40 32, 22 32 Z"></path>
      <path d="M14 14 C 18 10, 24 9, 28 10" class="pebble-shine"></path>
    </svg>
    <span class="pebble-label hand">back to the gate</span>
  </button>
</div>

<script>
  const row = document.querySelector<HTMLElement>(".pebble-row");
  const pebble = row?.querySelector<HTMLButtonElement>(".pebble");
  const stone = row?.querySelector<SVGSVGElement>(".pebble-stone");

  const LONG_PAGE_SCREENS = 2.5; // only pages longer than this get a pebble
  const STONE_RADIUS = 16; // px, how far it travels for one radian of turn
  const ARRIVE_WHEN_SHOWN = 0.6; // share of the row on screen before it rolls in

  const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  function measure() {
    if (row) row.hidden = document.documentElement.scrollHeight < innerHeight * LONG_PAGE_SCREENS;
  }

  function rollIn() {
    if (!row || !stone || still()) {
      row?.classList.add("is-here");
      return;
    }
    const distance = innerWidth - stone.getBoundingClientRect().left;
    const turn = (distance / STONE_RADIUS) * (180 / Math.PI);
    row.style.setProperty("--roll-from", `${distance}px`);
    row.style.setProperty("--turn-from", `${turn}deg`);
    row.classList.add("is-arriving");
    stone.addEventListener("animationend", () => row.classList.add("is-here"), { once: true });
  }

  if (row && "IntersectionObserver" in window) {
    const watch = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        watch.disconnect();
        rollIn();
      },
      { threshold: ARRIVE_WHEN_SHOWN },
    );
    watch.observe(row);
  } else {
    row?.classList.add("is-here");
  }

  pebble?.addEventListener("click", () => {
    row?.classList.add("is-here");
    pebble.classList.remove("is-rolling");
    void pebble.offsetWidth;
    if (!still()) pebble.classList.add("is-rolling");
    window.scrollTo({ top: 0, behavior: still() ? "auto" : "smooth" });
  });

  measure();
  window.addEventListener("load", measure);
</script>

<style>
  .pebble-row {
    --arrive-time: 1.2s;
    --appear-time: 0.35s;
    --arrow-lead: 0.55;
    --arrow-rise: 6px;
    display: flex;
    justify-content: flex-end;
    margin-top: 5rem;
  }

  .pebble-row[hidden] {
    display: none;
  }

  .pebble {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    align-items: end;
    column-gap: 0.75rem;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--fg-dim);
    cursor: pointer;
  }

  .pebble-arrow {
    grid-column: 1;
    justify-self: center;
    margin-bottom: 0.375rem;
  }

  .pebble-arrow path {
    fill: none;
    stroke: var(--cursor);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s ease;
  }

  .pebble:hover .pebble-arrow path {
    transform: translateY(-3px);
  }

  .pebble-stone {
    grid-column: 1;
    grid-row: 2;
  }

  .pebble-stone path {
    fill: var(--bg-alt);
    stroke: var(--fg-dim);
    stroke-width: 1.3;
  }

  .pebble-stone .pebble-shine {
    fill: none;
    stroke: var(--border);
    stroke-linecap: round;
  }

  .pebble-label {
    grid-column: 2;
    grid-row: 2;
    padding-bottom: 0.375rem;
    font-size: 1.0625rem;
  }

  .pebble:hover .pebble-label {
    color: var(--fg-main);
  }

  .pebble-row:not(.is-arriving, .is-here) .pebble-stone {
    visibility: hidden;
  }

  .pebble-arrow,
  .pebble-label {
    opacity: 0;
    transition:
      opacity var(--appear-time) ease,
      translate var(--appear-time) ease;
  }

  .pebble-arrow {
    translate: 0 var(--arrow-rise);
  }

  .is-arriving .pebble-arrow,
  .is-arriving .pebble-label,
  .is-here .pebble-arrow,
  .is-here .pebble-label {
    opacity: 1;
    translate: 0 0;
  }

  .is-arriving .pebble-arrow {
    transition-delay: calc(var(--arrive-time) * var(--arrow-lead));
  }

  .is-arriving .pebble-label {
    transition-delay: calc(var(--arrive-time) * var(--arrow-lead) + var(--appear-time) / 2);
  }

  .is-here:not(.is-arriving) .pebble-label {
    transition-delay: calc(var(--appear-time) / 2);
  }

  .is-arriving .pebble-stone {
    animation: pebble-arrive var(--arrive-time) cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  @keyframes pebble-arrive {
    from {
      transform: translateX(var(--roll-from)) rotate(var(--turn-from));
    }
  }

  .is-rolling .pebble-stone {
    animation: pebble-roll 0.9s cubic-bezier(0.3, 0.6, 0.4, 1);
  }

  @keyframes pebble-roll {
    to {
      transform: translateX(-28px) rotate(-200deg);
    }
  }
</style>
