---
// Passphrase line inside a vault envelope.
// Notes decrypt into the envelope; files decrypt straight to a download.
import InkButton from "./InkButton.astro";

interface Props {
  ciphertext?: string;
  encryptedUrl?: string;
  filename?: string;
  filesize?: string;
  iv: string;
  salt: string;
}

const { ciphertext, encryptedUrl, filename = "document.org", filesize, iv, salt } = Astro.props;
const isFile = Boolean(encryptedUrl);
---

<div
  class="vault-container"
  data-ciphertext={ciphertext || ""}
  data-url={encryptedUrl || ""}
  data-filename={filename}
  data-is-file={isFile ? "true" : "false"}
  data-iv={iv}
  data-salt={salt}
>
  <form class="vault-form">
    <label>
      <span>passphrase</span>
      <input type="password" class="vault-input" autocomplete="off" required />
      <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 4.2 C 22 3, 46 5.4, 70 3.6 S 92 4.6, 100 3.8"></path>
      </svg>
    </label>
    <InkButton type="submit" class="vault-btn">
      break the seal
    </InkButton>
    <p class="vault-status hand" role="status"></p>
  </form>

  <p class="vault-file">
    {filename}
    {filesize && ` · ${filesize}`} · AES-GCM
  </p>

  <div class="vault-unlocked" hidden>
    <div class="vault-content prose"></div>
    <div class="vault-actions">
      {!isFile && (
        <InkButton quiet class="vault-copy-btn">
          copy
        </InkButton>
      )}
      <InkButton quiet class="vault-download-btn">
        {isFile ? "download again" : "download"}
      </InkButton>
    </div>
  </div>
</div>

<script>
  function bytes(b64: string) {
    return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
  }

  async function deriveKey(passphrase: string, salt: Uint8Array) {
    const material = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(passphrase),
      "PBKDF2",
      false,
      ["deriveKey"],
    );
    return crypto.subtle.deriveKey(
      { name: "PBKDF2", salt, iterations: 100000, hash: "SHA-256" },
      material,
      { name: "AES-GCM", length: 256 },
      false,
      ["decrypt"],
    );
  }

  function save(blob: Blob, filename: string) {
    const href = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = href;
    a.download = filename;
    a.click();
    setTimeout(() => URL.revokeObjectURL(href), 3000);
  }

  async function unlock(container: HTMLElement) {
    const { url, filename = "document.org", ciphertext = "" } = container.dataset;
    const isFile = container.dataset.isFile === "true";
    const form = container.querySelector<HTMLFormElement>(".vault-form")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const button = form.querySelector<HTMLButtonElement>(".vault-btn")!;
    const status = form.querySelector(".vault-status")!;
    const unlocked = container.querySelector<HTMLElement>(".vault-unlocked")!;
    const content = container.querySelector<HTMLElement>(".vault-content")!;
    const copy = container.querySelector<HTMLButtonElement>(".vault-copy-btn");
    const download = container.querySelector<HTMLButtonElement>(".vault-download-btn")!;

    button.disabled = true;
    status.textContent = "breaking the seal…";

    try {
      const key = await deriveKey(input.value, bytes(container.dataset.salt || ""));
      const iv = bytes(container.dataset.iv || "");

      if (isFile) {
        const resp = await fetch(url!);
        if (!resp.ok) throw new Error("fetch");
        const plain = await crypto.subtle.decrypt(
          { name: "AES-GCM", iv },
          key,
          await resp.arrayBuffer(),
        );
        const blob = new Blob([plain], { type: "application/octet-stream" });
        save(blob, filename);
        content.textContent = `${filename} is on its way to your device.`;
        download.onclick = () => save(blob, filename);
      } else {
        const plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, key, bytes(ciphertext));
        content.innerHTML = new TextDecoder().decode(plain);
        const text = () => content.innerText;
        const name = /\.(org|txt|md)$/.test(filename) ? filename : `${filename}.org`;
        download.onclick = () =>
          save(new Blob([text()], { type: "text/plain;charset=utf-8" }), name);
        if (copy) {
          copy.onclick = () =>
            navigator.clipboard.writeText(text()).then(() => {
              const label = copy.lastChild!;
              label.textContent = " copied ";
              setTimeout(() => (label.textContent = " copy "), 2000);
            });
        }
      }

      form.hidden = true;
      unlocked.hidden = false;
      container.closest(".envelope")?.classList.add("is-open");
    } catch {
      status.textContent = "that isn’t the word.";
      input.select();
    } finally {
      button.disabled = false;
    }
  }

  document.querySelectorAll<HTMLElement>(".vault-container").forEach((container) => {
    container.querySelector("form")?.addEventListener("submit", (e) => {
      e.preventDefault();
      unlock(container);
    });
  });
</script>

<style>
  .vault-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.875rem 1.25rem;
    margin-top: 1.375rem;
  }

  .vault-form[hidden] {
    display: none;
  }

  label {
    flex: 1 1 12.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  label span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  input {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg-main);
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.2em;
    outline: none;
  }

  label svg {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 8px;
  }

  label path {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  label:focus-within path {
    stroke: var(--cursor);
  }

  .vault-status {
    flex-basis: 100%;
    margin: 0;
    font-size: 1.0625rem;
  }

  .vault-status:empty {
    display: none;
  }

  .vault-file {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
  }

  .vault-unlocked {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border);
  }

  .vault-content {
    font-size: 1rem;
  }

  .vault-content :global(> :first-child) {
    margin-top: 0;
  }

  .vault-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }
</style>
