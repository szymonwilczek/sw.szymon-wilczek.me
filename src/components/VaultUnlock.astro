---
interface Props {
  ciphertext: string; // Base64 encoded AES-GCM ciphertext + tag
  iv: string;         // Base64 encoded 12-byte IV
  salt: string;       // Base64 encoded salt for PBKDF2
  hint?: string;
}

const { ciphertext, iv, salt, hint } = Astro.props;
---

<div class="vault-container" data-ciphertext={ciphertext} data-iv={iv} data-salt={salt}>
  <div class="vault-prompt">
    <div class="vault-header">
      <span class="vault-title">[ Encrypted Document ]</span>
    </div>
    <p class="vault-message">
      This resource is protected by client-side AES-256-GCM encryption.
      {hint && <span class="vault-hint">Hint: {hint}</span>}
    </p>

    <form class="vault-form" onsubmit="return false;">
      <div class="input-group">
        <input 
          type="password" 
          class="vault-input" 
          placeholder="Enter Passphrase..."
          autocomplete="off" 
          required 
        />
        <button type="submit" class="btn-action vault-btn">Unlock</button>
      </div>
      <div class="vault-error" style="display: none;"></div>
    </form>
  </div>

  <div class="vault-unlocked" style="display: none;">
    <div class="unlocked-header">
      <span class="unlocked-badge">Document Decrypted Successfully</span>
    </div>
    <div class="vault-content"></div>
  </div>
</div>

<script is:inline>
  (function() {
    function base64ToBuffer(b64) {
      var bin = atob(b64);
      var buf = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) buf[i] = bin.charCodeAt(i);
      return buf;
    }

    async function unlockVault(container) {
      var input = container.querySelector('.vault-input');
      var errorEl = container.querySelector('.vault-error');
      var promptEl = container.querySelector('.vault-prompt');
      var unlockedEl = container.querySelector('.vault-unlocked');
      var contentEl = container.querySelector('.vault-content');
      var btn = container.querySelector('.vault-btn');

      if (!input || !errorEl || !promptEl || !unlockedEl || !contentEl || !btn) return;

      var passphrase = input.value;
      if (!passphrase) return;

      btn.disabled = true;
      btn.textContent = 'Verifying...';
      errorEl.style.display = 'none';

      try {
        var ciphertext = base64ToBuffer(container.dataset.ciphertext || '');
        var iv = base64ToBuffer(container.dataset.iv || '');
        var salt = base64ToBuffer(container.dataset.salt || '');

        var enc = new TextEncoder();
        var keyMaterial = await window.crypto.subtle.importKey(
          'raw',
          enc.encode(passphrase),
          'PBKDF2',
          false,
          ['deriveKey']
        );

        var key = await window.crypto.subtle.deriveKey(
          {
            name: 'PBKDF2',
            salt: salt,
            iterations: 100000,
            hash: 'SHA-256',
          },
          keyMaterial,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt']
        );

        var decrypted = await window.crypto.subtle.decrypt(
          { name: 'AES-GCM', iv: iv },
          key,
          ciphertext
        );

        var dec = new TextDecoder();
        contentEl.innerHTML = dec.decode(decrypted);
        promptEl.style.display = 'none';
        unlockedEl.style.display = 'block';
      } catch (e) {
        errorEl.textContent = 'Decryption failed: Invalid passphrase or corrupted ciphertext.';
        errorEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Unlock';
        input.focus();
      }
    }

    function initVaults() {
      document.querySelectorAll('.vault-container').forEach(function(container) {
        var form = container.querySelector('.vault-form');
        if (form && !form.dataset.bound) {
          form.dataset.bound = 'true';
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            unlockVault(container);
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVaults);
    } else {
      initVaults();
    }
  })();
</script>

<style>
  .vault-container {
    margin: 2rem 0;
  }

  .vault-prompt {
    background-color: var(--bg-dim);
    border: 1px solid var(--border);
    padding: 1.5rem;
    max-width: 580px;
  }

  .vault-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-weight: 700;
    font-size: 1rem;
    color: var(--fg-link);
    margin-bottom: 0.5rem;
  }

  .vault-message {
    font-size: 0.95rem;
    color: var(--fg-main);
    margin-bottom: 1.25rem;
  }

  .vault-hint {
    display: block;
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.85rem;
    color: var(--fg-dim);
    margin-top: 0.35rem;
  }

  .input-group {
    display: flex;
    gap: 0.6rem;
  }

  .vault-input {
    flex: 1;
    background-color: var(--bg-main);
    border: 1px solid var(--border);
    color: var(--fg-main);
    padding: 0.45rem 0.75rem;
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    border-radius: 0;
  }

  .vault-input:focus {
    outline: 1px solid var(--fg-link);
    border-color: var(--fg-link);
  }

  .vault-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: 1px solid var(--border) !important;
    color: var(--fg-main) !important;
    font-family: "Typus Mono 95", "Typus Mono", monospace !important;
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    padding: 0.35rem 0.85rem !important;
    border-radius: 0 !important;
    cursor: pointer !important;
    text-decoration: none !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease !important;
  }

  .vault-btn:hover:not(:disabled) {
    background-color: var(--fg-main) !important;
    color: var(--bg-main) !important;
    border-color: var(--fg-main) !important;
  }

  .vault-btn:active:not(:disabled) {
    background-color: var(--fg-link) !important;
    color: var(--bg-main) !important;
    border-color: var(--fg-link) !important;
  }

  .vault-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .vault-error {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.85rem;
    color: var(--red-warmer);
    margin-top: 0.75rem;
  }

  .vault-unlocked {
    background-color: var(--bg-dim);
    border: 1px solid var(--border);
    padding: 1.5rem;
    max-width: 680px;
    border-radius: 2px;
  }

  .unlocked-header {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--border);
  }

  .unlocked-badge {
    font-family: "Typus Mono 95", "Typus Mono", monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--fg-link-active);
  }

  .vault-content {
    line-height: 1.7;
    color: var(--fg-main);
  }
</style>
