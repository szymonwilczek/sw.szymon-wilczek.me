root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 100

[*.{c,h,s,S}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 100

[*.{sh,bash,zsh}]
indent_style = tab
indent_size = 8
tab_width = 8

[*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro,json,css,html}]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.org]
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = false
